      "default": "<p>A liquid botanical extract made from black walnut hulls.</p>"
    },
    {
      "type": "text",
      "id": "purchase",
      "label": "Purchase heading",
      "default": "Purchase options"
    },
    {
      "type": "text",
      "id": "once",
      "label": "One-time label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "subscribe",
      "label": "Subscription label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#02c6ea"
    },
    {
      "type": "text",
      "id": "single_title",
      "label": "Single offer",
      "default": "Buy 1"
    },
    {
      "type": "text",
      "id": "middle_title",
      "label": "Middle offer",
      "default": "Buy 2 Get 1 FREE"
    },
    {
      "type": "text",
      "id": "large_title",
      "label": "Largest offer",
      "default": "Buy 3 Get 1 FREE"
    },
    {
      "type": "text",
      "id": "single_subtitle",
      "label": "Single offer subtitle",
      "default": "1 bottle"
    },
    {
      "type": "text",
      "id": "middle_subtitle",
      "label": "Middle offer subtitle",
      "default": "3 bottles total"
    },
    {
      "type": "text",
      "id": "large_subtitle",
      "label": "Largest offer subtitle",
      "default": "4 bottles total"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Free U.S. shipping"
    },
    {
      "type": "text",
      "id": "ebook_label",
      "label": "Ebook gift label",
      "default": "Free e-book"
    },
    {
      "type": "url",
      "id": "ebook_url",
      "label": "Ebook download link"
    },
    {
      "type": "text",
      "id": "stock_label",
      "label": "Low stock label",
      "default": "Low Stock \u2013 Selling Fast"
    },
    {
      "type": "text",
      "id": "mode_heading",
      "label": "Purchase frequency heading",
      "default": "How often would you like it?"
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "label": "Low stock threshold",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "ebook_download",
      "label": "Ebook download text",
      "default": "Download Nature\u2019s Forgotten Remedies"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",

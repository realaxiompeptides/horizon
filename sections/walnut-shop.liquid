{% liquid
  assign item = product | default: section.settings.item
  assign variant = item.selected_or_first_available_variant
  assign default_bundle = item.variants | where: 'option1', '3 bottles' | first
  if item.selected_variant == blank and default_bundle.available
    assign variant = default_bundle
  endif
  assign ebook_url = section.settings.ebook_url | default: 'https://cdn.shopify.com/s/files/1/1074/0488/6176/files/Natures_Forgotten_Remedies_25_Page_Ebook.pdf?v=1795314600'
  assign form_id = 'WalnutForm-' | append: section.id
%}
<script src="{{ 'product-form.js' | asset_url }}" type="module" fetchpriority="low"></script>
<div id="Walnut-{{ section.id }}" class="walnut-shop" style="--accent:{{ section.settings.accent }}">
<div class="walnut-shop__gallery">
{% assign slides = section.blocks | where: 'type', 'slide' %}
{% for block in slides %}
<details name="gallery-{{ section.id }}" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
<summary>{{ block.settings.label | escape }}</summary>
{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: widths: '400,700,1100' }}{% else %}<div class="walnut-art" role="img" aria-label="{{ block.settings.label | escape }}" style="background-position:{{ block.settings.position }}"></div>{% endif %}
</details>
{% endfor %}
</div>
<div class="walnut-shop__info"><h1>{{ section.settings.heading | default: item.title | escape }}</h1>
{{ section.settings.intro }}
<ul>{% for block in section.blocks %}{% if block.type == 'benefit' %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endif %}{% endfor %}</ul>
{% if variant %}
<product-form-component data-section-id="{{ section.id }}" data-product-id="{{ item.id }}" data-product-url="{{ item.url }}" data-quantity-default="1" on:submit="/handleSubmit">
<div class="visually-hidden" aria-live="polite" ref="liveRegion"></div>
{% form 'product', item, id: form_id %}
<input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
<div class="walnut-offer-header">
  <strong>{{ section.settings.subscribe | escape }}</strong>
  <div class="walnut-offer-values">
    <span data-walnut-summary>{{ variant.price | money }}</span>
    <del data-walnut-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</del>
    <span class="walnut-sale" data-walnut-sale hidden></span>
  </div>
  {% if variant.selling_plan_allocations == empty %}
    <small>{{ section.settings.example_note | escape }}</small>
  {% endif %}
</div>
{% if section.settings.show_stock %}
  <p class="walnut-stock"><span>{{ section.settings.stock_label | escape }}</span></p>
{% endif %}
<fieldset class="walnut-bundles">
  <legend class="visually-hidden">{{ section.settings.purchase | escape }}</legend>
  {% for pack in item.variants %}
    {% liquid
      assign title = pack.title
      assign subtitle = ''
      assign shipping = false
      assign gift_ebook = false
      assign savings = 0
      if pack.compare_at_price > pack.price
        assign savings = pack.compare_at_price | minus: pack.price | times: 100.0 | divided_by: pack.compare_at_price | round
      endif
      if pack.option1 == '4 bottles' and ebook_url != blank
        assign gift_ebook = true
      endif
      case pack.option1
        when '1 bottle', 'Default Title'
          assign title = section.settings.single_title
          assign subtitle = section.settings.single_subtitle
        when '3 bottles'
          assign title = section.settings.middle_title
          assign subtitle = section.settings.middle_subtitle
          assign shipping = true
        when '4 bottles'
          assign title = section.settings.large_title
          assign subtitle = section.settings.large_subtitle
          assign shipping = true
      endcase
    %}
    <label class="walnut-bundle">
      <input type="radio" name="walnut_pack" value="{{ pack.id }}" data-walnut-pack {% if pack.option1 == '4 bottles' %}data-walnut-ebook{% endif %} data-price="{{ pack.price | money | escape }}" data-compare="{% if savings > 0 %}{{ pack.compare_at_price | money | escape }}{% endif %}" data-savings="{{ savings }}" {% if pack.id == variant.id %}checked{% endif %} {% unless pack.available %}disabled{% endunless %}>
      {% if shipping %}
        <span class="walnut-ribbon">{{ section.settings.shipping_label | escape }}{% if gift_ebook %} + {{ section.settings.ebook_label | escape }}{% endif %}</span>
      {% endif %}
      <span class="walnut-bundle__thumb" aria-hidden="true"></span>
      <span class="walnut-bundle__copy">
        <strong>{{ title | escape }}</strong>
        {% if subtitle != blank %}<small>{{ subtitle | escape }}</small>{% endif %}
        {% if savings > 0 %}<small>{{ section.settings.savings_prefix | escape }} {{ savings }}%</small>{% endif %}
        {% unless pack.available %}<small>{{ 'products.product.sold_out' | t }}</small>{% endunless %}
      </span>
      <span class="walnut-bundle__price">
        <strong>{{ pack.price | money }}</strong>
        {% if pack.compare_at_price > pack.price %}<del>{{ pack.compare_at_price | money }}</del>{% endif %}
      </span>
      {% if shipping %}
        <span class="walnut-unlock">
          <strong>{{ section.settings.gift_heading | escape }}</strong>
          <span><i aria-hidden="true">✓</i>{{ section.settings.shipping_label | escape }}</span>
          {% if gift_ebook %}<span><i aria-hidden="true">✓</i>{{ section.settings.ebook_label | escape }}</span>{% endif %}
        </span>
      {% endif %}
    </label>
  {% endfor %}
</fieldset>
{% for pack in item.variants %}
  {% if pack.selling_plan_allocations != empty %}
    <fieldset class="walnut-modes" data-walnut-modes="{{ pack.id }}" {% unless pack.id == variant.id %}hidden disabled{% endunless %}>
      <legend>{{ section.settings.mode_heading | escape }}</legend>
      {% for allocation in pack.selling_plan_allocations %}
        <label><input type="radio" name="selling_plan" value="{{ allocation.selling_plan.id }}" data-price="{{ allocation.price | money | escape }}" {% if forloop.first and item.requires_selling_plan and pack.id == variant.id %}checked{% endif %}><span><strong>{{ section.settings.subscribe | escape }}</strong><br>{{ allocation.selling_plan.name | escape }}</span><b>{{ allocation.price | money }}</b></label>
      {% endfor %}
      {% unless item.requires_selling_plan %}
        <label><input type="radio" name="selling_plan" value="" data-price="{{ pack.price | money | escape }}" {% if pack.id == variant.id %}checked{% endif %}><span>{{ section.settings.once | escape }}</span><b>{{ pack.price | money }}</b></label>
      {% endunless %}
    </fieldset>
  {% endif %}
{% endfor %}
<div class="hidden" ref="addToCartTextError" role="alert"></div>
<button class="button" type="submit" {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}{{ section.settings.cta | escape }} <span aria-hidden="true">·</span> <span data-walnut-total>{{ variant.price | money }}</span> <del data-walnut-cta-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</del>{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
{% if ebook_url != blank %}
  <p class="walnut-ebook" data-walnut-ebook-link {% unless variant.option1 == '4 bottles' %}hidden{% endunless %}>
    <a href="{{ ebook_url | escape }}" target="_blank" rel="noopener">{{ section.settings.ebook_download | escape }}</a>
  </p>
{% endif %}
{% endform %}
</product-form-component>
{% endif %}</div></div>
<script>
  (() => {
    const form = document.getElementById({{ form_id | json }});
    if (!form) return;
    const variantInput = form.querySelector('[name="id"]');
    const total = form.querySelector('[data-walnut-total]');
    const summary = form.querySelector('[data-walnut-summary]');
    const sale = form.querySelector('[data-walnut-sale]');
    const comparePrices = form.querySelectorAll('[data-walnut-compare], [data-walnut-cta-compare]');
    const savingsPrefix = {{ section.settings.savings_prefix | json }};
    const ebook = form.querySelector('[data-walnut-ebook-link]');
    const modeGroups = [...form.querySelectorAll('[data-walnut-modes]')];
    function selectPack() {
      const pack = form.querySelector('[data-walnut-pack]:checked');
      if (!pack) return;
      variantInput.value = pack.value;
      if (ebook) ebook.hidden = !pack.hasAttribute('data-walnut-ebook');
      const activeGroup = modeGroups.find(group => group.dataset.walnutModes === pack.value);
      const selectedPlan = activeGroup?.querySelector('input:checked');
      for (const group of modeGroups) {
        group.hidden = group !== activeGroup;
        group.disabled = group !== activeGroup;
        for (const option of group.querySelectorAll('input')) {
          option.checked = option === selectedPlan;
        }
      }
      if (activeGroup && !selectedPlan) {
        const defaultPlan = activeGroup.querySelector('input[value=""]') || activeGroup.querySelector('input');
        if (defaultPlan) defaultPlan.checked = true;
      }
      const price = activeGroup?.querySelector('input:checked')?.dataset.price || pack.dataset.price;
      if (total) total.textContent = price;
      summary.textContent = price;
      for (const compare of comparePrices) {
        compare.textContent = pack.dataset.compare;
        compare.hidden = !pack.dataset.compare;
      }
      sale.hidden = !pack.dataset.compare;
      sale.textContent = savingsPrefix + ' ' + pack.dataset.savings + '%';
    }
    form.addEventListener('change', selectPack);
    form.addEventListener('submit', selectPack, { capture: true });
    selectPack();
  })();
</script>
<style>
/* Offer header, stock divider, stacked cards and expanded gifts follow the Soursop layout. */
.walnut-shop { max-width:1180px; margin:auto; padding:clamp(14px,4vw,56px); display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:start; gap:clamp(22px,5vw,70px); --offer-blue:#167b9a; --offer-dark:#123f54; --offer-border:#c5e3ec; }
.walnut-shop h1 { font-size:clamp(2.2rem,4vw,3.8rem); letter-spacing:-.045em; color:#092d46; margin:0 0 16px; }
.walnut-shop li { margin:.45rem 0; }
.walnut-shop li::marker { color:var(--accent); }
.walnut-shop fieldset { padding:0; border:0; min-width:0; margin:0 0 14px; }
.walnut-offer-header { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:9px 14px; border-block:1px solid var(--offer-border); padding:16px 0; margin-top:20px; color:var(--offer-dark); font-size:clamp(18px,4.4vw,23px); }
.walnut-offer-values { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:6px 9px; }
.walnut-offer-values > span:first-child { color:var(--offer-blue); font-size:clamp(23px,6vw,33px); font-weight:850; }
.walnut-offer-values del { color:#3c4b53; font-size:clamp(12px,3.2vw,17px); font-weight:700; }
.walnut-offer-header > small { grid-column:1/-1; font-size:12px; color:#50616a; }
.walnut-sale,.walnut-ribbon { background:var(--offer-blue); color:white; border-radius:999px; padding:5px 10px; font-size:11px; line-height:1.25; font-weight:850; letter-spacing:.04em; }
.walnut-stock { display:flex; align-items:center; gap:10px; margin:13px 0 19px; color:var(--offer-dark); font-size:clamp(14px,3.7vw,17px); font-weight:850; text-align:center; }
.walnut-stock::before,.walnut-stock::after { content:""; flex:1; height:2px; background:var(--offer-border); }
.walnut-bundles { display:grid; gap:13px; }
.walnut-bundle { display:grid; grid-template-columns:46px minmax(0,1fr) auto; align-items:center; gap:11px; min-height:91px; position:relative; margin:0; padding:16px 12px; border:2px solid var(--offer-border); border-radius:17px; background:white; cursor:pointer; }
.walnut-bundle:has(:checked) { background:#dff3fa; border-color:var(--offer-blue); box-shadow:0 0 0 3px #e5f4f9,0 8px 20px #153f5411; }
.walnut-bundle:has(:focus-visible) { outline:3px solid var(--offer-dark); outline-offset:3px; }
.walnut-bundle > input { position:absolute; opacity:0; width:1px; height:1px; }
.walnut-ribbon { position:absolute; top:-10px; right:11px; white-space:nowrap; text-transform:uppercase; }
.walnut-bundle__thumb { width:46px; aspect-ratio:1; border-radius:8px; background:url('{{ "avonent-black-walnut-gallery.webp" | asset_url }}') 0 0 / 400% 200%; }
.walnut-bundle__copy,.walnut-bundle__price { display:grid; gap:4px; line-height:1.25; }
.walnut-bundle__copy strong { color:var(--offer-dark); font-size:clamp(15px,4vw,20px); }
.walnut-bundle__copy small,.walnut-bundle__price del { color:#536775; font-size:12px; }
.walnut-bundle__price { text-align:right; color:var(--offer-blue); white-space:nowrap; font-size:clamp(17px,4.5vw,23px); }
.walnut-unlock { display:none; grid-column:1/-1; border-top:1px solid #b9dce8; padding-top:10px; color:var(--offer-dark); }
.walnut-bundle:has(:checked) .walnut-unlock { display:grid; gap:7px; }
.walnut-unlock > strong { font-size:10px; letter-spacing:.12em; text-transform:uppercase; }
.walnut-unlock > span { display:flex; gap:8px; align-items:center; font-size:13px; font-weight:750; }
.walnut-unlock i { color:white; background:var(--offer-blue); width:20px; height:20px; border-radius:50%; display:grid; place-items:center; font-style:normal; }
.walnut-shop .button { width:100%; min-height:54px; border-radius:13px; background:var(--offer-blue); color:white; font-weight:850; }
.walnut-shop .button del { opacity:.8; font-size:.85em; }
.walnut-ebook { margin-top:10px; text-align:center; }
.walnut-shop [hidden] { display:none!important; }
.walnut-modes label { display:flex; align-items:center; gap:9px; padding:10px; margin-top:6px; border:1px solid var(--offer-border); border-radius:10px; }
.walnut-modes b { margin-left:auto; }
@media(max-width:380px) { .walnut-bundle { grid-template-columns:34px minmax(0,1fr) auto; gap:7px; padding-inline:9px; } .walnut-bundle__thumb { width:34px; } }

.walnut-shop__gallery{display:flex;flex-wrap:wrap;gap:6px;position:relative;padding-top:calc(100% + 10px)}.walnut-shop summary{font-size:.8rem;cursor:pointer;border:1px solid #cbdde2;border-radius:20px;padding:5px 10px;list-style:none}.walnut-shop details[open] summary{border-color:var(--accent);background:#edfbff}.walnut-shop__gallery img,.walnut-shop .walnut-art{position:absolute;top:0;left:0;width:100%;aspect-ratio:1;object-fit:cover;border-radius:16px}.walnut-art{background-image:url('{{ "avonent-black-walnut-gallery.webp" | asset_url }}');background-size:400% 200%}
@media(max-width:749px){.walnut-shop{grid-template-columns:minmax(0,1fr)}}
</style>

{% schema %}
{
  "name": "Black walnut product",
  "settings": [
    {
      "type": "product",
      "id": "item",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title override"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Description",
      "default": "<p>A liquid botanical extract made from black walnut hulls.</p>"
    },
    {
      "type": "text",
      "id": "purchase",
      "label": "Purchase heading",
      "default": "Purchase options"
    },
    {
      "type": "text",
      "id": "once",
      "label": "One-time label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "subscribe",
      "label": "Subscription label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#02c6ea"
    },
    {
      "type": "text",
      "id": "single_title",
      "label": "Single offer",
      "default": "Buy 1"
    },
    {
      "type": "text",
      "id": "middle_title",
      "label": "Middle offer",
      "default": "Buy 2 Get 1 FREE"
    },
    {
      "type": "text",
      "id": "large_title",
      "label": "Largest offer",
      "default": "Buy 3 Get 1 FREE"
    },
    {
      "type": "text",
      "id": "single_subtitle",
      "label": "Single offer subtitle",
      "default": "1 bottle"
    },
    {
      "type": "text",
      "id": "middle_subtitle",
      "label": "Middle offer subtitle",
      "default": "3 bottles total"
    },
    {
      "type": "text",
      "id": "large_subtitle",
      "label": "Largest offer subtitle",
      "default": "4 bottles total"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Free U.S. shipping"
    },
    {
      "type": "text",
      "id": "ebook_label",
      "label": "Ebook gift label",
      "default": "Free e-book"
    },
    {
      "type": "url",
      "id": "ebook_url",
      "label": "Ebook download link"
    },
    {
      "type": "text",
      "id": "stock_label",
      "label": "Low stock label",
      "default": "Low Stock \u2013 Selling Fast"
    },
    {
      "type": "text",
      "id": "mode_heading",
      "label": "Purchase frequency heading",
      "default": "How often would you like it?"
    },
    {
      "type": "text",
      "id": "ebook_download",
      "label": "Ebook download text",
      "default": "Download Nature\u2019s Forgotten Remedies"
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Show low stock message",
      "default": true
    },
    {
      "type": "text",
      "id": "example_note",
      "label": "Example offer note",
      "default": "Subscription offer preview. One-time purchase is available today."
    },
    {
      "type": "text",
      "id": "savings_prefix",
      "label": "Savings text",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "gift_heading",
      "label": "Gift heading",
      "default": "Gifts Unlocked"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption",
          "default": "Product image"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Default artwork",
          "default": "0% 0%",
          "options": [
            {
              "value": "0% 0%",
              "label": "1"
            },
            {
              "value": "33.333% 0%",
              "label": "2"
            },
            {
              "value": "66.666% 0%",
              "label": "3"
            },
            {
              "value": "100% 0%",
              "label": "4"
            },
            {
              "value": "0% 100%",
              "label": "5"
            },
            {
              "value": "33.333% 100%",
              "label": "6"
            },
            {
              "value": "66.666% 100%",
              "label": "7"
            },
            {
              "value": "100% 100%",
              "label": "8"
            }
          ]
        }

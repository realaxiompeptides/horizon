{% liquid
  assign trust_bg = section.settings.background_image
  if trust_bg == blank
    assign trust_bg = product.featured_image
  endif
%}

<section
  class="ag-trust2"
  style="--bg:{{ section.settings.background }};--a:{{ section.settings.accent }};--ad:{{ section.settings.accent_dark }};--t:{{ section.settings.text }};--check:{{ section.settings.check_color }};"
>
  <div class="ag-trust2__in">
    <div class="ag-trust2__panel">
      {% if trust_bg != blank %}
        {{ trust_bg | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '(min-width:900px) 980px,100vw', loading: 'lazy', class: 'ag-trust2__img', alt: section.settings.heading }}
      {% endif %}
      <div class="ag-trust2__shade"></div>
      <div class="ag-trust2__content">
        <span class="ag-trust2__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <div class="ag-trust2__grid">
          {% for block in section.blocks %}
            <div class="ag-trust2__item" {{ block.shopify_attributes }}>
              <i aria-hidden="true">✓</i>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>
        {% if section.settings.footer != blank %}
          <strong class="ag-trust2__footer">{{ section.settings.footer }}</strong>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.ag-trust2{background:var(--bg);padding:20px 0 46px}.ag-trust2 *{box-sizing:border-box}.ag-trust2__in{width:min(calc(100% - 28px),1040px);margin:auto}.ag-trust2__panel{position:relative;min-height:440px;overflow:hidden;border-radius:24px;background:linear-gradient(145deg,var(--ad),var(--a));box-shadow:0 18px 55px rgb(0 72 145 / 12%)}.ag-trust2__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.72) contrast(1.03)}.ag-trust2__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgb(3 21 66 / 82%),rgb(0 104 232 / 82%))}.ag-trust2__content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;min-height:440px;padding:52px 48px;color:var(--t)}.ag-trust2__eyebrow{display:block;margin:0 auto 9px;color:#bdefff;font-size:10px;font-weight:900;letter-spacing:.14em;text-align:center;text-transform:uppercase}.ag-trust2 h2{margin:0 auto 34px;max-width:760px;color:var(--t);font-size:clamp(34px,4.6vw,54px);font-weight:800;line-height:1;letter-spacing:-.04em;text-align:center}.ag-trust2__grid{display:grid;grid-template-columns:1fr 1fr;gap:20px 38px;max-width:790px;margin:auto}.ag-trust2__item{display:flex;align-items:center;gap:11px;color:var(--t);font-size:16px;font-weight:650;line-height:1.35}.ag-trust2__item i{display:grid;place-items:center;width:24px;height:24px;flex:0 0 24px;border-radius:50%;background:var(--check);color:#fff;font-style:normal;font-size:13px;font-weight:900;box-shadow:0 0 0 4px rgb(255 255 255 / 10%)}.ag-trust2__footer{display:block;margin-top:36px;color:#fff;font-size:20px;font-weight:850;text-align:center}.ag-trust2__footer::before,.ag-trust2__footer::after{content:"";display:inline-block;width:34px;height:1px;margin:0 11px 6px;background:rgb(255 255 255 / 38%)}@media(max-width:749px){.ag-trust2{padding:12px 0 34px}.ag-trust2__panel{min-height:410px;border-radius:18px}.ag-trust2__content{min-height:410px;padding:38px 22px}.ag-trust2 h2{margin-bottom:28px;font-size:34px}.ag-trust2__grid{gap:16px 14px}.ag-trust2__item{font-size:13px}.ag-trust2__item i{width:22px;height:22px;flex-basis:22px}.ag-trust2__footer{margin-top:30px;font-size:16px}.ag-trust2__footer::before,.ag-trust2__footer::after{width:18px}}
{% endstylesheet %}

{% schema %}
{
  "name":"Why Trust Avonent",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"image_picker","id":"background_image","label":"Background image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY AVONENT"},
    {"type":"text","id":"heading","label":"Heading","default":"Why Trust Avonent as Your Wellness Partner?"},
    {"type":"text","id":"footer","label":"Footer text","default":"Carefully Crafted Formula"},
    {"type":"color","id":"background","label":"Section background","default":"#FFFFFF"},
    {"type":"color","id":"accent","label":"Avonent blue","default":"#02C6EA"},
    {"type":"color","id":"accent_dark","label":"Deep blue","default":"#0068E8"},
    {"type":"color","id":"text","label":"Text","default":"#FFFFFF"},
    {"type":"color","id":"check_color","label":"Check icon","default":"#72B58A"}
  ],
  "blocks":[
    {
      "type":"trust_item",
      "name":"Trust point",
      "settings":[
        {"type":"text","id":"text","label":"Text","default":"Odorless Formula"}
      ]
    }
  ],
  "max_blocks":8,
  "presets":[{"name":"Why Trust Avonent","blocks":[{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"}]}]
}
{% endschema %}
<section class="ag-trust2" style="--bg:{{ section.settings.background }};--a:{{ section.settings.accent }};--t:{{ section.settings.text }};">
  <div class="ag-trust2__in">
    <div class="ag-trust2__panel">
      {% if section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width:900px) 900px,100vw', loading: 'lazy', class: 'ag-trust2__img', alt: section.settings.heading }}
      {% endif %}
      <div class="ag-trust2__shade"></div>
      <div class="ag-trust2__content">
        <h2>{{ section.settings.heading }}</h2>
        <div class="ag-trust2__grid">
          {% for block in section.blocks %}
            <div class="ag-trust2__item" {{ block.shopify_attributes }}><i>✓</i><span>{{ block.settings.text }}</span></div>
          {% endfor %}
        </div>
        {% if section.settings.footer != blank %}<strong>{{ section.settings.footer }}</strong>{% endif %}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.ag-trust2{background:var(--bg);padding:16px 0 38px}.ag-trust2__in{width:min(calc(100% - 28px),980px);margin:auto}.ag-trust2__panel{position:relative;min-height:410px;overflow:hidden;border-radius:22px;background:linear-gradient(150deg,#2b1118,var(--a))}.ag-trust2__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ag-trust2__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgb(35 14 20 / 70%),rgb(126 31 47 / 84%))}.ag-trust2__content{position:relative;z-index:2;padding:46px 42px;color:var(--t)}.ag-trust2 h2{margin:0 auto 30px;max-width:760px;text-align:center;color:var(--t);font-size:clamp(34px,4vw,48px);line-height:1.03;letter-spacing:-.035em}.ag-trust2__grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 28px;max-width:760px;margin:auto}.ag-trust2__item{display:flex;align-items:center;gap:10px;font-size:16px}.ag-trust2__item i{display:grid;place-items:center;width:23px;height:23px;flex:0 0 23px;border-radius:50%;background:#83aa90;color:#fff;font-style:normal;font-size:12px;font-weight:900}.ag-trust2__content>strong{display:block;text-align:center;margin-top:30px;font-size:18px}@media(max-width:749px){.ag-trust2__panel{min-height:380px;border-radius:18px}.ag-trust2__content{padding:36px 23px}.ag-trust2 h2{font-size:31px}.ag-trust2__grid{gap:14px 16px}.ag-trust2__item{font-size:13px}}
{% endstylesheet %}
{% schema %}
{
  "name":"Aged Garlic Trust V2",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"image_picker","id":"background_image","label":"Background image"},
    {"type":"text","id":"heading","label":"Heading","default":"Why choose Avonent for your daily routine?"},
    {"type":"text","id":"footer","label":"Footer text","default":"Straightforward formula. Easy daily use."},
    {"type":"color","id":"background","label":"Section background","default":"#FFFDFC"},
    {"type":"color","id":"accent","label":"Burgundy","default":"#8B2635"},
    {"type":"color","id":"text","label":"Text","default":"#FFFFFF"}
  ],
  "blocks":[{"type":"trust_item","name":"Trust item","settings":[{"type":"text","id":"text","label":"Text","default":"Odorless softgel format"}]}],
  "max_blocks":8,
  "presets":[{"name":"Aged Garlic Trust V2","blocks":[{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"},{"type":"trust_item"}]}]
}
{% endschema %}
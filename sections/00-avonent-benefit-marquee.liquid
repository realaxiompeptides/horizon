{% liquid
  assign section_id = 'AvonentBenefitMarquee-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-benefit-marquee"
  style="
    --avm-bg: {{ section.settings.background_color }};
    --avm-text: {{ section.settings.text_color }};
    --avm-icon: {{ section.settings.icon_color }};
    --avm-icon-bg: {{ section.settings.icon_background }};
    --avm-border: {{ section.settings.border_color }};
    --avm-speed: {{ section.settings.speed }}s;
    --avm-gap: {{ section.settings.item_gap }}px;
    --avm-icon-size: {{ section.settings.icon_size }}px;
    --avm-text-size: {{ section.settings.text_size }}px;
    --avm-pad-y: {{ section.settings.padding_y }}px;
    --avm-space-top: {{ section.settings.spacing_top }}px;
    --avm-space-bottom: {{ section.settings.spacing_bottom }}px;
  "
>
  <div class="avonent-benefit-marquee__viewport">
    <div class="avonent-benefit-marquee__track{% if section.settings.reverse_direction %} is-reverse{% endif %}">
      {% for copy_index in (1..2) %}
        <div class="avonent-benefit-marquee__set"{% if copy_index == 2 %} aria-hidden="true"{% endif %}>
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="avonent-benefit-marquee__item" {% if copy_index == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {% unless block.settings.icon == 'none' %}
                  <span class="avonent-benefit-marquee__icon{% unless section.settings.show_icon_background %} is-plain{% endunless %}" aria-hidden="true">
                    {% case block.settings.icon %}
                      {% when 'bolt' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M13.2 2.5 5.8 13h5.6l-.7 8.5 7.5-11h-5.7l.7-8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg>
                      {% when 'sparkle' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.7c.8 4.5 3.2 6.9 7.7 7.7-4.5.8-6.9 3.2-7.7 7.7-.8-4.5-3.2-6.9-7.7-7.7 4.5-.8 6.9-3.2 7.7-7.7Z" stroke="currentColor" stroke-width="1.8"/><path d="M19 2.8c.25 1.45 1.05 2.25 2.5 2.5-1.45.25-2.25 1.05-2.5 2.5-.25-1.45-1.05-2.25-2.5-2.5 1.45-.25 2.25-1.05 2.5-2.5Z" fill="currentColor"/></svg>
                      {% when 'leaf' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M19.5 4.5C12.4 4.7 7.7 7.9 7.2 13.2c-.4 4.2 2.2 6.3 5.5 5.8 5.1-.8 7.4-6.4 6.8-14.5Z" stroke="currentColor" stroke-width="1.8"/><path d="M5 20c2.2-4.4 5.7-7.7 10.8-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                      {% when 'heart' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M20.2 5.8c-2-2-5.2-2-7.2 0L12 6.8l-1-1c-2-2-5.2-2-7.2 0s-2 5.2 0 7.2L12 21l8.2-8c2-2 2-5.2 0-7.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {% when 'heart_pulse' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M20.2 5.8c-2-2-5.2-2-7.2 0L12 6.8l-1-1c-2-2-5.2-2-7.2 0s-2 5.2 0 7.2L12 21l8.2-8c2-2 2-5.2 0-7.2Z" stroke="currentColor" stroke-width="1.7"/><path d="M4.4 12h4l1.3-2.7 2.2 5.5 1.5-2.8h6.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'shield' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 19 5.6v5.2c0 4.5-2.8 8.4-7 10.4-4.2-2-7-5.9-7-10.4V5.6L12 2.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {% when 'shield_plus' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 19 5.6v5.2c0 4.5-2.8 8.4-7 10.4-4.2-2-7-5.9-7-10.4V5.6L12 2.8Z" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v6M9 11h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                      {% when 'activity' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M3 12h4l2-5 4 10 2-5h6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'sun' %}
                        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                      {% when 'moon' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M20 15.2A8.2 8.2 0 0 1 8.8 4 8.6 8.6 0 1 0 20 15.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {% when 'brain' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M9.2 5.2a3 3 0 0 0-5.1 2.2c0 .6.2 1.2.5 1.7a3.3 3.3 0 0 0 .7 6.4 3.1 3.1 0 0 0 3.9 3.1V5.2ZM14.8 5.2a3 3 0 0 1 5.1 2.2c0 .6-.2 1.2-.5 1.7a3.3 3.3 0 0 1-.7 6.4 3.1 3.1 0 0 1-3.9 3.1V5.2Z" stroke="currentColor" stroke-width="1.7"/><path d="M9.2 9H7.4M14.8 9h1.8M9.2 14H7M14.8 14H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      {% when 'droplet' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8S6.2 9.2 6.2 14.2a5.8 5.8 0 1 0 11.6 0C17.8 9.2 12 2.8 12 2.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {% when 'flame' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M13.2 2.7c.8 4.3-3.4 5-2.2 8.3.7 1.9 2.6 1.7 3.3.2.9 1 1.7 2.5 1.7 4.3A4.8 4.8 0 0 1 11.2 20C7.8 20 5 17.5 5 14.2c0-4.3 3.5-6.6 8.2-11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {% when 'check' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'plus' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                      {% when 'circle' %}
                        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.9"/></svg>
                      {% when 'arrows' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M7 7h10l-2.5-2.5M17 17H7l2.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 7v4M7 17v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    {% endcase %}
                  </span>
                {% endunless %}
                <span class="avonent-benefit-marquee__label">{{ block.settings.text }}{% unless block.settings.marker == 'none' %}<sup class="avonent-benefit-marquee__marker">{{ block.settings.marker }}</sup>{% endunless %}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .avonent-benefit-marquee {
    width: 100%;
    margin-top: var(--avm-space-top);
    margin-bottom: var(--avm-space-bottom);
    overflow: hidden;
    color: var(--avm-text);
    background: var(--avm-bg);
    border-top: 1px solid var(--avm-border);
    border-bottom: 1px solid var(--avm-border);
  }
  .avonent-benefit-marquee__viewport { width: 100%; overflow: hidden; }
  .avonent-benefit-marquee__track {
    display: flex;
    width: max-content;
    min-width: 200%;
    animation: avonentBenefitMarquee var(--avm-speed) linear infinite;
    will-change: transform;
  }
  .avonent-benefit-marquee__track.is-reverse { animation-direction: reverse; }
  .avonent-benefit-marquee__set {
    display: flex;
    align-items: center;
    flex: none;
    gap: var(--avm-gap);
    padding: var(--avm-pad-y) 16px;
  }
  .avonent-benefit-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    color: var(--avm-text);
    font-family: var(--font-body--family);
    font-size: var(--avm-text-size);
    font-weight: 650;
    line-height: 1;
  }
  .avonent-benefit-marquee__icon {
    display: grid;
    width: calc(var(--avm-icon-size) + 10px);
    height: calc(var(--avm-icon-size) + 10px);
    place-items: center;
    flex: 0 0 auto;
    color: var(--avm-icon);
    background: var(--avm-icon-bg);
    border-radius: 999px;
  }
  .avonent-benefit-marquee__icon.is-plain { width: var(--avm-icon-size); height: var(--avm-icon-size); background: transparent; }
  .avonent-benefit-marquee__icon svg { width: var(--avm-icon-size); height: var(--avm-icon-size); display: block; }
  .avonent-benefit-marquee__label { display: inline; }
  .avonent-benefit-marquee__marker {
    display: inline;
    margin-left: .02em;
    color: inherit;
    font-size: .64em;
    font-weight: 800;
    line-height: 0;
    vertical-align: super;
  }
  @keyframes avonentBenefitMarquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media screen and (max-width: 749px) {
    .avonent-benefit-marquee__set { padding-left: 12px; padding-right: 12px; }
    .avonent-benefit-marquee__item { gap: 6px; }
  }
  @media (prefers-reduced-motion: reduce) { .avonent-benefit-marquee__track { animation: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent moving benefits",
  "tag": "section",
  "class": "section-avonent-benefit-marquee",
  "settings": [
    {"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text color","default":"#111111"},
    {"type":"color","id":"icon_color","label":"Icon color","default":"#078AA5"},
    {"type":"color","id":"icon_background","label":"Icon background","default":"#EAF9FC"},
    {"type":"color","id":"border_color","label":"Border color","default":"#D9E9ED"},
    {"type":"checkbox","id":"show_icon_background","label":"Show icon circles","default":true},
    {"type":"checkbox","id":"reverse_direction","label":"Reverse direction","default":false},
    {"type":"range","id":"speed","label":"Scroll speed","min":8,"max":60,"step":1,"unit":"s","default":24},
    {"type":"range","id":"item_gap","label":"Space between benefits","min":12,"max":64,"step":2,"unit":"px","default":28},
    {"type":"range","id":"icon_size","label":"Icon size","min":12,"max":28,"step":1,"unit":"px","default":18},
    {"type":"range","id":"text_size","label":"Text size","min":11,"max":22,"step":1,"unit":"px","default":14},
    {"type":"range","id":"padding_y","label":"Bar height / vertical padding","min":6,"max":24,"step":1,"unit":"px","default":11},
    {"type":"range","id":"spacing_top","label":"Spacing above section","min":0,"max":80,"step":2,"unit":"px","default":0},
    {"type":"range","id":"spacing_bottom","label":"Spacing below section","min":0,"max":80,"step":2,"unit":"px","default":18}
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 12,
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"Daily Vitality"},
        {"type":"select","id":"icon","label":"Icon","default":"bolt","options":[
          {"value":"none","label":"None"},{"value":"bolt","label":"Bolt / energy"},{"value":"sparkle","label":"Sparkle / antioxidant"},{"value":"leaf","label":"Leaf / botanical"},{"value":"heart","label":"Heart"},{"value":"heart_pulse","label":"Heart pulse"},{"value":"shield","label":"Shield"},{"value":"shield_plus","label":"Shield plus / immune"},{"value":"activity","label":"Activity / joints"},{"value":"sun","label":"Sun / vitality"},{"value":"moon","label":"Moon / rest"},{"value":"brain","label":"Brain / clarity"},{"value":"droplet","label":"Droplet"},{"value":"flame","label":"Flame / metabolism"},{"value":"arrows","label":"Circular arrows / metabolism"},{"value":"check","label":"Check"},{"value":"plus","label":"Plus"},{"value":"circle","label":"Circle"}
        ]},
        {"type":"select","id":"marker","label":"Disclaimer marker","default":"†","options":[{"value":"none","label":"None"},{"value":"†","label":"†"},{"value":"*","label":"*"},{"value":"‡","label":"‡"}]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Avonent moving benefits",
      "blocks": [
        {"type":"benefit","settings":{"text":"Daily Vitality","icon":"bolt","marker":"†"}},
        {"type":"benefit","settings":{"text":"Antioxidant Defense","icon":"sparkle","marker":"†"}},
        {"type":"benefit","settings":{"text":"Healthy Aging","icon":"sun","marker":"†"}},
        {"type":"benefit","settings":{"text":"Heart Wellness","icon":"heart_pulse","marker":"‡"}},
        {"type":"benefit","settings":{"text":"Metabolic Support","icon":"arrows","marker":"‡"}},
        {"type":"benefit","settings":{"text":"Joint & Active Support","icon":"activity","marker":"†"}}
      ]
    }
  ]
}
{% endschema %}
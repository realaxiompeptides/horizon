{% if template.suffix == 'moringa' %}
  <section
    class="avonent-moringa-header-benefits"
    aria-label="Pure Moringa wellness benefits"
    style="
      --amhb-bg: {{ section.settings.background_color }};
      --amhb-text: {{ section.settings.text_color }};
      --amhb-border: {{ section.settings.border_color }};
      --amhb-speed: {{ section.settings.speed }}s;
    "
  >
    <div class="avonent-moringa-header-benefits__viewport">
      <div class="avonent-moringa-header-benefits__track">
        {% for copy_index in (1..2) %}
          <div class="avonent-moringa-header-benefits__set"{% if copy_index == 2 %} aria-hidden="true"{% endif %}>
            {% for i in (1..8) %}
              {% liquid
                assign text_key = 'benefit_' | append: i
                assign icon_key = 'icon_' | append: i
                assign benefit_text = section.settings[text_key]
                assign benefit_icon = section.settings[icon_key]
              %}
              {% if benefit_text != blank %}
                <span class="avonent-moringa-header-benefits__item">
                  <span class="avonent-moringa-header-benefits__icon" aria-hidden="true">
                    {% case benefit_icon %}
                      {% when 'energy' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M13.2 2.5 5.8 13h5.6l-.7 8.5 7.5-11h-5.7l.7-8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                      {% when 'joint' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M8.2 4.2c1.8 2.1 2.7 4.2 2.7 6.3M15.8 19.8c-1.8-2.1-2.7-4.2-2.7-6.3M6 9.5c2.5.2 4.4 1.1 5.8 2.7M18 14.5c-2.5-.2-4.4-1.1-5.8-2.7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="12" cy="12" r="2.2" stroke="currentColor" stroke-width="1.8"/></svg>
                      {% when 'glucose' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.2S6.5 9.3 6.5 14a5.5 5.5 0 0 0 11 0C17.5 9.3 12 3.2 12 3.2Z" stroke="currentColor" stroke-width="1.8"/><path d="M9.3 14.2h5.4M12 11.5v5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                      {% when 'heart' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M20.2 5.8c-2-2-5.2-2-7.2 0L12 6.8l-1-1c-2-2-5.2-2-7.2 0s-2 5.2 0 7.2L12 21l8.2-8c2-2 2-5.2 0-7.2Z" stroke="currentColor" stroke-width="1.8"/><path d="M4.4 12h4l1.3-2.7 2.2 5.5 1.5-2.8h6.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'inflammation' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M13.2 2.7c.8 4.3-3.4 5-2.2 8.3.7 1.9 2.6 1.7 3.3.2.9 1 1.7 2.5 1.7 4.3A4.8 4.8 0 0 1 11.2 20C7.8 20 5 17.5 5 14.2c0-4.3 3.5-6.6 8.2-11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {% when 'metabolic' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M7 7h10l-2.5-2.5M17 17H7l2.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 7v4M7 17v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                      {% when 'shield' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 19 5.6v5.2c0 4.5-2.8 8.4-7 10.4-4.2-2-7-5.9-7-10.4V5.6L12 2.8Z" stroke="currentColor" stroke-width="1.8"/><path d="m8.8 12 2.1 2.1 4.5-4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'sparkle' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.7c.8 4.5 3.2 6.9 7.7 7.7-4.5.8-6.9 3.2-7.7 7.7-.8-4.5-3.2-6.9-7.7-7.7 4.5-.8 6.9-3.2 7.7-7.7Z" stroke="currentColor" stroke-width="1.8"/></svg>
                    {% endcase %}
                  </span>
                  <span>{{ benefit_text }}</span>
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .avonent-moringa-header-benefits {
    width: 100%;
    overflow: hidden;
    background: var(--amhb-bg);
    color: var(--amhb-text);
    border-top: 1px solid var(--amhb-border);
    border-bottom: 1px solid var(--amhb-border);
  }

  .avonent-moringa-header-benefits__viewport {
    width: 100%;
    overflow: hidden;
  }

  .avonent-moringa-header-benefits__track {
    display: flex;
    width: max-content;
    min-width: 200%;
    animation: avonentMoringaHeaderBenefits var(--amhb-speed) linear infinite;
    will-change: transform;
  }

  .avonent-moringa-header-benefits__set {
    display: flex;
    align-items: center;
    flex: none;
    gap: 46px;
    padding: 8px 24px;
  }

  .avonent-moringa-header-benefits__item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    color: var(--amhb-text);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
  }

  .avonent-moringa-header-benefits__icon {
    display: inline-grid;
    width: 17px;
    height: 17px;
    place-items: center;
    flex: 0 0 17px;
    color: var(--amhb-text);
  }

  .avonent-moringa-header-benefits__icon svg {
    display: block;
    width: 17px;
    height: 17px;
  }

  @keyframes avonentMoringaHeaderBenefits {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media screen and (max-width: 749px) {
    .avonent-moringa-header-benefits__set {
      gap: 30px;
      padding: 8px 16px;
    }

    .avonent-moringa-header-benefits__item {
      font-size: 12px;
    }

    .avonent-moringa-header-benefits__icon,
    .avonent-moringa-header-benefits__icon svg {
      width: 15px;
      height: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avonent-moringa-header-benefits__track {
      animation: none;
    }
  }
{% endstylesheet %}


<section
  class="avonent-footer"
  style="
    --av-footer-bg: {{ section.settings.background_color }};
    --av-footer-text: {{ section.settings.text_color }};
    --av-footer-muted: {{ section.settings.muted_text_color }};
    --av-footer-accent: {{ section.settings.accent_color }};
    --av-footer-border: {{ section.settings.border_color }};
    --av-footer-input-bg: {{ section.settings.input_background }};
    --av-footer-input-text: {{ section.settings.input_text_color }};
    --av-footer-button-bg: {{ section.settings.button_background }};
    --av-footer-button-text: {{ section.settings.button_text_color }};
    --av-footer-radius: {{ section.settings.corner_radius }}px;
    --av-footer-padding-top: {{ section.settings.padding_top }}px;
    --av-footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="avonent-footer__container">

    <div class="avonent-footer__top">
      <div class="avonent-footer__brand">

        {% if section.settings.brand_name != blank %}
          <h2 class="avonent-footer__brand-name">
            {{ section.settings.brand_name }}
          </h2>
        {% endif %}

        {% if section.settings.brand_tagline != blank %}
          <div class="avonent-footer__tagline">
            {{ section.settings.brand_tagline }}
          </div>
        {% endif %}

        {% if section.settings.brand_description != blank %}
          <div class="avonent-footer__description">
            {{ section.settings.brand_description }}
          </div>
        {% endif %}

        {% if section.settings.show_social_icons %}
          <div class="avonent-footer__socials">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="avonent-footer__social-link" aria-label="Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
                  <circle cx="12" cy="12" r="4.2"></circle>
                  <circle cx="17.2" cy="6.8" r="1"></circle>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" class="avonent-footer__social-link" aria-label="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M13.2 20V12.7h2.5l.4-2.8h-2.9V8.1c0-.9.3-1.5 1.5-1.5H16V4.1c-.2 0-.9-.1-1.8-.1-2.4 0-4 1.4-4 4.1V10H7.9v2.8h2.3V20z"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
              <a href="{{ section.settings.tiktok_url }}" class="avonent-footer__social-link" aria-label="TikTok">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14.7 4c.4 1.3 1.2 2.3 2.4 3 .8.5 1.7.7 2.6.8v2.8c-1.4-.1-2.7-.5-3.9-1.2v5.2c0 3.1-2.4 5.2-5.3 5.2-3.1 0-5.5-2.4-5.2-5.7.2-2.4 2.2-4.4 4.6-4.6.5 0 1 0 1.4.1v2.9c-.4-.1-.8-.2-1.2-.1-1.2.1-2.2 1.1-2.3 2.4-.1 1.5 1 2.7 2.4 2.7 1.3 0 2.3-1 2.3-2.3z"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.youtube_url != blank %}
              <a href="{{ section.settings.youtube_url }}" class="avonent-footer__social-link" aria-label="YouTube">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 8.6a2.8 2.8 0 0 0-2-2c-1.8-.5-7-.5-7-.5s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29.8 29.8 0 0 0 2.5 12 29.8 29.8 0 0 0 3 15.4a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29.8 29.8 0 0 0 .5-3.4 29.8 29.8 0 0 0-.5-3.4z"></path>
                  <path d="m10 15.2 5.2-3.2L10 8.8z"></path>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_newsletter %}
        <div class="avonent-footer__newsletter">
          {% if section.settings.newsletter_heading != blank %}
            <h3 class="avonent-footer__newsletter-heading">
              {{ section.settings.newsletter_heading }}
            </h3>
          {% endif %}

          {% if section.settings.newsletter_text != blank %}
            <div class="avonent-footer__newsletter-text">
              {{ section.settings.newsletter_text }}
            </div>
          {% endif %}

          {% form 'customer', class: 'avonent-footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="avonent-footer__newsletter-fields">
              <input
                type="email"
                name="contact[email]"
                class="avonent-footer__newsletter-input"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ section.settings.email_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}aria-invalid="true"{% endif %}
                required
              >

              <button
                type="submit"
                class="avonent-footer__newsletter-button"
                name="commit"
              >
                {{ section.settings.button_label }}
              </button>
            </div>

            {% if form.posted_successfully? %}
              <div class="avonent-footer__form-message is-success">
                {{ section.settings.success_text }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="avonent-footer__form-message is-error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    <div class="avonent-footer__nav">

      {% assign shop_menu = section.settings.shop_menu %}
      {% assign help_menu = section.settings.help_menu %}
      {% assign legal_menu = section.settings.legal_menu %}
      {% assign account_menu = section.settings.account_menu %}

      {% if shop_menu != blank %}
        <details class="avonent-footer__menu-group" open>
          <summary class="avonent-footer__menu-title">
            {{ shop_menu.title }}
          </summary>
          <ul class="avonent-footer__menu-list">
            {% for link in shop_menu.links %}
              <li>
                <a href="{{ link.url }}" class="avonent-footer__menu-link">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

      {% if help_menu != blank %}
        <details class="avonent-footer__menu-group" open>
          <summary class="avonent-footer__menu-title">
            {{ help_menu.title }}
          </summary>
          <ul class="avonent-footer__menu-list">
            {% for link in help_menu.links %}
              <li>
                <a href="{{ link.url }}" class="avonent-footer__menu-link">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

      {% if legal_menu != blank %}
        <details class="avonent-footer__menu-group" open>
          <summary class="avonent-footer__menu-title">
            {{ legal_menu.title }}
          </summary>
          <ul class="avonent-footer__menu-list">
            {% for link in legal_menu.links %}
              <li>
                <a href="{{ link.url }}" class="avonent-footer__menu-link">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

      {% if account_menu != blank %}
        <details class="avonent-footer__menu-group" open>
          <summary class="avonent-footer__menu-title">
            {{ account_menu.title }}
          </summary>
          <ul class="avonent-footer__menu-list">
            {% for link in account_menu.links %}
              <li>
                <a href="{{ link.url }}" class="avonent-footer__menu-link">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

    </div>

    <div class="avonent-footer__bottom">

      <div class="avonent-footer__bottom-left">
        {% if section.settings.bottom_text != blank %}
          <div class="avonent-footer__bottom-text">
            {{ section.settings.bottom_text }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_payment_icons %}
        <div class="avonent-footer__payments">
          {% for type in shop.enabled_payment_types %}
            <span class="avonent-footer__payment-icon">
              {{ type | payment_type_svg_tag }}
            </span>
          {% endfor %}
        </div>
      {% endif %}

    </div>

  </div>
</section>

{% stylesheet %}
  .avonent-footer {
    width: 100%;
    background: var(--av-footer-bg);
    color: var(--av-footer-text);
    padding-top: var(--av-footer-padding-top);
    padding-bottom: var(--av-footer-padding-bottom);
    border-top: 1px solid var(--av-footer-border);
  }

  .avonent-footer__container {
    width: min(calc(100% - 48px), 1360px);
    margin: 0 auto;
  }

  .avonent-footer__top {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: start;
    padding-bottom: 38px;
    border-bottom: 1px solid var(--av-footer-border);
  }

  .avonent-footer__brand-name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--av-footer-text);
  }

  .avonent-footer__tagline {
    margin-top: 14px;
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--av-footer-text);
  }

  .avonent-footer__description {
    max-width: 560px;
    margin-top: 14px;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.6;
    color: var(--av-footer-muted);
  }

  .avonent-footer__description p {
    margin: 0;
  }

  .avonent-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .avonent-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--av-footer-border);
    border-radius: 999px;
    color: var(--av-footer-text);
    text-decoration: none;
    transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }

  .avonent-footer__social-link svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avonent-footer__social-link:hover {
    background: rgba(2, 198, 234, 0.12);
    border-color: var(--av-footer-accent);
    color: var(--av-footer-accent);
    transform: translateY(-1px);
  }

  .avonent-footer__newsletter-heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--av-footer-text);
  }

  .avonent-footer__newsletter-text {
    margin-top: 12px;
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.55;
    color: var(--av-footer-muted);
  }

  .avonent-footer__newsletter-text p {
    margin: 0;
  }

  .avonent-footer__newsletter-form {
    margin-top: 22px;
  }

  .avonent-footer__newsletter-fields {
    display: flex;
    gap: 12px;
  }

  .avonent-footer__newsletter-input {
    flex: 1 1 auto;
    min-height: 56px;
    padding: 0 18px;
    border: 1px solid var(--av-footer-border);
    border-radius: var(--av-footer-radius);
    background: var(--av-footer-input-bg);
    color: var(--av-footer-input-text);
    font-family: var(--font-body--family);
    font-size: 15px;
    outline: none;
  }

  .avonent-footer__newsletter-input::placeholder {
    color: var(--av-footer-muted);
  }

  .avonent-footer__newsletter-button {
    flex: 0 0 auto;
    min-width: 150px;
    min-height: 56px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--av-footer-radius);
    background: var(--av-footer-button-bg);
    color: var(--av-footer-button-text);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.18s ease, opacity 0.18s ease, background 0.18s ease;
  }

  .avonent-footer__newsletter-button:hover {
    transform: translateY(-1px);
    background: var(--av-footer-accent);
    color: #111111;
  }

  .avonent-footer__form-message {
    margin-top: 12px;
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
  }

  .avonent-footer__form-message.is-success {
    color: #9be8b1;
  }

  .avonent-footer__form-message.is-error {
    color: #ffb0b0;
  }

  .avonent-footer__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    padding: 34px 0;
    border-bottom: 1px solid var(--av-footer-border);
  }

  .avonent-footer__menu-group {
    margin: 0;
  }

  .avonent-footer__menu-group summary {
    list-style: none;
  }

  .avonent-footer__menu-group summary::-webkit-details-marker {
    display: none;
  }

  .avonent-footer__menu-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--av-footer-text);
    cursor: default;
  }

  .avonent-footer__menu-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .avonent-footer__menu-list li + li {
    margin-top: 12px;
  }

  .avonent-footer__menu-link {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.45;
    color: var(--av-footer-muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .avonent-footer__menu-link:hover {
    color: var(--av-footer-text);
  }

  .avonent-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
  }

  .avonent-footer__bottom-text {
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    color: var(--av-footer-muted);
  }

  .avonent-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .avonent-footer__payment-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    color: var(--av-footer-text);
    opacity: 0.88;
  }

  .avonent-footer__payment-icon svg {
    height: 100%;
    width: auto;
  }

  @media screen and (max-width: 989px) {
    .avonent-footer__top {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .avonent-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .avonent-footer__container {
      width: calc(100% - 24px);
    }

    .avonent-footer__top {
      gap: 26px;
      padding-bottom: 28px;
    }

    .avonent-footer__brand-name {
      font-size: 38px;
    }

    .avonent-footer__tagline {
      font-size: 22px;
    }

    .avonent-footer__description {
      font-size: 14px;
      line-height: 1.55;
    }

    .avonent-footer__newsletter-heading {
      font-size: 24px;
    }

    .avonent-footer__newsletter-fields {
      flex-direction: column;
      gap: 10px;
    }

    .avonent-footer__newsletter-button,
    .avonent-footer__newsletter-input {
      width: 100%;
      min-width: 100%;
    }

    .avonent-footer__nav {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 22px 0;
    }

    .avonent-footer__menu-group {
      border-bottom: 1px solid var(--av-footer-border);
      padding: 14px 0;
    }

    .avonent-footer__menu-group:last-child {
      border-bottom: 0;
    }

    .avonent-footer__menu-group[open] .avonent-footer__menu-title::after {
      transform: rotate(180deg);
    }

    .avonent-footer__menu-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .avonent-footer__menu-title::after {
      content: '+';
      font-size: 18px;
      font-weight: 400;
      line-height: 1;
      color: var(--av-footer-muted);
      transition: transform 0.18s ease;
    }

    .avonent-footer__menu-group[open] .avonent-footer__menu-title::after {
      content: '–';
    }

    .avonent-footer__menu-list {
      margin-top: 14px;
      padding-bottom: 2px;
    }

    .avonent-footer__menu-link {
      font-size: 14px;
    }

    .avonent-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding-top: 20px;
    }

    .avonent-footer__payments {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "00 Avonent Footer",
  "tag": "section",
  "class": "avonent-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Avonent"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Tagline",
      "default": "Premium daily wellness, made simple."
    },
    {
      "type": "richtext",
      "id": "brand_description",
      "label": "Description",
      "default": "<p>Premium formulas built for the routines that matter. Clean presentation, modern design, and a better shopping experience from start to finish.</p>"
    },

    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our email list"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "<p>Get exclusive deals and early access to new products.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Thanks for signing up."
    },

    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Help menu"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "link_list",
      "id": "account_menu",
      "label": "Account menu"
    },

    {
      "type": "header",
      "content": "Social icons"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },

    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "© 2026 Avonent. All rights reserved."
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111315"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#AEB5B8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / divider",
      "default": "rgba(255,255,255,0.12)"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#181B1E"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "Spacing & shape"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Input/button roundness",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,

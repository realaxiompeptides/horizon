{% liquid
  assign footer_id = 'avonent-footer-' | append: section.id
%}

<section
  id="{{ footer_id }}"
  class="avonent-footer"
  style="
    --av-footer-bg: {{ section.settings.background_color }};
    --av-footer-text: {{ section.settings.text_color }};
    --av-footer-muted: {{ section.settings.muted_text_color }};
    --av-footer-accent: {{ section.settings.accent_color }};
    --av-footer-border: {{ section.settings.border_color }};
    --av-footer-input-bg: {{ section.settings.input_background }};
    --av-footer-input-text: {{ section.settings.input_text_color }};
    --av-footer-button-bg: {{ section.settings.button_background }};
    --av-footer-button-text: {{ section.settings.button_text_color }};
    --av-footer-radius: {{ section.settings.corner_radius }}px;
    --av-footer-padding-top: {{ section.settings.padding_top }}px;
    --av-footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  <div class="avonent-footer__container">

    {%- comment -%}
      BRAND + NEWSLETTER
    {%- endcomment -%}

    <div class="avonent-footer__top">

      <div class="avonent-footer__brand">

        <a
          href="{{ routes.root_url }}"
          class="avonent-footer__logo-link"
          aria-label="{{ shop.name | escape }}"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'avonent-footer__logo',
                loading: 'lazy',
                widths: '160, 240, 320, 480, 600',
                sizes: '240px'
            }}
          {% else %}
            <span class="avonent-footer__logo-text">
              {{ section.settings.brand_name }}
            </span>
          {% endif %}
        </a>

        {% if section.settings.tagline != blank %}
          <div class="avonent-footer__tagline">
            {{ section.settings.tagline }}
          </div>
        {% endif %}

        {% if section.settings.brand_description != blank %}
          <div class="avonent-footer__description">
            {{ section.settings.brand_description }}
          </div>
        {% endif %}

        {% if section.settings.show_social_icons %}
          <div class="avonent-footer__socials">

            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.3" cy="6.7" r="1"></circle>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
              <a
                href="{{ section.settings.tiktok_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="TikTok"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14.5 4v10.3a4.8 4.8 0 1 1-4-4.7"></path>
                  <path d="M14.5 4c.6 2.4 2.3 3.9 4.5 4.2"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1z"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.youtube_url != blank %}
              <a
                href="{{ section.settings.youtube_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="YouTube"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 7.2c-.2-.8-.8-1.4-1.6-1.6C17 5.2 12 5.2 12 5.2s-5 0-6.4.4C4.8 5.8 4.2 6.4 4 7.2A21 21 0 0 0 3.6 12 21 21 0 0 0 4 16.8c.2.8.8 1.4 1.6 1.6 1.4.4 6.4.4 6.4.4s5 0 6.4-.4c.8-.2 1.4-.8 1.6-1.6.4-1.5.4-4.8.4-4.8s0-3.3-.4-4.8z"></path>
                  <path d="m10 15 5-3-5-3z"></path>
                </svg>
              </a>
            {% endif %}

          </div>
        {% endif %}

      </div>


      {% if section.settings.show_newsletter %}
        <div class="avonent-footer__newsletter">

          {% if section.settings.newsletter_eyebrow != blank %}
            <div class="avonent-footer__newsletter-eyebrow">
              {{ section.settings.newsletter_eyebrow }}
            </div>
          {% endif %}

          {% if section.settings.newsletter_heading != blank %}
            <h3 class="avonent-footer__newsletter-heading">
              {{ section.settings.newsletter_heading }}
            </h3>
          {% endif %}

          {% if section.settings.newsletter_text != blank %}
            <div class="avonent-footer__newsletter-text">
              {{ section.settings.newsletter_text }}
            </div>
          {% endif %}

          {% form 'customer', class: 'avonent-footer__form' %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <div class="avonent-footer__form-row">

              <label
                class="visually-hidden"
                for="AvonentFooterEmail-{{ section.id }}"
              >
                Email address
              </label>

              <input
                id="AvonentFooterEmail-{{ section.id }}"
                class="avonent-footer__input"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >

              <button
                type="submit"
                class="avonent-footer__submit"
              >
                {{ section.settings.button_label }}

                <span aria-hidden="true">→</span>
              </button>

            </div>

            {% if form.posted_successfully? %}
              <div class="avonent-footer__form-message">
                {{ section.settings.success_text }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="avonent-footer__form-message avonent-footer__form-message--error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

          {% endform %}

        </div>
      {% endif %}

    </div>


    {%- comment -%}
      NAVIGATION
    {%- endcomment -%}

    <div class="avonent-footer__navigation">

      {% if section.settings.main_menu != blank %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.main_menu_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">
            {% for link in section.settings.main_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>

        </details>
      {% endif %}


      {% if section.settings.support_menu != blank %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.support_menu_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">
            {% for link in section.settings.support_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>

        </details>
      {% endif %}


      {% if section.settings.show_policy_links %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.policy_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">

            {% for policy in shop.policies %}
              {% if policy != blank %}
                <li>
                  <a href="{{ policy.url }}">
                    {{ policy.title }}
                  </a>
                </li>
              {% endif %}
            {% endfor %}

          </ul>

        </details>
      {% endif %}


      {% if section.settings.extra_menu != blank %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.extra_menu_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">
            {% for link in section.settings.extra_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>

        </details>
      {% endif %}

    </div>


    {%- comment -%}
      DISCLAIMER
    {%- endcomment -%}

    {% if section.settings.show_disclaimer %}
      <div class="avonent-footer__disclaimer">

        {% if section.settings.disclaimer_heading != blank %}
          <div class="avonent-footer__disclaimer-heading">
            {{ section.settings.disclaimer_heading }}
          </div>
        {% endif %}

        {% if section.settings.fda_disclaimer != blank %}
          <div class="avonent-footer__disclaimer-text">
            {{ section.settings.fda_disclaimer }}
          </div>
        {% endif %}

        {% if section.settings.additional_disclaimer != blank %}
          <div class="avonent-footer__disclaimer-extra">
            {{ section.settings.additional_disclaimer }}
          </div>
        {% endif %}

      </div>
    {% endif %}


    {%- comment -%}
      PAYMENT ICONS
    {%- endcomment -%}

    {% if section.settings.show_payment_icons %}
      <div class="avonent-footer__payment-area">

        {% if section.settings.payment_heading != blank %}
          <div class="avonent-footer__payment-heading">
            {{ section.settings.payment_heading }}
          </div>
        {% endif %}

        <div
          class="avonent-footer__payments"
          aria-label="Accepted payment methods"
        >
          {% for type in shop.enabled_payment_types %}
            <span class="avonent-footer__payment">
              {{ type | payment_type_svg_tag }}
            </span>
          {% endfor %}
        </div>

      </div>
    {% endif %}


    {%- comment -%}
      BOTTOM
    {%- endcomment -%}

    <div class="avonent-footer__bottom">

      <div class="avonent-footer__copyright">
        © {{ 'now' | date: '%Y' }}
        {{ section.settings.brand_name }}.
        {{ section.settings.copyright_text }}
      </div>

      {% if section.settings.bottom_policy_links %}
        <div class="avonent-footer__bottom-links">

          {% if shop.privacy_policy != blank %}
            <a href="{{ shop.privacy_policy.url }}">
              Privacy
            </a>
          {% endif %}

          {% if shop.terms_of_service != blank %}
            <a href="{{ shop.terms_of_service.url }}">
              Terms
            </a>
          {% endif %}

          {% if shop.refund_policy != blank %}
            <a href="{{ shop.refund_policy.url }}">
              Refunds
            </a>
          {% endif %}

        </div>
      {% endif %}

    </div>

  </div>

</section>


{% stylesheet %}

  /*
   * AVONENT FOOTER
   */

  .avonent-footer {
    width: 100%;

    padding-top:
      var(--av-footer-padding-top);

    padding-bottom:
      var(--av-footer-padding-bottom);

    background:
      var(--av-footer-bg);

    color:
      var(--av-footer-text);
  }


  .avonent-footer__container {
    width:
      min(
        calc(100% - 48px),
        1360px
      );

    margin:
      0 auto;
  }


  /*
   * BRAND / NEWSLETTER
   */

  .avonent-footer__top {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap:
      clamp(50px, 8vw, 120px);

    padding-bottom: 46px;

    border-bottom:
      1px solid
      var(--av-footer-border);
  }


  .avonent-footer__logo-link {
    display: inline-block;

    color:
      var(--av-footer-text);

    text-decoration: none;
  }


  .avonent-footer__logo {
    display: block;

    width: auto;
    max-width: 220px;
    max-height: 70px;

    object-fit: contain;
  }


  .avonent-footer__logo-text {
    font-family:
      var(--font-heading--family);

    font-size:
      clamp(
        34px,
        4vw,
        52px
      );

    font-weight: 650;

    line-height: 1;

    letter-spacing: -0.035em;
  }


  .avonent-footer__tagline {
    max-width: 520px;

    margin-top: 18px;

    font-family:
      var(--font-heading--family);

    font-size: 22px;
    font-weight: 500;

    line-height: 1.25;
  }


  .avonent-footer__description {
    max-width: 520px;

    margin-top: 13px;

    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 15px;

    line-height: 1.6;
  }


  .avonent-footer__description p {
    margin: 0;
  }


  /*
   * SOCIALS
   */

  .avonent-footer__socials {
    display: flex;

    gap: 9px;

    margin-top: 23px;
  }


  .avonent-footer__social {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    border:
      1px solid
      var(--av-footer-border);

    border-radius: 50%;

    color:
      var(--av-footer-text);

    text-decoration: none;

    transition:
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }


  .avonent-footer__social svg {
    width: 17px;
    height: 17px;

    fill: none;

    stroke:
      currentColor;

    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .avonent-footer__social:hover {
    border-color:
      var(--av-footer-accent);

    background:
      var(--av-footer-accent);

    color: #071216;

    transform:
      translateY(-1px);
  }


  /*
   * NEWSLETTER
   */

  .avonent-footer__newsletter {
    max-width: 650px;

    margin-left: auto;
  }


  .avonent-footer__newsletter-eyebrow {
    margin-bottom: 10px;

    color:
      var(--av-footer-accent);

    font-family:
      var(--font-body--family);

    font-size: 11px;
    font-weight: 700;

    line-height: 1;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }


  .avonent-footer__newsletter-heading {
    margin: 0;

    color:
      var(--av-footer-text);

    font-family:
      var(--font-heading--family);

    font-size:
      clamp(
        28px,
        3vw,
        38px
      );

    font-weight: 600;

    line-height: 1.08;

    letter-spacing:
      -0.025em;
  }


  .avonent-footer__newsletter-text {
    margin-top: 12px;

    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 15px;

    line-height: 1.5;
  }


  .avonent-footer__newsletter-text p {
    margin: 0;
  }


  .avonent-footer__form {
    margin-top: 22px;
  }


  .avonent-footer__form-row {
    display: flex;

    gap: 9px;

    padding: 6px;

    border:
      1px solid
      var(--av-footer-border);

    border-radius:
      var(--av-footer-radius);

    background:
      var(--av-footer-input-bg);
  }


  .avonent-footer__input {
    flex: 1 1 auto;

    min-width: 0;
    min-height: 50px;

    padding:
      0
      15px;

    border: 0;

    background:
      transparent;

    color:
      var(--av-footer-input-text);

    outline: none;

    font-family:
      var(--font-body--family);

    font-size: 15px;
  }


  .avonent-footer__input::placeholder {
    color:
      var(--av-footer-muted);

    opacity: 0.72;
  }


  .avonent-footer__submit {
    flex: 0 0 auto;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    min-width: 142px;
    min-height: 50px;

    padding:
      0
      22px;

    border: 0;

    border-radius:
      calc(
        var(--av-footer-radius)
        - 5px
      );

    background:
      var(--av-footer-button-bg);

    color:
      var(--av-footer-button-text);

    cursor: pointer;

    font-family:
      var(--font-body--family);

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.04em;
  }


  .avonent-footer__submit:hover {
    background:
      var(--av-footer-accent);

    color:
      #071216;
  }


  .avonent-footer__form-message {
    margin-top: 11px;

    color:
      var(--av-footer-text);

    font-family:
      var(--font-body--family);

    font-size: 13px;
  }


  .avonent-footer__form-message--error {
    color: #ffb7b7;
  }


  /*
   * NAVIGATION
   */

  .avonent-footer__navigation {
    display: grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap: 32px;

    padding:
      40px
      0;

    border-bottom:
      1px solid
      var(--av-footer-border);
  }


  .avonent-footer__menu {
    margin: 0;
  }


  .avonent-footer__menu-heading {
    display: block;

    list-style: none;

    color:
      var(--av-footer-text);

    cursor: default;

    font-family:
      var(--font-body--family);

    font-size: 12px;
    font-weight: 700;

    line-height: 1.2;

    letter-spacing: 0.075em;

    text-transform: uppercase;
  }


  .avonent-footer__menu-heading::-webkit-details-marker {
    display: none;
  }


  .avonent-footer__menu-toggle {
    display: none;
  }


  .avonent-footer__links {
    display: flex;

    flex-direction: column;

    gap: 11px;

    margin:
      18px
      0
      0;

    padding: 0;

    list-style: none;
  }


  .avonent-footer__links a {
    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 14px;
    font-weight: 400;

    line-height: 1.35;

    text-decoration: none;

    transition:
      color 160ms ease;
  }


  .avonent-footer__links a:hover {
    color:
      var(--av-footer-accent);
  }


  /*
   * DISCLAIMER
   */

  .avonent-footer__disclaimer {
    max-width: 900px;

    margin:
      0
      auto;

    padding:
      34px
      0;

    text-align: center;

    border-bottom:
      1px solid
      var(--av-footer-border);
  }


  .avonent-footer__disclaimer-heading {
    margin-bottom: 10px;

    color:
      var(--av-footer-text);

    font-family:
      var(--font-body--family);

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .avonent-footer__disclaimer-text,
  .avonent-footer__disclaimer-extra {
    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 12px;

    line-height: 1.6;
  }


  .avonent-footer__disclaimer-text p,
  .avonent-footer__disclaimer-extra p {
    margin: 0;
  }


  .avonent-footer__disclaimer-extra {
    margin-top: 8px;
  }


  /*
   * PAYMENT METHODS
   */

  .avonent-footer__payment-area {
    padding:
      28px
      0;

    text-align: center;

    border-bottom:
      1px solid
      var(--av-footer-border);
  }


  .avonent-footer__payment-heading {
    margin-bottom: 14px;

    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 11px;
    font-weight: 600;

    line-height: 1;

    letter-spacing: 0.065em;

    text-transform: uppercase;
  }


  .avonent-footer__payments {
    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 8px;

    width: 100%;
  }


  .avonent-footer__payment {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    height: 28px;
  }


  .avonent-footer__payment svg {
    display: block;

    width: auto;
    height: 28px;
  }


  /*
   * BOTTOM
   */

  .avonent-footer__bottom {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding-top: 25px;
  }


  .avonent-footer__copyright {
    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 12px;

    line-height: 1.4;
  }


  .avonent-footer__bottom-links {
    display: flex;

    align-items: center;

    gap: 18px;
  }


  .avonent-footer__bottom-links a {
    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 12px;

    text-decoration: none;
  }


  .avonent-footer__bottom-links a:hover {
    color:
      var(--av-footer-text);
  }


  /*
   * TABLET
   */

  @media screen and (max-width: 989px) {

    .avonent-footer__top {
      grid-template-columns: 1fr;

      gap: 36px;
    }


    .avonent-footer__newsletter {
      max-width: none;

      margin: 0;
    }


    .avonent-footer__navigation {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    .avonent-footer__container {
      width:
        calc(100% - 32px);
    }


    .avonent-footer__top {
      gap: 34px;

      padding-bottom: 34px;
    }


    .avonent-footer__logo {
      max-width: 180px;
      max-height: 58px;
    }


    .avonent-footer__logo-text {
      font-size: 40px;
    }


    .avonent-footer__tagline {
      margin-top: 15px;

      font-size: 20px;
    }


    .avonent-footer__description {
      margin-top: 11px;

      font-size: 14px;
    }


    .avonent-footer__newsletter-heading {
      font-size: 29px;
    }


    .avonent-footer__newsletter-text {
      font-size: 14px;
    }


    .avonent-footer__form-row {
      padding: 5px;
    }


    .avonent-footer__input {
      min-height: 48px;

      padding-inline: 12px;

      font-size: 14px;
    }


    .avonent-footer__submit {
      min-width: 110px;
      min-height: 48px;

      padding-inline: 14px;

      font-size: 11px;
    }


    /*
     * Accordion navigation
     */

    .avonent-footer__navigation {
      display: block;

      padding:
        18px
        0;
    }


    .avonent-footer__menu {
      padding:
        16px
        0;

      border-bottom:
        1px solid
        var(--av-footer-border);
    }


    .avonent-footer__menu:last-child {
      border-bottom: 0;
    }


    .avonent-footer__menu-heading {
      display: flex;

      align-items: center;
      justify-content: space-between;

      cursor: pointer;

      font-size: 13px;
    }


    .avonent-footer__menu-toggle {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      color:
        var(--av-footer-muted);

      font-size: 20px;

      font-weight: 300;
    }


    .avonent-footer__menu[open]
      .avonent-footer__menu-toggle {
      transform:
        rotate(45deg);
    }


    .avonent-footer__links {
      gap: 10px;

      margin-top: 14px;
    }


    .avonent-footer__links a {
      font-size: 14px;
    }


    .avonent-footer__disclaimer {
      padding:
        28px
        0;
    }


    .avonent-footer__disclaimer-text,
    .avonent-footer__disclaimer-extra {
      font-size: 11px;

      line-height: 1.55;
    }


    .avonent-footer__payment-area {
      padding:
        24px
        0;
    }


    .avonent-footer__payment svg {
      height: 25px;
    }


    .avonent-footer__bottom {
      flex-direction: column;

      justify-content: center;

      gap: 13px;

      text-align: center;
    }


    .avonent-footer__bottom-links {
      justify-content: center;

      flex-wrap: wrap;

      gap: 12px;
    }

  }

{% endstylesheet %}



{% liquid
  assign footer_id = 'avonent-footer-' | append: section.id
  assign avonent_cinnamon_footer = false
  if template.name == 'product' and product.template_suffix == 'cinnamon-berberine'
    assign avonent_cinnamon_footer = true
  endif

  assign avonent_footer_logo = section.settings.logo
  if avonent_cinnamon_footer and section.settings.cinnamon_logo != blank
    assign avonent_footer_logo = section.settings.cinnamon_logo
  endif
%}

<section
  id="{{ footer_id }}"
  class="avonent-footer{% if avonent_cinnamon_footer %} avonent-footer--cinnamon{% endif %}"
  style="
    --av-footer-bg: {% if avonent_cinnamon_footer %}#2B180F{% else %}{{ section.settings.background_color }}{% endif %};
    --av-footer-text: {% if avonent_cinnamon_footer %}#FFF8F2{% else %}{{ section.settings.text_color }}{% endif %};
    --av-footer-muted: {% if avonent_cinnamon_footer %}#D8C7BA{% else %}{{ section.settings.muted_text_color }}{% endif %};
    --av-footer-accent: {% if avonent_cinnamon_footer %}#C86F3A{% else %}{{ section.settings.accent_color }}{% endif %};
    --av-footer-border: {% if avonent_cinnamon_footer %}#5B3828{% else %}{{ section.settings.border_color }}{% endif %};
    --av-footer-input-bg: {% if avonent_cinnamon_footer %}#FFFDFC{% else %}{{ section.settings.input_background }}{% endif %};
    --av-footer-input-text: {% if avonent_cinnamon_footer %}#2B180F{% else %}{{ section.settings.input_text_color }}{% endif %};
    --av-footer-button-bg: {% if avonent_cinnamon_footer %}#C86F3A{% else %}{{ section.settings.button_background }}{% endif %};
    --av-footer-button-text: {% if avonent_cinnamon_footer %}#FFFFFF{% else %}{{ section.settings.button_text_color }}{% endif %};
    --av-footer-radius: {{ section.settings.corner_radius }}px;
    --av-footer-padding-top: {{ section.settings.padding_top }}px;
    --av-footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

  <div class="avonent-footer__container">

    {% if avonent_cinnamon_footer %}
      <div class="avonent-footer__cinnamon-grid">
        <div class="avonent-footer__cinnamon-brand">
          <a href="{{ routes.root_url }}" class="avonent-footer__cinnamon-logo-link" aria-label="{{ shop.name | escape }}">
            {% if avonent_footer_logo != blank %}
              {{
                avonent_footer_logo
                | image_url: width: 720
                | image_tag:
                  class: 'avonent-footer__cinnamon-logo',
                  loading: 'lazy',
                  widths: '180, 280, 420, 560, 720',
                  sizes: '(max-width: 749px) 210px, 250px'
              }}
            {% else %}
              <span class="avonent-footer__cinnamon-logo-text">{{ section.settings.brand_name }}</span>
            {% endif %}
          </a>

          <div class="avonent-footer__cinnamon-tagline">{{ section.settings.cinnamon_tagline }}</div>
          <div class="avonent-footer__cinnamon-description">{{ section.settings.cinnamon_description }}</div>

          <div class="avonent-footer__support-list">
            <a class="avonent-footer__support-row" href="{% if pages['contact'] != blank %}{{ pages['contact'].url }}{% else %}/pages/contact{% endif %}">
              <span class="avonent-footer__support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="6.5" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m5 8 7 5 7-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span>{{ section.settings.cinnamon_contact_label }}</span>
            </a>
            <div class="avonent-footer__support-row">
              <span class="avonent-footer__support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span>{{ section.settings.cinnamon_support_text }}</span>
            </div>
          </div>
        </div>

        <nav class="avonent-footer__cinnamon-column" aria-label="Quick links">
          <h3>QUICK LINKS</h3>
          <ul>
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><a href="{% if pages['contact'] != blank %}{{ pages['contact'].url }}{% else %}/pages/contact{% endif %}">Contact</a></li>
            <li><a href="{% if pages['track-your-order'] != blank %}{{ pages['track-your-order'].url }}{% else %}/pages/track-your-order{% endif %}">Track My Order</a></li>
            <li><a href="{{ product.url }}#av-cb-faq">FAQ</a></li>
          </ul>
        </nav>

        <nav class="avonent-footer__cinnamon-column" aria-label="Policies">
          <h3>POLICIES</h3>
          <ul>
            {% if shop.privacy_policy != blank %}<li><a href="{{ shop.privacy_policy.url }}">Privacy Policy</a></li>{% endif %}
            {% if shop.terms_of_service != blank %}<li><a href="{{ shop.terms_of_service.url }}">Terms of Service</a></li>{% endif %}
            {% if shop.refund_policy != blank %}<li><a href="{{ shop.refund_policy.url }}">Refund Policy</a></li>{% endif %}
            {% if shop.shipping_policy != blank %}<li><a href="{{ shop.shipping_policy.url }}">Shipping Policy</a></li>{% endif %}
          </ul>
        </nav>

        {% if section.settings.show_newsletter %}
          <div class="avonent-footer__cinnamon-newsletter">
            <div class="avonent-footer__cinnamon-eyebrow">{{ section.settings.newsletter_eyebrow }}</div>
            <h3>{{ section.settings.newsletter_heading }}</h3>
            <div class="avonent-footer__cinnamon-newsletter-copy">{{ section.settings.newsletter_text }}</div>

            {% form 'customer', class: 'avonent-footer__cinnamon-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="AvonentCinnamonFooterEmail-{{ section.id }}">Email address</label>
              <div class="avonent-footer__cinnamon-form-row">
                <input id="AvonentCinnamonFooterEmail-{{ section.id }}" class="avonent-footer__cinnamon-input" type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder }}" autocomplete="email" required>
                <button class="avonent-footer__cinnamon-submit" type="submit">{{ section.settings.button_label }} <span aria-hidden="true">→</span></button>
              </div>
              {% if form.posted_successfully? %}<div class="avonent-footer__form-message">{{ section.settings.success_text }}</div>{% endif %}
              {% if form.errors %}<div class="avonent-footer__form-message avonent-footer__form-message--error">{{ form.errors | default_errors }}</div>{% endif %}
            {% endform %}
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_disclaimer %}
        <div class="avonent-footer__cinnamon-disclaimer">
          {% if section.settings.disclaimer_heading != blank %}<strong>{{ section.settings.disclaimer_heading }}</strong>{% endif %}
          <div>{{ section.settings.fda_disclaimer }}</div>
          <div>{{ section.settings.additional_disclaimer }}</div>
        </div>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <div class="avonent-footer__cinnamon-payment">
          <span>{{ section.settings.payment_heading }}</span>
          <div class="avonent-footer__cinnamon-payment-icons" aria-label="Accepted payment methods">
            {% for type in shop.enabled_payment_types %}<span>{{ type | payment_type_svg_tag }}</span>{% endfor %}
          </div>
        </div>
      {% endif %}

      <div class="avonent-footer__cinnamon-bottom">
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. {{ section.settings.copyright_text }}</span>
      </div>
    {% else %}

    {%- comment -%}
      BRAND + NEWSLETTER
    {%- endcomment -%}

    <div class="avonent-footer__top">

      <div class="avonent-footer__brand">

        <a
          href="{{ routes.root_url }}"
          class="avonent-footer__logo-link"
          aria-label="{{ shop.name | escape }}"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'avonent-footer__logo',
                loading: 'lazy',
                widths: '160, 240, 320, 480, 600',
                sizes: '240px'
            }}
          {% else %}
            <span class="avonent-footer__logo-text">
              {{ section.settings.brand_name }}
            </span>
          {% endif %}
        </a>

        {% if section.settings.tagline != blank %}
          <div class="avonent-footer__tagline">
            {{ section.settings.tagline }}
          </div>
        {% endif %}

        {% if section.settings.brand_description != blank %}
          <div class="avonent-footer__description">
            {{ section.settings.brand_description }}
          </div>
        {% endif %}

        {% if section.settings.show_social_icons %}
          <div class="avonent-footer__socials">

            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.3" cy="6.7" r="1"></circle>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
              <a
                href="{{ section.settings.tiktok_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="TikTok"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14.5 4v10.3a4.8 4.8 0 1 1-4-4.7"></path>
                  <path d="M14.5 4c.6 2.4 2.3 3.9 4.5 4.2"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1z"></path>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.youtube_url != blank %}
              <a
                href="{{ section.settings.youtube_url }}"
                class="avonent-footer__social"
                target="_blank"
                rel="noopener"
                aria-label="YouTube"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 7.2c-.2-.8-.8-1.4-1.6-1.6C17 5.2 12 5.2 12 5.2s-5 0-6.4.4C4.8 5.8 4.2 6.4 4 7.2A21 21 0 0 0 3.6 12 21 21 0 0 0 4 16.8c.2.8.8 1.4 1.6 1.6 1.4.4 6.4.4 6.4.4s5 0 6.4-.4c.8-.2 1.4-.8 1.6-1.6.4-1.5.4-4.8.4-4.8s0-3.3-.4-4.8z"></path>
                  <path d="m10 15 5-3-5-3z"></path>
                </svg>
              </a>
            {% endif %}

          </div>
        {% endif %}

      </div>


      {% if section.settings.show_newsletter %}
        <div class="avonent-footer__newsletter">

          {% if section.settings.newsletter_eyebrow != blank %}
            <div class="avonent-footer__newsletter-eyebrow">
              {{ section.settings.newsletter_eyebrow }}
            </div>
          {% endif %}

          {% if section.settings.newsletter_heading != blank %}
            <h3 class="avonent-footer__newsletter-heading">
              {{ section.settings.newsletter_heading }}
            </h3>
          {% endif %}

          {% if section.settings.newsletter_text != blank %}
            <div class="avonent-footer__newsletter-text">
              {{ section.settings.newsletter_text }}
            </div>
          {% endif %}

          {% form 'customer', class: 'avonent-footer__form' %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <div class="avonent-footer__form-row">

              <label
                class="visually-hidden"
                for="AvonentFooterEmail-{{ section.id }}"
              >
                Email address
              </label>

              <input
                id="AvonentFooterEmail-{{ section.id }}"
                class="avonent-footer__input"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >

              <button
                type="submit"
                class="avonent-footer__submit"
              >
                {{ section.settings.button_label }}

                <span aria-hidden="true">→</span>
              </button>

            </div>

            {% if form.posted_successfully? %}
              <div class="avonent-footer__form-message">
                {{ section.settings.success_text }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="avonent-footer__form-message avonent-footer__form-message--error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

          {% endform %}

        </div>
      {% endif %}

    </div>


    {%- comment -%}
      NAVIGATION
    {%- endcomment -%}

    <div class="avonent-footer__navigation">

      {% if section.settings.main_menu != blank %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.main_menu_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">
            {% for link in section.settings.main_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>

        </details>
      {% endif %}


      {% if section.settings.support_menu != blank %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.support_menu_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">
            {% for link in section.settings.support_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>

        </details>
      {% endif %}


      {% if section.settings.show_policy_links %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.policy_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">

            {% for policy in shop.policies %}
              {% if policy != blank %}
                <li>
                  <a href="{{ policy.url }}">
                    {{ policy.title }}
                  </a>
                </li>
              {% endif %}
            {% endfor %}

          </ul>

        </details>
      {% endif %}


      {% if section.settings.extra_menu != blank %}
        <details class="avonent-footer__menu" open>

          <summary class="avonent-footer__menu-heading">
            {{ section.settings.extra_menu_heading }}

            <span
              class="avonent-footer__menu-toggle"
              aria-hidden="true"
            >
              +
            </span>
          </summary>

          <ul class="avonent-footer__links">
            {% for link in section.settings.extra_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>

        </details>
      {% endif %}

    </div>


    {%- comment -%}
      DISCLAIMER
    {%- endcomment -%}

    {% if section.settings.show_disclaimer %}
      <div class="avonent-footer__disclaimer">

        {% if section.settings.disclaimer_heading != blank %}
          <div class="avonent-footer__disclaimer-heading">
            {{ section.settings.disclaimer_heading }}
          </div>
        {% endif %}

        {% if section.settings.fda_disclaimer != blank %}
          <div class="avonent-footer__disclaimer-text">
            {{ section.settings.fda_disclaimer }}
          </div>
        {% endif %}

        {% if section.settings.additional_disclaimer != blank %}
          <div class="avonent-footer__disclaimer-extra">
            {{ section.settings.additional_disclaimer }}
          </div>
        {% endif %}

      </div>
    {% endif %}


    {%- comment -%}
      PAYMENT ICONS
    {%- endcomment -%}

    {% if section.settings.show_payment_icons %}
      <div class="avonent-footer__payment-area">

        {% if section.settings.payment_heading != blank %}
          <div class="avonent-footer__payment-heading">
            {{ section.settings.payment_heading }}
          </div>
        {% endif %}

        <div
          class="avonent-footer__payments"
          aria-label="Accepted payment methods"
        >
          {% for type in shop.enabled_payment_types %}
            <span class="avonent-footer__payment">
              {{ type | payment_type_svg_tag }}
            </span>
          {% endfor %}
        </div>

      </div>
    {% endif %}


    {%- comment -%}
      BOTTOM
    {%- endcomment -%}

    <div class="avonent-footer__bottom">

      <div class="avonent-footer__copyright">
        © {{ 'now' | date: '%Y' }}
        {{ section.settings.brand_name }}.
        {{ section.settings.copyright_text }}
      </div>

      {% if section.settings.bottom_policy_links %}
        <div class="avonent-footer__bottom-links">

          {% if shop.privacy_policy != blank %}
            <a href="{{ shop.privacy_policy.url }}">
              Privacy
            </a>
          {% endif %}

          {% if shop.terms_of_service != blank %}
            <a href="{{ shop.terms_of_service.url }}">
              Terms
            </a>
          {% endif %}

          {% if shop.refund_policy != blank %}
            <a href="{{ shop.refund_policy.url }}">
              Refunds
            </a>
          {% endif %}

        </div>
      {% endif %}

    </div>

    {% endif %}
  </div>

</section>


<style>

  /*
   * AVONENT FOOTER
   */

  .avonent-footer {
    width: 100%;

    padding-top:
      var(--av-footer-padding-top);

    padding-bottom:
      var(--av-footer-padding-bottom);

    background:
      var(--av-footer-bg);

    color:
      var(--av-footer-text);
  }


  .avonent-footer__container {
    width:
      min(
        calc(100% - 48px),
        1360px
      );

    margin:
      0 auto;
  }


  /*
   * BRAND / NEWSLETTER
   */

  .avonent-footer__top {
    display: grid;

    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);

    gap:
      clamp(50px, 8vw, 120px);

    padding-bottom: 46px;

    border-bottom:
      1px solid
      var(--av-footer-border);
  }


  .avonent-footer__logo-link {
    display: inline-block;

    color:
      var(--av-footer-text);

    text-decoration: none;
  }


  .avonent-footer__logo {
    display: block;

    width: auto;
    max-width: 220px;
    max-height: 70px;

    object-fit: contain;
  }


  .avonent-footer__logo-text {
    font-family:
      var(--font-heading--family);

    font-size:
      clamp(
        34px,
        4vw,
        52px
      );

    font-weight: 650;

    line-height: 1;

    letter-spacing: -0.035em;
  }


  .avonent-footer__tagline {
    max-width: 520px;

    margin-top: 18px;

    font-family:
      var(--font-heading--family);

    font-size: 22px;
    font-weight: 500;

    line-height: 1.25;
  }


  .avonent-footer__description {
    max-width: 520px;

    margin-top: 13px;

    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 15px;

    line-height: 1.6;
  }


  .avonent-footer__description p {
    margin: 0;
  }


  /*
   * SOCIALS
   */

  .avonent-footer__socials {
    display: flex;

    gap: 9px;

    margin-top: 23px;
  }


  .avonent-footer__social {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    border:
      1px solid
      var(--av-footer-border);

    border-radius: 50%;

    color:
      var(--av-footer-text);

    text-decoration: none;

    transition:
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }


  .avonent-footer__social svg {
    width: 17px;
    height: 17px;

    fill: none;

    stroke:
      currentColor;

    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .avonent-footer__social:hover {
    border-color:
      var(--av-footer-accent);

    background:
      var(--av-footer-accent);

    color: #071216;

    transform:
      translateY(-1px);
  }


  /*
   * NEWSLETTER
   */

  .avonent-footer__newsletter {
    max-width: 650px;

    margin-left: auto;
  }


  .avonent-footer__newsletter-eyebrow {
    margin-bottom: 10px;

    color:
      var(--av-footer-accent);

    font-family:
      var(--font-body--family);

    font-size: 11px;
    font-weight: 700;

    line-height: 1;

    letter-spacing: 0.09em;

    text-transform: uppercase;
  }


  .avonent-footer__newsletter-heading {
    margin: 0;

    color:
      var(--av-footer-text);

    font-family:
      var(--font-heading--family);

    font-size:
      clamp(
        28px,
        3vw,
        38px
      );

    font-weight: 600;

    line-height: 1.08;

    letter-spacing:
      -0.025em;
  }


  .avonent-footer__newsletter-text {
    margin-top: 12px;

    color:
      var(--av-footer-muted);

    font-family:
      var(--font-body--family);

    font-size: 15px;

    line-height: 1.5;
  }


  .avonent-footer__newsletter-text p {
    margin: 0;
  }


  .avonent-footer__form {
    margin-top: 22px;
  }


  .avonent-footer__form-row {
    display: flex;

    gap: 9px;

    padding: 6px;

    border:
      1px solid
      var(--av-footer-border);

    border-radius:
      var(--av-footer-radius);

    background:
      var(--av-footer-input-bg);
  }


  .avonent-footer__input {
    flex: 1 1 auto;

    min-width: 0;
    min-height: 50px;

    padding:
      0
      15px;

    border: 0;

    background:
      transparent;

    color:
      var(--av-footer-input-text);

    outline: none;

    font-family:
      var(--font-body--family);

    font-size: 15px;
  }


  .avonent-footer__input::placeholder {
    color:
      var(--av-footer-muted);

    opacity: 0.72;
  }


  .avonent-footer__submit {
    flex: 0 0 auto;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    min-width: 142px;
    min-height: 50px;

    padding:
      0
      22px;

    border: 0;

    border-radius:
      calc(
        var(--av-footer-radius)
        - 5px
      );

    background:
      var(--av-footer-button-bg);

    color:
      var(--av-footer-button-text);

    cursor: pointer;

    font-family:
      var(--font-body--family);

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.04em;
  }


  .avonent-footer__submit:hover {
    background:
      var(--av-footer-accent);


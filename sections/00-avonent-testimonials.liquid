{% liquid
  assign section_id = 'avonent-testimonials-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-testimonials"
  style="
    --av-testimonials-bg: {{ section.settings.background_color }};
    --av-testimonials-text: {{ section.settings.text_color }};
    --av-testimonials-card-bg: {{ section.settings.card_background }};
    --av-testimonials-card-text: {{ section.settings.card_text_color }};
    --av-testimonials-star: {{ section.settings.star_color }};
    --av-testimonials-border: {{ section.settings.border_color }};
    --av-testimonials-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="avonent-testimonials__container">

    {% if section.settings.eyebrow != blank %}
      <div class="avonent-testimonials__eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="avonent-testimonials__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="avonent-testimonials__subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {% if section.settings.show_summary %}
      <div class="avonent-testimonials__summary">

        <div
          class="avonent-testimonials__summary-stars"
          aria-label="{{ section.settings.summary_rating }} out of 5 stars"
        >
          {% for i in (1..5) %}
            <span aria-hidden="true">★</span>
          {% endfor %}
        </div>

        <div class="avonent-testimonials__summary-copy">
          {% if section.settings.summary_bold_text != blank %}
            <strong>
              {{ section.settings.summary_bold_text }}
            </strong>
          {% endif %}

          {% if section.settings.summary_text != blank %}
            <span>
              {{ section.settings.summary_text }}
            </span>
          {% endif %}
        </div>

      </div>
    {% endif %}

    <div class="avonent-testimonials__grid">

      {% for block in section.blocks %}
        <article
          class="avonent-testimonial-card"
          {{ block.shopify_attributes }}
        >

          <div
            class="avonent-testimonial-card__stars"
            aria-label="{{ block.settings.rating }} out of 5 stars"
          >
            {% for i in (1..5) %}
              <span
                class="{% if i > block.settings.rating %}is-empty{% endif %}"
                aria-hidden="true"
              >
                ★
              </span>
            {% endfor %}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="avonent-testimonial-card__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}

          {% if block.settings.review != blank %}
            <div class="avonent-testimonial-card__review">
              {{ block.settings.review }}
            </div>
          {% endif %}

          <div class="avonent-testimonial-card__footer">

            {% if block.settings.customer_image != blank %}
              <div class="avonent-testimonial-card__avatar">
                {{
                  block.settings.customer_image
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '80, 120, 160',
                    sizes: '48px'
                }}
              </div>
            {% endif %}

            <div class="avonent-testimonial-card__customer">

              {% if block.settings.customer_name != blank %}
                <div class="avonent-testimonial-card__name">
                  {{ block.settings.customer_name }}
                </div>
              {% endif %}

              {% if block.settings.show_verified %}
                <div class="avonent-testimonial-card__verified">
                  <span
                    class="avonent-testimonial-card__verified-icon"
                    aria-hidden="true"
                  >
                    ✓
                  </span>

                  {{ block.settings.verified_text }}
                </div>
              {% endif %}

            </div>

          </div>

          {% if block.settings.show_product %}
            <div class="avonent-testimonial-card__product">

              {% if block.settings.product_image != blank %}
                <div class="avonent-testimonial-card__product-image">
                  {{
                    block.settings.product_image
                    | image_url: width: 180
                    | image_tag:
                      loading: 'lazy',
                      widths: '90, 140, 180',
                      sizes: '58px'
                  }}
                </div>
              {% endif %}

              <div class="avonent-testimonial-card__product-copy">

                {% if block.settings.product_label != blank %}
                  <span class="avonent-testimonial-card__product-label">
                    {{ block.settings.product_label }}
                  </span>
                {% endif %}

                {% if block.settings.product_name != blank %}
                  <strong class="avonent-testimonial-card__product-name">
                    {{ block.settings.product_name }}
                  </strong>
                {% endif %}

              </div>

            </div>
          {% endif %}

        </article>
      {% endfor %}

    </div>

  </div>
</section>

{% stylesheet %}

  /*
   * AVONENT TESTIMONIALS
   */

  .avonent-testimonials {
    width: 100%;

    padding:
      84px
      0;

    background:
      var(--av-testimonials-bg);

    color:
      var(--av-testimonials-text);
  }

  .avonent-testimonials__container {
    width:
      min(
        calc(100% - 48px),
        1380px
      );

    margin:
      0
      auto;
  }


  /*
   * SECTION HEADER
   */

  .avonent-testimonials__eyebrow {
    margin-bottom: 10px;

    font-family:
      var(--font-body--family);

    font-size: 12px;
    font-weight: 650;

    letter-spacing: 0.08em;

    text-align: center;
    text-transform: uppercase;

    opacity: 0.82;
  }

  .avonent-testimonials__heading {
    max-width: 760px;

    margin:
      0
      auto;

    font-family:
      var(--font-heading--family);

    font-size:
      clamp(
        36px,
        4vw,
        54px
      );

    font-weight: 600;

    line-height: 1.04;

    letter-spacing: -0.025em;

    text-align: center;

    color: inherit;
  }

  .avonent-testimonials__subheading {
    max-width: 660px;

    margin:
      16px
      auto
      0;

    font-family:
      var(--font-body--family);

    font-size: 16px;
    font-weight: 400;

    line-height: 1.5;

    text-align: center;

    opacity: 0.88;
  }

  .avonent-testimonials__subheading p {
    margin: 0;
  }


  /*
   * SUMMARY
   */

  .avonent-testimonials__summary {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 24px;
  }

  .avonent-testimonials__summary-stars {
    display: flex;
    align-items: center;

    gap: 2px;

    color:
      var(--av-testimonials-star);

    font-size: 20px;

    line-height: 1;
  }

  .avonent-testimonials__summary-copy {
    display: flex;
    align-items: baseline;

    gap: 5px;

    font-family:
      var(--font-body--family);

    font-size: 15px;

    line-height: 1.2;
  }

  .avonent-testimonials__summary-copy strong {
    font-weight: 700;
  }


  /*
   * GRID
   */

  .avonent-testimonials__grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 18px;

    margin-top: 42px;
  }


  /*
   * REVIEW CARD
   */

  .avonent-testimonial-card {
    display: flex;
    flex-direction: column;

    min-width: 0;

    padding: 28px;

    border:
      1px solid
      var(--av-testimonials-border);

    border-radius:
      var(--av-testimonials-radius);

    background:
      var(--av-testimonials-card-bg);

    color:
      var(--av-testimonials-card-text);

    box-shadow:
      0
      8px
      30px
      rgba(0, 0, 0, 0.035);
  }


  /*
   * STARS
   */

  .avonent-testimonial-card__stars {
    display: flex;

    gap: 1px;

    margin-bottom: 18px;

    color:
      var(--av-testimonials-star);

    font-size: 19px;

    line-height: 1;
  }

  .avonent-testimonial-card__stars
    .is-empty {
    opacity: 0.2;
  }


  /*
   * TITLE
   */

  .avonent-testimonial-card__title {
    margin: 0;

    font-family:
      var(--font-heading--family);

    font-size: 22px;
    font-weight: 600;

    line-height: 1.15;

    letter-spacing: -0.015em;

    color: inherit;
  }


  /*
   * REVIEW BODY
   */

  .avonent-testimonial-card__review {
    margin-top: 13px;

    font-family:
      var(--font-body--family);

    font-size: 15px;
    font-weight: 400;

    line-height: 1.55;

    opacity: 0.9;
  }

  .avonent-testimonial-card__review p {
    margin: 0;
  }


  /*
   * CUSTOMER
   */

  .avonent-testimonial-card__footer {
    display: flex;
    align-items: center;

    gap: 12px;

    margin-top: auto;
    padding-top: 26px;
  }

  .avonent-testimonial-card__avatar {
    flex:
      0
      0
      44px;

    width: 44px;
    height: 44px;

    overflow: hidden;

    border-radius: 50%;

    background: #f3f5f6;
  }

  .avonent-testimonial-card__avatar img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .avonent-testimonial-card__customer {
    min-width: 0;
  }

  .avonent-testimonial-card__name {
    font-family:
      var(--font-body--family);

    font-size: 14px;
    font-weight: 650;

    line-height: 1.2;
  }

  .avonent-testimonial-card__verified {
    display: flex;
    align-items: center;

    gap: 5px;

    margin-top: 4px;

    font-family:
      var(--font-body--family);

    font-size: 11px;
    font-weight: 500;

    line-height: 1;

    opacity: 0.66;
  }

  .avonent-testimonial-card__verified-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 15px;
    height: 15px;

    border-radius: 50%;

    background:
      var(--av-testimonials-star);

    color: #ffffff;

    font-size: 9px;
    font-weight: 700;
  }


  /*
   * PRODUCT
   */

  .avonent-testimonial-card__product {
    display: flex;
    align-items: center;

    gap: 13px;

    margin-top: 22px;

    padding: 12px;

    border-radius:
      calc(
        var(--av-testimonials-radius)
        - 6px
      );

    background:
      rgba(0, 0, 0, 0.035);
  }

  .avonent-testimonial-card__product-image {
    flex:
      0
      0
      54px;

    width: 54px;
    height: 54px;

    overflow: hidden;

    border-radius: 10px;

    background: #ffffff;
  }

  .avonent-testimonial-card__product-image img {
    width: 100%;
    height: 100%;

    object-fit: contain;
  }

  .avonent-testimonial-card__product-copy {
    display: flex;
    flex-direction: column;

    min-width: 0;
  }

  .avonent-testimonial-card__product-label {
    margin-bottom: 3px;

    font-family:
      var(--font-body--family);

    font-size: 10px;
    font-weight: 500;

    line-height: 1;

    opacity: 0.58;

    text-transform: uppercase;

    letter-spacing: 0.05em;
  }

  .avonent-testimonial-card__product-name {
    font-family:
      var(--font-body--family);

    font-size: 14px;
    font-weight: 650;

    line-height: 1.2;
  }


  /*
   * TABLET
   */

  @media screen and (max-width: 989px) {
    .avonent-testimonials__grid {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }
  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    .avonent-testimonials {
      padding:
        58px
        0;
    }

    .avonent-testimonials__container {
      width:
        calc(100% - 32px);
    }

    .avonent-testimonials__heading {
      font-size:
        clamp(
          31px,
          9vw,
          40px
        );

      line-height: 1.08;
    }

    .avonent-testimonials__subheading {
      margin-top: 13px;

      font-size: 14px;
    }

    .avonent-testimonials__summary {
      margin-top: 20px;

      gap: 8px;
    }

    .avonent-testimonials__summary-stars {
      font-size: 18px;
    }

    .avonent-testimonials__summary-copy {
      font-size: 13px;
    }

    /*
     * Horizontal swipe on mobile.
     */

    .avonent-testimonials__grid {
      display: flex;

      width:
        calc(
          100% + 16px
        );

      gap: 12px;

      margin-top: 30px;

      padding:
        0
        16px
        8px
        0;

      overflow-x: auto;

      scroll-snap-type:
        x
        mandatory;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;
    }

    .avonent-testimonials__grid::-webkit-scrollbar {
      display: none;
    }

    .avonent-testimonial-card {
      flex:
        0
        0
        min(
          86vw,
          360px
        );

      scroll-snap-align: start;

      padding: 23px;
    }

    .avonent-testimonial-card__title {
      font-size: 20px;
    }

    .avonent-testimonial-card__review {
      font-size: 14px;
    }

    .avonent-testimonial-card__stars {
      font-size: 18px;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "00 Avonent Testimonials",
  "tag": "section",
  "class": "avonent-testimonials-section",

  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "REAL EXPERIENCES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by people who make wellness a priority."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>See what customers are saying about making Avonent part of their routine.</p>"
    },

    {
      "type": "header",
      "content": "Review summary"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show review summary",
      "default": true
    },
    {
      "type": "range",
      "id": "summary_rating",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "summary_bold_text",
      "label": "Bold text",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Summary text",
      "default": "from verified customers"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars and verified icon",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#E7EEF0"
    },

    {
      "type": "header",
      "content": "Card styling"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card roundness",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],

  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "A new favorite in my routine."
        },
        {
          "type": "richtext",
          "id": "review",
          "label": "Review",
          "default": "<p>Easy to work into my day and the whole experience feels much more premium than other supplements I've tried.</p>"
        },

        {
          "type": "header",
          "content": "Customer"
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Customer image"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Sarah M."
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show verified customer",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified text",
          "default": "Verified Customer"
        },

        {
          "type": "header",
          "content": "Reviewed product"
        },
        {
          "type": "checkbox",
          "id": "show_product",
          "label": "Show reviewed product",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Reviewing"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "default": "Avonent Daily Formula"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "00 Avonent Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Simple, easy, and premium.",
            "review": "<p>I wanted something easy to stay consistent with. The packaging, routine, and overall experience have been great.</p>",
            "customer_name": "Emily R."
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Exactly what I wanted.",
            "review": "<p>It fits naturally into my routine and feels like a product that was actually designed with quality in mind.</p>",
            "customer_name": "Jordan T."
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Definitely ordering again.",
            "review": "<p>The experience has been excellent from ordering through delivery. I'm very happy with Avonent so far.</p>",
            "customer_name": "Michael C."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% liquid
  assign section_id = 'avonent-testimonials-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-testimonials"
  style="
    --av-testimonials-bg: {{ section.settings.background_color }};
    --av-testimonials-text: {{ section.settings.text_color }};
    --av-testimonials-card-bg: {{ section.settings.card_background }};
    --av-testimonials-card-text: {{ section.settings.card_text_color }};
    --av-testimonials-star: {{ section.settings.star_color }};
    --av-testimonials-border: {{ section.settings.border_color }};
    --av-testimonials-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="avonent-testimonials__container">
    <h2 class="avonent-testimonials__heading">
      <span>Real Stories,</span> <span class="avonent-testimonials__heading-accent">Real Results</span>
    </h2>

    {% if section.settings.subheading != blank %}
      <div class="avonent-testimonials__subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    <div class="avonent-testimonials__viewport" data-av-testimonials-viewport>
      <div class="avonent-testimonials__track">
        {% for block in section.blocks %}
          <article class="avonent-testimonial-card" data-av-testimonial-card {{ block.shopify_attributes }}>
            <div class="avonent-testimonial-card__rating-row">
              <strong class="avonent-testimonial-card__rating-number">5.0</strong>
              <div class="avonent-testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {% for i in (1..5) %}
                  <span class="{% if i > block.settings.rating %}is-empty{% endif %}" aria-hidden="true">★</span>
                {% endfor %}
              </div>
            </div>

            {% if block.settings.title != blank %}
              <h3 class="avonent-testimonial-card__title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.review != blank %}
              <div class="avonent-testimonial-card__review">{{ block.settings.review }}</div>
            {% endif %}

            <div class="avonent-testimonial-card__footer">
              {% if block.settings.customer_name != blank %}
                <div class="avonent-testimonial-card__name">{{ block.settings.customer_name }}</div>
              {% endif %}
              {% if block.settings.show_verified %}
                <div class="avonent-testimonial-card__verified">
                  <span class="avonent-testimonial-card__verified-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M4.4 10.2 8 13.6 15.6 6" stroke="currentColor" stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  {{ block.settings.verified_text }}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    {% if section.blocks.size > 1 %}
      <div class="avonent-testimonials__dots" data-av-testimonials-dots>
        {% for block in section.blocks %}
          <button
            type="button"
            class="avonent-testimonials__dot{% if forloop.first %} is-active{% endif %}"
            data-av-testimonials-dot="{{ forloop.index0 }}"
            aria-label="Go to review {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>

      <div class="avonent-testimonials__arrows">
        <button type="button" class="avonent-testimonials__arrow" data-av-testimonials-prev aria-label="Previous review">
          <svg viewBox="0 0 24 24" fill="none"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="avonent-testimonials__arrow" data-av-testimonials-next aria-label="Next review">
          <svg viewBox="0 0 24 24" fill="none"><path d="m9.5 6 6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('{{ section_id }}');
    if (!root || root.dataset.carouselReady === 'true') return;
    root.dataset.carouselReady = 'true';

    const viewport = root.querySelector('[data-av-testimonials-viewport]');
    const cards = Array.from(root.querySelectorAll('[data-av-testimonial-card]'));
    const dots = Array.from(root.querySelectorAll('[data-av-testimonials-dot]'));
    const prev = root.querySelector('[data-av-testimonials-prev]');
    const next = root.querySelector('[data-av-testimonials-next]');
    if (!viewport || !cards.length) return;

    let index = 0;
    let scrollTimer;

    const setActive = (newIndex, behavior = 'smooth') => {
      index = Math.max(0, Math.min(cards.length - 1, newIndex));
      viewport.scrollTo({left: cards[index].offsetLeft - viewport.offsetLeft, behavior});
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    prev?.addEventListener('click', () => setActive(index <= 0 ? cards.length - 1 : index - 1));
    next?.addEventListener('click', () => setActive(index >= cards.length - 1 ? 0 : index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => setActive(i)));

    viewport.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const viewportLeft = viewport.scrollLeft;
        let closest = 0;
        let closestDistance = Infinity;
        cards.forEach((card, i) => {
          const distance = Math.abs(card.offsetLeft - viewport.offsetLeft - viewportLeft);
          if (distance < closestDistance) {
            closestDistance = distance;
            closest = i;
          }
        });
        index = closest;
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      }, 80);
    }, {passive:true});
  })();
</script>

{% stylesheet %}
  .avonent-testimonials{
    width:100%;
    padding:72px 0 82px;
    background:var(--av-testimonials-bg);
    color:var(--av-testimonials-text);
  }
  .avonent-testimonials__container{
    width:min(calc(100% - 40px),980px);
    margin:0 auto;
  }
  .avonent-testimonials__heading{
    max-width:760px;
    margin:0 auto;
    font-family:var(--font-heading--family);
    font-size:clamp(36px,4vw,54px);
    font-weight:650;
    line-height:1.04;
    letter-spacing:-.025em;
    text-align:center;
    color:inherit;
  }
  .avonent-testimonials__heading-accent{color:#02C6EA}
  .avonent-testimonials__subheading{
    max-width:660px;
    margin:15px auto 0;
    font-family:var(--font-body--family);
    font-size:16px;
    line-height:1.5;
    text-align:center;
    opacity:.84;
  }
  .avonent-testimonials__subheading p{margin:0}
  .avonent-testimonials__viewport{
    width:100%;
    margin-top:34px;
    overflow-x:auto;
    overflow-y:hidden;
    scroll-snap-type:x mandatory;
    scroll-behavior:smooth;
    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
  }
  .avonent-testimonials__viewport::-webkit-scrollbar{display:none}
  .avonent-testimonials__track{
    display:flex;
    gap:18px;
  }
  .avonent-testimonial-card{
    flex:0 0 100%;
    scroll-snap-align:start;
    scroll-snap-stop:always;
    display:flex;
    flex-direction:column;
    min-width:0;
    padding:34px 34px 30px;
    border:1px solid var(--av-testimonials-border);
    border-radius:var(--av-testimonials-radius);
    background:var(--av-testimonials-card-bg);
    color:var(--av-testimonials-card-text);
    box-shadow:0 12px 34px rgba(33,28,22,.055);
  }
  .avonent-testimonial-card__rating-row{
    display:flex;
    align-items:center;
    gap:11px;
    margin-bottom:24px;
  }
  .avonent-testimonial-card__rating-number{
    color:#171513;
    font-family:var(--font-body--family);
    font-size:20px;
    font-weight:800;
    line-height:1;
  }
  .avonent-testimonial-card__stars{
    display:flex;
    gap:2px;
    color:var(--av-testimonials-star);
    font-size:23px;
    line-height:1;
  }
  .avonent-testimonial-card__stars .is-empty{opacity:.2}
  .avonent-testimonial-card__title{
    margin:0;
    font-family:var(--font-heading--family);
    font-size:28px;
    font-weight:750;
    line-height:1.12;
    letter-spacing:-.025em;
    color:inherit;
  }
  .avonent-testimonial-card__review{
    margin-top:16px;
    font-family:var(--font-body--family);
    font-size:17px;
    line-height:1.62;
    opacity:.92;
  }
  .avonent-testimonial-card__review p{margin:0}
  .avonent-testimonial-card__footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    margin-top:28px;
    padding-top:22px;
    border-top:1px solid var(--av-testimonials-border);
  }
  .avonent-testimonial-card__name{
    font-family:var(--font-body--family);
    font-size:16px;
    font-weight:800;
  }
  .avonent-testimonial-card__verified{
    display:flex;
    align-items:center;
    gap:7px;
    font-family:var(--font-body--family);
    font-size:13px;
    font-weight:700;
  }
  .avonent-testimonial-card__verified-icon{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:19px;
    height:19px;
    border-radius:50%;
    background:#4D8A64;
    color:#fff;
  }
  .avonent-testimonial-card__verified-icon svg{width:12px;height:12px}
  .avonent-testimonials__dots{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:9px;
    margin-top:24px;
  }
  .avonent-testimonials__dot{
    width:10px;
    height:10px;
    padding:0;
    border:0;
    border-radius:999px;
    background:#D2D0CE;
    cursor:pointer;
    transition:width .2s ease,background .2s ease;
  }
  .avonent-testimonials__dot.is-active{
    width:42px;
    background:#02C6EA;
  }
  .avonent-testimonials__arrows{
    display:flex;
    justify-content:center;
    gap:12px;
    margin-top:18px;
  }
  .avonent-testimonials__arrow{
    display:grid;
    place-items:center;
    width:54px;
    height:54px;
    padding:0;
    border:1px solid #DCE5E8;
    border-radius:50%;
    background:#fff;
    color:#161616;
    cursor:pointer;
  }
  .avonent-testimonials__arrow svg{width:25px;height:25px}
  @media(max-width:749px){
    .avonent-testimonials{padding:54px 0 62px}
    .avonent-testimonials__container{width:calc(100% - 28px)}
    .avonent-testimonials__heading{
      max-width:350px;
      font-size:clamp(32px,9vw,40px);
    }
    .avonent-testimonials__subheading{
      max-width:330px;
      margin-top:12px;
      font-size:14px;
    }
    .avonent-testimonials__viewport{margin-top:28px}
    .avonent-testimonials__track{gap:12px}
    .avonent-testimonial-card{
      padding:25px 22px 22px;
      border-radius:min(var(--av-testimonials-radius),22px);
    }
    .avonent-testimonial-card__rating-row{margin-bottom:19px}
    .avonent-testimonial-card__rating-number{font-size:19px}
    .avonent-testimonial-card__stars{font-size:20px}
    .avonent-testimonial-card__title{font-size:23px}
    .avonent-testimonial-card__review{font-size:15px;line-height:1.58}
    .avonent-testimonial-card__footer{
      margin-top:22px;
      padding-top:19px;
    }
    .avonent-testimonial-card__name{font-size:14px}
    .avonent-testimonial-card__verified{font-size:11.5px}
    .avonent-testimonial-card__verified-icon{width:18px;height:18px}
    .avonent-testimonials__dots{margin-top:20px}
    .avonent-testimonials__arrow{width:48px;height:48px}
  }
  .avonent-testimonials-bottom-image{
    position:relative;
    width:100%;
    height:var(--av-bottom-image-desktop);
    overflow:hidden;
    margin:0;
  }
  .avonent-testimonials-bottom-image__image{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }
  .avonent-testimonials-bottom-image__shade{
    position:absolute;
    inset:0;
    background:rgba(0,31,39,var(--av-bottom-image-overlay));
    pointer-events:none;
  }
  .avonent-testimonials-bottom-image__content{
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(900px,calc(100% - 40px));
    padding:0 0 38px;
    color:#fff;
    text-align:left;
  }
  .avonent-testimonials-bottom-image__content h2{
    max-width:700px;
    margin:0;
    color:#fff;
    font-family:var(--font-heading--family,var(--font-body--family));
    font-size:clamp(34px,5vw,58px);
    line-height:1.03;
    letter-spacing:-.035em;
  }
  .avonent-testimonials-bottom-image__content p{
    max-width:640px;
    margin:14px 0 0;
    color:rgba(255,255,255,.92);
    font-family:var(--font-body--family);
    font-size:17px;
    line-height:1.5;
  }
  @media(max-width:749px){
    .avonent-testimonials-bottom-image{height:var(--av-bottom-image-mobile)}
    .avonent-testimonials-bottom-image__content{
      width:calc(100% - 32px);
      padding-bottom:24px;
    }
    .avonent-testimonials-bottom-image__content h2{font-size:34px}
    .avonent-testimonials-bottom-image__content p{font-size:14.5px}
  }
{% endstylesheet %}

{% if section.settings.bottom_image != blank %}
  <div
    class="avonent-testimonials-bottom-image"
    style="
      --av-bottom-image-overlay: {{ section.settings.bottom_image_overlay | divided_by: 100.0 }};
      --av-bottom-image-mobile: {{ section.settings.bottom_image_height_mobile }}px;
      --av-bottom-image-desktop: {{ section.settings.bottom_image_height_desktop }}px;
    "
  >
    {{
      section.settings.bottom_image
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        widths: '750,1100,1500,2000,2400',
        sizes: '100vw',
        class: 'avonent-testimonials-bottom-image__image',
        alt: section.settings.bottom_image_heading
    }}
    <div class="avonent-testimonials-bottom-image__shade"></div>
    {% if section.settings.bottom_image_heading != blank or section.settings.bottom_image_text != blank %}
      <div class="avonent-testimonials-bottom-image__content">
        {% if section.settings.bottom_image_heading != blank %}
          <h2>{{ section.settings.bottom_image_heading }}</h2>
        {% endif %}
        {% if section.settings.bottom_image_text != blank %}
          <p>{{ section.settings.bottom_image_text }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}


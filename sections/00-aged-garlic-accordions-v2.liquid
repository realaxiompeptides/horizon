<section class="ag-acc2" style="--bg:{{ section.settings.background }};--t:{{ section.settings.text }};--m:{{ section.settings.muted }};--l:{{ section.settings.line }};--a:{{ section.settings.accent }};">
  <div class="ag-acc2__in">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% for block in section.blocks %}
      <details class="ag-acc2__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.heading }}</span><b>+</b></summary>
        <div class="ag-acc2__body rte">{{ block.settings.content }}</div>
      </details>
    {% endfor %}
  </div>
</section>
{% stylesheet %}
.ag-acc2{background:var(--bg);color:var(--t);padding:10px 0 32px}.ag-acc2__in{width:min(calc(100% - 30px),900px);margin:auto}.ag-acc2 h2{margin:0 0 14px;font-size:30px}.ag-acc2__item{border-bottom:2px dashed var(--l)}.ag-acc2__item:first-of-type{border-top:2px dashed var(--l)}.ag-acc2 summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:15px;padding:20px 2px;cursor:pointer;font-size:18px;font-weight:800}.ag-acc2 summary::-webkit-details-marker{display:none}.ag-acc2 summary b{color:var(--a);font-size:24px;font-weight:400;transition:.18s}.ag-acc2__item[open] summary b{transform:rotate(45deg)}.ag-acc2__body{padding:0 2px 20px;color:var(--m);font-size:14px;line-height:1.65}.ag-acc2__body p:first-child{margin-top:0}.ag-acc2__body p:last-child{margin-bottom:0}@media(max-width:749px){.ag-acc2 summary{font-size:17px;padding:18px 1px}}
{% endstylesheet %}
{% schema %}
{
  "name":"Aged Garlic Accordions V2",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"heading","label":"Optional heading"},
    {"type":"color","id":"background","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text","label":"Text","default":"#1E1A1C"},
    {"type":"color","id":"muted","label":"Body text","default":"#5E575A"},
    {"type":"color","id":"line","label":"Dashed line","default":"#D8D3D4"},
    {"type":"color","id":"accent","label":"Accent","default":"#8B2635"}
  ],
  "blocks":[{"type":"item","name":"Accordion item","settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Daily wellness support"},
    {"type":"richtext","id":"content","label":"Content","default":"<p>Edit this answer in the Shopify theme editor.</p>"},
    {"type":"checkbox","id":"open_by_default","label":"Open by default","default":false}
  ]}],
  "max_blocks":10,
  "presets":[{"name":"Aged Garlic Accordions V2","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
{% liquid
  assign av_product = product | default: closest.product
%}

<section
  id="AgedGarlicStory-{{ section.id }}"
  class="aged-garlic-story"
  style="
    --ags-ivory:{{ section.settings.ivory }};
    --ags-cream:{{ section.settings.cream }};
    --ags-burgundy:{{ section.settings.burgundy }};
    --ags-burgundy-dark:{{ section.settings.burgundy_dark }};
    --ags-gold:{{ section.settings.gold }};
    --ags-ink:{{ section.settings.ink }};
    --ags-muted:{{ section.settings.muted }};
    --ags-line:{{ section.settings.line }};
    --ags-white:#ffffff;
    --ags-width:{{ section.settings.content_width }}px;
  "
>
  <div class="aged-garlic-story__why">
    <div class="aged-garlic-story__wrap">
      <header class="aged-garlic-story__header">
        <span class="aged-garlic-story__eyebrow">{{ section.settings.why_eyebrow }}</span>
        <h2>{{ section.settings.why_heading }}</h2>
        <div class="aged-garlic-story__lede rte">{{ section.settings.why_text }}</div>
      </header>

      <div class="aged-garlic-story__benefit-grid">
        <article class="aged-garlic-story__benefit">
          <span class="aged-garlic-story__icon">01</span>
          <h3>Odorless by Design</h3>
          <p>Made for people who want garlic supplementation without making strong garlic odor part of the routine.</p>
        </article>
        <article class="aged-garlic-story__benefit">
          <span class="aged-garlic-story__icon">02</span>
          <h3>Aged Garlic</h3>
          <p>Uses garlic that has gone through an aging or maturation process rather than ordinary raw garlic.</p>
        </article>
        <article class="aged-garlic-story__benefit">
          <span class="aged-garlic-story__icon">03</span>
          <h3>CoQ10 + Ubiquinol</h3>
          <p>A differentiated combination that brings aged garlic and the ubiquinol form of CoQ10 into one formula.</p>
        </article>
        <article class="aged-garlic-story__benefit">
          <span class="aged-garlic-story__icon">04</span>
          <h3>Easy Daily Routine</h3>
          <p>A softgel format built to fit into the wellness habits you already have—without mixing powders or preparing garlic.</p>
        </article>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__education">
    <div class="aged-garlic-story__wrap aged-garlic-story__split">
      <div class="aged-garlic-story__education-copy">
        <span class="aged-garlic-story__eyebrow">{{ section.settings.education_eyebrow }}</span>
        <h2>{{ section.settings.education_heading }}</h2>
        <div class="aged-garlic-story__lede rte">{{ section.settings.education_text }}</div>

        <div class="aged-garlic-story__compare-cards">
          <div class="aged-garlic-story__compare-card aged-garlic-story__compare-card--plain">
            <span>RAW GARLIC</span>
            <strong>Useful food. Not always a convenient supplement routine.</strong>
            <ul>
              <li>Strong aroma and flavor</li>
              <li>Requires food prep</li>
              <li>Not designed as a measured softgel routine</li>
            </ul>
          </div>
          <div class="aged-garlic-story__compare-card aged-garlic-story__compare-card--accent">
            <span>AGED GARLIC</span>
            <strong>A more convenient way to make garlic part of a daily supplement habit.</strong>
            <ul>
              <li>Odorless positioning</li>
              <li>Easy softgel format</li>
              <li>Paired with CoQ10 + ubiquinol</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="aged-garlic-story__visual">
        {% if section.settings.education_image != blank %}
          {{ section.settings.education_image | image_url: width: 1200 | image_tag: loading:'lazy', widths:'420,640,900,1200', class:'aged-garlic-story__image', alt:section.settings.education_image_alt }}
        {% else %}
          <div class="aged-garlic-story__placeholder">
            <div class="aged-garlic-story__placeholder-pack">
              <span>AVONENT HEALTH</span>
              <strong>AGED GARLIC</strong>
              <b>+ CoQ10</b>
              <small>ODORLESS SOFTGEL FORMULA</small>
            </div>
            <div class="aged-garlic-story__placeholder-copy">Upload your final Avonent garlic lifestyle image here when the packaging is ready.</div>
          </div>
        {% endif %}
        <div class="aged-garlic-story__visual-note">Premium DTC imagery goes here — not supplier photography.</div>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__formula">
    <div class="aged-garlic-story__wrap">
      <header class="aged-garlic-story__header">
        <span class="aged-garlic-story__eyebrow">{{ section.settings.formula_eyebrow }}</span>
        <h2>{{ section.settings.formula_heading }}</h2>
        <div class="aged-garlic-story__lede rte">{{ section.settings.formula_text }}</div>
      </header>

      <div class="aged-garlic-story__ingredient-grid">
        <article>
          <span class="aged-garlic-story__ingredient-number">01</span>
          <h3>Aged Garlic</h3>
          <p>The foundation of the formula: garlic that has gone through an aging or maturation process for a more convenient daily supplement format.</p>
        </article>
        <article>
          <span class="aged-garlic-story__ingredient-number">02</span>
          <h3>CoQ10</h3>
          <p>Coenzyme Q10 is a naturally occurring compound involved in normal cellular energy processes and is commonly included in daily wellness formulas.</p>
        </article>
        <article>
          <span class="aged-garlic-story__ingredient-number">03</span>
          <h3>Ubiquinol</h3>
          <p>Ubiquinol is a form of CoQ10 included to make the formula more differentiated than a basic garlic-only supplement.</p>
        </article>
      </div>

      {% if section.settings.facts_image != blank %}
        <div class="aged-garlic-story__facts">
          <div>
            <span>SUPPLEMENT FACTS</span>
            <h3>See exactly what is in your routine.</h3>
            <p>Review the serving size, ingredient quantities, other ingredients, and label directions before adding any supplement to your routine.</p>
          </div>
          {{ section.settings.facts_image | image_url: width: 900 | image_tag: loading:'lazy', widths:'360,540,720,900', class:'aged-garlic-story__facts-image', alt:'Supplement Facts for Avonent Aged Garlic + CoQ10' }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="aged-garlic-story__routine">
    <div class="aged-garlic-story__wrap">
      <div class="aged-garlic-story__routine-card">
        <div>
          <span class="aged-garlic-story__eyebrow">{{ section.settings.routine_eyebrow }}</span>
          <h2>{{ section.settings.routine_heading }}</h2>
          <p>{{ section.settings.routine_text }}</p>
        </div>
        <div class="aged-garlic-story__routine-steps">
          <div><b>1</b><span>Keep it somewhere you already visit every day.</span></div>
          <div><b>2</b><span>Follow the serving directions printed on the verified product label.</span></div>
          <div><b>3</b><span>Stay consistent instead of making your supplement routine complicated.</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__comparison">
    <div class="aged-garlic-story__wrap">
      <header class="aged-garlic-story__header">
        <span class="aged-garlic-story__eyebrow">{{ section.settings.compare_eyebrow }}</span>
        <h2>{{ section.settings.compare_heading }}</h2>
        <p class="aged-garlic-story__compare-note">We keep this comparison to objective format and formula differences—not vague “better quality” claims.</p>
      </header>

      <div class="aged-garlic-story__table" role="table" aria-label="Avonent compared with ordinary garlic supplements">
        <div class="aged-garlic-story__table-row aged-garlic-story__table-head" role="row">
          <div role="columnheader">What you get</div>
          <div role="columnheader">Avonent</div>
          <div role="columnheader">Basic garlic supplement</div>
        </div>
        <div class="aged-garlic-story__table-row" role="row"><div role="cell">Aged garlic format</div><div role="cell" class="yes">✓</div><div role="cell">Varies</div></div>
        <div class="aged-garlic-story__table-row" role="row"><div role="cell">Odorless positioning</div><div role="cell" class="yes">✓</div><div role="cell">Varies</div></div>
        <div class="aged-garlic-story__table-row" role="row"><div role="cell">CoQ10 included</div><div role="cell" class="yes">✓</div><div role="cell">Often not included</div></div>
        <div class="aged-garlic-story__table-row" role="row"><div role="cell">Ubiquinol included</div><div role="cell" class="yes">✓</div><div role="cell">Often not included</div></div>
        <div class="aged-garlic-story__table-row" role="row"><div role="cell">Softgel routine</div><div role="cell" class="yes">✓</div><div role="cell">Varies</div></div>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__offer">
    <div class="aged-garlic-story__wrap">
      <div class="aged-garlic-story__offer-card">
        <div>
          <span class="aged-garlic-story__eyebrow">KEEP IT SIMPLE</span>
          <h2>Choose the quantity that fits your routine.</h2>
          <p>No complicated BOGO math. Start with 1 bag, save more with 2, or get the lowest planned per-bag price with 3.</p>
        </div>
        <a class="aged-garlic-story__cta" href="#avonent-garlic-buy">CHOOSE YOUR QUANTITY</a>
        <small>30-Day Guarantee · Secure Checkout</small>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__guarantee">
    <div class="aged-garlic-story__wrap">
      <div class="aged-garlic-story__guarantee-inner">
        <div class="aged-garlic-story__seal">30<span>DAY</span></div>
        <div>
          <span class="aged-garlic-story__eyebrow">{{ section.settings.guarantee_eyebrow }}</span>
          <h2>{{ section.settings.guarantee_heading }}</h2>
          <div class="rte">{{ section.settings.guarantee_text }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__faq">
    <div class="aged-garlic-story__wrap aged-garlic-story__faq-wrap">
      <header>
        <span class="aged-garlic-story__eyebrow">QUESTIONS, ANSWERED</span>
        <h2>Before you add it to your routine.</h2>
      </header>
      <div class="aged-garlic-story__faq-list">
        <details><summary>What is aged garlic?<span>+</span></summary><p>Aged garlic is garlic that has gone through a maturation process before being used in a supplement. The exact Avonent aging process and duration should match the final supplier documentation.</p></details>
        <details><summary>Does it smell like normal garlic?<span>+</span></summary><p>This product is positioned as an odorless aged-garlic softgel. Individual experience can vary, and the final product label should be the source of truth.</p></details>
        <details><summary>How many softgels should I take?<span>+</span></summary><p>Follow the serving directions printed on the product label and do not exceed the suggested use.</p></details>
        <details><summary>How long does one bag last?<span>+</span></summary><p>How long one bag lasts depends on the serving directions shown on the product label.</p></details>
        <details><summary>Does this contain CoQ10 and ubiquinol?<span>+</span></summary><p>Yes. This formula is positioned around aged garlic with CoQ10 + ubiquinol. Refer to the product label for the exact amounts.</p></details>
        <details><summary>Where can I see the Supplement Facts?<span>+</span></summary><p>The Supplement Facts panel is shown on this page when available and is also printed on the product packaging.</p></details>
        <details><summary>Can I take it with medications?<span>+</span></summary><p>If you take medication, have a health condition, are pregnant or nursing, have a procedure planned, or have questions about supplementation, speak with a qualified healthcare professional before use.</p></details>
        <details><summary>What is the return policy?<span>+</span></summary><p>Avonent offers a 30-day satisfaction guarantee. Returns and refunds are handled according to the refund policy linked on the store.</p></details>
      </div>
    </div>
  </div>

  <div class="aged-garlic-story__disclaimer">
    <div class="aged-garlic-story__wrap">
      <p>* Dietary supplements are not intended to diagnose, treat, cure, or prevent disease. Read the product label and speak with a qualified healthcare professional if you have questions about adding a supplement to your routine.</p>
    </div>
  </div>

  <div class="aged-garlic-mobile-cta" data-aged-garlic-mobile-cta hidden>
    <div>
      <small>AVONENT AGED GARLIC</small>
      <strong>Choose your quantity</strong>
    </div>
    <a href="#avonent-garlic-buy">SHOP NOW</a>
  </div>

  <script>
    (() => {
      const bar = document.querySelector('[data-aged-garlic-mobile-cta]');
      const buy = document.getElementById('avonent-garlic-buy');
      if (!bar || !buy) return;

      let buyVisible = false;
      const update = () => {
        const shouldShow = window.innerWidth < 750 && window.scrollY > 520 && !buyVisible;
        bar.hidden = !shouldShow;
      };

      const observer = new IntersectionObserver((entries) => {
        buyVisible = entries.some((entry) => entry.isIntersecting);
        update();
      }, { threshold: 0.12 });

      observer.observe(buy);
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    })();
  </script>
</section>

{% stylesheet %}
  .aged-garlic-story { background:var(--ags-ivory); color:var(--ags-ink); overflow:hidden; }
  .aged-garlic-story * { box-sizing:border-box; }
  .aged-garlic-story__wrap { width:min(calc(100% - 36px),var(--ags-width)); margin:0 auto; }
  .aged-garlic-story__why,.aged-garlic-story__formula,.aged-garlic-story__comparison,.aged-garlic-story__faq { padding:82px 0; }
  .aged-garlic-story__education,.aged-garlic-story__routine,.aged-garlic-story__offer,.aged-garlic-story__guarantee { padding:72px 0; }
  .aged-garlic-story__header { max-width:760px; margin:0 auto 36px; text-align:center; }
  .aged-garlic-story__eyebrow { display:block; margin-bottom:10px; color:var(--ags-burgundy); font-size:11px; font-weight:850; letter-spacing:.14em; line-height:1.2; text-transform:uppercase; }
  .aged-garlic-story h2 { margin:0; color:var(--ags-ink); font-family:var(--font-heading--family); font-size:clamp(34px,4vw,52px); font-weight:760; letter-spacing:-.035em; line-height:1.02; }
  .aged-garlic-story h3 { margin:0; color:var(--ags-ink); font-size:18px; font-weight:760; line-height:1.2; }
  .aged-garlic-story p { color:var(--ags-muted); }
  .aged-garlic-story__lede { max-width:680px; margin:15px auto 0; color:var(--ags-muted); font-size:16px; line-height:1.65; }
  .aged-garlic-story__lede p { margin:0; }
  .aged-garlic-story__benefit-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:13px; }
  .aged-garlic-story__benefit { min-height:220px; padding:25px 22px; border:1px solid var(--ags-line); border-radius:18px; background:#fff; box-shadow:0 13px 38px rgb(57 35 40 / 5%); }
  .aged-garlic-story__benefit .aged-garlic-story__icon { display:grid; place-items:center; width:38px; height:38px; margin-bottom:34px; border-radius:50%; background:var(--ags-burgundy); color:#fff; font-size:11px; font-weight:850; }
  .aged-garlic-story__benefit p { margin:9px 0 0; font-size:13px; line-height:1.55; }
  .aged-garlic-story__education { background:var(--ags-cream); }
  .aged-garlic-story__split { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(340px,.95fr); align-items:center; gap:60px; }
  .aged-garlic-story__education-copy h2 { max-width:620px; }
  .aged-garlic-story__education-copy .aged-garlic-story__lede { margin-left:0; }
  .aged-garlic-story__compare-cards { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:28px; }
  .aged-garlic-story__compare-card { padding:21px; border-radius:16px; }
  .aged-garlic-story__compare-card--plain { border:1px solid var(--ags-line); background:#fff; }
  .aged-garlic-story__compare-card--accent { background:var(--ags-burgundy); color:#fff; }
  .aged-garlic-story__compare-card > span { display:block; margin-bottom:9px; font-size:10px; font-weight:850; letter-spacing:.12em; }
  .aged-garlic-story__compare-card strong { display:block; font-size:15px; line-height:1.35; }
  .aged-garlic-story__compare-card ul { margin:15px 0 0; padding-left:18px; font-size:12px; line-height:1.7; }
  .aged-garlic-story__compare-card--accent ul { color:#f9e9e9; }
  .aged-garlic-story__visual { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:520px; padding:34px; border-radius:28px; background:linear-gradient(145deg,#fff7ed,#ead7c4); overflow:hidden; }
  .aged-garlic-story__image { display:block; width:100%; height:auto; max-height:470px; object-fit:cover; border-radius:20px; }
  .aged-garlic-story__image--product { object-fit:contain; filter:drop-shadow(0 26px 24px rgb(70 35 40 / 15%)); }
  .aged-garlic-story__placeholder { display:grid; grid-template-columns:1fr; place-items:center; gap:18px; width:100%; min-height:390px; padding:34px; border:1px solid #ead8ca; border-radius:18px; color:#8b746c; text-align:center; background:linear-gradient(145deg,#fffaf4,#f1e1d5); }
  .aged-garlic-story__placeholder-pack { display:flex; flex-direction:column; justify-content:center; width:min(68%,250px); aspect-ratio:.74; padding:28px 20px; border:1px solid #e8d8cf; border-radius:18px; background:linear-gradient(180deg,#fff,#fff8f1); box-shadow:0 24px 40px rgb(75 25 39 / 13%); transform:rotate(-2deg); text-align:left; }
  .aged-garlic-story__placeholder-pack span { color:var(--ags-burgundy); font-size:9px; font-weight:850; letter-spacing:.13em; }
  .aged-garlic-story__placeholder-pack strong { margin-top:35px; color:var(--ags-burgundy-dark); font-size:32px; font-weight:850; line-height:.88; letter-spacing:-.04em; }
  .aged-garlic-story__placeholder-pack b { margin-top:7px; color:var(--ags-gold); font-size:18px; }
  .aged-garlic-story__placeholder-pack small { margin-top:28px; padding-top:10px; border-top:1px solid #ead8cf; color:#8c777d; font-size:7px; font-weight:800; letter-spacing:.11em; }
  .aged-garlic-story__placeholder-copy { max-width:320px; color:#8b746c; font-size:10px; line-height:1.4; }
  .aged-garlic-story__visual-note { margin-top:14px; color:#87706a; font-size:10px; font-weight:650; text-align:center; }
  .aged-garlic-story__ingredient-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .aged-garlic-story__ingredient-grid article { min-height:250px; padding:27px; border:1px solid var(--ags-line); border-radius:18px; background:#fff; }
  .aged-garlic-story__ingredient-number { display:inline-flex; margin-bottom:50px; color:var(--ags-burgundy); font-size:11px; font-weight:850; }
  .aged-garlic-story__ingredient-grid p { margin:11px 0 0; font-size:13px; line-height:1.6; }
  .aged-garlic-story__facts { display:grid; grid-template-columns:1fr minmax(300px,.72fr); align-items:center; gap:38px; margin-top:18px; padding:36px; border-radius:22px; background:var(--ags-burgundy-dark); color:#fff; }
  .aged-garlic-story__facts > div:first-child > span { color:#dfbd79; font-size:10px; font-weight:850; letter-spacing:.12em; }
  .aged-garlic-story__facts h3 { margin-top:8px; color:#fff; font-size:30px; }
  .aged-garlic-story__facts p { max-width:610px; color:#eadfe1; font-size:13px; line-height:1.65; }
  .aged-garlic-story__facts-image { width:100%; max-height:420px; object-fit:contain; border-radius:12px; background:#fff; }
  .aged-garlic-story__facts-placeholder { display:grid; place-items:center; min-height:290px; padding:30px; border:1px dashed rgb(255 255 255 / 45%); border-radius:14px; color:#fff; font-size:18px; font-weight:850; letter-spacing:.06em; text-align:center; }
  .aged-garlic-story__facts-placeholder small { display:block; margin-top:9px; color:#d8c5ca; font-size:11px; font-weight:600; letter-spacing:0; }
  .aged-garlic-story__routine { background:#fff; }
  .aged-garlic-story__routine-card { display:grid; grid-template-columns:.85fr 1.15fr; gap:60px; align-items:center; padding:44px; border:1px solid var(--ags-line); border-radius:24px; background:var(--ags-cream); }
  .aged-garlic-story__routine-card p { margin:15px 0 0; line-height:1.65; }
  .aged-garlic-story__routine-steps { display:grid; gap:9px; }
  .aged-garlic-story__routine-steps > div { display:grid; grid-template-columns:38px 1fr; align-items:center; gap:12px; padding:14px 16px; border-radius:13px; background:#fff; }
  .aged-garlic-story__routine-steps b { display:grid; place-items:center; width:32px; height:32px; border-radius:50%; background:var(--ags-burgundy); color:#fff; font-size:11px; }
  .aged-garlic-story__routine-steps span { color:var(--ags-ink); font-size:13px; font-weight:650; line-height:1.4; }
  .aged-garlic-story__comparison { background:var(--ags-ivory); }
  .aged-garlic-story__compare-note { margin:12px auto 0; color:var(--ags-muted); font-size:12px; }
  .aged-garlic-story__table { max-width:920px; margin:0 auto; overflow:hidden; border:1px solid var(--ags-line); border-radius:18px; background:#fff; }
  .aged-garlic-story__table-row { display:grid; grid-template-columns:1.5fr .7fr .9fr; align-items:center; min-height:58px; border-bottom:1px solid var(--ags-line); }
  .aged-garlic-story__table-row:last-child { border-bottom:0; }
  .aged-garlic-story__table-row > div { padding:14px 18px; color:var(--ags-muted); font-size:13px; text-align:center; }
  .aged-garlic-story__table-row > div:first-child { color:var(--ags-ink); font-weight:700; text-align:left; }
  .aged-garlic-story__table-head { background:var(--ags-burgundy-dark); }
  .aged-garlic-story__table-head > div,.aged-garlic-story__table-head > div:first-child { color:#fff; font-size:11px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; }
  .aged-garlic-story__table-row .yes { color:var(--ags-burgundy); font-size:20px; font-weight:900; }
  .aged-garlic-story__offer { background:var(--ags-burgundy); }
  .aged-garlic-story__offer-card { display:flex; align-items:center; justify-content:space-between; gap:26px; padding:34px 38px; border:1px solid rgb(255 255 255 / 18%); border-radius:22px; background:var(--ags-burgundy-dark); color:#fff; }
  .aged-garlic-story__offer-card h2 { max-width:650px; color:#fff; font-size:38px; }
  .aged-garlic-story__offer-card p { max-width:700px; margin:10px 0 0; color:#eadde0; font-size:13px; line-height:1.55; }
  .aged-garlic-story__offer-card .aged-garlic-story__eyebrow { color:#e7c98d; }
  .aged-garlic-story__cta { flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center; min-height:54px; padding:15px 24px; border-radius:12px; background:#fff; color:var(--ags-burgundy-dark); font-size:12px; font-weight:850; text-decoration:none; }
  .aged-garlic-story__offer-card > small { display:none; }
  .aged-garlic-story__guarantee { background:#fff; }
  .aged-garlic-story__guarantee-inner { display:grid; grid-template-columns:130px 1fr; align-items:center; gap:28px; max-width:880px; margin:0 auto; }
  .aged-garlic-story__seal { display:flex; flex-direction:column; align-items:center; justify-content:center; width:120px; height:120px; border:2px solid var(--ags-gold); border-radius:50%; color:var(--ags-burgundy); font-size:34px; font-weight:850; line-height:.85; }
  .aged-garlic-story__seal span { margin-top:8px; color:var(--ags-gold); font-size:10px; letter-spacing:.15em; }
  .aged-garlic-story__guarantee h2 { font-size:40px; }
  .aged-garlic-story__guarantee .rte { margin-top:11px; color:var(--ags-muted); font-size:14px; line-height:1.6; }
  .aged-garlic-story__faq { background:var(--ags-cream); }
  .aged-garlic-story__faq-wrap { display:grid; grid-template-columns:.65fr 1.35fr; gap:70px; }
  .aged-garlic-story__faq-wrap header { position:sticky; top:120px; align-self:start; }
  .aged-garlic-story__faq-list { display:grid; gap:9px; }
  .aged-garlic-story__faq-list details { border:1px solid var(--ags-line); border-radius:14px; background:#fff; overflow:hidden; }
  .aged-garlic-story__faq-list summary { display:flex; align-items:center; justify-content:space-between; gap:18px; padding:18px 20px; color:var(--ags-ink); font-size:14px; font-weight:730; cursor:pointer; list-style:none; }
  .aged-garlic-story__faq-list summary::-webkit-details-marker { display:none; }
  .aged-garlic-story__faq-list summary span { color:var(--ags-burgundy); font-size:19px; transition:transform .18s ease; }
  .aged-garlic-story__faq-list details[open] summary span { transform:rotate(45deg); }
  .aged-garlic-story__faq-list details p { margin:0; padding:0 20px 19px; font-size:13px; line-height:1.65; }
  .aged-garlic-story__disclaimer { padding:22px 0; border-top:1px solid var(--ags-line); background:#fff; }
  .aged-garlic-story__disclaimer p { max-width:900px; margin:0 auto; color:#82777a; font-size:10px; line-height:1.5; text-align:center; }
  .aged-garlic-mobile-cta { display:none; }
  @media screen and (max-width:899px) {
    .aged-garlic-story__benefit-grid { grid-template-columns:1fr 1fr; }
    .aged-garlic-story__split,.aged-garlic-story__routine-card,.aged-garlic-story__faq-wrap { grid-template-columns:1fr; gap:32px; }
    .aged-garlic-story__faq-wrap header { position:static; }
    .aged-garlic-story__ingredient-grid { grid-template-columns:1fr; }
    .aged-garlic-story__ingredient-grid article { min-height:0; }
    .aged-garlic-story__ingredient-number { margin-bottom:24px; }
    .aged-garlic-story__facts { grid-template-columns:1fr; }
    .aged-garlic-story__offer-card { flex-direction:column; align-items:flex-start; }
  }
  @media screen and (max-width:749px) {
    .aged-garlic-story__wrap { width:min(calc(100% - 28px),var(--ags-width)); }
    .aged-garlic-story__why,.aged-garlic-story__formula,.aged-garlic-story__comparison,.aged-garlic-story__faq { padding:56px 0; }
    .aged-garlic-story__education,.aged-garlic-story__routine,.aged-garlic-story__offer,.aged-garlic-story__guarantee { padding:48px 0; }
    .aged-garlic-story__header { margin-bottom:25px; text-align:left; }
    .aged-garlic-story h2 { font-size:36px; }
    .aged-garlic-story__lede { margin-left:0; font-size:14px; }
    .aged-garlic-story__benefit-grid { grid-template-columns:1fr 1fr; gap:8px; }
    .aged-garlic-story__benefit { min-height:190px; padding:18px 15px; border-radius:14px; }
    .aged-garlic-story__benefit .aged-garlic-story__icon { width:32px; height:32px; margin-bottom:25px; }
    .aged-garlic-story__benefit h3 { font-size:15px; }
    .aged-garlic-story__benefit p { font-size:11.5px; }
    .aged-garlic-story__compare-cards { grid-template-columns:1fr; }
    .aged-garlic-story__visual { min-height:390px; padding:22px; border-radius:20px; }
    .aged-garlic-story__facts { padding:24px 20px; }
    .aged-garlic-story__facts h3 { font-size:25px; }
    .aged-garlic-story__routine-card { padding:24px 18px; }
    .aged-garlic-story__table { overflow-x:auto; }
    .aged-garlic-story__table-row { min-width:650px; }
    .aged-garlic-story__offer-card { padding:28px 22px; }
    .aged-garlic-story__offer-card h2 { font-size:31px; }
    .aged-garlic-story__cta { width:100%; }
    .aged-garlic-story__offer-card > small { display:block; width:100%; color:#d9c9cd; font-size:10px; text-align:center; }
    .aged-garlic-story__guarantee-inner { grid-template-columns:84px 1fr; gap:17px; }
    .aged-garlic-story__seal { width:78px; height:78px; font-size:23px; }
    .aged-garlic-story__seal span { margin-top:5px; font-size:8px; }
    .aged-garlic-story__guarantee h2 { font-size:30px; }
    .aged-garlic-story__faq-list summary { padding:16px; font-size:13px; }
    .aged-garlic-story__faq-list details p { padding:0 16px 17px; font-size:12.5px; }
    .aged-garlic-mobile-cta:not([hidden]) {
      position:fixed; left:12px; right:12px; bottom:12px; z-index:50; display:flex;
      align-items:center; justify-content:space-between; gap:12px; padding:10px 10px 10px 14px;
      border:1px solid rgb(255 255 255 / 18%); border-radius:16px; background:rgb(60 13 25 / 96%);
      box-shadow:0 16px 44px rgb(37 9 16 / 28%); backdrop-filter:blur(14px); color:#fff;
    }
    .aged-garlic-mobile-cta div { display:flex; flex-direction:column; min-width:0; }
    .aged-garlic-mobile-cta small { color:#dfbd79; font-size:8px; font-weight:850; letter-spacing:.1em; line-height:1.2; }
    .aged-garlic-mobile-cta strong { margin-top:3px; color:#fff; font-size:12px; line-height:1.2; }
    .aged-garlic-mobile-cta a {
      flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:10px 16px;
      border-radius:10px; background:#fff; color:#3C0D19; font-size:10px; font-weight:900; text-decoration:none;
    }
  }
{% endstylesheet %}


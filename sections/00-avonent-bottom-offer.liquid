{% liquid
  assign av_product = closest.product | default: product
  assign selected_variant = av_product.selected_or_first_available_variant
  assign section_anchor = section.settings.anchor_id | default: 'avonent-bottom-offer' | handle
  assign product_form_id = 'AvonentBottomOfferForm-' | append: section.id
  assign selected_bundle = section.settings.default_bundle | default: '2'
  assign default_quantity_key = 'bundle_' | append: selected_bundle | append: '_quantity'
  assign default_quantity = section.settings[default_quantity_key] | default: 1
  assign offer_image = section.settings.image | default: av_product.featured_image

  assign default_total = selected_variant.price | times: default_quantity
  assign default_compare_unit = selected_variant.compare_at_price
  if default_compare_unit == blank or default_compare_unit <= selected_variant.price
    assign default_compare_unit = selected_variant.price
  endif
  assign default_compare_total = default_compare_unit | times: default_quantity
  assign default_savings = default_compare_total | minus: default_total

  assign can_add_to_cart = false
  assign add_to_cart_text = 'Add to cart'
  if selected_variant != blank and selected_variant.available
    assign can_add_to_cart = true
  elsif selected_variant != blank
    assign add_to_cart_text = 'Sold out'
  else
    assign add_to_cart_text = 'Unavailable'
  endif
%}

{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<section
  id="{{ section_anchor }}"
  class="avonent-bottom-offer"
  data-avonent-bottom-offer
  data-section-id="{{ section.id }}"
  style="
    --abo-bg: {{ section.settings.background_color }};
    --abo-card: {{ section.settings.card_color }};
    --abo-soft: {{ section.settings.soft_color }};
    --abo-text: {{ section.settings.text_color }};
    --abo-muted: {{ section.settings.muted_text_color }};
    --abo-accent: {{ section.settings.accent_color }};
    --abo-accent-dark: {{ section.settings.accent_dark_color }};
    --abo-border: {{ section.settings.border_color }};
    --abo-button: {{ section.settings.button_color }};
    --abo-button-text: {{ section.settings.button_text_color }};
    --abo-radius: {{ section.settings.corner_radius }}px;
    --abo-width: {{ section.settings.content_width }}px;
    --abo-top: {{ section.settings.padding_top }}px;
    --abo-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="avonent-bottom-offer__inner">
    <header class="avonent-bottom-offer__header">
      {% if section.settings.eyebrow != blank %}
        <p class="avonent-bottom-offer__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="avonent-bottom-offer__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="avonent-bottom-offer__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="avonent-bottom-offer__layout">
      <div class="avonent-bottom-offer__purchase">
        {% if av_product != blank %}
          {% if section.settings.show_stock_meter %}
            <div class="avonent-bottom-offer__stock">
              <span class="avonent-bottom-offer__stock-track" aria-hidden="true">
                <span style="width: {{ section.settings.sold_percent }}%"></span>
              </span>
              <strong>{{ section.settings.sold_percent }}% {{ section.settings.sold_text }}</strong>
            </div>
          {% endif %}

          <div class="avonent-bottom-offer__offer-row">
            <strong class="avonent-bottom-offer__offer-label">{{ section.settings.purchase_label }}</strong>
            <div class="avonent-bottom-offer__offer-pricing">
              <div class="avonent-bottom-offer__offer-numbers">
                <strong data-abo-offer-price>{{ default_total | money }}</strong>
                <s data-abo-offer-compare{% unless default_compare_total > default_total %} hidden{% endunless %}>
                  {% if default_compare_total > default_total %}{{ default_compare_total | money }}{% endif %}
                </s>
              </div>
              {% if section.settings.sale_name != blank %}
                <span class="avonent-bottom-offer__offer-badge">
                  {{ section.settings.sale_name }}
                  <span data-abo-offer-savings{% unless default_savings > 0 %} hidden{% endunless %}>
                    {% if default_savings > 0 %} · Save {{ default_savings | money }}{% endif %}
                  </span>
                </span>
              {% endif %}
            </div>
          </div>

          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ av_product.id }}"
            data-product-url="{{ av_product.url }}"
            data-quantity-default="{{ default_quantity }}"
            on:submit="/handleSubmit"
          >
            <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>

            {% form 'product', av_product, id: product_form_id, data-type: 'add-to-cart-form' %}
              <input
                type="hidden"
                name="id"
                ref="variantId"
                value="{{ selected_variant.id }}"
                data-abo-variant-input
              >
              <input
                type="hidden"
                name="quantity"
                value="{{ default_quantity }}"
                data-abo-quantity-input
              >

              <fieldset class="avonent-bottom-offer__bundles">
                <legend>{{ section.settings.bundle_legend }}</legend>

                {% for i in (1..3) %}
                  {% liquid
                    assign enabled_key = 'bundle_' | append: i | append: '_enabled'
                    assign title_key = 'bundle_' | append: i | append: '_title'
                    assign subtitle_key = 'bundle_' | append: i | append: '_subtitle'
                    assign quantity_key = 'bundle_' | append: i | append: '_quantity'
                    assign badge_key = 'bundle_' | append: i | append: '_badge'
                    assign savings_key = 'bundle_' | append: i | append: '_savings'

                    assign bundle_enabled = section.settings[enabled_key]
                    assign bundle_title = section.settings[title_key]
                    assign bundle_subtitle = section.settings[subtitle_key]
                    assign bundle_quantity = section.settings[quantity_key] | default: i
                    assign bundle_badge = section.settings[badge_key]
                    assign bundle_savings = section.settings[savings_key]
                    assign bundle_total = selected_variant.price | times: bundle_quantity

                    assign compare_unit = selected_variant.compare_at_price
                    if compare_unit == blank or compare_unit <= selected_variant.price
                      assign compare_unit = selected_variant.price
                    endif
                    assign compare_total = compare_unit | times: bundle_quantity
                    assign savings_total = compare_total | minus: bundle_total

                    assign i_string = i | append: ''
                    assign is_selected = false
                    if i_string == selected_bundle
                      assign is_selected = true
                    endif
                  %}

                  {% if bundle_enabled %}
                    <label class="avonent-bottom-offer__bundle{% if is_selected %} is-selected{% endif %}">
                      <input
                        type="radio"
                        name="avonent_bundle_{{ section.id }}"
                        value="{{ bundle_quantity }}"
                        {% if is_selected %}checked{% endif %}
                        data-abo-bundle
                        data-quantity="{{ bundle_quantity }}"
                        data-price="{{ bundle_total | money | escape }}"
                        data-compare-price="{% if compare_total > bundle_total %}{{ compare_total | money | escape }}{% endif %}"
                        data-savings-price="{% if savings_total > 0 %}{{ savings_total | money | escape }}{% endif %}"
                      >

                      {% if bundle_badge != blank %}
                        <span class="avonent-bottom-offer__bundle-badge">{{ bundle_badge }}</span>
                      {% endif %}

                      <span class="avonent-bottom-offer__bundle-radio" aria-hidden="true"><span></span></span>

                      {% if section.settings.show_bundle_images and offer_image != blank %}
                        <span class="avonent-bottom-offer__bundle-image">
                          {{
                            offer_image
                            | image_url: width: 150
                            | image_tag:
                              loading: 'lazy',
                              widths: '75, 110, 150',
                              sizes: '58px',
                              alt: bundle_title
                          }}
                          {% if bundle_quantity > 1 %}
                            <span class="avonent-bottom-offer__quantity-bubble">×{{ bundle_quantity }}</span>
                          {% endif %}
                        </span>
                      {% endif %}

                      <span class="avonent-bottom-offer__bundle-copy">
                        <strong>{{ bundle_title }}</strong>
                        {% if bundle_subtitle != blank %}<small>{{ bundle_subtitle }}</small>{% endif %}
                        {% if bundle_savings != blank %}<em>{{ bundle_savings }}</em>{% endif %}
                      </span>

                      <span class="avonent-bottom-offer__bundle-price">
                        <strong>{{ bundle_total | money }}</strong>
                        {% if compare_total > bundle_total %}<s>{{ compare_total | money }}</s>{% endif %}
                      </span>
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>

              {% if section.settings.delivery_text != blank or section.settings.shipping_text != blank %}
                <div class="avonent-bottom-offer__delivery">
                  <span class="avonent-bottom-offer__delivery-dot" aria-hidden="true"></span>
                  <span>
                    {% if section.settings.delivery_text != blank %}{{ section.settings.delivery_text }}{% endif %}
                    {% if section.settings.delivery_text != blank and section.settings.shipping_text != blank %}<span aria-hidden="true"> · </span>{% endif %}
                    {% if section.settings.shipping_text != blank %}<strong>{{ section.settings.shipping_text }}</strong>{% endif %}
                  </span>
                </div>
              {% endif %}

              <div class="avonent-bottom-offer__submit-wrap">
                {% render 'add-to-cart-button',
                  id: 'AvonentBottomOfferSubmit-' | append: section.id,
                  class: 'avonent-bottom-offer__submit add-to-cart-button',
                  can_add_to_cart: can_add_to_cart,
                  show_icon: true,
                  product: av_product,
                  add_to_cart_text: add_to_cart_text,
                  data_testid: 'avonent-bottom-offer-add-to-cart'
                %}

                <span class="avonent-bottom-offer__submit-price" aria-hidden="true">
                  <span data-abo-button-price>
                    {{ selected_variant.price | times: default_quantity | money }}
                  </span>
                  <s data-abo-button-compare{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}>
                    {% if selected_variant.compare_at_price > selected_variant.price %}
                      {{ selected_variant.compare_at_price | times: default_quantity | money }}
                    {% endif %}
                  </s>
                </span>
              </div>
            {% endform %}
          </product-form-component>

          {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
            <div class="avonent-bottom-offer__payments" aria-label="Accepted payment methods">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'avonent-bottom-offer__payment-icon' }}
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.guarantee_text != blank %}
            <div class="avonent-bottom-offer__guarantee">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none">
                <path d="M12 3 19 6v5c0 4.65-2.98 8.63-7 10-4.02-1.37-7-5.35-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ section.settings.guarantee_text }}</span>
            </div>
          {% endif %}
        {% else %}
          <div class="avonent-bottom-offer__empty">Select a product to preview this purchase section.</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const initBottomOffer = (root) => {
      if (!root || root.dataset.aboInitialized === 'true') return;
      root.dataset.aboInitialized = 'true';

      const quantityInput = root.querySelector('[data-abo-quantity-input]');
      const bundleInputs = Array.from(root.querySelectorAll('[data-abo-bundle]'));
      const buttonPrice = root.querySelector('[data-abo-button-price]');
      const buttonCompare = root.querySelector('[data-abo-button-compare]');
      const offerPrice = root.querySelector('[data-abo-offer-price]');
      const offerCompare = root.querySelector('[data-abo-offer-compare]');
      const offerSavings = root.querySelector('[data-abo-offer-savings]');

      const selectBundle = (input) => {
        if (!input) return;
        bundleInputs.forEach((candidate) => {
          candidate.closest('.avonent-bottom-offer__bundle')?.classList.toggle('is-selected', candidate === input);
        });

        if (quantityInput) {
          quantityInput.value = input.dataset.quantity || '1';
          quantityInput.setAttribute('value', quantityInput.value);
          quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (buttonPrice) buttonPrice.textContent = input.dataset.price || '';
        if (buttonCompare) {
          buttonCompare.textContent = input.dataset.comparePrice || '';
          buttonCompare.hidden = !input.dataset.comparePrice;
        }
        if (offerPrice) offerPrice.textContent = input.dataset.price || '';
        if (offerCompare) {
          offerCompare.textContent = input.dataset.comparePrice || '';
          offerCompare.hidden = !input.dataset.comparePrice;
        }
        if (offerSavings) {
          offerSavings.textContent = input.dataset.savingsPrice ? ` · Save ${input.dataset.savingsPrice}` : '';
          offerSavings.hidden = !input.dataset.savingsPrice;
        }
      };

      bundleInputs.forEach((input) => input.addEventListener('change', () => selectBundle(input)));
      selectBundle(bundleInputs.find((input) => input.checked) || bundleInputs[0]);
    };

    const initScrollLinks = () => {
      const target = document.getElementById('{{ section_anchor }}');
      if (!target) return;
      document.querySelectorAll('a[href="#{{ section_anchor }}"]').forEach((link) => {
        if (link.dataset.aboScrollInitialized === 'true') return;
        link.dataset.aboScrollInitialized = 'true';
        link.addEventListener('click', (event) => {
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (history.replaceState) history.replaceState(null, '', '#{{ section_anchor }}');
        });
      });
    };

    const init = () => {
      document.querySelectorAll('[data-avonent-bottom-offer]').forEach(initBottomOffer);
      initScrollLinks();
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>

{% stylesheet %}
  .avonent-bottom-offer {
    scroll-margin-top: calc(var(--header-height, 76px) + 20px);
    padding: var(--abo-top) 0 var(--abo-bottom);
    background:
      radial-gradient(circle at 8% 10%, color-mix(in srgb, var(--abo-accent) 11%, transparent), transparent 28rem),
      var(--abo-bg);
    color: var(--abo-text);
  }

  .avonent-bottom-offer__inner {
    width: min(calc(100% - 40px), var(--abo-width));
    margin: 0 auto;
  }

  .avonent-bottom-offer__header {
    width: min(100%, 760px);
    margin: 0 auto 36px;
    text-align: center;
  }

  .avonent-bottom-offer__eyebrow {
    display: block;
    margin: 0 0 8px;
    color: var(--abo-accent-dark);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .avonent-bottom-offer__heading {
    margin: 0;
    color: var(--abo-text);
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 820;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .avonent-bottom-offer__description {
    margin: 15px auto 0;
    color: var(--abo-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .avonent-bottom-offer__description p { margin: 0; }

  .avonent-bottom-offer__layout {
    width: min(100%, 960px);
    margin: 0 auto;
  }

  .avonent-bottom-offer__purchase {
    min-width: 0;
    padding: clamp(22px, 3.4vw, 38px);
    background: color-mix(in srgb, var(--abo-bg) 64%, white);
    border: 0;
    border-radius: calc(var(--abo-radius) + 4px);
    box-shadow: none;
  }

  .avonent-bottom-offer__bundle-badge {
    color: #fff;
    background: var(--abo-accent-dark);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
  }

  .avonent-bottom-offer__stock {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
    margin: 0 0 26px;
    padding: 22px clamp(18px, 4vw, 34px);
    background: var(--abo-card);
    border: 1px solid color-mix(in srgb, var(--abo-border) 78%, white);
    border-radius: var(--abo-radius);
    box-shadow: 0 12px 34px rgb(20 53 61 / 0.08);
  }

  .avonent-bottom-offer__stock-track {
    display: block;
    height: 8px;
    overflow: hidden;
    background: #e2edf0;
    border-radius: 999px;
  }

  .avonent-bottom-offer__stock-track span {
    display: block;
    height: 100%;
    background: var(--abo-accent);
    border-radius: inherit;
    box-shadow: 0 0 16px color-mix(in srgb, var(--abo-accent) 55%, transparent);
  }

  .avonent-bottom-offer__stock strong {
    color: var(--abo-accent-dark);
    font-size: 15px;
    white-space: nowrap;
  }

  .avonent-bottom-offer__offer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
    padding: 23px 0;
    border-top: 1px solid var(--abo-border);
    border-bottom: 1px solid var(--abo-border);
  }

  .avonent-bottom-offer__offer-label {
    color: var(--abo-accent-dark);
    font-size: clamp(16px, 2vw, 21px);
    font-weight: 800;
    line-height: 1.2;
  }

  .avonent-bottom-offer__offer-pricing {
    display: grid;
    justify-items: end;
    gap: 8px;
  }

  .avonent-bottom-offer__offer-numbers {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 10px;
  }

  .avonent-bottom-offer__offer-numbers strong {
    color: var(--abo-accent-dark);
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1;
  }

  .avonent-bottom-offer__offer-numbers s {
    color: var(--abo-muted);
    font-size: 15px;
  }

  .avonent-bottom-offer__offer-badge {
    display: inline-flex;
    padding: 7px 10px;
    color: #fff;
    background: var(--abo-accent-dark);
    border-radius: 8px;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
  }

  .avonent-bottom-offer__bundles {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .avonent-bottom-offer__bundles legend {
    margin-bottom: 10px;
    color: var(--abo-text);
    font-size: 13px;
    font-weight: 760;
  }

  .avonent-bottom-offer__bundle {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 82px;
    padding: 13px 14px;
    cursor: pointer;
    background: #fff;
    border: 1.5px solid var(--abo-border);
    border-radius: var(--abo-radius);
    transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .avonent-bottom-offer__bundle:has(input:focus-visible) {
    outline: 2px solid var(--abo-accent);
    outline-offset: 2px;
  }

  .avonent-bottom-offer__bundle.is-selected {
    background: var(--abo-soft);
    border-color: var(--abo-accent);
    box-shadow: 0 9px 26px rgb(2 198 234 / 0.10);
  }

  .avonent-bottom-offer__bundle > input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .avonent-bottom-offer__bundle-radio {
    display: grid;
    width: 19px;
    height: 19px;
    place-items: center;
    border: 1.5px solid #acbbc0;
    border-radius: 50%;
  }

  .avonent-bottom-offer__bundle-radio span {
    width: 9px;
    height: 9px;
    background: transparent;
    border-radius: 50%;
  }

  .avonent-bottom-offer__bundle.is-selected .avonent-bottom-offer__bundle-radio { border-color: var(--abo-accent); }
  .avonent-bottom-offer__bundle.is-selected .avonent-bottom-offer__bundle-radio span { background: var(--abo-accent); }

  .avonent-bottom-offer__bundle-image {
    position: relative;
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    padding: 3px;
    background: #fff;
    border-radius: 10px;
  }

  .avonent-bottom-offer__bundle-image img { width: 100%; height: 100%; object-fit: contain; }

  .avonent-bottom-offer__quantity-bubble {
    position: absolute;
    right: -5px;
    bottom: -5px;
    display: grid;
    min-width: 20px;
    height: 20px;
    place-items: center;
    padding: 0 4px;
    color: #fff;
    background: var(--abo-accent-dark);
    border: 2px solid #fff;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
  }

  .avonent-bottom-offer__bundle-copy { min-width: 0; }
  .avonent-bottom-offer__bundle-copy strong,
  .avonent-bottom-offer__bundle-copy small,
  .avonent-bottom-offer__bundle-copy em { display: block; }
  .avonent-bottom-offer__bundle-copy strong { color: var(--abo-text); font-size: 14px; line-height: 1.25; }
  .avonent-bottom-offer__bundle-copy small { margin-top: 3px; color: var(--abo-muted); font-size: 11px; line-height: 1.25; }
  .avonent-bottom-offer__bundle-copy em { margin-top: 4px; color: var(--abo-accent-dark); font-size: 10px; font-style: normal; font-weight: 760; }

  .avonent-bottom-offer__bundle-price { text-align: right; }
  .avonent-bottom-offer__bundle-price strong,
  .avonent-bottom-offer__bundle-price s { display: block; white-space: nowrap; }
  .avonent-bottom-offer__bundle-price strong { color: var(--abo-text); font-size: 14px; }
  .avonent-bottom-offer__bundle-price s { margin-top: 3px; color: var(--abo-muted); font-size: 10px; }

  .avonent-bottom-offer__bundle-badge {
    position: absolute;
    top: -9px;
    right: 12px;
    padding: 4px 9px;
    border-radius: 999px;
  }

  .avonent-bottom-offer__delivery {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
    padding: 12px 8px;
    color: var(--abo-muted);
    border-top: 1px dashed var(--abo-border);
    border-bottom: 1px dashed var(--abo-border);
    font-size: 12px;
    line-height: 1.35;
    text-align: center;
  }

  .avonent-bottom-offer__delivery strong { color: var(--abo-accent-dark); }
  .avonent-bottom-offer__delivery-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    background: var(--abo-accent);
    border: 2px solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--abo-accent) 28%, transparent);
  }

  .avonent-bottom-offer__submit-wrap {
    position: relative;
    margin-top: 16px;
  }

  .avonent-bottom-offer__submit.add-to-cart-button {
    width: 100%;
    min-height: 58px;
    justify-content: flex-start;
    padding: 14px 154px 14px 22px;
    color: var(--abo-button-text);
    background: var(--abo-button);
    border: 1px solid var(--abo-button);
    border-radius: var(--abo-radius);
    font-size: 15px;
    font-weight: 800;
  }

  .avonent-bottom-offer__submit-price {
    position: absolute;
    top: 50%;
    right: 19px;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--abo-button-text);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .avonent-bottom-offer__submit-price span { font-size: 15px; font-weight: 800; }
  .avonent-bottom-offer__submit-price s { font-size: 10px; opacity: 0.66; }

  .avonent-bottom-offer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px;
    margin-top: 13px;
  }

  .avonent-bottom-offer__payment-icon { width: auto; height: 22px; }

  .avonent-bottom-offer__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 13px;
    color: var(--abo-muted);
    font-size: 11px;
    font-weight: 650;
  }

  .avonent-bottom-offer__guarantee svg { color: var(--abo-accent); flex: 0 0 auto; }
  .avonent-bottom-offer__empty { padding: 36px; color: var(--abo-muted); text-align: center; }

  @media screen and (max-width: 989px) {
    .avonent-bottom-offer__layout { width: min(100%, 760px); }
  }

  @media screen and (max-width: 749px) {
    .avonent-bottom-offer {
      scroll-margin-top: calc(var(--header-height, 64px) + 12px);
    }

    .avonent-bottom-offer__inner { width: min(calc(100% - 28px), var(--abo-width)); }
    .avonent-bottom-offer__header { margin-bottom: 25px; text-align: left; }
    .avonent-bottom-offer__heading { font-size: 34px; }
    .avonent-bottom-offer__description { margin-top: 11px; font-size: 14px; }
    .avonent-bottom-offer__purchase { padding: 18px 14px; border-radius: var(--abo-radius); }
    .avonent-bottom-offer__stock { gap: 12px; margin-bottom: 20px; padding: 18px 16px; }
    .avonent-bottom-offer__stock strong { font-size: 14px; }
    .avonent-bottom-offer__offer-row { gap: 14px; margin-bottom: 22px; padding: 19px 0; }
    .avonent-bottom-offer__offer-label { font-size: 16px; }
    .avonent-bottom-offer__offer-numbers strong { font-size: 21px; }
    .avonent-bottom-offer__offer-numbers s { font-size: 12px; }
    .avonent-bottom-offer__offer-badge { font-size: 9px; }
    .avonent-bottom-offer__bundle { grid-template-columns: auto auto minmax(0, 1fr) auto; gap: 9px; min-height: 76px; padding: 12px 10px; }
    .avonent-bottom-offer__bundle-image { width: 48px; height: 48px; }
    .avonent-bottom-offer__bundle-copy strong { font-size: 13px; }
    .avonent-bottom-offer__bundle-copy small { font-size: 10px; }
    .avonent-bottom-offer__bundle-price strong { font-size: 13px; }
    .avonent-bottom-offer__submit.add-to-cart-button { padding-right: 132px; padding-left: 17px; }
    .avonent-bottom-offer__submit-price { right: 15px; }
  }

  @media screen and (max-width: 390px) {
    .avonent-bottom-offer__bundle-image { display: none; }
    .avonent-bottom-offer__bundle { grid-template-columns: auto minmax(0, 1fr) auto; }
    .avonent-bottom-offer__submit.add-to-cart-button { justify-content: center; padding-right: 16px; }
    .avonent-bottom-offer__submit-price { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    html:has(.avonent-bottom-offer) { scroll-behavior: auto; }
  }
{% endstylesheet %}


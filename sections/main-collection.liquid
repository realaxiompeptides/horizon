{% liquid
  assign visible_products_count = 0
  for catalog_product in collection.products
    assign catalog_title = catalog_product.title | strip | downcase
    assign catalog_handle = catalog_product.handle | strip | downcase
    unless catalog_title == 'shipping protection' or catalog_handle == 'shipping-protection' or catalog_handle contains 'shipping-protection'
      assign visible_products_count = visible_products_count | plus: 1
    endunless
  endfor
%}

<section id="avonent-catalog-{{ section.id }}" class="avonent-catalog">
  <div class="avonent-catalog__inner">
    <header class="avonent-catalog__header">
      <div>
        <span class="avonent-catalog__eyebrow">THE COLLECTION</span>
        <h1>Find your daily routine.</h1>
        <p>Premium Avonent wellness formulas made simple.</p>
      </div>

      <span class="avonent-catalog__count">
        {{ visible_products_count }}
        {% if visible_products_count == 1 %}product{% else %}products{% endif %}
      </span>
    </header>

    {% paginate collection.products by 24 %}
      <ul class="avonent-catalog__grid" role="list">
        {% for product in collection.products %}
          {% liquid
            assign product_title_downcase = product.title | strip | downcase
            assign product_handle_downcase = product.handle | strip | downcase
            assign hide_product = false

            if product_title_downcase == 'shipping protection'
              assign hide_product = true
            elsif product_handle_downcase == 'shipping-protection' or product_handle_downcase contains 'shipping-protection'
              assign hide_product = true
            endif
          %}

          {% unless hide_product %}
            <li class="avonent-card-wrap">
              <article class="avonent-card">
                <a
                  class="avonent-card__media"
                  href="{{ product.url }}"
                  aria-label="View {{ product.title | escape }}"
                >
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 990px) 340px, (min-width: 750px) 42vw, 92vw',
                        class: 'avonent-card__image',
                        alt: product.title
                    }}
                  {% else %}
                    <div class="avonent-card__placeholder">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if product.compare_at_price_max > product.price %}
                    <span class="avonent-card__sale">SALE</span>
                  {% endif %}
                </a>

                <div class="avonent-card__body">
                  <div class="avonent-card__micro-row">
                    <span>AVONENT</span>
                    <span class="avonent-card__quality">
                      <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <path d="m4.5 9.2 2.6 2.6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Quality tested
                    </span>
                  </div>

                  <h2 class="avonent-card__title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h2>

                  <div class="avonent-card__purchase">
                    <div class="avonent-card__price">
                      <span class="avonent-card__price-current">{{ product.price | money }}</span>
                      {% if product.compare_at_price_max > product.price %}
                        <s>{{ product.compare_at_price_max | money }}</s>
                      {% endif %}
                    </div>

                    {% if product.available %}
                      <span class="avonent-card__stock"><span></span> In stock</span>
                    {% else %}
                      <span class="avonent-card__stock avonent-card__stock--out">Sold out</span>
                    {% endif %}
                  </div>

                  <a href="{{ product.url }}" class="avonent-card__button">
                    View product
                    <span aria-hidden="true">→</span>
                  </a>

                  <div class="avonent-card__assurance">
                    <span>30-day guarantee</span>
                    <span aria-hidden="true">•</span>
                    <span>Ships from USA</span>
                  </div>
                </div>
              </article>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>

      {% if paginate.pages > 1 %}
        <div class="avonent-catalog__pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
  #avonent-catalog-{{ section.id }} {
    --av-blue: #02c6ea;
    --av-blue-dark: #1996b5;
    --av-ink: #071114;
    --av-muted: #65757b;
    --av-border: #d8eaee;
    position: relative;
    min-height: 55vh;
    padding: 52px 20px 72px;
    background:
      radial-gradient(circle at 8% 0%, rgba(2, 198, 234, .08), transparent 24rem),
      #f7fcfd;
    color: var(--av-ink);
  }

  #avonent-catalog-{{ section.id }} * {
    box-sizing: border-box;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__inner {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 30px;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__eyebrow {
    display: block;
    margin-bottom: 8px;
    color: var(--av-blue-dark);
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: .15em;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__header h1 {
    margin: 0;
    color: var(--av-ink);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -.045em;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__header p {
    margin: 10px 0 0;
    color: var(--av-muted);
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.5;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__count {
    flex: 0 0 auto;
    margin-bottom: 5px;
    color: #829096;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 650;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 340px));
    justify-content: start;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #avonent-catalog-{{ section.id }} .avonent-card-wrap {
    min-width: 0;
  }

  #avonent-catalog-{{ section.id }} .avonent-card {
    overflow: hidden;
    border: 1px solid var(--av-border);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 12px 34px rgba(7, 58, 69, .065);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }

  #avonent-catalog-{{ section.id }} .avonent-card:hover {
    transform: translateY(-3px);
    border-color: rgba(2, 198, 234, .58);
    box-shadow: 0 18px 42px rgba(7, 95, 113, .11);
  }

  #avonent-catalog-{{ section.id }} .avonent-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #eaf8fc;
    text-decoration: none;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .28s ease;
  }

  #avonent-catalog-{{ section.id }} .avonent-card:hover .avonent-card__image {
    transform: scale(1.02);
  }

  #avonent-catalog-{{ section.id }} .avonent-card__placeholder,
  #avonent-catalog-{{ section.id }} .avonent-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__sale {
    position: absolute;
    top: 13px;
    right: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 29px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--av-blue);
    color: #00313a;
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .06em;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__body {
    padding: 17px 18px 16px;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__micro-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 7px;
    color: #849196;
    font-family: var(--font-body--family);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__quality {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #27849a;
    letter-spacing: 0;
    text-transform: none;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__quality svg {
    width: 14px;
    height: 14px;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__title {
    margin: 0;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: 20px;
    font-weight: 780;
    line-height: 1.18;
    letter-spacing: -.028em;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__title a {
    color: var(--av-ink);
    text-decoration: none;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__purchase {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__price-current {
    color: var(--av-ink);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: 19px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.025em;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__price s {
    color: #8b989d;
    font-family: var(--font-body--family);
    font-size: 12px;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__stock {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #4c757f;
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__stock > span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--av-blue);
    box-shadow: 0 0 0 3px rgba(2, 198, 234, .12);
  }

  #avonent-catalog-{{ section.id }} .avonent-card__stock--out {
    color: #8b989d;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    min-height: 45px;
    margin-top: 12px;
    padding: 12px 15px;
    border-radius: 12px;
    background: var(--av-ink);
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 780;
    line-height: 1;
    text-decoration: none;
    transition: background .18s ease, transform .18s ease;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__button:hover {
    background: var(--av-blue-dark);
    transform: translateY(-1px);
  }

  #avonent-catalog-{{ section.id }} .avonent-card__button span {
    font-size: 17px;
  }

  #avonent-catalog-{{ section.id }} .avonent-card__assurance {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    color: #849196;
    font-family: var(--font-body--family);
    font-size: 9.5px;
    font-weight: 650;
  }

  #avonent-catalog-{{ section.id }} .avonent-catalog__pagination {
    margin-top: 34px;
    font-family: var(--font-body--family);
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #avonent-catalog-{{ section.id }} {
      padding: 34px 14px 54px;
    }

    #avonent-catalog-{{ section.id }} .avonent-catalog__header {
      display: block;
      margin-bottom: 20px;
    }

    #avonent-catalog-{{ section.id }} .avonent-catalog__eyebrow {
      margin-bottom: 7px;
      font-size: 10px;
    }

    #avonent-catalog-{{ section.id }} .avonent-catalog__header h1 {
      font-size: clamp(31px, 9.8vw, 42px);
    }

    #avonent-catalog-{{ section.id }} .avonent-catalog__header p {
      margin-top: 8px;
      font-size: 13px;
    }

    #avonent-catalog-{{ section.id }} .avonent-catalog__count {
      display: none;
    }

    #avonent-catalog-{{ section.id }} .avonent-catalog__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #avonent-catalog-{{ section.id }} .avonent-card {
      border-radius: 18px;
    }

    #avonent-catalog-{{ section.id }} .avonent-card__body {
      padding: 15px 16px 14px;
    }

    #avonent-catalog-{{ section.id }} .avonent-card__title {
      font-size: 18px;
    }

    #avonent-catalog-{{ section.id }} .avonent-card__purchase {
      margin-top: 8px;
    }

    #avonent-catalog-{{ section.id }} .avonent-card__button {
      margin-top: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #avonent-catalog-{{ section.id }} .avonent-card,
    #avonent-catalog-{{ section.id }} .avonent-card__image,
    #avonent-catalog-{{ section.id }} .avonent-card__button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Avonent Catalog",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Avonent Catalog"
    }
  ]
}
{% endschema %}

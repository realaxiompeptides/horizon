<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) card.scrollIntoView({ behavior: 'instant' });
      },
      { once: true }
    );
  }
{% endjavascript %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign visible_products_count = 0
  for catalog_product in collection.products
    assign catalog_title = catalog_product.title | strip | downcase
    assign catalog_handle = catalog_product.handle | strip | downcase
    unless catalog_title == 'shipping protection' or catalog_handle == 'shipping-protection' or catalog_handle contains 'shipping-protection'
      assign visible_products_count = visible_products_count | plus: 1
    endunless
  endfor
%}

{% render 'collection-wrapper-styles' %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<section class="avonent-catalog-shell">
  <div class="avonent-catalog-hero">
    <div class="avonent-catalog-hero__glow avonent-catalog-hero__glow--left" aria-hidden="true"></div>
    <div class="avonent-catalog-hero__glow avonent-catalog-hero__glow--right" aria-hidden="true"></div>

    <div class="avonent-catalog-hero__inner">
      <div class="avonent-catalog-hero__eyebrow">
        <span aria-hidden="true"></span>
        AVONENT WELLNESS
      </div>

      <h1 class="avonent-catalog-hero__title">Shop Avonent</h1>
      <p class="avonent-catalog-hero__copy">
        Premium wellness formulas built around clear ingredients, quality-focused manufacturing, and routines that are easy to stay consistent with.
      </p>

      <div class="avonent-catalog-hero__trust" aria-label="Why shop Avonent">
        <div class="avonent-catalog-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 3h6M10 3v5l-4.6 8.2A3.2 3.2 0 0 0 8.2 21h7.6a3.2 3.2 0 0 0 2.8-4.8L14 8V3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.8 14h8.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span>Third-party lab tested</span>
        </div>
        <div class="avonent-catalog-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v8.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          <span>Ships from the USA</span>
        </div>
        <div class="avonent-catalog-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10 4.1-1.8 7-5.2 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.7 12 2.1 2.1 4.7-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>30-day guarantee</span>
        </div>
      </div>
    </div>
  </div>

  {% # theme-check-disable-next-line UnknownFilter %}
  <collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
    <results-list
      class="section product-grid-container avonent-catalog{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
      style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
      section-id="{{ section.id }}"
      infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
    >
      {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

      <div class="avonent-catalog__heading-row">
        <div>
          <span class="avonent-catalog__kicker">THE COLLECTION</span>
          <h2>Find your daily routine.</h2>
        </div>
        <p>
          {{ visible_products_count }}
          {% if visible_products_count == 1 %}product{% else %}products{% endif %}
        </p>
      </div>

      <div class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}">
        {% content_for 'block',
          type: 'filters',
          id: 'filters',
          results: collection,
          results_size: visible_products_count
        %}

        {% assign products_per_page = 24 %}
        {% if section.settings.enable_infinite_scroll == false %}
          {% assign products_per_page = section.settings.products_per_page %}
        {% endif %}

        {% paginate collection.products by products_per_page %}
          {% capture children %}
            {% for product in collection.products %}
              {% liquid
                assign avonent_product_title = product.title | strip | downcase
                assign avonent_product_handle = product.handle | strip | downcase
                assign hide_from_avonent_catalog = false

                if avonent_product_title == 'shipping protection'
                  assign hide_from_avonent_catalog = true
                elsif avonent_product_handle == 'shipping-protection' or avonent_product_handle contains 'shipping-protection'
                  assign hide_from_avonent_catalog = true
                endif
              %}

              {% unless hide_from_avonent_catalog %}
                <li
                  id="{{ section.id }}-{{ product.id }}"
                  class="product-grid__item avonent-product-grid__item"
                  data-page="{{ paginate.current_page }}"
                  data-product-id="{{ product.id }}"
                  ref="cards[]"
                >
                  <article class="avonent-product-card">
                    <a href="{{ product.url }}" class="avonent-product-card__media" aria-label="View {{ product.title | escape }}">
                      {% if product.featured_image != blank %}
                        {{
                          product.featured_image
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            widths: '360, 540, 720, 900',
                            sizes: '(min-width: 1100px) 360px, (min-width: 750px) 32vw, 92vw',
                            class: 'avonent-product-card__image',
                            alt: product.featured_image.alt | default: product.title
                        }}
                      {% else %}
                        <div class="avonent-product-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                      {% endif %}

                      <div class="avonent-product-card__badges">
                        {% if product.compare_at_price_max > product.price %}
                          <span class="avonent-product-card__badge avonent-product-card__badge--sale">Sale</span>
                        {% endif %}
                        {% unless product.available %}
                          <span class="avonent-product-card__badge avonent-product-card__badge--dark">Sold out</span>
                        {% endunless %}
                      </div>
                    </a>

                    <div class="avonent-product-card__body">
                      <div class="avonent-product-card__meta">
                        <span>AVONENT</span>
                        <span class="avonent-product-card__tested">
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5.5 10.2 2.8 2.8 6.2-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          Quality tested
                        </span>
                      </div>

                      <h3 class="avonent-product-card__title">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>

                      {% if product.description != blank %}
                        <p class="avonent-product-card__description">
                          {{ product.description | strip_html | strip | truncate: 112 }}
                        </p>
                      {% endif %}

                      <div class="avonent-product-card__bottom">
                        <div class="avonent-product-card__price">
                          <span class="avonent-product-card__current-price">{{ product.price | money }}</span>
                          {% if product.compare_at_price_max > product.price %}
                            <s>{{ product.compare_at_price_max | money }}</s>
                          {% endif %}
                        </div>

                        <a href="{{ product.url }}" class="avonent-product-card__button">
                          View product
                          <span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </div>
                  </article>
                </li>
              {% endunless %}
            {% endfor %}
          {% endcapture %}

          {% render 'product-grid',
            section: section,
            children: children,
            products: collection.products,
            paginate: paginate,
            enable_infinite_scroll: section.settings.enable_infinite_scroll
          %}
        {% endpaginate %}
      </div>
    </results-list>
  </collection-component>
</section>

<style>
  /* Fallback: if an older collection template still has Horizon's generic title
     section directly before main-collection, remove it. */
  #MainContent > .shopify-section:has(+ #shopify-section-{{ section.id }}) {
    display: none !important;
  }

  #shopify-section-{{ section.id }} {
    background: #f7fcfd;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-shell {
    --av-blue: #02c6ea;
    --av-blue-dark: #1996b5;
    --av-ink: #071114;
    --av-muted: #5b6b71;
    --av-border: #d8ebef;
    background: #f7fcfd;
    color: var(--av-ink);
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 58px 22px 52px;
    border-bottom: 1px solid var(--av-border);
    background:
      linear-gradient(180deg, #eefbfe 0%, #f7fcfd 100%);
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__glow {
    position: absolute;
    z-index: -1;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: rgba(2, 198, 234, .12);
    filter: blur(8px);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__glow--left { top: -320px; left: -180px; }
  #shopify-section-{{ section.id }} .avonent-catalog-hero__glow--right { right: -230px; bottom: -360px; }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__inner {
    width: min(1040px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 16px;
    padding: 8px 13px;
    border: 1px solid rgba(2, 198, 234, .3);
    border-radius: 999px;
    background: rgba(255,255,255,.86);
    color: #087f99;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: .14em;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--av-blue);
    box-shadow: 0 0 0 5px rgba(2,198,234,.13);
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__title {
    margin: 0;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: clamp(46px, 6vw, 74px);
    font-weight: 800;
    line-height: .98;
    letter-spacing: -.055em;
    color: var(--av-ink);
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__copy {
    max-width: 690px;
    margin: 18px auto 0;
    color: var(--av-muted);
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 25px;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 43px;
    padding: 9px 14px;
    border: 1px solid var(--av-border);
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    box-shadow: 0 8px 24px rgba(5,76,90,.04);
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 720;
  }

  #shopify-section-{{ section.id }} .avonent-catalog-hero__trust-item svg {
    width: 19px;
    height: 19px;
    color: var(--av-blue-dark);
  }

  #shopify-section-{{ section.id }} .avonent-catalog {
    padding-top: 0;
    background:
      radial-gradient(circle at 8% 0%, rgba(2,198,234,.06), transparent 25rem),
      #f7fcfd;
  }

  #shopify-section-{{ section.id }} .avonent-catalog__heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 42px 0 20px;
  }

  #shopify-section-{{ section.id }} .avonent-catalog__kicker {
    display: block;
    margin-bottom: 7px;
    color: var(--av-blue-dark);
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
  }

  #shopify-section-{{ section.id }} .avonent-catalog__heading-row h2 {
    margin: 0;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  #shopify-section-{{ section.id }} .avonent-catalog__heading-row > p {
    margin: 0 0 5px;
    color: #75848a;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 650;
  }

  #shopify-section-{{ section.id }} .avonent-catalog .collection-wrapper {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding-top: 0;
  }

  #shopify-section-{{ section.id }} .avonent-catalog :is(.facets, .facets__wrapper, [class*='facets']) {
    font-family: var(--font-body--family);
  }

  #shopify-section-{{ section.id }} .avonent-catalog :is(.facets, .facets__wrapper, [class*='facets']) button,
  #shopify-section-{{ section.id }} .avonent-catalog :is(.facets, .facets__wrapper, [class*='facets']) select,
  #shopify-section-{{ section.id }} .avonent-catalog :is(.facets, .facets__wrapper, [class*='facets']) summary {
    font-size: 13px;
    font-weight: 650;
  }

  #shopify-section-{{ section.id }} .avonent-catalog .product-grid {
    grid-template-columns: repeat(auto-fit, minmax(285px, 360px)) !important;
    justify-content: center;
    gap: 22px !important;
    margin-top: 4px;
  }

  #shopify-section-{{ section.id }} .avonent-product-grid__item {
    width: 100%;
    padding: 0 !important;
    border: 0 !important;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .avonent-product-card {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--av-border);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 12px 38px rgba(8,57,68,.07);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  #shopify-section-{{ section.id }} .avonent-product-card:hover {
    transform: translateY(-4px);
    border-color: rgba(2,198,234,.58);
    box-shadow: 0 20px 48px rgba(6,111,132,.12);
  }

  #shopify-section-{{ section.id }} .avonent-product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #ecf9fc;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .28s ease;
  }

  #shopify-section-{{ section.id }} .avonent-product-card:hover .avonent-product-card__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .avonent-product-card__placeholder,
  #shopify-section-{{ section.id }} .avonent-product-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__badges {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 6px 11px;
    border-radius: 999px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .03em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__badge--sale { background: var(--av-blue); color: #00252c; }
  #shopify-section-{{ section.id }} .avonent-product-card__badge--dark { background: #071114; color: #fff; }

  #shopify-section-{{ section.id }} .avonent-product-card__body {
    display: flex;
    flex-direction: column;
    min-height: 245px;
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    color: #7c8a8f;
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .13em;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__tested {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: #328a9d;
    letter-spacing: 0;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__tested svg { width: 16px; height: 16px; }

  #shopify-section-{{ section.id }} .avonent-product-card__title {
    margin: 0;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: 21px;
    font-weight: 780;
    line-height: 1.18;
    letter-spacing: -.03em;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__title a {
    color: var(--av-ink);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__description {
    margin: 10px 0 18px;
    color: var(--av-muted);
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__bottom {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid #e6f0f2;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__current-price {
    color: var(--av-ink);
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -.02em;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__price s {
    color: #89979c;
    font-family: var(--font-body--family);
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 12px 15px;
    border-radius: 12px;
    background: var(--av-ink);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 780;
    line-height: 1;
    text-decoration: none;
    transition: background .18s ease, transform .18s ease;
  }

  #shopify-section-{{ section.id }} .avonent-product-card__button:hover {
    background: var(--av-blue-dark);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .avonent-product-card__button span { font-size: 17px; }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .avonent-catalog-hero { padding: 42px 16px 35px; }
    #shopify-section-{{ section.id }} .avonent-catalog-hero__title { font-size: clamp(40px, 12vw, 54px); }
    #shopify-section-{{ section.id }} .avonent-catalog-hero__copy { margin-top: 15px; font-size: 14px; line-height: 1.55; }
    #shopify-section-{{ section.id }} .avonent-catalog-hero__trust { display: grid; grid-template-columns: 1fr; gap: 7px; margin-top: 21px; }
    #shopify-section-{{ section.id }} .avonent-catalog-hero__trust-item { justify-content: flex-start; border-radius: 13px; }
    #shopify-section-{{ section.id }} .avonent-catalog__heading-row { width: calc(100% - 28px); padding: 30px 0 16px; }
    #shopify-section-{{ section.id }} .avonent-catalog__heading-row > p { display: none; }
    #shopify-section-{{ section.id }} .avonent-catalog .collection-wrapper { width: calc(100% - 28px); }
    #shopify-section-{{ section.id }} .avonent-catalog .product-grid { grid-template-columns: 1fr !important; gap: 16px !important; }
    #shopify-section-{{ section.id }} .avonent-product-card { border-radius: 18px; }
    #shopify-section-{{ section.id }} .avonent-product-card__body { min-height: 0; padding: 17px; }
    #shopify-section-{{ section.id }} .avonent-product-card__title { font-size: 19px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .avonent-product-card,
    #shopify-section-{{ section.id }} .avonent-product-card__image,
    #shopify-section-{{ section.id }} .avonent-product-card__button { transition: none; }
  }
</style>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "organic", "label": "t:options.editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "extra-large", "label": "t:options.extra_large" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "small"
    },
    { "type": "checkbox", "id": "enable_infinite_scroll", "label": "t:settings.auto_load_products", "default": true },

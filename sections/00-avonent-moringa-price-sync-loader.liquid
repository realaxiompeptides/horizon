{% comment %}
  Moringa-only compatibility loader.
  Loads desktop PDP overrides and desktop-only reference-style proof/journey layouts.
  Mobile is untouched.
{% endcomment %}

{% if template.suffix == 'moringa' %}
  {{ 'avonent-moringa-desktop.css' | asset_url | stylesheet_tag }}

  <style>
    @media screen and (min-width: 990px) {
      /* -----------------------------
         PROOF / ROOTED IN NATURE
         ----------------------------- */
      .avonent-proof-stats {
        padding-top: 58px !important;
        padding-bottom: 42px !important;
      }

      .avonent-proof-stats__inner {
        display: grid !important;
        grid-template-columns: minmax(0, 1.04fr) minmax(430px, 0.96fr) !important;
        grid-template-areas:
          'stats header'
          'stats footer' !important;
        column-gap: clamp(64px, 6vw, 112px) !important;
        row-gap: 22px !important;
        align-items: center !important;
        width: min(calc(100% - 96px), 1240px) !important;
        max-width: 1240px !important;
        margin-inline: auto !important;
      }

      .avonent-proof-stats__header {
        grid-area: header !important;
        width: 100% !important;
        max-width: 560px !important;
        margin: 0 auto !important;
        text-align: center !important;
        align-self: end !important;
      }

      .avonent-proof-stats__eyebrow {
        display: none !important;
      }

      .avonent-proof-stats__heading {
        max-width: 560px !important;
        margin: 0 auto !important;
        font-size: clamp(31px, 2.35vw, 42px) !important;
        line-height: 1.08 !important;
        letter-spacing: -0.035em !important;
        text-wrap: balance !important;
      }

      .avonent-proof-stats__description {
        max-width: 520px !important;
        margin: 17px auto 0 !important;
        font-size: 15px !important;
        line-height: 1.48 !important;
        text-align: center !important;
      }

      .avonent-proof-stats__grid {
        grid-area: stats !important;
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        width: 100% !important;
        align-self: center !important;
        border-top: 0 !important;
        border-bottom: 0 !important;
      }

      .avonent-proof-stats__stat {
        min-height: 116px !important;
        padding: 22px 26px 22px 0 !important;
        border-left: 0 !important;
        border-top: 0 !important;
      }

      .avonent-proof-stats__stat:nth-child(even) {
        padding-left: 36px !important;
        padding-right: 0 !important;
      }

      .avonent-proof-stats__stat:nth-child(n + 3) {
        border-top: 1px solid var(--aps-line) !important;
      }

      .avonent-proof-stats__kicker {
        display: none !important;
      }

      .avonent-proof-stats__value {
        margin: 0 !important;
        font-size: clamp(42px, 3.1vw, 56px) !important;
        line-height: .95 !important;
        letter-spacing: -0.045em !important;
        white-space: nowrap !important;
      }

      .avonent-proof-stats__label {
        max-width: 235px !important;
        margin-top: 8px !important;
        font-size: 14px !important;
        line-height: 1.28 !important;
        font-weight: 650 !important;
      }

      .avonent-proof-stats__footer {
        grid-area: footer !important;
        width: 100% !important;
        max-width: 570px !important;
        margin: 0 auto !important;
        align-self: start !important;
        text-align: center !important;
      }

      .avonent-proof-stats__button {
        min-height: 58px !important;
        border-radius: 999px !important;
        font-size: 16px !important;
        box-shadow: none !important;
      }

      .avonent-proof-stats__guarantee {
        margin-top: 11px !important;
        margin-bottom: 22px !important;
        font-size: 12px !important;
      }

      .avonent-proof-stats__footnote {
        margin-top: 8px !important;
      }

      /* -----------------------------
         WELLNESS JOURNEY / WEEK 1–4
         Desktop split layout like reference
         ----------------------------- */
      .avonent-journey {
        display: grid !important;
        grid-template-columns: minmax(420px, 560px) minmax(500px, 640px) !important;
        grid-template-rows: auto auto !important;
        justify-content: center !important;
        align-items: start !important;
        column-gap: clamp(58px, 6vw, 100px) !important;
        row-gap: 30px !important;
        padding: 44px 40px 50px !important;
        overflow: visible !important;
      }

      .avonent-journey__media-wrap {
        grid-column: 1 !important;
        grid-row: 1 !important;
        position: static !important;
        left: auto !important;
        transform: none !important;
        width: 100% !important;
        max-width: 560px !important;
        margin: 0 !important;
        align-self: start !important;
        justify-self: center !important;
      }

      .avonent-journey__media {
        width: 100% !important;
        height: clamp(230px, 17vw, 270px) !important;
        border-radius: 0 !important;
      }

      .avonent-journey__media-image {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center 56% !important;
      }

      .avonent-journey__inner,
      .avonent-journey__inner.has-journey-image {
        display: contents !important;
        width: auto !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .avonent-journey__header {
        grid-column: 1 !important;
        grid-row: 2 !important;
        width: 100% !important;
        max-width: 560px !important;
        margin: 0 !important;
        padding: 2px 16px 0 !important;
        text-align: center !important;
        align-self: start !important;
        justify-self: center !important;
      }

      .avonent-journey__eyebrow {
        margin-bottom: 8px !important;
        font-size: 12px !important;
        letter-spacing: .12em !important;
      }

      .avonent-journey__heading {
        max-width: 520px !important;
        margin-inline: auto !important;
        font-size: clamp(32px, 2.5vw, 40px) !important;
        line-height: 1.06 !important;
        letter-spacing: -.035em !important;
      }

      .avonent-journey__description {
        max-width: 500px !important;
        margin: 16px auto 0 !important;
        font-size: 15.5px !important;
        line-height: 1.5 !important;
      }

      .avonent-journey__timeline {
        grid-column: 2 !important;
        grid-row: 1 / span 2 !important;
        width: 100% !important;
        max-width: 640px !important;
        margin: 0 !important;
        align-self: start !important;
      }

      .avonent-journey__step {
        display: grid !important;
        grid-template-columns: 22px minmax(0, 1fr) !important;
        gap: 12px !important;
        padding-bottom: 18px !important;
      }

      .avonent-journey__rail {
        justify-content: center !important;
      }

      .avonent-journey__rail::after,
      .avonent-journey__rail::before {
        top: 15px !important;
        bottom: -22px !important;
        width: 2px !important;
      }

      .avonent-journey__dot {
        width: 14px !important;
        height: 14px !important;
        flex: 0 0 14px !important;
        margin-top: 5px !important;
        background: var(--avj-accent) !important;
        border: 0 !important;
        box-shadow: none !important;
      }

      .avonent-journey__step:nth-child(n + 3) .avonent-journey__dot {
        background: #111 !important;
      }

      .avonent-journey__dot-icon {
        display: none !important;
      }

      .avonent-journey__card {
        padding: 0 0 14px !important;
        background: transparent !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
      }

      .avonent-journey__card-heading {
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
        min-height: 42px !important;
        padding: 10px 16px !important;
        background: var(--avj-accent) !important;
        border: 0 !important;
        border-radius: 5px !important;
      }

      .avonent-journey__step:nth-child(n + 3) .avonent-journey__card-heading {
        background: #111 !important;
      }

      .avonent-journey__week {
        min-height: 0 !important;
        padding: 0 !important;
        color: #fff !important;
        background: transparent !important;
        border: 0 !important;
        border-radius: 0 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        letter-spacing: 0 !important;
        text-transform: none !important;
      }

      .avonent-journey__week::after {
        content: ':';
      }

      .avonent-journey__title {
        color: #fff !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        letter-spacing: 0 !important;
        line-height: 1.2 !important;
      }

      .avonent-journey__benefits {
        gap: 13px !important;
        margin: 16px 0 0 !important;
        padding: 0 4px 0 2px !important;
      }

      .avonent-journey__benefit {
        display: grid !important;
        grid-template-columns: 18px minmax(0, 1fr) !important;
        gap: 6px !important;
        align-items: start !important;
        color: #4f5965 !important;
        font-size: 15px !important;
        line-height: 1.45 !important;
      }

      .avonent-journey__check {
        display: inline !important;
        width: auto !important;
        height: auto !important;
        margin-top: 0 !important;
        color: #00a98f !important;
        background: transparent !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-size: 17px !important;
        line-height: 1.2 !important;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Moringa price sync",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [],
  "presets": [
    {"name":"Moringa price sync"}
  ]
}
{% endschema %}

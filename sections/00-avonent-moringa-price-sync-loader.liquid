{% comment %}
  Moringa-only compatibility loader.
  The old price-sync JS is no longer needed here, but this header-group section
  is a reliable Moringa-aware place to load the desktop PDP overrides.
{% endcomment %}

{% if template.suffix == 'moringa' %}
  {{ 'avonent-moringa-desktop.css' | asset_url | stylesheet_tag }}
{% endif %}

{% schema %}
{
  "name": "Moringa price sync",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [],
  "presets": [
    {"name":"Moringa price sync"}
  ]
}
{% endschema %}

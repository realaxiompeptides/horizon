<section
  class="ag-wellness"
  style="--bg:{{ section.settings.background }};--t:{{ section.settings.text }};--soft:{{ section.settings.soft_text }};--ring:{{ section.settings.ring }};"
>
  <div class="ag-wellness__in">
    <header>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<div class="ag-wellness__sub rte">{{ section.settings.subheading }}</div>{% endif %}
    </header>

    <div class="ag-wellness__grid">
      {% for block in section.blocks %}
        <div class="ag-wellness__item" {{ block.shopify_attributes }}>
          <span class="ag-wellness__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'heart' %}
                <svg viewBox="0 0 48 48"><path d="M7 25h9l4-9 6 18 5-9h10"></path><path d="M24 43S5 33 5 18C5 9 16 6 24 15c8-9 19-6 19 3 0 15-19 25-19 25z"></path></svg>
              {% when 'shield' %}
                <svg viewBox="0 0 48 48"><path d="M24 4 40 10v12c0 11-7 18-16 22C15 40 8 33 8 22V10z"></path><path d="M18 24h12M24 18v12"></path></svg>
              {% when 'routine' %}
                <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="M24 14v11l8 5"></path></svg>
              {% else %}
                <svg viewBox="0 0 48 48"><path d="M13 15c6 0 8 4 11 9 3-5 5-9 11-9"></path><path d="M10 9c8 2 11 8 14 15C27 17 30 11 38 9"></path><path d="M24 24v16"></path></svg>
            {% endcase %}
          </span>
          <strong>{{ block.settings.heading }}</strong>
        </div>
      {% endfor %}
    </div>

    <div class="ag-wellness__product">
      <span class="ag-wellness__ring ag-wellness__ring--1"></span>
      <span class="ag-wellness__ring ag-wellness__ring--2"></span>
      <span class="ag-wellness__ring ag-wellness__ring--3"></span>
      {% if section.settings.product_image != blank %}
        {{ section.settings.product_image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', class: 'ag-wellness__img', alt: product.title }}
      {% elsif product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', class: 'ag-wellness__img', alt: product.title }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
.ag-wellness{overflow:hidden;background:var(--bg);color:var(--t);padding:64px 0 0}.ag-wellness *{box-sizing:border-box}.ag-wellness__in{width:min(calc(100% - 30px),960px);margin:auto}.ag-wellness header{text-align:center;max-width:760px;margin:auto}.ag-wellness h2{margin:0;color:var(--t);font-size:clamp(38px,5vw,58px);font-weight:820;line-height:1.03;letter-spacing:-.04em}.ag-wellness__sub{margin:16px auto 0;max-width:720px;color:var(--soft);font-size:16px;line-height:1.6}.ag-wellness__sub p{margin:0}.ag-wellness__grid{display:grid;grid-template-columns:1fr 1fr;gap:42px 34px;max-width:740px;margin:48px auto 18px}.ag-wellness__item{display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center}.ag-wellness__icon{display:grid;place-items:center;width:66px;height:66px;color:var(--t)}.ag-wellness__icon svg{width:58px;height:58px;fill:none;stroke:currentColor;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}.ag-wellness__item strong{max-width:260px;color:var(--t);font-size:18px;line-height:1.25}.ag-wellness__product{position:relative;display:grid;place-items:end center;min-height:520px;margin-top:26px}.ag-wellness__img{position:relative;z-index:3;display:block;max-width:min(60%,420px);max-height:480px;width:auto;height:auto;object-fit:contain;filter:drop-shadow(0 24px 24px rgb(0 60 130 / 18%))}.ag-wellness__ring{position:absolute;left:50%;bottom:0;transform:translateX(-50%);border:1.5px dashed var(--ring);border-radius:50% 50% 0 0}.ag-wellness__ring--1{width:74%;height:310px}.ag-wellness__ring--2{width:58%;height:245px}.ag-wellness__ring--3{width:42%;height:180px}@media(max-width:749px){.ag-wellness{padding-top:48px}.ag-wellness h2{font-size:38px}.ag-wellness__sub{font-size:14px}.ag-wellness__grid{gap:34px 18px;margin-top:38px}.ag-wellness__icon{width:56px;height:56px}.ag-wellness__icon svg{width:50px;height:50px}.ag-wellness__item strong{font-size:15px}.ag-wellness__product{min-height:400px;margin-top:18px}.ag-wellness__img{max-width:min(70%,320px);max-height:370px}.ag-wellness__ring--1{width:92%;height:255px}.ag-wellness__ring--2{width:72%;height:200px}.ag-wellness__ring--3{width:52%;height:145px}}
{% endstylesheet %}

{% schema %}
{
  "name":"Everyday Wellness",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Designed for Everyday Wellness"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>From a simple softgel format to a more convenient daily routine, here’s what makes Avonent Aged Garlic different.</p>"},
    {"type":"image_picker","id":"product_image","label":"Product image"},
    {"type":"color","id":"background","label":"Background","default":"#02C6EA"},
    {"type":"color","id":"text","label":"Text","default":"#FFFFFF"},
    {"type":"color","id":"soft_text","label":"Secondary text","default":"#E8FBFF"},
    {"type":"color","id":"ring","label":"Decorative rings","default":"#B9F4FF"}
  ],
  "blocks":[
    {
      "type":"feature",
      "name":"Feature",
      "settings":[
        {"type":"select","id":"icon","label":"Icon","options":[
          {"value":"heart","label":"Heart"},
          {"value":"shield","label":"Shield"},
          {"value":"routine","label":"Routine"},
          {"value":"leaf","label":"Leaf"}
        ],"default":"heart"},
        {"type":"text","id":"heading","label":"Text","default":"Daily Wellness Routine"}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"Everyday Wellness","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]
}
{% endschema %}
<section
  id="avonent-contact-{{ section.id }}"
  class="avonent-contact"
  style="
    --av-contact-accent: {{ section.settings.accent_color }};
    --av-contact-bg: {{ section.settings.background_color }};
    --av-contact-card: {{ section.settings.card_color }};
    --av-contact-text: {{ section.settings.text_color }};
    --av-contact-muted: {{ section.settings.muted_color }};
    --av-contact-border: {{ section.settings.border_color }};
  "
>
  <div class="avonent-contact__glow avonent-contact__glow--one" aria-hidden="true"></div>
  <div class="avonent-contact__glow avonent-contact__glow--two" aria-hidden="true"></div>

  <div class="avonent-contact__inner">
    <header class="avonent-contact__header">
      {% if section.settings.eyebrow != blank %}
        <div class="avonent-contact__eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</div>
      {% endif %}
      <h1 class="avonent-contact__heading">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="avonent-contact__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="avonent-contact__layout">
      <aside class="avonent-contact__aside">
        <div class="avonent-contact__info-card avonent-contact__info-card--primary">
          <div class="avonent-contact__info-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.8 9.8 0 0 1-3.8-.8L3 21l1.8-4.6A8.3 8.3 0 0 1 3 11.5a8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 9 8.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <h2>{{ section.settings.help_heading | escape }}</h2>
          <p>{{ section.settings.help_text | escape }}</p>
        </div>

        <div class="avonent-contact__info-card">
          <div class="avonent-contact__mini-row">
            <span class="avonent-contact__mini-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m5 7 7 6 7-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <strong>Order questions</strong>
              <p>Include your order number so we can help more efficiently.</p>
            </div>
          </div>
          <div class="avonent-contact__mini-row">
            <span class="avonent-contact__mini-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10 4.1-1.8 7-5.2 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.7 12 2.1 2.1 4.7-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <strong>30-day guarantee</strong>
              <p>Contact us within the eligible guarantee period for help with next steps.</p>
            </div>
          </div>
          <div class="avonent-contact__mini-row">
            <span class="avonent-contact__mini-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v8.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <strong>Shipping support</strong>
              <p>Questions about delivery or an existing shipment? Send the details below.</p>
            </div>
          </div>
        </div>

        <div class="avonent-contact__trust">
          <span>Third-party lab tested</span>
          <span>Ships from USA</span>
          <span>Secure checkout</span>
        </div>
      </aside>

      <div class="avonent-contact__form-card">
        <div class="avonent-contact__form-heading">
          <span>CONTACT SUPPORT</span>
          <h2>Send us a message</h2>
          <p>Fill out the form below with as much detail as you can.</p>
        </div>

        {% form 'contact', id: 'AvonentContactForm', class: 'avonent-contact__form' %}
          {% if form.posted_successfully? %}
            <div class="avonent-contact__notice avonent-contact__notice--success" tabindex="-1" autofocus>
              <strong>Message received.</strong>
              <span>Thanks for contacting Avonent. Our support team will review your message.</span>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="avonent-contact__notice avonent-contact__notice--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="avonent-contact__field-grid">
            <div class="avonent-contact__field">
              <label for="AvonentContactName">Name</label>
              <input id="AvonentContactName" type="text" name="contact[name]" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}" autocomplete="name" placeholder="Your name">
            </div>

            <div class="avonent-contact__field">
              <label for="AvonentContactEmail">Email <span>*</span></label>
              <input id="AvonentContactEmail" type="email" name="contact[email]" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" autocomplete="email" autocapitalize="off" spellcheck="false" required placeholder="you@example.com">
            </div>
          </div>

          <div class="avonent-contact__field-grid">
            <div class="avonent-contact__field">
              <label for="AvonentContactTopic">What can we help with?</label>
              <select id="AvonentContactTopic" name="contact[topic]">
                <option value="Product question">Product question</option>
                <option value="Order status">Order status</option>
                <option value="Shipping or delivery">Shipping or delivery</option>
                <option value="Return or guarantee">Return or guarantee</option>
                <option value="Subscription">Subscription</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="avonent-contact__field">
              <label for="AvonentContactOrder">Order number <em>optional</em></label>
              <input id="AvonentContactOrder" type="text" name="contact[order_number]" placeholder="#1234">
            </div>
          </div>

          <div class="avonent-contact__field">
            <label for="AvonentContactPhone">Phone <em>optional</em></label>
            <input id="AvonentContactPhone" type="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}" autocomplete="tel" placeholder="(555) 555-5555">
          </div>

          <div class="avonent-contact__field">
            <label for="AvonentContactBody">Message <span>*</span></label>
            <textarea id="AvonentContactBody" rows="7" name="contact[body]" required placeholder="Tell us how we can help...">{{ form.body }}</textarea>
          </div>

          <button class="avonent-contact__submit" type="submit">
            Send message
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 14-7-4 14-3-5-7-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m12 14 3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>

          <p class="avonent-contact__privacy">Please do not include passwords, payment card numbers, or other sensitive account information in your message.</p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  #avonent-contact-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 66px 20px 88px;
    background: linear-gradient(180deg, var(--av-contact-bg) 0%, #ffffff 100%);
    color: var(--av-contact-text);
  }
  #avonent-contact-{{ section.id }} * { box-sizing: border-box; }
  #avonent-contact-{{ section.id }} .avonent-contact__inner { width:100%; max-width:1120px; margin:0 auto; }
  #avonent-contact-{{ section.id }} .avonent-contact__glow { position:absolute; z-index:-1; width:480px; height:480px; border-radius:50%; background:rgba(2,198,234,.11); filter:blur(8px); pointer-events:none; }
  #avonent-contact-{{ section.id }} .avonent-contact__glow--one { top:-320px; left:-220px; }
  #avonent-contact-{{ section.id }} .avonent-contact__glow--two { right:-290px; bottom:-300px; }
  #avonent-contact-{{ section.id }} .avonent-contact__header { max-width:760px; margin:0 auto 40px; text-align:center; }
  #avonent-contact-{{ section.id }} .avonent-contact__eyebrow { display:inline-flex; align-items:center; gap:9px; margin-bottom:16px; padding:8px 13px; border:1px solid rgba(2,198,234,.3); border-radius:999px; background:rgba(255,255,255,.84); color:#078aa5; font-size:11px; font-weight:800; line-height:1; letter-spacing:.13em; text-transform:uppercase; }
  #avonent-contact-{{ section.id }} .avonent-contact__eyebrow span { width:8px; height:8px; border-radius:50%; background:var(--av-contact-accent); box-shadow:0 0 0 5px rgba(2,198,234,.12); }
  #avonent-contact-{{ section.id }} .avonent-contact__heading { margin:0; font-family:var(--font-heading--family, var(--font-body--family)); font-size:clamp(44px,6vw,70px); font-weight:800; line-height:.98; letter-spacing:-.05em; }
  #avonent-contact-{{ section.id }} .avonent-contact__subheading { max-width:650px; margin:18px auto 0; color:var(--av-contact-muted); font-size:16px; line-height:1.6; }
  #avonent-contact-{{ section.id }} .avonent-contact__layout { display:grid; grid-template-columns:minmax(0,.82fr) minmax(0,1.45fr); gap:20px; align-items:start; }
  #avonent-contact-{{ section.id }} .avonent-contact__aside { display:grid; gap:14px; }
  #avonent-contact-{{ section.id }} .avonent-contact__info-card, #avonent-contact-{{ section.id }} .avonent-contact__form-card { border:1px solid var(--av-contact-border); border-radius:22px; background:var(--av-contact-card); box-shadow:0 14px 42px rgba(7,55,65,.055); }
  #avonent-contact-{{ section.id }} .avonent-contact__info-card { padding:22px; }
  #avonent-contact-{{ section.id }} .avonent-contact__info-card--primary { background:linear-gradient(145deg,#e1f9fd 0%,#f5fdff 100%); border-color:rgba(2,198,234,.36); }
  #avonent-contact-{{ section.id }} .avonent-contact__info-icon { display:flex; align-items:center; justify-content:center; width:50px; height:50px; margin-bottom:17px; border-radius:15px; background:var(--av-contact-accent); color:#00303a; }
  #avonent-contact-{{ section.id }} .avonent-contact__info-icon svg { width:27px; height:27px; }
  #avonent-contact-{{ section.id }} .avonent-contact__info-card h2 { margin:0; font-family:var(--font-heading--family, var(--font-body--family)); font-size:25px; font-weight:800; letter-spacing:-.025em; }
  #avonent-contact-{{ section.id }} .avonent-contact__info-card > p { margin:9px 0 0; color:var(--av-contact-muted); font-size:14px; line-height:1.6; }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-row { display:grid; grid-template-columns:38px minmax(0,1fr); gap:12px; align-items:start; padding:15px 0; border-bottom:1px solid var(--av-contact-border); }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-row:first-child { padding-top:0; }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-row:last-child { padding-bottom:0; border-bottom:0; }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-icon { display:flex; align-items:center; justify-content:center; width:38px; height:38px; border-radius:12px; background:#eaf9fc; color:#0797b3; }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-icon svg { width:21px; height:21px; }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-row strong { display:block; font-size:14px; line-height:1.3; }
  #avonent-contact-{{ section.id }} .avonent-contact__mini-row p { margin:4px 0 0; color:var(--av-contact-muted); font-size:12px; line-height:1.45; }
  #avonent-contact-{{ section.id }} .avonent-contact__trust { display:flex; flex-wrap:wrap; gap:7px; padding:2px; }
  #avonent-contact-{{ section.id }} .avonent-contact__trust span { padding:8px 10px; border:1px solid var(--av-contact-border); border-radius:999px; background:#fff; color:#52656c; font-size:10px; font-weight:750; text-transform:uppercase; letter-spacing:.045em; }
  #avonent-contact-{{ section.id }} .avonent-contact__form-card { padding:28px; }
  #avonent-contact-{{ section.id }} .avonent-contact__form-heading { margin-bottom:23px; }
  #avonent-contact-{{ section.id }} .avonent-contact__form-heading > span { display:block; margin-bottom:7px; color:#078aa5; font-size:10px; font-weight:850; letter-spacing:.13em; }
  #avonent-contact-{{ section.id }} .avonent-contact__form-heading h2 { margin:0; font-family:var(--font-heading--family, var(--font-body--family)); font-size:31px; font-weight:800; line-height:1.05; letter-spacing:-.035em; }
  #avonent-contact-{{ section.id }} .avonent-contact__form-heading p { margin:8px 0 0; color:var(--av-contact-muted); font-size:13px; }
  #avonent-contact-{{ section.id }} .avonent-contact__form { display:grid; gap:16px; }
  #avonent-contact-{{ section.id }} .avonent-contact__field-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:13px; }
  #avonent-contact-{{ section.id }} .avonent-contact__field { display:grid; gap:7px; }
  #avonent-contact-{{ section.id }} .avonent-contact__field label { color:var(--av-contact-text); font-size:12px; font-weight:750; }
  #avonent-contact-{{ section.id }} .avonent-contact__field label span { color:#e54c4c; }
  #avonent-contact-{{ section.id }} .avonent-contact__field label em { color:#88959a; font-size:10px; font-style:normal; font-weight:600; }
  #avonent-contact-{{ section.id }} :is(input, select, textarea) { width:100%; margin:0; border:1px solid #cfe5ea; border-radius:13px; background:#fbfeff; color:var(--av-contact-text); font:inherit; font-size:14px; outline:none; transition:border-color 160ms ease, box-shadow 160ms ease, background 160ms ease; }
  #avonent-contact-{{ section.id }} :is(input, select) { min-height:49px; padding:0 13px; }
  #avonent-contact-{{ section.id }} textarea { min-height:150px; padding:13px; resize:vertical; }
  #avonent-contact-{{ section.id }} :is(input, select, textarea):focus { border-color:var(--av-contact-accent); background:#fff; box-shadow:0 0 0 4px rgba(2,198,234,.12); }
  #avonent-contact-{{ section.id }} :is(input, textarea)::placeholder { color:#94a2a7; opacity:1; }
  #avonent-contact-{{ section.id }} .avonent-contact__submit { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; min-height:54px; padding:13px 18px; border:0; border-radius:14px; background:var(--av-contact-accent); color:#002c34; font-size:14px; font-weight:850; cursor:pointer; box-shadow:0 10px 25px rgba(2,198,234,.22); transition:transform 160ms ease, filter 160ms ease; }
  #avonent-contact-{{ section.id }} .avonent-contact__submit:hover { transform:translateY(-1px); filter:saturate(1.08) brightness(.98); }
  #avonent-contact-{{ section.id }} .avonent-contact__submit svg { width:19px; height:19px; }
  #avonent-contact-{{ section.id }} .avonent-contact__privacy { margin:-2px 0 0; color:#7b898e; font-size:10.5px; line-height:1.5; text-align:center; }
  #avonent-contact-{{ section.id }} .avonent-contact__notice { display:grid; gap:3px; padding:13px 14px; border-radius:13px; font-size:12px; line-height:1.5; }
  #avonent-contact-{{ section.id }} .avonent-contact__notice--success { border:1px solid #a8ddd2; background:#effbf7; color:#195d50; }
  #avonent-contact-{{ section.id }} .avonent-contact__notice--error { border:1px solid #f0bbbb; background:#fff4f4; color:#8c3232; }
  @media (max-width:849px) { #avonent-contact-{{ section.id }} .avonent-contact__layout { grid-template-columns:1fr; } #avonent-contact-{{ section.id }} .avonent-contact__aside { order:2; } }
  @media (max-width:749px) {
    #avonent-contact-{{ section.id }} { padding:43px 14px 62px; }
    #avonent-contact-{{ section.id }} .avonent-contact__header { margin-bottom:28px; }
    #avonent-contact-{{ section.id }} .avonent-contact__heading { font-size:clamp(39px,12vw,52px); }
    #avonent-contact-{{ section.id }} .avonent-contact__subheading { font-size:14px; line-height:1.55; }
    #avonent-contact-{{ section.id }} .avonent-contact__form-card { padding:18px 15px; border-radius:18px; }
    #avonent-contact-{{ section.id }} .avonent-contact__form-heading h2 { font-size:27px; }
    #avonent-contact-{{ section.id }} .avonent-contact__field-grid { grid-template-columns:1fr; gap:16px; }
    #avonent-contact-{{ section.id }} .avonent-contact__info-card { padding:18px; border-radius:18px; }
  }
  @media (prefers-reduced-motion:reduce) { #avonent-contact-{{ section.id }} :is(input,select,textarea), #avonent-contact-{{ section.id }} .avonent-contact__submit { transition:none; } }
</style>

{% schema %}
{
  "name": "00 Avonent Contact",
  "tag": "section",
  "class": "section-avonent-contact",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AVONENT SUPPORT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about an order, a product, shipping, or your Avonent routine? Send us a message and our support team will help." },
    { "type": "text", "id": "help_heading", "label": "Support card heading", "default": "We’re here to help." },
    { "type": "textarea", "id": "help_text", "label": "Support card text", "default": "Whether you have a product question or need help with an existing order, give us the details and we’ll point you in the right direction." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#02C6EA" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F1FBFD" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#071114" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#53636A" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D5EDF3" }
  ],
  "presets": [{ "name": "00 Avonent Contact" }]
}
{% endschema %}

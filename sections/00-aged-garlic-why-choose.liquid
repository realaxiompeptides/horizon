<section
  class="ag-choose"
  style="--bg:{{ section.settings.background }};--overlay:{{ section.settings.overlay }};--t:{{ section.settings.text }};--line:{{ section.settings.line }};--btn:{{ section.settings.button_bg }};--btntext:{{ section.settings.button_text_color }};"
>
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '100vw', loading: 'lazy', class: 'ag-choose__bg', alt: section.settings.heading }}
  {% endif %}
  <div class="ag-choose__wash"></div>

  <div class="ag-choose__in">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.intro != blank %}<div class="ag-choose__intro rte">{{ section.settings.intro }}</div>{% endif %}

    <div class="ag-choose__rows">
      {% for block in section.blocks %}
        <div class="ag-choose__row" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <a class="ag-choose__button" href="{{ section.settings.button_link | default: '#avonent-garlic-buy' }}">{{ section.settings.button_text }}</a>
    {% endif %}

    {% if section.settings.guarantee_text != blank %}
      <div class="ag-choose__guarantee">
        <span class="ag-choose__shield" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="M16 3 27 7v8c0 7-4.5 11.8-11 14-6.5-2.2-11-7-11-14V7z"></path><path d="m11 16 3 3 7-8"></path></svg>
        </span>
        <span>{{ section.settings.guarantee_text }}</span>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.ag-choose{position:relative;overflow:hidden;background:var(--bg);color:var(--t);padding:64px 0;isolation:isolate}.ag-choose *{box-sizing:border-box}.ag-choose__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-3}.ag-choose__wash{position:absolute;inset:0;z-index:-2;background:linear-gradient(180deg,color-mix(in srgb,var(--overlay) 88%,transparent),color-mix(in srgb,var(--overlay) 94%,transparent))}.ag-choose__in{width:min(calc(100% - 34px),980px);margin:auto}.ag-choose h2{margin:0;max-width:760px;color:var(--t);font-size:clamp(40px,5.2vw,62px);font-weight:820;line-height:1.02;letter-spacing:-.04em}.ag-choose__intro{max-width:800px;margin-top:22px;color:var(--t);font-size:17px;line-height:1.62}.ag-choose__intro p{margin:0}.ag-choose__rows{margin-top:34px;border-top:1px solid var(--line)}.ag-choose__row{padding:23px 0;border-bottom:1px solid var(--line)}.ag-choose__row h3{margin:0;color:var(--t);font-size:20px;font-weight:820}.ag-choose__row .rte{margin-top:7px;color:var(--t);font-size:15px;line-height:1.55}.ag-choose__row .rte p{margin:0}.ag-choose__button{display:flex;align-items:center;justify-content:center;width:100%;min-height:58px;margin-top:34px;border-radius:10px;background:var(--btn);color:var(--btntext);font-size:17px;font-weight:850;text-decoration:none}.ag-choose__guarantee{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:18px;color:var(--t);font-size:14px}.ag-choose__shield{display:grid;place-items:center;width:26px;height:26px}.ag-choose__shield svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}@media(max-width:749px){.ag-choose{padding:48px 0}.ag-choose__in{width:min(calc(100% - 36px),680px)}.ag-choose h2{font-size:42px}.ag-choose__intro{margin-top:18px;font-size:15px}.ag-choose__rows{margin-top:26px}.ag-choose__row{padding:20px 0}.ag-choose__row h3{font-size:18px}.ag-choose__row .rte{font-size:14px}.ag-choose__button{margin-top:28px;min-height:56px}}
{% endstylesheet %}

{% schema %}
{
  "name":"Why Customers Choose Avonent",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"image_picker","id":"background_image","label":"Background image"},
    {"type":"text","id":"heading","label":"Heading","default":"Why Customers Choose Avonent"},
    {"type":"richtext","id":"intro","label":"Intro text","default":"<p>Avonent Aged Garlic is designed to be a simple addition to your daily wellness routine.</p>"},
    {"type":"text","id":"button_text","label":"Button text","default":"Try Risk-Free Today"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"guarantee_text","label":"Guarantee text","default":"30-day money-back guarantee"},
    {"type":"color","id":"background","label":"Fallback background","default":"#02C6EA"},
    {"type":"color","id":"overlay","label":"Image overlay","default":"#0068E8"},
    {"type":"color","id":"text","label":"Text","default":"#FFFFFF"},
    {"type":"color","id":"line","label":"Divider","default":"#7EE8F6"},
    {"type":"color","id":"button_bg","label":"Button background","default":"#FFFFFF"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#071A52"}
  ],
  "blocks":[
    {
      "type":"reason",
      "name":"Reason",
      "settings":[
        {"type":"text","id":"heading","label":"Title","default":"Two Daily Softgels"},
        {"type":"richtext","id":"text","label":"Text","default":"<p>A straightforward serving that fits into a consistent daily routine.</p>"}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Why Customers Choose Avonent","blocks":[{"type":"reason"},{"type":"reason"},{"type":"reason"},{"type":"reason"}]}]
}
{% endschema %}
        {"type":"select","id":"icon","label":"Icon","default":"auto","options":[
          {"value":"auto","label":"Auto from title"},
          {"value":"energy","label":"Energy / lightning"},
          {"value":"joint","label":"Joint / movement"},
          {"value":"metabolic","label":"Metabolic / exchange"},
          {"value":"heart","label":"Heart"},
          {"value":"aging","label":"Healthy aging / sparkle"},
          {"value":"immune","label":"Immune / shield"},
          {"value":"leaf","label":"Leaf / botanical"}
        ]},
        {"type":"text","id":"title","label":"Title","default":"Daily Energy"},
        {"type":"text","id":"front_line","label":"Front line","default":"Wake up with real energy. Stay steady all day."},
        {"type":"textarea","id":"back_copy","label":"Back copy","default":"Moringa leaf is packed with plant nutrients your body uses for everyday energy — so you feel fueled without relying on another coffee."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Avonent benefit flips",
      "blocks": [
        {"type":"benefit","settings":{"icon":"energy","title":"Daily Energy","front_line":"Wake up with real energy. Stay steady all day.","back_copy":"Moringa leaf is packed with plant nutrients your body uses for everyday energy — so you feel fueled without relying on another coffee."}},
        {"type":"benefit","settings":{"icon":"joint","title":"Joint Comfort","front_line":"Move easier. Recover like you used to.","back_copy":"Used for generations as a daily botanical for movement. Modern interest focuses on joint comfort and everyday mobility support.†"}},
        {"type":"benefit","settings":{"icon":"metabolic","title":"Metabolic Wellness","front_line":"Support the way your body handles energy.","back_copy":"Human studies have explored moringa and markers like fasting glucose and HbA1c. The research is promising and still growing.†"}},
        {"type":"benefit","settings":{"icon":"heart","title":"Heart Wellness","front_line":"Daily support for a healthier heart routine.","back_copy":"Moringa’s nutrient and antioxidant profile is studied for cardiometabolic wellness — a simple daily add-on for heart-healthy habits.†"}},
        {"type":"benefit","settings":{"icon":"aging","title":"Healthy Aging","front_line":"Feel stronger as the years add up.","back_copy":"Antioxidant plant compounds help support the body against everyday oxidative stress — the kind that adds up over time.†"}},
        {"type":"benefit","settings":{"icon":"immune","title":"Immune Defense","front_line":"Nutritional backup for everyday immune function.","back_copy":"Vitamins, minerals, and phytonutrients in moringa leaf help support normal immune function as part of a daily wellness routine.†"}}
      ]

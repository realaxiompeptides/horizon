{% liquid
  assign section_id = 'AvonentResearchBenefits-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-research-benefits"
  style="
    --arb-bg: {{ section.settings.background_color }};
    --arb-card-bg: {{ section.settings.card_background }};
    --arb-visual-bg: {{ section.settings.visual_background }};
    --arb-text: {{ section.settings.text_color }};
    --arb-muted: {{ section.settings.muted_text_color }};
    --arb-accent: {{ section.settings.accent_color }};
    --arb-border: {{ section.settings.border_color }};
    --arb-width: {{ section.settings.content_width }}px;
    --arb-gap: {{ section.settings.card_gap }}px;
    --arb-height-desktop: {{ section.settings.card_height_desktop }}px;
    --arb-height-mobile: {{ section.settings.card_height_mobile }}px;
    --arb-visual-desktop: {{ section.settings.visual_size_desktop }}px;
    --arb-visual-mobile: {{ section.settings.visual_size_mobile }}px;
    --arb-top: {{ section.settings.padding_top_desktop }}px;
    --arb-bottom: {{ section.settings.padding_bottom_desktop }}px;
    --arb-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --arb-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="avonent-research-benefits__inner">
    <header class="avonent-research-benefits__header">
      <h2 class="avonent-research-benefits__heading">
        {% if section.settings.heading_accent != blank %}<span>{{ section.settings.heading_accent }}</span>{% endif %}
        {% if section.settings.heading_rest != blank %} {{ section.settings.heading_rest }}{% endif %}
      </h2>
      {% if section.settings.subheading != blank %}
        <div class="avonent-research-benefits__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </header>

    <div class="avonent-research-benefits__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign icon_name = block.settings.icon
          if icon_name == blank or icon_name == 'auto'
            assign title_lower = block.settings.title | downcase
            if title_lower contains 'energy'
              assign icon_name = 'energy'
            elsif title_lower contains 'joint' or title_lower contains 'movement'
              assign icon_name = 'joint'
            elsif title_lower contains 'metabolic' or title_lower contains 'glucose'
              assign icon_name = 'metabolic'
            elsif title_lower contains 'heart'
              assign icon_name = 'heart'
            elsif title_lower contains 'aging' or title_lower contains 'antioxidant'
              assign icon_name = 'aging'
            elsif title_lower contains 'immune'
              assign icon_name = 'immune'
            else
              assign icon_name = 'leaf'
            endif
          endif
        %}

        <div class="avonent-research-benefits__card" role="listitem" {{ block.shopify_attributes }}>
          <button
            class="avonent-research-benefits__button"
            type="button"
            aria-expanded="false"
            aria-label="Open {{ block.settings.title | escape }} details"
            data-arb-card
          >
            <span class="avonent-research-benefits__flipper">
              <span class="avonent-research-benefits__face avonent-research-benefits__face--front" data-arb-front>
                <span class="avonent-research-benefits__visual" aria-hidden="true">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 420, height: 420, crop: 'center' | image_tag: loading: 'lazy', class: 'avonent-research-benefits__image', alt: '' }}
                  {% else %}
                    <span class="avonent-research-benefits__icon">
                      {% case icon_name %}
                        {% when 'energy' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.2 2.5 5.8 13h5.7l-.7 8.5L18.2 11h-5.7l.7-8.5Z"/></svg>
                        {% when 'joint' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M10 7h7v7M5 12a7 7 0 0 0 7 7M12 5a7 7 0 0 1 7 7"/></svg>
                        {% when 'metabolic' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h12M14 4l3 3-3 3M19 17H7M10 14l-3 3 3 3"/></svg>
                        {% when 'heart' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 5.7a5 5 0 0 0-7.1 0L12 6.9l-1.2-1.2a5 5 0 0 0-7.1 7.1L12 21l8.3-8.2a5 5 0 0 0 0-7.1Z"/></svg>
                        {% when 'aging' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.5 4.3L18 9l-4.5 1.7L12 15l-1.5-4.3L6 9l4.5-1.7L12 3ZM18.5 14l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2ZM5 14l.7 1.8 1.8.7-1.8.7L5 19l-.7-1.8-1.8-.7 1.8-.7L5 14Z"/></svg>
                        {% when 'immune' %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 4.8-2.9 8-7 10-4.1-2-7-5.2-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                        {% else %}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5C12 4.5 6 8.2 6 14.2c0 2.7 1.8 4.8 4.6 4.8 6.1 0 8.9-7.2 8.9-14.5Z"/><path d="M5 20c2.2-4.8 5.3-7.8 10-10"/></svg>
                      {% endcase %}
                    </span>
                  {% endif %}
                </span>

                <span class="avonent-research-benefits__front-copy">
                  <strong class="avonent-research-benefits__title">{{ block.settings.title }}</strong>
                  <span class="avonent-research-benefits__line">{{ block.settings.front_line }}</span>
                </span>

                <span class="avonent-research-benefits__toggle" aria-hidden="true">+</span>
              </span>

              <span class="avonent-research-benefits__face avonent-research-benefits__face--back" aria-hidden="true" data-arb-back>
                <span class="avonent-research-benefits__back-copy">
                  <strong class="avonent-research-benefits__back-title">{{ block.settings.title }}</strong>
                  <span class="avonent-research-benefits__back-text">{{ block.settings.back_copy }}</span>
                </span>

                <span class="avonent-research-benefits__toggle" aria-hidden="true">−</span>
              </span>
            </span>
          </button>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .avonent-research-benefits {
    padding: var(--arb-top) 0 var(--arb-bottom);
    background: var(--arb-bg);
    color: var(--arb-text);
  }

  .avonent-research-benefits__inner {
    width: min(calc(100% - 40px), var(--arb-width));
    margin: 0 auto;
  }

  .avonent-research-benefits__header {
    width: min(100%, 760px);
    margin: 0 auto 34px;
    text-align: center;
  }

  .avonent-research-benefits__heading {
    margin: 0;
    color: var(--arb-text);
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -.035em;
  }

  .avonent-research-benefits__heading span {
    color: var(--arb-accent);
  }

  .avonent-research-benefits__subheading {
    margin: 13px auto 0;
    color: var(--arb-muted);
    font-size: 16px;
    line-height: 1.45;
  }

  .avonent-research-benefits__subheading p {
    margin: 0;
  }

  .avonent-research-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--arb-gap);
  }

  .avonent-research-benefits__card {
    min-width: 0;
    height: var(--arb-height-desktop);
    perspective: 1200px;
  }

  .avonent-research-benefits__button {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .avonent-research-benefits__button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--arb-accent) 55%, white);
    outline-offset: 3px;
    border-radius: 14px;
  }

  .avonent-research-benefits__flipper {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 520ms cubic-bezier(.2,.72,.2,1);
  }

  .avonent-research-benefits__button[aria-expanded='true'] .avonent-research-benefits__flipper {
    transform: rotateX(180deg);
  }

  .avonent-research-benefits__face {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    border: 1px solid var(--arb-border);
    border-radius: 14px;
    background: var(--arb-card-bg);
    box-shadow: 0 8px 28px rgb(17 24 39 / .035);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
  }

  .avonent-research-benefits__face--front {
    grid-template-columns: var(--arb-visual-desktop) minmax(0,1fr) 42px;
    gap: 18px;
    padding: 12px 20px 12px 12px;
  }

  .avonent-research-benefits__face--back {
    grid-template-columns: minmax(0,1fr) 42px;
    gap: 18px;
    padding: 24px 22px 24px 28px;
    transform: rotateX(180deg);
    background: color-mix(in srgb, var(--arb-card-bg) 88%, var(--arb-accent) 12%);
  }

  .avonent-research-benefits__visual {
    display: grid;
    width: var(--arb-visual-desktop);
    height: var(--arb-visual-desktop);
    aspect-ratio: 1 / 1;
    place-items: center;
    overflow: hidden;
    border-radius: 10px;
    background: var(--arb-visual-bg);
  }

  .avonent-research-benefits__image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
  }

  .avonent-research-benefits__icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    color: var(--arb-accent);
  }

  .avonent-research-benefits__icon svg {
    display: block;
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avonent-research-benefits__front-copy,
  .avonent-research-benefits__back-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
  }

  .avonent-research-benefits__title,
  .avonent-research-benefits__back-title {
    color: var(--arb-text);
    font-size: 21px;
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -.02em;
  }

  .avonent-research-benefits__line {
    margin-top: 5px;
    color: var(--arb-muted);
    font-size: 16px;
    line-height: 1.35;
  }

  .avonent-research-benefits__back-text {
    margin-top: 8px;
    color: var(--arb-muted);
    font-size: 15px;
    line-height: 1.48;
  }

  .avonent-research-benefits__toggle {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    justify-self: end;
    color: var(--arb-muted);
    border: 1px solid var(--arb-border);
    border-radius: 50%;
    background: white;
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .avonent-research-benefits {
      padding: var(--arb-top-mobile) 0 var(--arb-bottom-mobile);
    }

    .avonent-research-benefits__inner {
      width: min(calc(100% - 24px), var(--arb-width));
    }

    .avonent-research-benefits__header {
      width: min(100%, 420px);
      margin-bottom: 20px;
      padding-inline: 4px;
    }

    .avonent-research-benefits__heading {
      font-size: clamp(27px, 8.2vw, 34px);
      line-height: 1.03;
      text-wrap: balance;
    }

    .avonent-research-benefits__subheading {
      margin-top: 10px;
      font-size: 14.5px;
      line-height: 1.4;
    }

    .avonent-research-benefits__grid {
      grid-template-columns: 1fr;
      gap: max(10px, var(--arb-gap));
    }

    .avonent-research-benefits__card {
      height: var(--arb-height-mobile);
    }

    .avonent-research-benefits__face {
      border-radius: 13px;
    }

    .avonent-research-benefits__face--front {
      grid-template-columns: var(--arb-visual-mobile) minmax(0,1fr) 32px;
      gap: 11px;
      padding: 10px 11px 10px 10px;
    }

    .avonent-research-benefits__visual {
      width: var(--arb-visual-mobile);
      height: var(--arb-visual-mobile);
      aspect-ratio: 1 / 1;
      border-radius: 9px;
    }

    .avonent-research-benefits__icon {
      width: 40px;
      height: 40px;
    }

    .avonent-research-benefits__icon svg {
      width: 31px;
      height: 31px;
    }

    .avonent-research-benefits__face--back {
      grid-template-columns: minmax(0,1fr) 32px;
      gap: 9px;
      padding: 16px 12px 16px 16px;
    }

    .avonent-research-benefits__title,
    .avonent-research-benefits__back-title {
      font-size: 17px;
      line-height: 1.15;
    }

    .avonent-research-benefits__line {
      margin-top: 4px;
      font-size: 13.5px;
      line-height: 1.3;
    }

    .avonent-research-benefits__back-text {
      margin-top: 6px;
      font-size: 13.2px;
      line-height: 1.38;
    }

    .avonent-research-benefits__toggle {
      width: 30px;
      height: 30px;
      font-size: 19px;
    }
  }

  @media screen and (max-width: 390px) {
    .avonent-research-benefits__face--front {
      grid-template-columns: var(--arb-visual-mobile) minmax(0,1fr) 28px;
      gap: 9px;
      padding-right: 8px;
    }

    .avonent-research-benefits__toggle {
      width: 28px;
      height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avonent-research-benefits__flipper {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('{{ section_id }}');
    if (!section || section.dataset.flipReady === 'true') return;
    section.dataset.flipReady = 'true';

    const cards = Array.from(section.querySelectorAll('[data-arb-card]'));

    const closeCard = (card) => {
      card.setAttribute('aria-expanded', 'false');
      const front = card.querySelector('[data-arb-front]');
      const back = card.querySelector('[data-arb-back]');
      if (front) front.setAttribute('aria-hidden', 'false');
      if (back) back.setAttribute('aria-hidden', 'true');
    };

    const openCard = (card) => {
      cards.forEach((other) => {
        if (other !== card) closeCard(other);
      });
      card.setAttribute('aria-expanded', 'true');
      const front = card.querySelector('[data-arb-front]');
      const back = card.querySelector('[data-arb-back]');
      if (front) front.setAttribute('aria-hidden', 'true');
      if (back) back.setAttribute('aria-hidden', 'false');
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const isOpen = card.getAttribute('aria-expanded') === 'true';
        if (isOpen) closeCard(card);
        else openCard(card);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Avonent benefit flips",
  "tag": "section",
  "class": "section-avonent-benefit-flips",
  "max_blocks": 6,
  "settings": [
    {"type":"header","content":"Heading"},
    {"type":"text","id":"heading_accent","label":"Accent heading text","default":"Real Benefits."},
    {"type":"text","id":"heading_rest","label":"Heading text","default":"Backed by Research."},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>One plant. Multiple reasons people take it every day.</p>"},

    {"type":"header","content":"Layout"},
    {"type":"range","id":"content_width","label":"Content width","min":800,"max":1400,"step":20,"unit":"px","default":1200},
    {"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":2,"unit":"px","default":14},
    {"type":"range","id":"card_height_desktop","label":"Desktop card height","min":120,"max":260,"step":10,"unit":"px","default":150},
    {"type":"range","id":"card_height_mobile","label":"Mobile card height","min":110,"max":220,"step":10,"unit":"px","default":130},
    {"type":"range","id":"visual_size_desktop","label":"Desktop square image/icon size","min":80,"max":140,"step":4,"unit":"px","default":104},
    {"type":"range","id":"visual_size_mobile","label":"Mobile square image/icon size","min":60,"max":100,"step":4,"unit":"px","default":76},
    {"type":"range","id":"padding_top_desktop","label":"Desktop spacing above","min":0,"max":140,"step":4,"unit":"px","default":52},
    {"type":"range","id":"padding_bottom_desktop","label":"Desktop spacing below","min":0,"max":140,"step":4,"unit":"px","default":52},
    {"type":"range","id":"padding_top_mobile","label":"Mobile spacing above","min":0,"max":100,"step":4,"unit":"px","default":32},
    {"type":"range","id":"padding_bottom_mobile","label":"Mobile spacing below","min":0,"max":100,"step":4,"unit":"px","default":32},

    {"type":"header","content":"Colors"},
    {"type":"color","id":"background_color","label":"Section background","default":"#F7F8F2"},
    {"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"visual_background","label":"Square icon background","default":"#E8F8FC"},
    {"type":"color","id":"text_color","label":"Heading text","default":"#111111"},
    {"type":"color","id":"muted_text_color","label":"Body text","default":"#4F5965"},
    {"type":"color","id":"accent_color","label":"Icon / accent color","default":"#02C6EA"},
    {"type":"color","id":"border_color","label":"Card border","default":"#D8DEE2"}
  ],
  "blocks": [
    {

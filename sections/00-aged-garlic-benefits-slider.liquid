<section
  id="AGBenefits-{{ section.id }}"
  class="ag-benefits"
  style="--bg:{{ section.settings.background }};--t:{{ section.settings.text }};--m:{{ section.settings.muted }};--a:{{ section.settings.accent }};--card:{{ section.settings.card }};"
>
  <div class="ag-benefits__in">
    <h2>{{ section.settings.heading_before }} <span>{{ section.settings.heading_accent }}</span></h2>

    <div class="ag-benefits__slider" data-ag-benefits-slider>
      <div class="ag-benefits__track" data-ag-benefits-track>
        {% for block in section.blocks %}
          <article class="ag-benefits__slide{% if forloop.first %} is-active{% endif %}" data-ag-benefit-slide {{ block.shopify_attributes }}>
            <div class="ag-benefits__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', loading: 'lazy', class: 'ag-benefits__img', alt: block.settings.heading }}
              {% elsif forloop.index == 1 and product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', loading: 'lazy', class: 'ag-benefits__img ag-benefits__img--contain', alt: product.title }}
              {% elsif forloop.index == 2 %}
                <img class="ag-benefits__img ag-benefits__img--contain" src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-aged-garlic-softgel-realistic.png?v=1792648420" alt="Golden aged garlic softgels" loading="lazy">
              {% else %}
                <div class="ag-benefits__placeholder">
                  <span>ADD IMAGE</span>
                  <small>Choose a benefit image in Shopify</small>
                </div>
              {% endif %}
            </div>

            <div class="ag-benefits__copy">
              <h3>{{ block.settings.heading }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="ag-benefits__controls">
        <button type="button" class="ag-benefits__arrow" data-ag-benefits-prev aria-label="Previous benefit">‹</button>
        <div class="ag-benefits__dots">
          {% for block in section.blocks %}
            <button type="button" class="ag-benefits__dot{% if forloop.first %} is-active{% endif %}" data-ag-benefits-dot data-index="{{ forloop.index0 }}" aria-label="Show benefit {{ forloop.index }}"></button>
          {% endfor %}
        </div>
        <button type="button" class="ag-benefits__arrow" data-ag-benefits-next aria-label="Next benefit">›</button>
      </div>
    </div>
  </div>

  <div class="ag-benefits__post">
    <div class="ag-benefits__choose" style="--choose-bg:{{ section.settings.choose_background }};--choose-overlay:{{ section.settings.choose_overlay }};">
      {% if section.settings.choose_background_image != blank %}
        {{ section.settings.choose_background_image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '100vw', loading: 'lazy', class: 'ag-benefits__choose-bg', alt: section.settings.choose_heading }}
      {% endif %}
      <div class="ag-benefits__choose-wash"></div>
      <div class="ag-benefits__choose-in">
        <h2>{{ section.settings.choose_heading }}</h2>
        <div class="ag-benefits__choose-intro rte">{{ section.settings.choose_intro }}</div>

        <div class="ag-benefits__choose-rows">
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_1_heading }}</h3>
            <div class="rte">{{ section.settings.reason_1_text }}</div>
          </div>
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_2_heading }}</h3>
            <div class="rte">{{ section.settings.reason_2_text }}</div>
          </div>
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_3_heading }}</h3>
            <div class="rte">{{ section.settings.reason_3_text }}</div>
          </div>
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_4_heading }}</h3>
            <div class="rte">{{ section.settings.reason_4_text }}</div>
          </div>
        </div>

        {% if section.settings.choose_button_text != blank %}
          <a class="ag-benefits__choose-btn" href="{{ section.settings.choose_button_link | default: '#avonent-garlic-buy' }}">{{ section.settings.choose_button_text }}</a>
        {% endif %}
        <div class="ag-benefits__choose-guarantee">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 27 7v8c0 7-4.5 11.8-11 14-6.5-2.2-11-7-11-14V7z"></path><path d="m11 16 3 3 7-8"></path></svg>
          <span>{{ section.settings.choose_guarantee }}</span>
        </div>
      </div>
    </div>

    <div class="ag-benefits__daily">
      <div class="ag-benefits__daily-card">
        <h2>{{ section.settings.daily_heading }}</h2>
        <div class="ag-benefits__daily-intro rte">{{ section.settings.daily_intro }}</div>
        <div class="ag-benefits__daily-grid">
          <div class="ag-benefits__daily-points">
            <div class="ag-benefits__daily-point">
              <i></i>
              <h3>{{ section.settings.daily_point_1_heading }}</h3>
              <div class="rte">{{ section.settings.daily_point_1_text }}</div>
            </div>
            <div class="ag-benefits__daily-point">
              <i></i>
              <h3>{{ section.settings.daily_point_2_heading }}</h3>
              <div class="rte">{{ section.settings.daily_point_2_text }}</div>
            </div>
          </div>
          <div class="ag-benefits__daily-visual">
            {% if section.settings.daily_visual != blank %}
              {{ section.settings.daily_visual | image_url: width: 900 | image_tag: widths: '320,480,640,900', loading: 'lazy', class: 'ag-benefits__daily-img', alt: section.settings.daily_visual_alt }}
            {% else %}
              <div class="ag-benefits__daily-capsule" aria-hidden="true"></div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="ag-benefits__image-break">
      {% if section.settings.break_image != blank %}
        {{ section.settings.break_image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '(min-width:1000px) 960px,calc(100vw - 28px)', loading: 'lazy', class: 'ag-benefits__break-img', alt: section.settings.break_alt }}
      {% else %}
        <div class="ag-benefits__break-placeholder">
          <strong>Add your image in the theme editor</strong>
          <span>This image sits directly below the daily-use section.</span>
        </div>
      {% endif %}
    </div>

    <div class="ag-benefits__wellness" style="--wellness-bg:{{ section.settings.wellness_background }};--wellness-ring:{{ section.settings.wellness_ring }};">
      <div class="ag-benefits__wellness-in">
        <h2>{{ section.settings.wellness_heading }}</h2>
        <div class="ag-benefits__wellness-sub rte">{{ section.settings.wellness_subheading }}</div>

        <div class="ag-benefits__wellness-grid">
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon">{% render 'icon', icon: 'heart' %}</span>
            <strong>{{ section.settings.wellness_1 }}</strong>
          </div>
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon ag-benefits__wellness-icon--shield">
              <svg viewBox="0 0 48 48"><path d="M24 4 40 10v12c0 11-7 18-16 22C15 40 8 33 8 22V10z"></path><path d="M18 24h12M24 18v12"></path></svg>
            </span>
            <strong>{{ section.settings.wellness_2 }}</strong>
          </div>
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon">
              <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="M24 14v11l8 5"></path></svg>
            </span>
            <strong>{{ section.settings.wellness_3 }}</strong>
          </div>
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon">
              <svg viewBox="0 0 48 48"><path d="M13 15c6 0 8 4 11 9 3-5 5-9 11-9"></path><path d="M10 9c8 2 11 8 14 15C27 17 30 11 38 9"></path><path d="M24 24v16"></path></svg>
            </span>
            <strong>{{ section.settings.wellness_4 }}</strong>
          </div>
        </div>

        <div class="ag-benefits__wellness-product">
          <span class="ag-benefits__ring ag-benefits__ring--1"></span>
          <span class="ag-benefits__ring ag-benefits__ring--2"></span>
          <span class="ag-benefits__ring ag-benefits__ring--3"></span>
          {% if section.settings.wellness_product_image != blank %}
            {{ section.settings.wellness_product_image | image_url: width: 1000 | image_tag: widths: '360,540,720,1000', loading: 'lazy', class: 'ag-benefits__wellness-img', alt: product.title }}
          {% elsif product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 1000 | image_tag: widths: '360,540,720,1000', loading: 'lazy', class: 'ag-benefits__wellness-img', alt: product.title }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('AGBenefits-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const slides = [...root.querySelectorAll('[data-ag-benefit-slide]')];
  const dots = [...root.querySelectorAll('[data-ag-benefits-dot]')];
  const prev = root.querySelector('[data-ag-benefits-prev]');
  const next = root.querySelector('[data-ag-benefits-next]');
  let index = 0;

  const show = (nextIndex) => {
    if (!slides.length) return;
    index = (nextIndex + slides.length) % slides.length;
    slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
    dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
  };

  prev?.addEventListener('click', () => show(index - 1));
  next?.addEventListener('click', () => show(index + 1));
  dots.forEach((dot) => dot.addEventListener('click', () => show(Number(dot.dataset.index || 0))));

  let startX = 0;
  root.addEventListener('touchstart', (e) => { startX = e.touches[0]?.clientX || 0; }, { passive: true });
  root.addEventListener('touchend', (e) => {
    const endX = e.changedTouches[0]?.clientX || startX;
    const delta = endX - startX;
    if (Math.abs(delta) > 45) show(index + (delta < 0 ? 1 : -1));
  }, { passive: true });
})();
</script>

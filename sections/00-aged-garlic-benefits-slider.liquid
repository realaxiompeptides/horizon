<section
  id="AGBenefits-{{ section.id }}"
  class="ag-benefits"
  style="--bg:{{ section.settings.background }};--t:{{ section.settings.text }};--m:{{ section.settings.muted }};--a:{{ section.settings.accent }};--card:{{ section.settings.card }};"
>
  <div class="ag-benefits__in">
    <h2>{{ section.settings.heading_before }} <span>{{ section.settings.heading_accent }}</span></h2>

    <div class="ag-benefits__slider" data-ag-benefits-slider>
      <div class="ag-benefits__track" data-ag-benefits-track>
        {% for block in section.blocks %}
          <article class="ag-benefits__slide{% if forloop.first %} is-active{% endif %}" data-ag-benefit-slide {{ block.shopify_attributes }}>
            <div class="ag-benefits__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', loading: 'lazy', class: 'ag-benefits__img', alt: block.settings.heading }}
              {% elsif forloop.index == 1 and product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', loading: 'lazy', class: 'ag-benefits__img ag-benefits__img--contain', alt: product.title }}
              {% elsif forloop.index == 2 %}
                <img class="ag-benefits__img ag-benefits__img--contain" src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-aged-garlic-softgel-realistic.png?v=1792648420" alt="Golden aged garlic softgels" loading="lazy">
              {% else %}
                <div class="ag-benefits__placeholder">
                  <span>ADD IMAGE</span>
                  <small>Choose a benefit image in Shopify</small>
                </div>
              {% endif %}
            </div>

            <div class="ag-benefits__copy">
              <h3>{{ block.settings.heading }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="ag-benefits__controls">
        <button type="button" class="ag-benefits__arrow" data-ag-benefits-prev aria-label="Previous benefit">‹</button>
        <div class="ag-benefits__dots">
          {% for block in section.blocks %}
            <button type="button" class="ag-benefits__dot{% if forloop.first %} is-active{% endif %}" data-ag-benefits-dot data-index="{{ forloop.index0 }}" aria-label="Show benefit {{ forloop.index }}"></button>
          {% endfor %}
        </div>
        <button type="button" class="ag-benefits__arrow" data-ag-benefits-next aria-label="Next benefit">›</button>
      </div>
    </div>
  </div>

  <div class="ag-benefits__extra-cta"><a class="ag-benefits__stage-button" href="#avonent-garlic-buy" data-garlic-bottom-offer>{{ section.settings.extra_button_text }} <span aria-hidden="true">↓</span></a></div>
  <div class="ag-benefits__post">
    <div class="ag-benefits__choose" style="--choose-bg:{{ section.settings.choose_background }};--choose-overlay:{{ section.settings.choose_overlay }};">
      {% if section.settings.choose_background_image != blank %}
        {{ section.settings.choose_background_image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1600,1800', sizes: '100vw', loading: 'lazy', class: 'ag-benefits__choose-bg', alt: section.settings.choose_heading }}
      {% endif %}
      <div class="ag-benefits__choose-wash"></div>
      <div class="ag-benefits__choose-in">
        <h2>{{ section.settings.choose_heading }}</h2>
        <div class="ag-benefits__choose-intro rte">{{ section.settings.choose_intro }}</div>

        <div class="ag-benefits__choose-rows">
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_1_heading }}</h3>
            <div class="rte">{{ section.settings.reason_1_text }}</div>
          </div>
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_2_heading }}</h3>
            <div class="rte">{{ section.settings.reason_2_text }}</div>
          </div>
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_3_heading }}</h3>
            <div class="rte">{{ section.settings.reason_3_text }}</div>
          </div>
          <div class="ag-benefits__choose-row">
            <h3>{{ section.settings.reason_4_heading }}</h3>
            <div class="rte">{{ section.settings.reason_4_text }}</div>
          </div>
        </div>

        {% if section.settings.choose_button_text != blank %}
          <a class="ag-benefits__choose-btn" href="#avonent-garlic-buy" data-garlic-bottom-offer>{{ section.settings.choose_button_text }}</a>
        {% endif %}
        <div class="ag-benefits__choose-guarantee">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 27 7v8c0 7-4.5 11.8-11 14-6.5-2.2-11-7-11-14V7z"></path><path d="m11 16 3 3 7-8"></path></svg>
          <span>{{ section.settings.choose_guarantee }}</span>
        </div>
      </div>
    </div>

    <div class="ag-benefits__daily">
      <div class="ag-benefits__daily-card">
        <h2>{{ section.settings.daily_heading }}</h2>
        <div class="ag-benefits__daily-intro rte">{{ section.settings.daily_intro }}</div>
        <div class="ag-benefits__daily-grid">
          <div class="ag-benefits__daily-points">
            <div class="ag-benefits__daily-point">
              <i></i>
              <h3>{{ section.settings.daily_point_1_heading }}</h3>
              <div class="rte">{{ section.settings.daily_point_1_text }}</div>
            </div>
            <div class="ag-benefits__daily-point">
              <i></i>
              <h3>{{ section.settings.daily_point_2_heading }}</h3>
              <div class="rte">{{ section.settings.daily_point_2_text }}</div>
            </div>
          </div>
          <div class="ag-benefits__daily-visual">
            {% if section.settings.daily_visual != blank %}
              {{ section.settings.daily_visual | image_url: width: 900 | image_tag: widths: '320,480,640,900', loading: 'lazy', class: 'ag-benefits__daily-img', alt: section.settings.daily_visual_alt }}
            {% else %}
              <div class="ag-benefits__daily-capsule" aria-hidden="true"></div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="ag-benefits__image-break" style="--break-bg:{{ section.settings.break_background }};--break-accent:{{ section.settings.break_accent }};">
      <div class="ag-benefits__break-stage">
        <span class="ag-benefits__marble ag-benefits__marble--a" aria-hidden="true"></span>
        <span class="ag-benefits__marble ag-benefits__marble--b" aria-hidden="true"></span>
        <span class="ag-benefits__marble ag-benefits__marble--c" aria-hidden="true"></span>
        <span class="ag-benefits__marble ag-benefits__marble--d" aria-hidden="true"></span>
        <span class="ag-benefits__marble ag-benefits__marble--e" aria-hidden="true"></span>
        {% if section.settings.break_image != blank %}
          {{ section.settings.break_image | image_url: width: 1200 | image_tag: widths: '360,540,720,900,1200', sizes: '(min-width:1000px) 480px,62vw', loading: 'lazy', class: 'ag-benefits__break-img', alt: section.settings.break_alt }}
        {% else %}
          <div class="ag-benefits__break-placeholder">
            <strong>Add your product image in the theme editor</strong>
            <span>Use a transparent PNG for the cleanest result.</span>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ag-benefits__wellness" style="--wellness-bg:{{ section.settings.wellness_background }};--wellness-ring:{{ section.settings.wellness_ring }};">
      <div class="ag-benefits__wellness-in">
        <h2>{{ section.settings.wellness_heading }}</h2>
        <div class="ag-benefits__wellness-sub rte">{{ section.settings.wellness_subheading }}</div>

        <div class="ag-benefits__wellness-grid">
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon">
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path d="M24 42S6 32.2 6 18.5C6 10.9 15.1 7.1 20.7 13c1.4 1.5 2.5 3.2 3.3 4.9.8-1.7 1.9-3.4 3.3-4.9C32.9 7.1 42 10.9 42 18.5 42 32.2 24 42 24 42z"></path>
                <path d="M10 25h8l3-7 5.2 14 3.8-8H39"></path>
              </svg>
            </span>
            <strong>{{ section.settings.wellness_1 }}</strong>
          </div>
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon ag-benefits__wellness-icon--shield">
              <svg viewBox="0 0 48 48"><path d="M24 4 40 10v12c0 11-7 18-16 22C15 40 8 33 8 22V10z"></path><path d="M18 24h12M24 18v12"></path></svg>
            </span>
            <strong>{{ section.settings.wellness_2 }}</strong>
          </div>
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon">
              <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"></circle><path d="M24 14v11l8 5"></path></svg>
            </span>
            <strong>{{ section.settings.wellness_3 }}</strong>
          </div>
          <div class="ag-benefits__wellness-item">
            <span class="ag-benefits__wellness-icon">
              <svg viewBox="0 0 48 48"><path d="M13 15c6 0 8 4 11 9 3-5 5-9 11-9"></path><path d="M10 9c8 2 11 8 14 15C27 17 30 11 38 9"></path><path d="M24 24v16"></path></svg>
            </span>
            <strong>{{ section.settings.wellness_4 }}</strong>
          </div>
        </div>

        <div class="ag-benefits__wellness-product">
          <span class="ag-benefits__ring ag-benefits__ring--1"></span>
          <span class="ag-benefits__ring ag-benefits__ring--2"></span>
          <span class="ag-benefits__ring ag-benefits__ring--3"></span>
          {% if section.settings.wellness_product_image != blank %}
            {{ section.settings.wellness_product_image | image_url: width: 1000 | image_tag: widths: '360,540,720,1000', loading: 'lazy', class: 'ag-benefits__wellness-img', alt: product.title }}
          {% elsif product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 1000 | image_tag: widths: '360,540,720,1000', loading: 'lazy', class: 'ag-benefits__wellness-img', alt: product.title }}
          {% endif %}
        </div>
      </div>
    </div>

    <div id="aged-garlic-details" class="ag-benefits__crafted">
      <div class="ag-benefits__crafted-in">
        <h2>{{ section.settings.crafted_heading }}</h2>
        <div class="ag-benefits__crafted-intro rte">{{ section.settings.crafted_intro }}</div>

        <div class="ag-benefits__crafted-list">
          {% for i in (1..4) %}
            {% assign image_key = 'crafted_' | append: i | append: '_image' %}
            {% assign title_key = 'crafted_' | append: i | append: '_title' %}
            {% assign subtitle_key = 'crafted_' | append: i | append: '_subtitle' %}
            {% assign body_key = 'crafted_' | append: i | append: '_body' %}
            {% assign card_image = section.settings[image_key] %}
            {% assign card_title = section.settings[title_key] %}
            {% assign card_subtitle = section.settings[subtitle_key] %}
            {% assign card_body = section.settings[body_key] %}

            <button type="button" class="ag-benefits__flipcard" data-crafted-card aria-pressed="false">
              <span class="ag-benefits__flipcard-inner">
                <span class="ag-benefits__flipface ag-benefits__flipface--front">
                  {% if card_image != blank %}
                    {{ card_image | image_url: width: 360 | image_tag: widths: '140,200,280,360', loading: 'lazy', class: 'ag-benefits__crafted-thumb', alt: card_title }}
                  {% else %}
                    <span class="ag-benefits__crafted-thumb ag-benefits__crafted-thumb--empty">
                      <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 39 18 28l7 7 6-8 9 12"></path><circle cx="17" cy="16" r="4"></circle><rect x="5" y="7" width="38" height="34" rx="4"></rect></svg>
                    </span>
                  {% endif %}
                  <span class="ag-benefits__crafted-copy">
                    <strong>{{ card_title }}</strong>
                    {% if card_subtitle != blank %}<small>{{ card_subtitle }}</small>{% endif %}
                  </span>
                  <span class="ag-benefits__crafted-toggle" aria-hidden="true"></span>
                </span>

                <span class="ag-benefits__flipface ag-benefits__flipface--back">
                  <span class="ag-benefits__flipback-title">{{ card_title }}</span>
                  <span class="ag-benefits__flipback-body rte">{{ card_body }}</span>
                  <span class="ag-benefits__crafted-toggle ag-benefits__crafted-toggle--back" aria-hidden="true"></span>
                </span>
              </span>
            </button>
          {% endfor %}
        </div>

        {% if section.settings.crafted_footer != blank %}
          <div class="ag-benefits__marquee" data-garlic-marquee>
            <div class="ag-benefits__marquee-window">
              <div class="ag-benefits__marquee-track">
                {% assign marquee_items = section.settings.crafted_footer | split: '·' %}
                {% for repeat in (1..2) %}
                  <div class="ag-benefits__marquee-group"{% if repeat == 2 %} aria-hidden="true"{% endif %}>
                    {% for item in marquee_items %}<span><b aria-hidden="true">✓</b>{{ item | strip | escape }}</span>{% endfor %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ag-benefits__stages" data-stage-timeline style="--stage-progress:0%;">
      <div class="ag-benefits__stages-in">
        {% if section.settings.stage_eyebrow != blank %}<div class="ag-benefits__stage-eyebrow">{{ section.settings.stage_eyebrow }}</div>{% endif %}
        <h2>{{ section.settings.stage_heading }}</h2>
        {% if section.settings.stage_intro != blank %}<div class="ag-benefits__stage-intro rte">{{ section.settings.stage_intro }}</div>{% endif %}

        <div class="ag-benefits__timeline">
          <span class="ag-benefits__timeline-rail" aria-hidden="true"><i></i></span>
          {% for i in (1..4) %}
            {% assign stage_title_key = 'stage_' | append: i | append: '_title' %}
            {% assign stage_text_key = 'stage_' | append: i | append: '_text' %}
            <article class="ag-benefits__stage{% if forloop.first %} is-active{% endif %}" data-stage-item data-stage-index="{{ forloop.index0 }}">
              <span class="ag-benefits__stage-dot" aria-hidden="true">
                <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="13"></circle><path d="m10.5 16.5 3.4 3.4 7.8-8"></path></svg>
              </span>
              <div class="ag-benefits__stage-copy">
                <small>Stage {{ i }}</small>
                <h3>{{ section.settings[stage_title_key] }}</h3>
                <div class="rte">{{ section.settings[stage_text_key] }}</div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if section.settings.stage_button_text != blank %}
          <a class="ag-benefits__stage-button" href="#avonent-garlic-buy" data-garlic-bottom-offer>{{ section.settings.stage_button_text }} <span>↓</span></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('AGBenefits-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const slides = [...root.querySelectorAll('[data-ag-benefit-slide]')];
  const dots = [...root.querySelectorAll('[data-ag-benefits-dot]')];
  const prev = root.querySelector('[data-ag-benefits-prev]');
  const next = root.querySelector('[data-ag-benefits-next]');
  let index = 0;

  const show = (nextIndex) => {
    if (!slides.length) return;
    index = (nextIndex + slides.length) % slides.length;
    slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
    dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
  };

  prev?.addEventListener('click', () => show(index - 1));
  next?.addEventListener('click', () => show(index + 1));
  dots.forEach((dot) => dot.addEventListener('click', () => show(Number(dot.dataset.index || 0))));

  let startX = 0;
  root.addEventListener('touchstart', (e) => { startX = e.touches[0]?.clientX || 0; }, { passive: true });
  root.addEventListener('touchend', (e) => {
    const endX = e.changedTouches[0]?.clientX || startX;
    const delta = endX - startX;
    if (Math.abs(delta) > 45) show(index + (delta < 0 ? 1 : -1));
  }, { passive: true });

  root.querySelectorAll('[data-crafted-card]').forEach((card) => {
    const flip = () => {
      const active = card.classList.toggle('is-flipped');
      card.setAttribute('aria-pressed', active ? 'true' : 'false');
    };
    card.addEventListener('click', flip);
  });

  const timeline = root.querySelector('[data-stage-timeline]');
  const stageItems = timeline ? [...timeline.querySelectorAll('[data-stage-item]')] : [];
  if (timeline && stageItems.length) {
    const activate = (index) => {
      const max = stageItems.length - 1;
      const clamped = Math.max(0, Math.min(index, max));
      stageItems.forEach((item, i) => item.classList.toggle('is-active', i <= clamped));
      timeline.style.setProperty('--stage-progress', max > 0 ? ((clamped / max) * 100) + '%' : '100%');
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const idx = Number(entry.target.dataset.stageIndex || 0);
        activate(idx);
      });
    }, { rootMargin: '-28% 0px -48% 0px', threshold: 0.15 });

    stageItems.forEach((item) => observer.observe(item));
    activate(0);
  }
})();
</script>
{% stylesheet %}
/* Garlic legacy purge: these blocks were removed from product.garlic, but this also hides any stale rendered copy. */
.aged-garlic-story__why,
.aged-garlic-story__education,
.aged-garlic-story__formula,
.aged-garlic-story__routine,
.aged-garlic-story__comparison,
.aged-garlic-story__offer,
.aged-garlic-story__disclaimer,
.ag-softgel{display:none!important}

:56px 0 0}.ag-benefits__wellness h2{margin:0;color:#fff;font-size:clamp(38px,5vw,56px)}.ag-benefits__wellness-sub{max-width:720px;margin:14px auto 0;color:#E8FBFF;text-align:center;font-size:16px;line-height:1.55}.ag-benefits__wellness-sub p{margin:0}.ag-benefits__wellness-grid{display:grid;grid-template-columns:1fr 1fr;gap:38px 30px;max-width:720px;margin:44px auto 20px}.ag-benefits__wellness-item{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center}.ag-benefits__wellness-icon{display:grid;place-items:center;width:62px;height:62px;color:#fff}.ag-benefits__wellness-icon svg{width:54px;height:54px;fill:none;stroke:currentColor;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}.ag-benefits__wellness-item strong{max-width:250px;font-size:18px;line-height:1.25}.ag-benefits__wellness-product{position:relative;display:grid;place-items:end center;min-height:500px;margin-top:20px}.ag-benefits__wellness-img{position:relative;z-index:3;display:block;max-width:min(62%,430px);max-height:460px;width:auto;height:auto;object-fit:contain;filter:drop-shadow(0 24px 24px rgb(0 60 130 / 18%))}.ag-benefits__ring{position:absolute;left:50%;bottom:0;transform:translateX(-50%);border:1.5px dashed var(--wellness-ring);border-radius:50% 50% 0 0}.ag-benefits__ring--1{width:76%;height:300px}.ag-benefits__ring--2{width:59%;height:235px}.ag-benefits__ring--3{width:43%;height:170px}@media(max-width:749px){.ag-benefits{padding:34px 0 38px}.ag-benefits h2{margin-bottom:22px;font-size:35px}.ag-benefits__media{height:420px;padding:12px 12px 0}.ag-benefits__copy{padding:20px 18px 22px}.ag-benefits__copy h3{font-size:21px}.ag-benefits__copy .rte{font-size:13.5px}.ag-benefits__controls{margin-top:14px}.ag-benefits__post{margin-top:34px}.ag-benefits__choose-in{padding:46px 0}.ag-benefits__choose h2{font-size:40px}.ag-benefits__choose-intro{font-size:15px}.ag-benefits__choose-row{padding:19px 0}.ag-benefits__daily{padding:34px 14px}.ag-benefits__daily-card{padding:24p
<script>
(() => {
  const root = document.getElementById('AvonentListicle-{{ section.id }}');
  if (!root) return;
  const intervals = [];
  const cleaners = [];
  const sticky = root.querySelector('[data-avl-sticky]');
  const firstButton = root.querySelector('.avl-hero .avl-button');
  if (sticky && firstButton) {
    const updateSticky = () => {
      const rect = firstButton.getBoundingClientRect();
      const hasPassed = rect.bottom < 0;
      sticky.classList.toggle('avl-sticky--visible', hasPassed);
      sticky.setAttribute('aria-hidden', String(!hasPassed));
    };
    window.addEventListener('scroll', updateSticky, { passive: true });
    document.addEventListener('scroll', updateSticky, { passive: true, capture: true });
    window.addEventListener('resize', updateSticky, { passive: true });
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(updateSticky, { threshold: [0, 1] });
      observer.observe(firstButton);
      cleaners.push(() => observer.disconnect());
    }
    cleaners.push(() => window.removeEventListener('scroll', updateSticky));
    cleaners.push(() => document.removeEventListener('scroll', updateSticky, true));
    cleaners.push(() => window.removeEventListener('resize', updateSticky));
    updateSticky();
    window.requestAnimationFrame(updateSticky);
  }
  const timer = root.querySelector('[data-avl-timer]');
  if (timer) {
    const duration = Math.max(1, Number(timer.dataset.duration) || 420) * 1000;
    const configuredDeadline = Date.parse(timer.dataset.deadline || '');
    const shouldRepeat = timer.dataset.repeat === 'true';
    const storageKey = 'avonent-listicle-timer-{{ section.id }}';
    let until = Number.isFinite(configuredDeadline) ? configuredDeadline : 0;
    if (!until) {
      try {
        until = Number(window.sessionStorage.getItem(storageKey)) || 0;
        if (!until) {
          until = Date.now() + duration;
          window.sessionStorage.setItem(storageKey, String(until));
        }
      } catch (error) {
        until = Date.now() + duration;
      }
    }
    const minutes = timer.querySelector('[data-avl-minutes]');
    const seconds = timer.querySelector('[data-avl-seconds]');
    const label = timer.querySelector('[data-avl-timer-label]');
    const activeLabel = label ? label.textContent : '';
    const saveUntil = () => {
      try {
        window.sessionStorage.setItem(storageKey, String(until));
      } catch (error) {}
    };
    const updateTimer = () => {
      let remaining = Math.max(0, Math.ceil((until - Date.now()) / 1000));
      if (remaining === 0 && shouldRepeat) {
        until = Date.now() + duration;
        saveUntil();
        remaining = Math.ceil(duration / 1000);
        timer.removeAttribute('data-expired');
        if (label) label.textContent = activeLabel;
      }
      minutes.textContent = String(Math.floor(remaining / 60)).padStart(2, '0');
      seconds.textContent = String(remaining % 60).padStart(2, '0');
      if (remaining === 0) {
        timer.setAttribute('data-expired', 'true');
        if (label) label.textContent = 'DEAL WINDOW ENDED';
      }
    };
    updateTimer();
    intervals.push(window.setInterval(updateTimer, 1000));
  }
  const carousel = root.querySelector('[data-avl-carousel]');
  if (carousel) {
    const viewport = carousel.querySelector('[data-avl-viewport]');
    const slides = Array.from(carousel.querySelectorAll('.avl-review'));
    const dots = carousel.querySelector('[data-avl-dots]');
    const prev = carousel.querySelector('[data-avl-prev]');
    const next = carousel.querySelector('[data-avl-next]');
    const scrollToSlide = (index) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
      if (target) viewport.scrollTo({ left: target.offsetLeft - slides[0].offsetLeft, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    slides.forEach((slide, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'avl-review-carousel__dot';
      dot.setAttribute('aria-label', 'Show review ' + (index + 1));
      dot.addEventListener('click', () => scrollToSlide(index));
      dots.appendChild(dot);
    });
    let active = 0;
    const updateDots = () => {
      const first = slides[0];
      if (!first) return;
      const left = viewport.scrollLeft;
      let best = 0;
      let distance = Infinity;
      slides.forEach((slide, index) => {
        const delta = Math.abs((slide.offsetLeft - first.offsetLeft) - left);
        if (delta < distance) { distance = delta; best = index; }
      });
      active = best;
      Array.from(dots.children).forEach((dot, index) => dot.setAttribute('aria-current', String(index === active)));
      prev.disabled = active === 0;
      next.disabled = active === slides.length - 1;
    };
    prev.addEventListener('click', () => scrollToSlide(active - 1));
    next.addEventListener('click', () => scrollToSlide(active + 1));
    viewport.addEventListener('scroll', updateDots, { passive: true });
    window.addEventListener('resize', updateDots, { passive: true });
    updateDots();
  }
  document.addEventListener('shopify:section:unload', (event) => {
    if (event.detail?.sectionId === '{{ section.id }}') { intervals.forEach(window.clearInterval); cleaners.forEach((fn) => fn()); }
  });
})();
</script>



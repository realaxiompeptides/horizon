{% comment %}
  Avonent cart-only polish.
  Loaded from templates/cart.json so these styles stay isolated to the full cart page.
{% endcomment %}

<style>
  /* Tighten the total -> checkout flow. */
  .cart-page__summary .cart-totals {
    margin-top: 10px !important;
    padding-top: 12px !important;
  }

  .cart-page__summary .avonent-cart-ctas {
    margin-top: 10px !important;
    gap: 9px !important;
  }

  .cart-page__summary .cart-totals__total {
    min-height: 44px;
  }

  /* Full cart product row: keep image, copy, price and controls in clean columns. */
  @media screen and (max-width: 749px) {
    .cart-page__items {
      padding: 18px 22px 20px !important;
    }

    .cart-page__items .cart-items__table-row {
      display: grid !important;
      grid-template-columns: 112px minmax(0, 1fr) auto !important;
      grid-template-rows: auto auto auto auto !important;
      grid-template-areas:
        'media details price'
        'media variants variants'
        'media unitprice unitprice'
        'media quantity quantity' !important;
      column-gap: 16px !important;
      row-gap: 7px !important;
      align-items: start !important;
      padding: 8px 0 22px !important;
      margin: 0 !important;
    }

    .cart-page__items .cart-items__media {
      grid-area: media !important;
      width: 112px !important;
      align-self: start !important;
    }

    .cart-page__items .cart-items__media-container {
      display: block !important;
      width: 112px !important;
      max-width: 112px !important;
      aspect-ratio: 1 / 1 !important;
      overflow: hidden !important;
      border-radius: 16px !important;
      background: #eefaff !important;
    }

    .cart-page__items .cart-items__media-image {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
      border-radius: 16px !important;
    }

    .cart-page__items .cart-items__details {
      display: contents !important;
      padding: 0 !important;
    }

    .cart-page__items .cart-items__product-info {
      grid-area: details !important;
      min-width: 0 !important;
      padding-top: 1px !important;
    }

    .cart-page__items .cart-items__variants-wrapper {
      grid-area: variants !important;
      min-width: 0 !important;
    }

    .cart-page__items .cart-items__unit-price-wrapper {
      grid-area: unitprice !important;
      min-width: 0 !important;
    }

    .cart-page__items .cart-items__quantity {
      grid-area: quantity !important;
      margin-top: 3px !important;
    }

    .cart-page__items .cart-items__price {
      grid-area: price !important;
      width: max-content !important;
      min-width: 0 !important;
      justify-self: end !important;
      padding-left: 8px !important;
      color: #111 !important;
      font-size: 16px !important;
      font-weight: 800 !important;
    }

    .cart-page__items .cart-items__title {
      display: block !important;
      max-width: 100% !important;
      font-size: 18px !important;
      line-height: 1.12 !important;
      letter-spacing: -.025em !important;
    }

    .cart-page__items .cart-items__quantity-controls {
      display: flex !important;
      align-items: center !important;
      gap: 12px !important;
    }

    .cart-page__items quantity-selector,
    .cart-page__items .quantity-selector {
      min-width: 138px !important;
      min-height: 48px !important;
    }

    .cart-page__summary {
      padding: 14px 22px 20px !important;
    }

    .cart-page__summary .cart-totals__total-label {
      font-size: 15px !important;
    }

    .cart-page__summary .cart-totals__total-value {
      font-size: 22px !important;
    }
  }

  /* You may also like: make it feel like an Avonent recommendation block, not default Shopify. */
  .ui-test-product-list {
    padding-top: 34px !important;
    padding-bottom: 42px !important;
  }

  .ui-test-product-list .section-resource-list__header {
    margin-bottom: 18px !important;
  }

  .ui-test-product-list .section-resource-list__header h2,
  .ui-test-product-list .section-resource-list__header h3 {
    margin: 0 !important;
    color: #071114 !important;
    font-family: var(--font-heading--family) !important;
    font-size: clamp(28px, 7vw, 38px) !important;
    font-weight: 820 !important;
    line-height: 1.02 !important;
    letter-spacing: -.04em !important;
  }

  .ui-test-product-list .section-resource-list__header .button-unstyled {
    display: none !important;
  }

  .ui-test-product-list .resource-list__item {
    overflow: hidden !important;
    padding: 10px 10px 14px !important;
    border: 1px solid #d5edf3 !important;
    border-radius: 18px !important;
    background: #fff !important;
    box-shadow: 0 10px 28px rgba(6, 73, 88, .07) !important;
  }

  .ui-test-product-list .resource-list__item img {
    border-radius: 14px !important;
  }

  .ui-test-product-list .resource-list__item :is(h1,h2,h3,h4,h5,h6,p,a) {
    font-family: var(--font-heading--family) !important;
  }

  .ui-test-product-list .resource-list__item a:not(:has(img)) {
    color: #071114 !important;
    font-weight: 760 !important;
    line-height: 1.2 !important;
    letter-spacing: -.018em !important;
    text-decoration: none !important;
  }

  .ui-test-product-list .resource-list__item s {
    color: #7a8589 !important;
    font-weight: 500 !important;
  }

  @media screen and (max-width: 749px) {
    .ui-test-product-list {
      padding-inline: 18px !important;
      padding-top: 30px !important;
      padding-bottom: 36px !important;
    }

    .ui-test-product-list .section-resource-list__header {
      margin-bottom: 15px !important;
    }

    .ui-test-product-list .resource-list__item {
      padding: 8px 8px 12px !important;
      border-radius: 16px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Avonent Cart Polish",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": []
}
{% endschema %}

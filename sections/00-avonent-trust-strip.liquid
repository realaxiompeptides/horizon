<section
  class="avonent-trust-strip"
  style="
    --av-trust-bg: {{ section.settings.background_color }};
    --av-trust-text: {{ section.settings.text_color }};
    --av-trust-accent: {{ section.settings.accent_color }};
    --av-trust-padding-top: {{ section.settings.padding_top }}px;
    --av-trust-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="avonent-trust-strip__inner">

    {% for block in section.blocks %}
      <div
        class="avonent-trust-strip__item"
        {{ block.shopify_attributes }}
      >
        <div class="avonent-trust-strip__icon">

          {% case block.settings.icon %}

            {% when 'check' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M8.3 12.1 10.7 14.5 15.8 9.5"></path>
              </svg>

            {% when 'shield' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3 19 6v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6z"></path>
                <path d="M9 12.1 11.1 14.2 15.3 10"></path>
              </svg>

            {% when 'lab' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 3h6"></path>
                <path d="M10 3v6l-5 8.2A2.4 2.4 0 0 0 7 21h10a2.4 2.4 0 0 0 2-3.8L14 9V3"></path>
                <path d="M8.5 14h7"></path>
              </svg>

            {% when 'flag' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 3v18"></path>
                <path d="M6 4h10l-2 3 2 3H6"></path>
              </svg>

            {% when 'truck' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 6h11v9H3z"></path>
                <path d="M14 10h3.5L21 13v2h-7z"></path>
                <circle cx="8" cy="17" r="1.7"></circle>
                <circle cx="18" cy="17" r="1.7"></circle>
              </svg>

            {% when 'star' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 3 2.7 5.5 6 .9-4.4 4.2 1 6-5.3-2.8-5.3 2.8 1-6-4.4-4.2 6-.9z"></path>
              </svg>

            {% else %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M8.3 12.1 10.7 14.5 15.8 9.5"></path>
              </svg>

          {% endcase %}

        </div>

        <div class="avonent-trust-strip__text">
          {{ block.settings.text }}
        </div>
      </div>
    {% endfor %}

  </div>
</section>

{% stylesheet %}

  .avonent-trust-strip {
    width: 100%;

    padding-top: var(--av-trust-padding-top);
    padding-bottom: var(--av-trust-padding-bottom);

    background: var(--av-trust-bg);
    color: var(--av-trust-text);
  }

  .avonent-trust-strip__inner {
    width: min(calc(100% - 40px), 1180px);

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: clamp(32px, 7vw, 100px);
  }

  .avonent-trust-strip__item {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    min-width: 0;

    color: var(--av-trust-text);

    text-align: left;
  }

  .avonent-trust-strip__icon {
    flex: 0 0 21px;

    width: 21px;
    height: 21px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--av-trust-accent);
  }

  .avonent-trust-strip__icon svg {
    display: block;

    width: 100%;
    height: 100%;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avonent-trust-strip__text {
    font-family: var(--font-body--family);

    font-size: 15px;
    font-weight: 500;

    line-height: 1.25;

    color: inherit;
  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    .avonent-trust-strip__inner {
      width: calc(100% - 24px);

      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      align-items: start;

      gap: 8px;
    }

    .avonent-trust-strip__item {
      display: flex;

      align-items: flex-start;
      justify-content: center;

      gap: 6px;

      min-width: 0;
    }

    .avonent-trust-strip__icon {
      flex: 0 0 17px;

      width: 17px;
      height: 17px;

      margin-top: 1px;
    }

    .avonent-trust-strip__text {
      max-width: 95px;

      font-size: 11px;
      font-weight: 500;

      line-height: 1.25;
    }

  }


  /*
   * SMALL PHONES
   */

  @media screen and (max-width: 380px) {

    .avonent-trust-strip__inner {
      width: calc(100% - 16px);

      gap: 5px;
    }

    .avonent-trust-strip__item {
      gap: 4px;
    }

    .avonent-trust-strip__icon {
      flex-basis: 15px;

      width: 15px;
      height: 15px;
    }

    .avonent-trust-strip__text {
      max-width: 88px;

      font-size: 10px;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "00 Avonent Trust Strip",
  "tag": "section",
  "class": "avonent-trust-strip-section",

  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icons",
      "default": "#02C6EA"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    }
  ],

  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "check",
              "label": "Check circle"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "lab",
              "label": "Lab flask"
            },
            {
              "value": "flag",
              "label": "Flag"
            },
            {
              "value": "truck",
              "label": "Shipping truck"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "30-Day Risk-Free Trial"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "00 Avonent Trust Strip",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "shield",
            "text": "30-Day Risk-Free Trial"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "lab",
            "text": "Third-Party Lab Tested"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "flag",
            "text": "Ships from USA"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section
  class="avonent-trust-strip"
  style="
    --av-trust-bg: {{ section.settings.background_color }};
    --av-trust-text: {{ section.settings.text_color }};
    --av-trust-accent: {{ section.settings.accent_color }};
    --av-trust-padding-top: {{ section.settings.padding_top }}px;
    --av-trust-padding-bottom: {{ section.settings.padding_bottom }}px;
    --av-trust-speed: {{ section.settings.speed | default: 18 }}s;
  "
>
  <div class="avonent-trust-strip__viewport" aria-label="Avonent store benefits">
    <div class="avonent-trust-strip__track">
      {% for repeat_i in (1..6) %}
        <div class="avonent-trust-strip__group"{% if repeat_i != 1 %} aria-hidden="true"{% endif %}>
          {% for block in section.blocks %}
            <div
              class="avonent-trust-strip__item"
              {% if repeat_i == 1 %}{{ block.shopify_attributes }}{% endif %}
            >
              <div class="avonent-trust-strip__icon">
                {% case block.settings.icon %}
                  {% when 'check' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M8.3 12.1 10.7 14.5 15.8 9.5"></path>
                    </svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3 19 6v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6z"></path>
                      <path d="M9 12.1 11.1 14.2 15.3 10"></path>
                    </svg>
                  {% when 'lab' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M9 3h6"></path>
                      <path d="M10 3v6l-5 8.2A2.4 2.4 0 0 0 7 21h10a2.4 2.4 0 0 0 2-3.8L14 9V3"></path>
                      <path d="M8.5 14h7"></path>
                    </svg>
                  {% when 'flag' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 3v18"></path>
                      <path d="M6 4h10l-2 3 2 3H6"></path>
                    </svg>
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M3 6h11v9H3z"></path>
                      <path d="M14 10h3.5L21 13v2h-7z"></path>
                      <circle cx="8" cy="17" r="1.7"></circle>
                      <circle cx="18" cy="17" r="1.7"></circle>
                    </svg>
                  {% when 'star' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m12 3 2.7 5.5 6 .9-4.4 4.2 1 6-5.3-2.8-5.3 2.8 1-6-4.4-4.2 6-.9z"></path>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M8.3 12.1 10.7 14.5 15.8 9.5"></path>
                    </svg>
                {% endcase %}
              </div>

              <div class="avonent-trust-strip__text">
                {{ block.settings.text }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<div class="avonent-faq-proofs" id="AvonentFaqProofs-{{ section.id }}">
  <div class="avonent-faq-proofs__inner">
    <div class="avonent-faq-proofs__faq">
      <div class="avonent-faq-proofs__heading">
        <h2>{{ section.settings.faq_title | escape }}</h2>
        <p>{{ section.settings.faq_description | escape }}</p>
      </div>
      <div class="avonent-faq-proofs__questions">
        <details class="avonent-faq-proofs__question">
          <summary><span>{{ section.settings.faq_q1 | escape }}</span><span class="avonent-faq-proofs__toggle" aria-hidden="true"></span></summary>
          <div class="avonent-faq-proofs__answer rte">{{ section.settings.faq_a1 }}</div>
        </details>
        <details class="avonent-faq-proofs__question">
          <summary><span>{{ section.settings.faq_q2 | escape }}</span><span class="avonent-faq-proofs__toggle" aria-hidden="true"></span></summary>
          <div class="avonent-faq-proofs__answer rte">{{ section.settings.faq_a2 }}</div>
        </details>
        <details class="avonent-faq-proofs__question">
          <summary><span>{{ section.settings.faq_q3 | escape }}</span><span class="avonent-faq-proofs__toggle" aria-hidden="true"></span></summary>
          <div class="avonent-faq-proofs__answer rte">{{ section.settings.faq_a3 }}</div>
        </details>
        <details class="avonent-faq-proofs__question">
          <summary><span>{{ section.settings.faq_q4 | escape }}</span><span class="avonent-faq-proofs__toggle" aria-hidden="true"></span></summary>
          <div class="avonent-faq-proofs__answer rte">{{ section.settings.faq_a4 }}</div>
        </details>
      </div>
    </div>
    <div class="avonent-proof-grid" aria-label="Avonent trust information">
      <div class="avonent-proof-grid__card">
        <span class="avonent-proof-grid__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none"><path d="M9 39V16L24 6l15 10v23H9Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M17 23h4v5h-4zm10 0h4v5h-4zM17 31h4v5h-4zm10 0h4v5h-4z" fill="currentColor"/><path d="M21 39v-5h6v5" stroke="currentColor" stroke-width="2.5"/></svg>
        </span>
        <span>{{ section.settings.proof_1 | escape }}</span>
      </div>
      <div class="avonent-proof-grid__card">
        <span class="avonent-proof-grid__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none"><path d="m21 10 7 7m-11 5 10-10m-8 10 5 5m4-14 5 5M16 28l8-8m-1 8a10 10 0 0 1-10 10H9m19-11a10 10 0 0 1-10 11h19M8 41h32" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="14" r="2" fill="currentColor"/></svg>
        </span>
        <span>{{ section.settings.proof_2 | escape }}</span>
      </div>
      <div class="avonent-proof-grid__card">
        <span class="avonent-proof-grid__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none"><rect x="6" y="10" width="32" height="23" rx="4" stroke="currentColor" stroke-width="2.5"/><path d="M7 17h30" stroke="currentColor" stroke-width="2.5"/><path d="m29 26 6-2 6 2v6c0 4-2.5 6.5-6 8-3.5-1.5-6-4-6-8v-6Z" fill="#E7F9FF" stroke="currentColor" stroke-width="2.5"/><path d="m32.5 32 2 2 3.5-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span>{{ section.settings.proof_3 | escape }}</span>
      </div>
      <div class="avonent-proof-grid__card">
        <span class="avonent-proof-grid__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none"><path d="M5 16h23v17H5zM28 22h7l7 8v3H28" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><circle cx="14" cy="35" r="3" fill="#E7F9FF" stroke="currentColor" stroke-width="2.5"/><circle cx="35" cy="35" r="3" fill="#E7F9FF" stroke="currentColor" stroke-width="2.5"/><path d="M8 11h9m-12 4h7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M31 11v5m0-5a6 6 0 1 1 0 12" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"/></svg>
        </span>
        <span>{{ section.settings.proof_4 | escape }}</span>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .avonent-trust-strip {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    padding-block: var(--av-trust-padding-top) var(--av-trust-padding-bottom);
    background: var(--av-trust-bg);
    color: var(--av-trust-text);
    border-block: 1px solid rgba(4, 52, 76, .10);
    isolation: isolate;
  }
  .avonent-trust-strip,
  .avonent-trust-strip * {
    box-sizing: border-box;
  }
  .avonent-trust-strip__viewport {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
  }
  .avonent-trust-strip__track {
    display: flex;
    align-items: center;
    width: max-content;
    min-width: max-content;
    max-width: none;
    gap: 0;
    transform: translate3d(0,0,0);
    will-change: transform;
    animation: avonent-trust-strip-marquee var(--av-trust-speed) linear infinite;
  }
  .avonent-trust-strip__group {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    width: max-content;
    min-width: max-content;
    gap: 0;
    padding: 0;
  }
  .avonent-trust-strip__item {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    width: max-content;
    min-width: max-content;
    gap: 10px;
    padding-inline: clamp(24px, 3vw, 52px);
    color: var(--av-trust-text);
    white-space: nowrap;
    text-align: left;
  }
  .avonent-trust-strip__icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    color: var(--av-trust-accent);
  }
  .avonent-trust-strip__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .avonent-trust-strip__text {
    display: block;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 650;
    letter-spacing: .005em;
    line-height: 1.35;
    color: inherit;
    white-space: nowrap;
  }
  .avonent-trust-strip:hover .avonent-trust-strip__track,
  .avonent-trust-strip:focus-within .avonent-trust-strip__track {
    animation-play-state: paused;
  }
  @keyframes avonent-trust-strip-marquee {
    from { transform: translate3d(0,0,0); }
    to { transform: translate3d(-16.6666667%,0,0); }
  }
  @media (max-width: 749px) {
    .avonent-trust-strip__viewport {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    }
    .avonent-trust-strip__track {
      animation-duration: calc(var(--av-trust-speed) * 1.4);
    }
    .avonent-trust-strip__item {
      gap: 8px;
      padding-inline: 22px;
    }
    .avonent-trust-strip__icon {
      flex-basis: 20px;
      width: 20px;
      height: 20px;
    }
    .avonent-trust-strip__text {
      font-size: 12.5px;
      font-weight: 650;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avonent-trust-strip__viewport {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .avonent-trust-strip__viewport::-webkit-scrollbar { display: none; }
    .avonent-trust-strip__track { animation: none; will-change: auto; }
    .avonent-trust-strip__group[aria-hidden="true"] { display: none; }
  }

  .avonent-faq-proofs {
    width:100%; background:#FFFFFF; color:#12273B; padding:clamp(60px,7vw,102px) 0 clamp(65px,8vw,110px);
  }
  .avonent-faq-proofs, .avonent-faq-proofs * { box-sizing:border-box; }
  .avonent-faq-proofs__inner { width:min(100% - 48px,1200px); margin-inline:auto; }
  .avonent-faq-proofs__faq { display:grid; grid-template-columns:minmax(0,.84fr) minmax(0,1.16fr); gap:clamp(30px,6vw,85px); align-items:start; }
  .avonent-faq-proofs__heading h2 {
    font-size:clamp(35px,3.6vw,55px); font-weight:730; letter-spacing:-.035em;
    line-height:1.13; color:#102B43; margin:0 0 16px; max-width:480px;
  }
  .avonent-faq-proofs__heading p { margin:0; color:#526779; max-width:455px; font-size:15px; line-height:1.65; }
  .avonent-faq-proofs__questions { display:flex; flex-direction:column; border:1px solid #DFE8EF; border-radius:14px; overflow:hidden; background:#FAFCFF; }
  .avonent-faq-proofs__question + .avonent-faq-proofs__question { border-top:1px solid #DFE8EF; }
  .avonent-faq-proofs__question[open] { background:#F1FAFE; }
  .avonent-faq-proofs__question summary { 
    list-style:none; display:flex; gap:18px; align-items:center; justify-content:space-between;
    padding:22px 24px; min-height:65px; font-size:15px; font-weight:630; line-height:1.45;
    color:#18334A; cursor:pointer; outline-offset:-3px;
  }
  .avonent-faq-proofs__question summary::-webkit-details-marker {display:none;}
  .avonent-faq-proofs__question summary::marker {content:"";}
  .avonent-faq-proofs__question summary:focus-visible {outline:2px solid #028EB7;}
  .avonent-faq-proofs__toggle {width:20px; height:20px; position:relative; flex:none;}
  .avonent-faq-proofs__toggle::before,
  .avonent-faq-proofs__toggle::after {content:""; position:absolute; top:50%; left:50%; background:#058FB4; transform:translate(-50%,-50%); border-radius:2px;}
  .avonent-faq-proofs__toggle::before {width:13px;height:2px;}
  .avonent-faq-proofs__toggle::after {height:13px;width:2px;}
  .avonent-faq-proofs__question[open] .avonent-faq-proofs__toggle::after {display:none;}
  .avonent-faq-proofs__answer {padding:0 24px 22px; font-size:14px; color:#526779; line-height:1.7;}
  .avonent-faq-proofs__answer p {margin:0 0 10px;color:inherit;line-height:inherit;}
  .avonent-faq-proofs__answer p:last-child {margin-bottom:0;}
  .avonent-faq-proofs__answer a {color:#007EA4;text-decoration:underline;text-underline-offset:3px;}
  .avonent-proof-grid {display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin-top:clamp(53px,6vw,88px);}
  .avonent-proof-grid__card {
    display:flex; flex-direction:column; gap:13px; align-items:center; justify-content:center;
    min-height:165px; padding:26px 16px; background:#F0FAFE; border:1px solid #E2F1F8;
    border-radius:9px; color:#113149; font-size:16px; line-height:1.35; font-weight:640; text-align:center;
  }
  .avonent-proof-grid__icon { display:flex; align-items:center; justify-content:center; width:56px; height:56px; background:#FFF; border:1px solid #D9EBF4; border-radius:50%; color:#078CAF;}
  .avonent-proof-grid__icon svg {width:30px; height:30px;display:block;}
  @media(max-width:920px) {
    .avonent-faq-proofs__faq {grid-template-columns:1fr; gap:30px;}
    .avonent-faq-proofs__heading h2 {max-width:700px;}
    .avonent-faq-proofs__heading p {max-width:700px;}
    .avonent-proof-grid {grid-template-columns:repeat(2,minmax(0,1fr));}
  }
  @media(max-width:530px) {
    .avonent-faq-proofs__inner {width:min(100% - 36px,560px);}
    .avonent-faq-proofs {padding:60px 0 70px;}
    .avonent-faq-proofs__heading h2 {font-size:clamp(33px,9vw,44px);}
    .avonent-faq-proofs__heading p {font-size:14px;}
    .avonent-faq-proofs__question summary {padding:18px 17px; font-size:14px;}
    .avonent-faq-proofs__answer {padding:0 17px 19px; font-size:13px;}
    .avonent-proof-grid {gap:10px; margin-top:50px;}
    .avonent-proof-grid__card {min-height:143px; padding:20px 9px; font-size:13px; gap:10px;}
    .avonent-proof-grid__icon {width:49px;height:49px;}
    .avonent-proof-grid__icon svg {width:27px;height:27px;}
  }

{% endstylesheet %}

{% schema %}

<section id="av-hub-{{ section.id }}" class="av-hub" data-av-demo>
  <div class="av-hub__hero">
    <div class="av-hub__wrap">
      <span class="av-hub__eyebrow">SUBSCRIBER HUB</span>
      <h1>Welcome back to<br><em>your wellness routine.</em></h1>
      <p>Make your deliveries fit your life. Manage your routine, take a break or explore your options whenever you need.</p>
      <div class="av-hub__hero-actions">
        <button class="av-hub__btn av-hub__accent" data-open="manage">Open my portal</button>
        <a class="av-hub__btn av-hub__outline" href="#av-options-{{ section.id }}">Need a break?</a>
        <button class="av-hub__btn av-hub__outline" data-open="guided">Explore cancellation options</button>
      </div>
      <div class="av-hub__checks"><span>✓ &nbsp; Skip a delivery</span><span>✓ &nbsp; Pause deliveries</span><span>✓ &nbsp; Adjust your timing</span><span>✓ &nbsp; Manage your plan</span></div>
      <div class="av-hub__demo-note">Preview environment · No real account or billing changes.</div>
    </div>
  </div>
  <div class="av-hub__wrap av-hub__body" id="av-options-{{ section.id }}">
    <span class="av-hub__eyebrow">LET'S FIND THE RIGHT FIT</span>
    <h2>What would you like to change?</h2>
    <p>Tell us what is not working for you, and we’ll show you options that fit your routine.</p>
    <div class="av-hub__reasons" role="group" aria-label="Optional reasons">
      <button data-reason="stock" aria-pressed="true">I have too much product</button>
      <button data-reason="price" aria-pressed="false">It's too expensive</button>
      <button data-reason="break" aria-pressed="false">I need a break</button>
      <button data-reason="timing" aria-pressed="false">Deliveries are too frequent</button>
      <button data-reason="results" aria-pressed="false">I'm not seeing results</button>
      <button data-reason="other" aria-pressed="false">Something else</button>
    </div>
    <div class="av-hub__solution" aria-live="polite">
      <span class="av-hub__tag">YOUR EASIEST OPTION</span>
      <h3 data-solution-title>Skip a delivery or stretch your timing</h3>
      <p data-solution-text>Still stocked up? Try skipping your next order or changing your delivery schedule to match your routine.</p>
      <div class="av-hub__pills" data-solution-actions>
        <button data-open="skip">Skip next order</button><button data-open="delay">Move to a later date</button><button data-open="frequency">Change my timing</button>
      </div>
      <button class="av-hub__btn av-hub__primary" data-open="manage">Open my portal</button>
      <button class="av-hub__btn av-hub__plain" data-open="guided">Explore cancellation options</button>
    </div>
    <div class="av-hub__info">
      <h3>You're always in control.</h3>
      <p>✓ &nbsp; Review your next scheduled delivery.</p>
      <p>✓ &nbsp; Choose a schedule that works for you.</p>
      <p>✓ &nbsp; Cancel whenever you choose.</p>
    </div>
    <div class="av-hub__bottom"><h3>Ready to cancel?</h3><p>You can cancel without answering any questions or accepting an offer.</p><button class="av-hub__btn av-hub__primary" data-open="guided">Review membership options</button><button class="av-hub__btn av-hub__plain" data-open="cancel">Cancel subscription</button><button class="av-hub__reset-link" data-reset>Reset preview</button></div>
  </div>
  <dialog class="av-hub__dialog" aria-labelledby="av-dialog-title-{{ section.id }}">
    <div class="av-hub__modal">
      <button class="av-hub__close" data-close aria-label="Close portal">×</button>
      <span class="av-hub__eyebrow">AVONENT · MY SUBSCRIPTION</span>
      <h2 id="av-dialog-title-{{ section.id }}" data-modal-title>Open my portal</h2>
      <p data-modal-description>Manage your upcoming deliveries and subscription preferences.</p>
      <div class="av-hub__account"><strong>Black Walnut Drops</strong><span>Recurring subscription</span><span data-status>Active · Every 30 days</span></div>
      <div data-modal-actions></div>
      <p class="av-hub__fine" data-message role="status"></p>
      <div class="av-hub__cancel-tools" data-cancel-tools><button class="av-hub__btn av-hub__plain" data-act="guided-start">Review my membership options</button><button class="av-hub__btn av-hub__plain" data-act="cancel-confirm">Cancel subscription</button></div>
      <button class="av-hub__reset-link" data-reset>Reset preview</button>
      <p class="av-hub__fine">Preview only · No actual billing changes.</p>
    </div>
  </dialog>
</section>
<style>
#av-hub-{{ section.id }}{--green:#557D4B;--deep:#355A38;--dark:#243f2b;--light:#EFF6EA;--accent:#BBD9AD;--line:#DBE8D4;color:var(--dark);background:#fff;font-family:inherit;line-height:1.55}
#av-hub-{{ section.id }} *{box-sizing:border-box}
#av-hub-{{ section.id }} [hidden]{display:none!important}
#av-hub-{{ section.id }} .av-hub__wrap{max-width:1080px;margin:auto;padding:0 24px}
#av-hub-{{ section.id }} .av-hub__hero{background:var(--dark);color:white;padding:56px 0 40px}
#av-hub-{{ section.id }} .av-hub__eyebrow{display:block;color:var(--green);font-size:12px;font-weight:800;letter-spacing:.16em;margin-bottom:14px}
#av-hub-{{ section.id }} .av-hub__hero .av-hub__eyebrow{color:var(--accent)}
#av-hub-{{ section.id }} h1,#av-hub-{{ section.id }} h2,#av-hub-{{ section.id }} h3{font-family:inherit;letter-spacing:-.04em;line-height:1.1;font-weight:800;margin:0 0 16px;color:inherit}
#av-hub-{{ section.id }} h1{font-size:clamp(40px,6vw,76px)}
#av-hub-{{ section.id }} h1 em{color:var(--accent);font-style:normal}
#av-hub-{{ section.id }} h2{font-size:clamp(30px,4vw,46px)}
#av-hub-{{ section.id }} h3{font-size:clamp(25px,3vw,36px)}
#av-hub-{{ section.id }} p{font-size:17px;margin:0 0 20px;color:inherit}
#av-hub-{{ section.id }} .av-hub__hero p{max-width:660px;color:#e5efe1;font-size:clamp(17px,2vw,23px)}
#av-hub-{{ section.id }} .av-hub__hero-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:28px 0}
#av-hub-{{ section.id }} button,#av-hub-{{ section.id }} a{font:inherit;cursor:pointer}
#av-hub-{{ section.id }} .av-hub__btn{display:flex;align-items:center;justify-content:center;min-height:52px;width:100%;padding:13px 16px;border:2px solid transparent;border-radius:9px;font-size:15px;font-weight:800;text-decoration:none;text-align:center;line-height:1.3}
#av-hub-{{ section.id }} .av-hub__accent{background:var(--accent);color:var(--dark)}
#av-hub-{{ section.id }} .av-hub__outline{background:transparent;color:white;border-color:#fff}
#av-hub-{{ section.id }} .av-hub__primary{background:var(--deep);color:#fff;border-color:var(--deep)}
#av-hub-{{ section.id }} .av-hub__plain{background:#fff;color:var(--deep);border-color:var(--deep);margin-top:10px}
#av-hub-{{ section.id }} .av-hub__checks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;font-size:15px;font-weight:700;max-width:650px}
#av-hub-{{ section.id }} .av-hub__demo-note{border-top:1px solid #ffffff33;margin-top:28px;padding-top:20px;color:#e5efe1;font-size:13px}
#av-hub-{{ section.id }} .av-hub__body{padding-top:48px;padding-bottom:64px;scroll-margin-top:100px}
#av-hub-{{ section.id }} .av-hub__reasons,#av-hub-{{ section.id }} .av-hub__pills{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0}
#av-hub-{{ section.id }} .av-hub__reasons button,#av-hub-{{ section.id }} .av-hub__pills button{background:#fff;color:var(--dark);border:1.5px solid #afc3aa;border-radius:8px;padding:12px 15px;font-size:15px;font-weight:750;min-height:46px;text-align:left}
#av-hub-{{ section.id }} .av-hub__reasons button[aria-pressed=true]{background:var(--deep);border-color:var(--deep);color:#fff}
#av-hub-{{ section.id }} .av-hub__solution,#av-hub-{{ section.id }} .av-hub__info,#av-hub-{{ section.id }} .av-hub__bottom{border-radius:18px;padding:clamp(22px,4vw,40px);margin-top:26px}
#av-hub-{{ section.id }} .av-hub__solution{background:var(--light)}
#av-hub-{{ section.id }} .av-hub__tag{display:inline-block;background:var(--deep);color:#fff;font-size:11px;font-weight:800;letter-spacing:.12em;padding:9px 12px;border-radius:6px;margin-bottom:18px}
#av-hub-{{ section.id }} .av-hub__pills button{border-radius:999px;border-color:var(--deep)}
#av-hub-{{ section.id }} .av-hub__info{background:var(--dark);color:#fff}
#av-hub-{{ section.id }} .av-hub__info p{margin:10px 0}
#av-hub-{{ section.id }} .av-hub__bottom{border:1px solid var(--line)}
#av-hub-{{ section.id }} .av-hub__dialog{max-width:min(540px,calc(100% - 28px));width:100%;max-height:90dvh;padding:0;border:0;border-radius:20px;color:var(--dark);background:#fff;box-shadow:0 20px 80px #0003;overflow:auto;position:fixed;inset:0;margin:auto}
#av-hub-{{ section.id }} .av-hub__dialog::backdrop{background:#18291f99;backdrop-filter:blur(4px)}
#av-hub-{{ section.id }} .av-hub__modal{padding:30px 24px;position:relative}
#av-hub-{{ section.id }} .av-hub__modal h2{padding-right:32px;font-size:32px}
#av-hub-{{ section.id }} .av-hub__close{position:absolute;right:16px;top:16px;background:var(--light);color:var(--dark);border:0;border-radius:8px;font-size:26px;width:42px;height:42px}
#av-hub-{{ section.id }} .av-hub__account{background:var(--light);border-radius:12px;padding:15px;margin:18px 0;display:grid;gap:5px;font-size:14px}
#av-hub-{{ section.id }} .av-hub__account strong{font-size:18px}
#av-hub-{{ section.id }} .av-hub__fine{font-size:13px;margin:14px 0 0}
#av-hub-{{ section.id }} [data-modal-actions]{display:grid;gap:10px}
#av-hub-{{ section.id }} :focus-visible{outline:3px solid #8aaa77;outline-offset:3px}
@media(max-width:640px){#av-hub-{{ section.id }} .av-hub__wrap{padding-inline:16px}#av-hub-{{ section.id }} .av-hub__hero{padding-top:42px}#av-hub-{{ section.id }} .av-hub__hero-actions{grid-template-columns:1fr}#av-hub-{{ section.id }} .av-hub__checks{gap:10px;font-size:14px}#av-hub-{{ section.id }} .av-hub__body{padding-top:35px}}
#av-hub-{{ section.id }} .av-hub__dialog{max-height:min(760px,calc(100dvh - 36px));overscroll-behavior:contain;scrollbar-width:thin}
#av-hub-{{ section.id }} .av-hub__modal{padding:24px}
#av-hub-{{ section.id }} .av-hub__modal .av-hub__eyebrow{padding-right:40px}
#av-hub-{{ section.id }} .av-hub__modal h2{font-size:clamp(26px,6vw,34px)}
#av-hub-{{ section.id }} .av-hub__modal p{font-size:15px;margin-bottom:12px}
#av-hub-{{ section.id }} .av-hub__account{margin:12px 0;padding:12px 15px}
#av-hub-{{ section.id }} .av-hub__modal .av-hub__btn{min-height:46px;padding:10px 14px}
#av-hub-{{ section.id }} .av-hub__modal .av-hub__plain{margin-top:0}
#av-hub-{{ section.id }} .av-hub__cancel-tools{display:grid;gap:8px;margin:12px 0}
#av-hub-{{ section.id }} .av-hub__reset-link{display:block;background:none;border:0;color:#355A38;text-decoration:underline;text-underline-offset:3px;font-size:13px;margin:12px auto;padding:8px}
#av-hub-{{ section.id }} .av-hub__review-card{padding:14px;background:var(--light);border:1px solid var(--line);border-radius:12px}
#av-hub-{{ section.id }} .av-hub__review-card p{margin:7px 0}
#av-hub-{{ section.id }} .av-hub__modal progress{border:0;border-radius:999px;overflow:hidden}
#av-hub-{{ section.id }} .av-hub__modal [aria-pressed=true]{background:var(--light);box-shadow:inset 0 0 0 1px var(--deep)}
@media(max-width:640px){#av-hub-{{ section.id }} .av-hub__modal{padding:20px 18px}#av-hub-{{ section.id }} .av-hub__dialog{max-height:calc(100dvh - 36px);max-width:calc(100% - 24px)}}
</style>
<script>
(function(){
const root=document.getElementById('av-hub-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='1';
const dialog=root.querySelector('dialog'), title=root.querySelector('[data-modal-title]'), desc=root.querySelector('[data-modal-description]'), actions=root.querySelector('[data-modal-actions]'), status=root.querySelector('[data-status]'), message=root.querySelector('[data-message]');
let current='Active', frequency=30, step=0, selected='stock', detail='';
const solutions={
stock:['Skip a delivery or stretch your timing','Still stocked up? Try skipping your next order or changing your delivery schedule to match your routine.',[['Skip next order','skip'],['Move to a later date','delay'],['Change my timing','frequency']]],
price:['Review your subscription pricing','Explore an exclusive offer to help make your subscription more affordable.',[['Review my offer','offer']]],
break:['Take a break when you need one','Try pausing your deliveries for a period that suits you.',[['Pause my plan','pause'],['Skip next order','skip']]],
timing:['Find your ideal delivery schedule','Adjust how often you receive your next shipment.',[['Change my timing','frequency'],['Move to a later date','delay']]],
results:['Review your options','If the product is not right for you, you can change your plan or cancel it. No obligation to continue.',[['Review my plan','manage']]],
other:['Manage your plan your way','Review your delivery options or cancel directly.',[['Open my portal','manage']]]};
function btn(label,act,style){const el=document.createElement('button');el.type='button';el.className=style||'av-hub__btn av-hub__primary';el.dataset.act=act;el.textContent=label;return el}
const followups={
stock:{q:'How much product do you have left?',answers:['Less than one bottle','One or two bottles','Three or more bottles'],title:'Get deliveries when you need them',body:'Skip the next delivery or move it to a later date so you can use what you already have.',options:[['Skip next order','view-skip'],['Move next delivery','view-delay']]},
price:{q:'What would make your plan more manageable?',answers:['A lower price','Less frequent payments','A temporary break'],title:'Make your subscription more affordable',body:'Review your next-order savings or a less frequent delivery schedule.',options:[['Review my savings','view-offer'],['Change delivery frequency','view-frequency']]},
break:{q:'How long would you like a break?',answers:['30 days','60 days','90 days','Not sure'],title:'Take a break on your terms',body:'Pause or reschedule deliveries without having to place another order.',options:[['Pause my subscription','view-pause'],['Move next delivery','view-delay']]},
timing:{q:'How often would you prefer deliveries?',answers:['Every 30 days','Every 60 days','Every 90 days'],title:'Choose a schedule that fits',body:'Adjust how often your subscription renews.',options:[['Change my delivery frequency','view-frequency']]},
results:{q:'What is your main concern?',answers:['Not meeting expectations','Product does not suit me','Questions about using the product'],title:'Choose what is right for you',body:'If the product is not right for you, you can cancel. Our team can also answer product questions.',options:[]},
other:{q:'What else is affecting your subscription?',answers:['Moving or travelling','I only wanted one order','Another reason'],title:'Manage your plan your way',body:'Review your delivery preferences or cancel your recurring plan.',options:[['Review delivery options','view-manage']]}
};
const cancelTools=root.querySelector('[data-cancel-tools]'), guideButton=root.querySelector('[data-act="guided-start"]');
function display(){status.textContent=current==='Cancelled'?'Cancelled':current+' · Every '+frequency+' days';cancelTools.hidden=current==='Cancelled'}
function top(){dialog.scrollTop=0}
function guided(n){
if(current==='Cancelled'){show('manage');return}
step=Math.min(6,Math.max(0,n));actions.replaceChildren();message.textContent='';display();guideButton.hidden=true;
const branch=followups[selected];
const progress=document.createElement('p');progress.className='av-hub__fine';progress.textContent='MEMBERSHIP REVIEW · STEP '+(step+1)+' OF 7';actions.append(progress);
const bar=document.createElement('progress');bar.max=7;bar.value=step+1;bar.setAttribute('aria-label','Membership review progress');bar.style.cssText='width:100%;height:8px;accent-color:#557D4B';actions.append(bar);
const screens=[
['Let’s review your membership','Here are the options included with your subscription. Explore them before deciding, or cancel directly.'],
['What’s your main reason for leaving?','Choose the option that best describes your situation.'],
[branch.q,'Select an answer if you would like a more relevant recommendation.'],
[branch.title,branch.body],
['An offer for your next delivery','Save an additional 20% on your next shipment if you choose to continue.'],
['Make deliveries fit your life','You can take a break or choose a different delivery frequency.'],
['Confirm your cancellation','Your subscription will stop renewing after cancellation.']
];
title.textContent=screens[step][0];desc.textContent=screens[step][1];
const plain='av-hub__btn av-hub__plain';
if(step===0){const box=document.createElement('div');box.className='av-hub__review-card';['✓ Manage your own delivery schedule','✓ Skip or reschedule upcoming orders','✓ Pause when you need a break'].forEach(t=>{const p=document.createElement('p');p.textContent=t;box.append(p)});actions.append(box)}
if(step===1){Object.entries({stock:'Too much product',price:'Too expensive',break:'Need a break',timing:'Too frequent',results:'Not seeing results',other:'Other'}).forEach(([k,label])=>{const b=btn(label,'reason-'+k,plain);b.setAttribute('aria-pressed',String(selected===k));actions.append(b)})}
if(step===2)branch.answers.forEach((label,i)=>{const b=btn(label,'detail-'+i,plain);b.setAttribute('aria-pressed',String(detail===label));actions.append(b)});
if(step===3){if(detail){const p=document.createElement('p');p.className='av-hub__review-card';p.textContent='Your preference: '+detail;actions.append(p)}branch.options.forEach(x=>actions.append(btn(x[0],x[1])))}
if(step===4)actions.append(btn('Apply my discount','offer'));
if(step===5)actions.append(btn('Pause for 30 days','pause30'),btn('Pause for 60 days','pause60'),btn('Change my delivery schedule','view-frequency'));
if(step<6)actions.append(btn(step===0?'Explore my options':'Continue review','guided-next',plain));else actions.append(btn('Confirm cancellation','cancel'));
if(step>0)actions.append(btn('Back','guided-back',plain));
if(!dialog.open){dialog.showModal();top()}else top();
}
function show(mode){
if(mode==='guided'){guided(0);return}

message.textContent='';actions.replaceChildren();display();guideButton.hidden=mode==='cancel';
const modes={manage:['Open my portal','Manage your subscription using the options below.',[['Skip next order','view-skip'],['Move next delivery','view-delay'],['Pause subscription','view-pause'],['Change delivery frequency','view-frequency'],['Review my offer','view-offer']]],skip:['Skip next order','Skip your upcoming shipment and resume on your regular schedule.',[['Confirm skip','skip']]],delay:['Move next delivery','Choose a new delivery date.',[['Move 14 days later','delay']]],pause:['Pause subscription','How long would you like to pause deliveries?',[['Pause for 30 days','pause30'],['Pause for 60 days','pause60'],['Pause for 90 days','pause90']]],frequency:['Change delivery frequency','Choose how often your subscription renews.',[['Every 30 days','freq30'],['Every 60 days','freq60'],['Every 90 days','freq90']]],offer:['Your exclusive offer','Save an additional 20% on your next delivery.',[['Apply my offer','offer']]],cancel:['Confirm your cancellation','Your subscription will stop renewing after cancellation.',[['Confirm cancellation','cancel']]]};
const m=modes[mode]||modes.manage;title.textContent=m[0];desc.textContent=m[1];
if(current!=='Cancelled'){m[2].forEach(x=>actions.append(btn(x[0],x[1])))}else{desc.textContent='Your subscription is cancelled. Reset the preview to test another action.'}
if(!dialog.open)dialog.showModal();top();
}
function apply(act){if(act==='guided-start'){guided(0);return}if(act==='cancel-confirm'){show('cancel');return}if(act.startsWith('detail-')){detail=followups[selected].answers[Number(act.slice(7))]||'';guided(2);return}if(act==='guided-next'){guided(step+1);return}if(act==='guided-back'){guided(step-1);return}if(act.startsWith('reason-')){selected=act.slice(7);detail='';guided(1);return}if(act==='keep'){dialog.close();return}if(act.startsWith('view-')){show(act.slice(5));return}if(current==='Cancelled')return;
if(act==='cancel'){current='Cancelled';title.textContent='Subscription cancelled';desc.textContent='Your subscription cancellation is complete in this preview.';actions.replaceChildren()}
else if(act==='skip')current='Next shipment skipped';
else if(act==='delay')current='Delivery moved 14 days';
else if(act==='pause30'||act==='pause60'||act==='pause90')current='Paused for '+act.slice(5)+' days';
else if(act.startsWith('freq')){frequency=Number(act.slice(4));current='Active'}
else if(act==='offer')current='Discount applied';
display();message.textContent='Subscription status: '+current+'.';}
root.addEventListener('click',function(e){const el=e.target.closest('button');if(!el||!root.contains(el))return;
if(el.hasAttribute('data-reset')){current='Active';frequency=30;selected='stock';detail='';step=0;show('manage');message.textContent='Preview reset.';return}
if(el.hasAttribute('data-close')){dialog.close();return}
if(el.dataset.open){show(el.dataset.open);return}
if(el.dataset.act){apply(el.dataset.act);return}
if(el.dataset.reason){root.querySelectorAll('[data-reason]').forEach(b=>b.setAttribute('aria-pressed',String(b===el)));const s=solutions[el.dataset.reason];root.querySelector('[data-solution-title]').textContent=s[0];root.querySelector('[data-solution-text]').textContent=s[1];const p=root.querySelector('[data-solution-actions]');p.replaceChildren();s[2].forEach(x=>{const b=document.createElement('button');b.type='button';b.dataset.open=x[1];b.textContent=x[0];p.append(b)});}
});
})();
</script>

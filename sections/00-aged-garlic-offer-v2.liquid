    {"type":"checkbox","id":"show_rating","label":"Show rating row","default":false},
    {"type":"text","id":"rating_text","label":"Rating text","default":"Rated 4.8 Excellent"},
    {"type":"text","id":"proof_text","label":"Rating proof text","default":""},
    {"type":"text","id":"heading","label":"Heading","default":"Aged Garlic + CoQ10 Odorless Softgels"},
    {"type":"text","id":"sale_badge","label":"Sale badge","default":"AVONENT LAUNCH PRICING"},
    {"type":"text","id":"stock_text","label":"Divider text","default":"Choose your quantity"},
    {"type":"text","id":"bundle_1_title","label":"Bundle 1 title","default":"Buy One"},
    {"type":"text","id":"bundle_1_subtitle","label":"Bundle 1 subtitle","default":"30 Day Supply"},
    {"type":"text","id":"bundle_1_badge","label":"Bundle 1 badge","default":""},
    {"type":"text","id":"bundle_2_title","label":"Bundle 2 title","default":"Buy Two"},
    {"type":"text","id":"bundle_2_subtitle","label":"Bundle 2 subtitle","default":"60 Day Supply"},
    {"type":"text","id":"bundle_2_badge","label":"Bundle 2 badge","default":"Most Popular"},
    {"type":"text","id":"bundle_3_title","label":"Bundle 3 title","default":"Buy Three"},
    {"type":"text","id":"bundle_3_subtitle","label":"Bundle 3 subtitle","default":"90 Day Supply"},
    {"type":"text","id":"bundle_3_badge","label":"Bundle 3 badge","default":"Best Value"},
    {"type":"text","id":"per_bag_label","label":"Per bag label","default":"/ bag"},
    {"type":"checkbox","id":"show_refill","label":"Show refill box","default":false},
    {"type":"text","id":"refill_heading","label":"Refill heading","default":"Save more with automatic refills"},
    {"type":"text","id":"refill_text","label":"Refill text","default":"Connect this to your subscription option when it is ready."},
    {"type":"url","id":"refill_link","label":"Refill link"},
    {"type":"text","id":"shipping_text","label":"Shipping text","default":"Shipping details shown at checkout"},
    {"type":"text","id":"button_text","label":"Add to cart text","default":"ADD TO CART"},

{% liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  if p.variants.size > 1
    assign v = p.variants[1]
  endif

  assign selected_allocation = v.selling_plan_allocations.first
  assign selected_plan_id = blank
  assign selected_subscription_price = v.price
  if selected_allocation != blank
    assign selected_plan_id = selected_allocation.selling_plan.id
    assign selected_subscription_price = selected_allocation.price
  elsif section.settings.subscription_plan_id != blank
    assign selected_plan_id = section.settings.subscription_plan_id | strip
  endif

  assign form_id = 'AGOffer-' | append: section.id
  assign hero = section.settings.image_1
  if hero == blank
    assign hero = p.featured_image
  endif
%}

<section id="AGOffer-{{ section.id }}" class="ag2" style="--a:{{ section.settings.accent }};--ad:{{ section.settings.accent_dark }};--g:{{ section.settings.gold }};--t:{{ section.settings.text }};--m:{{ section.settings.muted }};--l:{{ section.settings.line }};--bg:{{ section.settings.background }};">
  <span id="avonent-garlic-buy" class="ag2__anchor" aria-hidden="true"></span>
  <div class="ag2__wrap">
    <div class="ag2__media">
      <div class="ag2__hero" data-ag2-hero>
        {% if hero != blank %}
          {{ hero | image_url: width: 1400 | image_tag: widths: '480,720,960,1200,1400', sizes: '(min-width:900px) 50vw,100vw', loading: 'eager', fetchpriority: 'high', class: 'ag2__heroimg', alt: p.title }}
        {% else %}
          <div class="ag2__mock">
            <span>AVONENT HEALTH</span>
            <em>ODORLESS DAILY GARLIC SUPPORT</em>
            <strong>AGED GARLIC</strong>
            <b>+ CoQ10</b>
            <small>with ubiquinol</small>
            <i>PREMIUM SOFTGEL FORMULA</i>
          </div>
        {% endif %}
      </div>
      <div class="ag2__thumbs">
        {% for i in (1..4) %}
          {% assign k = 'image_' | append: i %}
          {% assign im = section.settings[k] %}
          {% if im == blank %}
            {% assign product_image_index = i | minus: 1 %}
            {% assign im = p.images[product_image_index] %}
          {% endif %}
          {% if im != blank %}
            <button type="button" class="ag2__thumb{% if forloop.first %} is-on{% endif %}" data-ag2-thumb data-src="{{ im | image_url: width: 1400 }}">
              {{ im | image_url: width: 180 | image_tag: loading: 'lazy', alt: p.title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ag2__info">
      {% if section.settings.show_rating %}
        <div class="ag2__rating">
          <span aria-label="5 stars">★★★★★</span>
          <b>{{ section.settings.rating_text }}</b>
          {% if section.settings.proof_text != blank %}<em>| {{ section.settings.proof_text }}</em>{% endif %}
        </div>
      {% endif %}

      <h1>{{ section.settings.heading | default: p.title }}</h1>
      {% if section.settings.subheading != blank %}
        <div class="ag2__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}

      <div class="ag2__benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="ag2__benefit" {{ block.shopify_attributes }}><i>✓</i><span>{{ block.settings.text }}</span></div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.sale_badge != blank %}<div class="ag2__sale">{{ section.settings.sale_badge }}</div>{% endif %}
      <div class="ag2__rule"><span></span><b>{{ section.settings.stock_text }}</b><span></span></div>

      {% form 'product', p, id: form_id %}
        <input type="hidden" name="id" value="{{ v.id }}" data-ag2-input>
        <input type="hidden" name="quantity" value="2" data-ag2-quantity-input>
        <input
          type="hidden"
          name="selling_plan"
          value="{{ selected_plan_id }}"
          data-ag2-selling-plan
          {% if selected_plan_id == blank %}disabled{% endif %}
        >

        <div class="ag2__purchase-mode" data-ag2-purchase-mode>
          <button type="button" class="ag2__purchase-option is-on" data-ag2-subscribe aria-pressed="true">
            <span class="ag2__purchase-copy">
              <strong>{{ section.settings.subscription_label }}</strong>
              {% if section.settings.subscription_helper != blank %}<small>{{ section.settings.subscription_helper }}</small>{% endif %}
            </span>
            <span class="ag2__purchase-price">
              <strong data-ag2-mode-price>{{ selected_subscription_price | money }}</strong>
              <s data-ag2-mode-compare{% unless v.price > selected_subscription_price %} hidden{% endunless %}>{{ v.price | money }}</s>
              <em data-ag2-mode-save{% unless v.price > selected_subscription_price %} hidden{% endunless %}>
                {% if v.price > selected_subscription_price %}
                  Save {{ v.price | minus: selected_subscription_price | times: 100.0 | divided_by: v.price | round }}%
                {% endif %}
              </em>
            </span>
          </button>
        </div>

        <div class="ag2__bundles">
          {% for n in (1..3) %}
            {% liquid
              assign tk = 'bundle_' | append: n | append: '_title'
              assign sk = 'bundle_' | append: n | append: '_subtitle'
              assign bk = 'bundle_' | append: n | append: '_badge'
              assign title = section.settings[tk]
              assign sub = section.settings[sk]
              assign badge = section.settings[bk]

              assign allocation = v.selling_plan_allocations.first
              assign plan_id = blank
              assign unit_subscription_price = v.price
              if allocation != blank
                assign plan_id = allocation.selling_plan.id
                assign unit_subscription_price = allocation.price
              elsif section.settings.subscription_plan_id != blank
                assign plan_id = section.settings.subscription_plan_id | strip
              endif

              assign subscription_total = unit_subscription_price | times: n
              assign one_time_total = v.price | times: n
              assign compare_total = 0
              if v.compare_at_price > v.price
                assign compare_total = v.compare_at_price | times: n
              endif

              assign on = false
              if n == 2
                assign on = true
              endif
            %}
            <button
              type="button"
              class="ag2__bundle{% if on %} is-on{% endif %}"
              data-ag2-bundle
              data-id="{{ v.id }}"
              data-plan-id="{{ plan_id }}"
              data-sub-price="{{ subscription_total }}"
              data-one-time-price="{{ one_time_total }}"
              data-compare-price="{{ compare_total }}"
              data-quantity="{{ n }}"
            >
              {% if badge != blank %}<small class="ag2__badge">{{ badge }}</small>{% endif %}
              <span class="ag2__radio"><i></i></span>
              <span class="ag2__copy">
                <strong>{{ title }}</strong>
                {% if sub != blank %}<small>{{ sub }}</small>{% endif %}
              </span>
              <span class="ag2__price">
                <strong data-ag2-bundle-price>{{ subscription_total | money }}</strong>
                <small data-ag2-bundle-each>{% if n > 1 %}{{ unit_subscription_price | money }} {{ section.settings.per_bag_label }}{% endif %}</small>
                <s data-ag2-bundle-compare{% unless one_time_total > subscription_total %} hidden{% endunless %}>{{ one_time_total | money }}</s>
              </span>
            </button>
          {% endfor %}
        </div>

        {% if section.settings.show_refill %}
          <a class="ag2__refill" {% if section.settings.refill_link != blank %}href="{{ section.settings.refill_link }}"{% endif %}><span>↻</span><div><strong>{{ section.settings.refill_heading }}</strong><small>{{ section.settings.refill_text }}</small></div></a>
        {% endif %}

        <div class="ag2__ship">
          <i aria-hidden="true"></i>
          <span>
            {{ section.settings.shipping_prefix }}
            <b data-ag2-ship-date data-business-days="{{ section.settings.shipping_business_days }}"></b>
            {{ section.settings.shipping_suffix }}
          </span>
        </div>
        <button type="submit" name="add" class="ag2__atc"><span>{{ section.settings.button_text }}</span><b>→</b><em data-ag2-price>{{ selected_subscription_price | money }}</em></button>

        <div class="ag2__purchase-meta" data-ag2-purchase-meta>
          <div class="ag2__recurring" data-ag2-recurring>
            <span class="ag2__recurring-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.34 5.66"></path><path d="M20 4v7h-7"></path></svg>
              <span>{{ section.settings.refill_every_text }}</span>
            </span>
            <i aria-hidden="true"></i>
            <span class="ag2__recurring-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              <span>{{ section.settings.cancel_text }}</span>
            </span>
          </div>

          <button type="button" class="ag2__one-time-toggle" data-ag2-one-time aria-pressed="false">
            {{ section.settings.one_time_label }}
            <strong data-ag2-one-time-price>{{ v.price | money }}</strong>
            {% if section.settings.one_time_suffix != blank %}<span>{{ section.settings.one_time_suffix }}</span>{% endif %}
          </button>

          <button type="button" class="ag2__subscription-return" data-ag2-return-sub hidden>
            {{ section.settings.subscription_return_label }}
            <strong data-ag2-return-sub-price>{{ selected_subscription_price | money }}</strong>
          </button>
        </div>
      {% endform %}

      {% if section.settings.show_payments %}
        <div class="ag2__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>
      {% endif %}

      {% if section.settings.show_trusted %}
      <div class="ag2__trusted">
        <div class="ag2__avatars">
          {% assign has_avatar = false %}
          {% for i in (1..3) %}
            {% assign ak = 'avatar_' | append: i %}
            {% assign av = section.settings[ak] %}
            {% if av != blank %}
              {% assign has_avatar = true %}
              {{ av | image_url: width: 100 | image_tag: width: 42, height: 42, loading: 'lazy', alt: section.settings.trusted_heading }}
            {% endif %}
          {% endfor %}
          {% unless has_avatar %}
            <span class="ag2__avatar-fallback"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="11" r="6"></circle><path d="M5 29c1-8 5-12 11-12s10 4 11 12"></path></svg></span>
            <span class="ag2__avatar-fallback ag2__avatar-fallback--two"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="11" r="6"></circle><path d="M5 29c1-8 5-12 11-12s10 4 11 12"></path></svg></span>
            <span class="ag2__avatar-fallback ag2__avatar-fallback--three"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="11" r="6"></circle><path d="M5 29c1-8 5-12 11-12s10 4 11 12"></path></svg></span>
            <span class="ag2__avatar-verified" aria-hidden="true">✓</span>
          {% endunless %}
        </div>
        <div><strong>{{ section.settings.trusted_heading }}</strong><p>{{ section.settings.trusted_text }}</p></div>
      </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_sticky %}
    <div class="ag2__sticky" data-ag2-sticky hidden><div><small>{{ section.settings.sticky_label }}</small><strong data-ag2-sticky-price>{{ v.price | money }}</strong></div><a href="#AGOffer-{{ section.id }}">{{ section.settings.sticky_button }} <b>→</b></a></div>
  {% endif %}
</section>

<script>
(() => {
  const root = document.getElementById('AGOffer-{{ section.id }}');
  if (!root || root.dataset.ready === '1') return;
  root.dataset.ready = '1';

  const form = root.querySelector('form[action*="/cart/add"]');
  const bundles = [...root.querySelectorAll('[data-ag2-bundle]')];
  const variantInput = root.querySelector('[data-ag2-input]');
  const quantityInput = root.querySelector('[data-ag2-quantity-input]');
  const planInput = root.querySelector('[data-ag2-selling-plan]');
  const atcPrice = root.querySelector('[data-ag2-price]');
  const stickyPrice = root.querySelector('[data-ag2-sticky-price]');
  const subscribeButton = root.querySelector('[data-ag2-subscribe]');
  const oneTimeButton = root.querySelector('[data-ag2-one-time]');
  const returnSubButton = root.querySelector('[data-ag2-return-sub]');
  const recurring = root.querySelector('[data-ag2-recurring]');
  const modePrice = root.querySelector('[data-ag2-mode-price]');
  const modeCompare = root.querySelector('[data-ag2-mode-compare]');
  const modeSave = root.querySelector('[data-ag2-mode-save]');
  const oneTimePrice = root.querySelector('[data-ag2-one-time-price]');
  const returnSubPrice = root.querySelector('[data-ag2-return-sub-price]');
  const currency = {{ cart.currency.iso_code | default: shop.currency | json }};

  let mode = 'subscription';

  const money = (cents) => {
    const amount = Number(cents || 0) / 100;
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(amount);
    } catch (e) {
      return '$' + amount.toFixed(2);
    }
  };

  const selectedBundle = () => root.querySelector('[data-ag2-bundle].is-on') || bundles[0];

  const selectedValues = () => {
    const button = selectedBundle();
    if (!button) return null;
    return {
      button,
      variantId: String(button.dataset.id || ''),
      planId: String(button.dataset.planId || ''),
      subscriptionPrice: Number(button.dataset.subPrice || 0),
      oneTimePrice: Number(button.dataset.oneTimePrice || 0),
      comparePrice: Number(button.dataset.comparePrice || 0),
      quantity: Math.max(1, Number(button.dataset.quantity || 1))
    };
  };

  const setPlanInput = () => {
    if (!planInput) return;
    const values = selectedValues();
    const useSubscription = mode === 'subscription' && values?.planId;

    form?.querySelectorAll('[name="selling_plan"]').forEach((control) => {
      if (control === planInput) return;
      control.disabled = true;
      if (control.matches('[type="radio"], [type="checkbox"]')) control.checked = false;
    });

    if (useSubscription) {
      planInput.disabled = false;
      planInput.name = 'selling_plan';
      planInput.value = values.planId;
      planInput.setAttribute('value', values.planId);
    } else {
      planInput.disabled = true;
      planInput.value = '';
      planInput.removeAttribute('value');
    }
  };

  const renderBundlePrices = () => {
    bundles.forEach((button) => {
      const n = Math.max(1, Number(button.dataset.quantity || 1));
      const sub = Number(button.dataset.subPrice || 0);
      const one = Number(button.dataset.oneTimePrice || 0);
      const shown = mode === 'subscription' ? sub : one;
      const compare = mode === 'subscription' ? one : Number(button.dataset.comparePrice || 0);
      const each = shown / n;

      const priceEl = button.querySelector('[data-ag2-bundle-price]');
      const eachEl = button.querySelector('[data-ag2-bundle-each]');
      const compareEl = button.querySelector('[data-ag2-bundle-compare]');

      if (priceEl) priceEl.textContent = money(shown);
      if (eachEl) eachEl.textContent = n > 1 ? money(each) + ' {{ section.settings.per_bag_label | escape }}' : '';
      if (compareEl) {
        const show = compare > shown;
        compareEl.hidden = !show;
        compareEl.textContent = show ? money(compare) : '';
      }
    });
  };

  const render = () => {
    const values = selectedValues();
    if (!values) return;

    if (variantInput) variantInput.value = values.variantId;
    if (quantityInput) quantityInput.value = String(values.quantity);

    const activePrice = mode === 'subscription'
      ? values.subscriptionPrice
      : values.oneTimePrice;

    if (atcPrice) atcPrice.textContent = money(activePrice);
    if (stickyPrice) stickyPrice.textContent = money(activePrice);
    if (oneTimePrice) oneTimePrice.textContent = money(values.oneTimePrice);
    if (returnSubPrice) returnSubPrice.textContent = money(values.subscriptionPrice);

    if (modePrice) modePrice.textContent = money(values.subscriptionPrice);
    if (modeCompare) {
      const show = values.oneTimePrice > values.subscriptionPrice;
      modeCompare.hidden = !show;
      modeCompare.textContent = show ? money(values.oneTimePrice) : '';
    }
    if (modeSave) {
      const save = values.oneTimePrice > values.subscriptionPrice
        ? Math.round(((values.oneTimePrice - values.subscriptionPrice) / values.oneTimePrice) * 100)
        : 0;
      modeSave.hidden = save <= 0;
      modeSave.textContent = save > 0 ? 'Save ' + save + '%' : '';
    }

    subscribeButton?.classList.toggle('is-on', mode === 'subscription');
    subscribeButton?.setAttribute('aria-pressed', mode === 'subscription' ? 'true' : 'false');
    oneTimeButton?.classList.toggle('is-on', mode === 'one_time');
    oneTimeButton?.setAttribute('aria-pressed', mode === 'one_time' ? 'true' : 'false');
    if (recurring) recurring.hidden = mode !== 'subscription';
    if (returnSubButton) returnSubButton.hidden = mode !== 'one_time';
    if (oneTimeButton) oneTimeButton.hidden = mode === 'one_time';

    root.classList.toggle('ag2--one-time', mode === 'one_time');

    setPlanInput();
    renderBundlePrices();
  };

  const setMode = (nextMode) => {
    mode = nextMode === 'one_time' ? 'one_time' : 'subscription';
    render();

    document.dispatchEvent(new Event('selling-plan:change'));
    document.dispatchEvent(new CustomEvent('avonent:purchase-mode-change', {
      detail: {
        mode,
        sellingPlanId: mode === 'subscription' ? selectedValues()?.planId || null : null
      }
    }));
  };

  root.addEventListener('click', (event) => {
    const button = event.target.closest('[data-ag2-bundle]');
    if (!button || !root.contains(button)) return;
    event.preventDefault();
    bundles.forEach((b) => b.classList.toggle('is-on', b === button));
    render();
  });

  subscribeButton?.addEventListener('click', () => setMode('subscription'));
  oneTimeButton?.addEventListener('click', () => setMode('one_time'));
  returnSubButton?.addEventListener('click', () => setMode('subscription'));

  const submitButton = form?.querySelector('button[type="submit"][name="add"]');
  const submitLabel = submitButton?.querySelector('span');
  const originalLabel = submitLabel?.textContent || 'ADD TO CART';
  let adding = false;
  const resetAddButton = () => {
    adding = false;
    if (submitButton) {
      submitButton.disabled = false;
      submitButton.removeAttribute('aria-busy');
    }
    if (submitLabel) submitLabel.textContent = originalLabel;
  };
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) resetAddButton();
  });

  if (form) {
    form.addEventListener('click', (event) => {
      const submit = event.target.closest('button[type="submit"][name="add"]');
      if (submit) setPlanInput();
    }, true);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (adding) return;

      const values = selectedValues();
      if (!values?.variantId) return;

      adding = true;
      let added = false;
      const previousError = root.querySelector('[data-ag2-cart-error]');
      if (previousError) previousError.hidden = true;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.setAttribute('aria-busy', 'true');
      }
      if (submitLabel) submitLabel.textContent = 'ADDING...';

      try {
        const rootPath = window.Shopify?.routes?.root || '/';

        const { CartLinesUpdateEvent } = await import('@shopify/events');
        setPlanInput();
        if (variantInput) variantInput.value = String(values.variantId);
        if (quantityInput) quantityInput.value = String(values.quantity);

        const delays = [0, 700, 1500, 3000, 5000];
        let payload = null;
        let response = null;
        let lastRequestId = '';

        for (let attempt = 0; attempt < delays.length; attempt += 1) {
          if (delays[attempt]) {
            await new Promise((resolve) => setTimeout(resolve, delays[attempt]));
          }

          const formData = new FormData(form);
          const sectionIds = [...new Set([...document.querySelectorAll('cart-items-component')]
            .map((component) => component.dataset.sectionId).filter(Boolean))].slice(0, 5);
          if (sectionIds.length) formData.set('sections', sectionIds.join(','));
          formData.set('sections_url', window.location.pathname);

          response = await fetch(rootPath + 'cart/add.js', {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin',
            signal: AbortSignal.timeout(20000),
            body: formData
          });

          lastRequestId =
            response.headers.get('x-request-id') ||
            response.headers.get('x-shopify-request-id') ||
            lastRequestId;

          payload = await response.json().catch(() => ({}));

          if (response.ok && !payload?.status) break;

          const description = String(
            payload?.description ||
            payload?.message ||
            payload?.errors ||
            ''
          ).toLowerCase();

          const isFalseSoldOut =
            response.status === 422 &&
            description.includes('sold out');

          if (!isFalseSoldOut || attempt === delays.length - 1) break;
        }

        if (!response?.ok || payload?.status) {
          const message =
            payload?.description ||
            payload?.message ||
            payload?.errors ||
            'Unable to add this item to the cart.';
          const requestSuffix = lastRequestId ? ' (Shopify request ' + lastRequestId + ')' : '';
          throw new Error((typeof message === 'string' ? message : JSON.stringify(message)) + requestSuffix);
        }

        added = true;
        const cartResponse = await fetch(rootPath + 'cart.js', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
          signal: AbortSignal.timeout(15000)
        });
        if (!cartResponse.ok) throw new Error('Cart refresh failed');
        const cart = await cartResponse.json();
        root.dispatchEvent(new CartLinesUpdateEvent({
          action: 'add',
          context: 'product',
          lines: [{ merchandiseId: values.variantId, quantity: values.quantity }],
          promise: Promise.resolve({
            cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
            detail: {
              sections: payload.sections || {},
              items: cart.items,
              itemCount: cart.item_count,
              source: 'avonent-garlic',
              didError: false
            }
          })
        }));
      } catch (error) {
        console.error('[Avonent garlic add to cart]', error);

        let errorBox = root.querySelector('[data-ag2-cart-error]');
        if (!errorBox) {
          errorBox = document.createElement('p');
          errorBox.setAttribute('data-ag2-cart-error', '');
          errorBox.className = 'ag2__cart-error';
          submitButton?.insertAdjacentElement('afterend', errorBox);
        }
        errorBox.setAttribute('role', 'alert');
        errorBox.textContent = added
          ? 'Added to your cart. Please tap the cart icon to view it.'
          : error?.message || 'Unable to add this item to the cart.';
        errorBox.hidden = false;
      } finally {
        resetAddButton();
      }
    });
  }

  const img = root.querySelector('[data-ag2-hero] img');
  root.querySelectorAll('[data-ag2-thumb]').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      root.querySelectorAll('[data-ag2-thumb]').forEach((x) => x.classList.toggle('is-on', x === thumb));
      if (img) img.src = thumb.dataset.src;
    });
  });

  const shipDate = root.querySelector('[data-ag2-ship-date]');
  if (shipDate) {
    let date = new Date();
    let left = Math.max(0, Number(shipDate.dataset.businessDays || 1));
    while (left > 0) {
      date.setDate(date.getDate() + 1);
      const day = date.getDay();
      if (day !== 0 && day !== 6) left--;
    }
    shipDate.textContent = date.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric'
    });
  }

  const sticky = root.querySelector('[data-ag2-sticky]');
  if (sticky) {
    const updateSticky = () => {
      sticky.hidden = !(innerWidth < 750 && root.getBoundingClientRect().bottom < 120);
    };
    addEventListener('scroll', updateSticky, { passive: true });
    addEventListener('resize', updateSticky, { passive: true });
    updateSticky();
  }

  // Default: Buy 2 + Subscribe & Save.
  const preferred = bundles[1] || bundles[0];
  if (preferred) {
    bundles.forEach((b) => b.classList.toggle('is-on', b === preferred));
  }
  setMode('subscription');
})();
</script>

{% stylesheet %}

  "blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"text","label":"Text","default":"Odorless aged garlic softgels"}]}],
  "max_blocks":6,
  "presets":[{"name":"Aged Garlic Offer V2","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]

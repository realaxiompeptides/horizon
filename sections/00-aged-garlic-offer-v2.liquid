    {"type":"text","id":"trusted_text","label":"Trust subtext","default":"Add real customer photos and verified social proof here."},
    {"type":"checkbox","id":"show_sticky","label":"Show mobile sticky cart","default":true},
    {"type":"text","id":"sticky_label","label":"Sticky label","default":"AVONENT AGED GARLIC"},
    {"type":"text","id":"sticky_button","label":"Sticky button","default":"ADD TO CART"},
    {"type":"color","id":"background","label":"Background","default":"#FFFDFC"},

{% comment %}
  Avonent FAQ
  Add this file to: sections/avonent-faq.liquid
{% endcomment %}

<section
  id="avonent-faq-{{ section.id }}"
  class="avonent-faq"
  style="
    --av-faq-accent: {{ section.settings.accent_color }};
    --av-faq-bg: {{ section.settings.background_color }};
    --av-faq-card: {{ section.settings.card_color }};
    --av-faq-text: {{ section.settings.text_color }};
    --av-faq-muted: {{ section.settings.muted_color }};
    --av-faq-border: {{ section.settings.border_color }};
    --av-faq-pad-top: {{ section.settings.padding_top }}px;
    --av-faq-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="avonent-faq__glow avonent-faq__glow--one" aria-hidden="true"></div>
  <div class="avonent-faq__glow avonent-faq__glow--two" aria-hidden="true"></div>

  <div class="avonent-faq__container">
    <header class="avonent-faq__header">
      {% if section.settings.eyebrow != blank %}
        <div class="avonent-faq__eyebrow">
          <span class="avonent-faq__eyebrow-dot" aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="avonent-faq__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="avonent-faq__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    {% if section.settings.show_trust_badges %}
      <div class="avonent-faq__trust" aria-label="Avonent purchase benefits">
        <div class="avonent-faq__trust-item">
          <span class="avonent-faq__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10 4.1-1.8 7-5.2 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="m8.7 12 2.1 2.1 4.7-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_one | escape }}</span>
        </div>

        <div class="avonent-faq__trust-item">
          <span class="avonent-faq__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v8.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_two | escape }}</span>
        </div>

        <div class="avonent-faq__trust-item">
          <span class="avonent-faq__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" stroke="currentColor" stroke-width="1.8"/>
              <path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_three | escape }}</span>
        </div>
      </div>
    {% endif %}

    <div class="avonent-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <details
            class="avonent-faq__item"
            {% if section.settings.open_first and forloop.first %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="avonent-faq__question">
              <span class="avonent-faq__number" aria-hidden="true">
                {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
              </span>
              <span class="avonent-faq__question-text">{{ block.settings.question | escape }}</span>
              <span class="avonent-faq__toggle" aria-hidden="true">
                <span></span>
                <span></span>
              </span>
            </summary>

            <div class="avonent-faq__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_support_card %}
      <div class="avonent-faq__support">
        <div class="avonent-faq__support-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.8 9.8 0 0 1-3.8-.8L3 21l1.8-4.6A8.3 8.3 0 0 1 3 11.5a8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 9 8.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M8.5 9.3c.3-1.5 1.6-2.4 3.4-2.4 1.9 0 3.3 1 3.3 2.6 0 1.3-.8 2-1.9 2.7-.9.5-1.3 1-1.3 1.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M12 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="avonent-faq__support-copy">
          <h3>{{ section.settings.support_heading | escape }}</h3>
          <p>{{ section.settings.support_text | escape }}</p>
        </div>

        {% if section.settings.support_label != blank %}
          <a
            class="avonent-faq__support-link"
            href="{{ section.settings.support_link | default: '/pages/contact' }}"
          >
            {{ section.settings.support_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_disclaimer %}
      <p class="avonent-faq__disclaimer">
        *These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.
      </p>
    {% endif %}
  </div>
</section>

<style>
  #avonent-faq-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--av-faq-pad-top) 20px var(--av-faq-pad-bottom);
    background:
      linear-gradient(180deg, var(--av-faq-bg) 0%, #ffffff 100%);
    color: var(--av-faq-text);
  }

  #avonent-faq-{{ section.id }} * {
    box-sizing: border-box;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__glow {
    position: absolute;
    z-index: -1;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: rgba(2, 198, 234, 0.11);
    filter: blur(2px);
    pointer-events: none;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__glow--one {
    top: -260px;
    left: -210px;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__glow--two {
    right: -260px;
    bottom: -280px;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__container {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__header {
    max-width: 760px;
    margin: 0 auto 34px;
    text-align: center;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 16px;
    padding: 8px 13px;
    border: 1px solid rgba(2, 198, 234, 0.27);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    color: #058aa5;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 0 8px 30px rgba(2, 198, 234, 0.07);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--av-faq-accent);
    box-shadow: 0 0 0 5px rgba(2, 198, 234, 0.12);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__heading {
    max-width: 720px;
    margin: 0 auto;
    color: var(--av-faq-text);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__subheading {
    max-width: 620px;
    margin: 20px auto 0;
    color: var(--av-faq-muted);
    font-size: 17px;
    line-height: 1.65;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    max-width: 860px;
    margin: 0 auto 22px;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__trust-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 56px;
    padding: 11px 15px;
    border: 1px solid var(--av-faq-border);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.76);
    color: var(--av-faq-text);
    font-size: 13px;
    font-weight: 750;
    line-height: 1.25;
    text-align: center;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__trust-icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 23px;
    height: 23px;
    color: var(--av-faq-accent);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__trust-icon svg {
    width: 100%;
    height: 100%;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__list {
    display: grid;
    gap: 12px;
    max-width: 920px;
    margin: 0 auto;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__item {
    overflow: hidden;
    border: 1px solid var(--av-faq-border);
    border-radius: 18px;
    background: var(--av-faq-card);
    box-shadow: 0 8px 30px rgba(9, 44, 54, 0.045);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__item:hover {
    transform: translateY(-1px);
    border-color: rgba(2, 198, 234, 0.55);
    box-shadow: 0 14px 36px rgba(2, 198, 234, 0.08);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__item[open] {
    border-color: var(--av-faq-accent);
    box-shadow: 0 16px 44px rgba(2, 198, 234, 0.13);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__question {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 15px;
    min-height: 86px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__question::-webkit-details-marker {
    display: none;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #e5f9fd;
    color: #058aa5;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.08em;
    transition: all 180ms ease;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__item[open] .avonent-faq__number {
    background: var(--av-faq-accent);
    color: #002830;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__question-text {
    color: var(--av-faq-text);
    font-size: 20px;
    font-weight: 760;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--av-faq-border);
    border-radius: 50%;
    background: #f7fdfe;
    color: var(--av-faq-text);
    transition: all 180ms ease;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__toggle span {
    position: absolute;
    width: 16px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__toggle span:last-child {
    transform: rotate(90deg);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__item[open] .avonent-faq__toggle {
    border-color: var(--av-faq-accent);
    background: var(--av-faq-accent);
    color: #002830;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__item[open] .avonent-faq__toggle span:last-child {
    transform: rotate(0deg);
  }

  #avonent-faq-{{ section.id }} .avonent-faq__answer {
    margin: 0 20px 0 77px;
    padding: 0 64px 25px 0;
    color: var(--av-faq-muted);
    font-size: 16px;
    line-height: 1.72;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__answer p {
    margin: 0;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__answer p + p,
  #avonent-faq-{{ section.id }} .avonent-faq__answer ul,
  #avonent-faq-{{ section.id }} .avonent-faq__answer ol {
    margin-top: 12px;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__answer a {
    color: #047e96;
    font-weight: 700;
    text-underline-offset: 3px;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    max-width: 920px;
    margin: 22px auto 0;
    padding: 20px;
    border: 1px solid rgba(2, 198, 234, 0.28);
    border-radius: 20px;
    background: #dff8fd;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--av-faq-accent);
    color: #002830;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-icon svg {
    width: 29px;
    height: 29px;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-copy h3 {
    margin: 0;
    color: var(--av-faq-text);
    font-size: 18px;
    font-weight: 800;
    line-height: 1.25;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-copy p {
    margin: 5px 0 0;
    color: var(--av-faq-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 13px 19px;
    border-radius: 999px;
    background: #071114;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-link:hover {
    transform: translateY(-1px);
    background: #083d48;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__support-link span {
    font-size: 18px;
    line-height: 0;
  }

  #avonent-faq-{{ section.id }} .avonent-faq__disclaimer {
    max-width: 840px;
    margin: 22px auto 0;
    color: #718088;
    font-size: 11px;
    line-height: 1.55;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #avonent-faq-{{ section.id }} {
      padding-right: 14px;
      padding-left: 14px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__header {
      margin-bottom: 26px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__eyebrow {
      margin-bottom: 14px;
      font-size: 10px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__heading {
      font-size: clamp(36px, 11vw, 48px);
      line-height: 1;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__subheading {
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.55;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__trust {
      grid-template-columns: 1fr;
      gap: 8px;
      margin-bottom: 16px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__trust-item {
      justify-content: flex-start;
      min-height: 48px;
      padding: 10px 14px;
      text-align: left;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__list {
      gap: 9px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__item {
      border-radius: 15px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__question {
      grid-template-columns: 34px minmax(0, 1fr) 38px;
      gap: 11px;
      min-height: 76px;
      padding: 15px 14px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__number {
      width: 34px;
      height: 34px;
      font-size: 10px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__question-text {
      font-size: 16px;
      line-height: 1.32;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__toggle {
      width: 38px;
      height: 38px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__toggle span {
      width: 14px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__answer {
      margin: 0 14px 0 59px;
      padding: 0 39px 20px 0;
      font-size: 14px;
      line-height: 1.65;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__support {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
      padding: 16px;
      border-radius: 17px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__support-icon {
      width: 44px;
      height: 44px;
      border-radius: 13px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__support-icon svg {
      width: 24px;
      height: 24px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__support-copy h3 {
      font-size: 16px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__support-copy p {
      font-size: 12px;
    }

    #avonent-faq-{{ section.id }} .avonent-faq__support-link {
      grid-column: 1 / -1;
      width: 100%;
      min-height: 46px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #avonent-faq-{{ section.id }} .avonent-faq__item,
    #avonent-faq-{{ section.id }} .avonent-faq__toggle,
    #avonent-faq-{{ section.id }} .avonent-faq__toggle span,
    #avonent-faq-{{ section.id }} .avonent-faq__number,
    #avonent-faq-{{ section.id }} .avonent-faq__support-link {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('avonent-faq-{{ section.id }}');
    if (!root || root.dataset.faqReady === 'true') return;

    root.dataset.faqReady = 'true';
    const items = Array.from(root.querySelectorAll('.avonent-faq__item'));

    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((otherItem) => {
          if (otherItem !== item) otherItem.removeAttribute('open');
        });
      });
    });

    if (typeof Shopify !== 'undefined' && Shopify.designMode) {
      document.addEventListener('shopify:block:select', (event) => {
        const selectedItem = event.target.closest('.avonent-faq__item');
        if (selectedItem && root.contains(selectedItem)) selectedItem.open = true;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "00 Avonent FAQ",
  "tag": "section",
  "class": "section-avonent-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions, answered"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clear answers about the formula, testing, shipping, and your 30-day guarantee."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_one",
      "label": "Trust badge 1",
      "default": "Third-party tested"
    },
    {
      "type": "text",
      "id": "trust_two",
      "label": "Trust badge 2",
      "default": "Ships from the USA"
    },
    {
      "type": "text",
      "id": "trust_three",
      "label": "Trust badge 3",
      "default": "30-day guarantee"
    },
    {
      "type": "header",
      "content": "Support card"
    },
    {
      "type": "checkbox",
      "id": "show_support_card",
      "label": "Show support card",
      "default": true
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support heading",
      "default": "Still have a question?"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Support text",
      "default": "Our team is here to help you make an informed decision."
    },
    {
      "type": "text",
      "id": "support_label",
      "label": "Button label",
      "default": "Contact Avonent"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show supplement disclaimer",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },

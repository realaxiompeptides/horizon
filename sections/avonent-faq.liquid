{% comment %}
  Avonent universal FAQ
  This section intentionally renders the same core FAQ set on every product.
  Legacy FAQ blocks are ignored so older product templates can keep their JSON
  without showing product-specific questions. New custom FAQ blocks added in
  the theme editor are rendered after the universal questions.
{% endcomment %}

<section
  id="avonent-faq-{{ section.id }}"
  class="avonent-faq"
  style="
    --av-faq-accent: {{ section.settings.accent_color }};
    --av-faq-bg: {{ section.settings.background_color }};
    --av-faq-card: {{ section.settings.card_color }};
    --av-faq-text: {{ section.settings.text_color }};
    --av-faq-muted: {{ section.settings.muted_color }};
    --av-faq-border: {{ section.settings.border_color }};
    --av-faq-pad-top: {{ section.settings.padding_top }}px;
    --av-faq-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="avonent-faq__orb avonent-faq__orb--one" aria-hidden="true"></div>
  <div class="avonent-faq__orb avonent-faq__orb--two" aria-hidden="true"></div>

  <div class="avonent-faq__container">
    <header class="avonent-faq__header">
      {% if section.settings.eyebrow != blank %}
        <div class="avonent-faq__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</div>
      {% endif %}
      <h2 class="avonent-faq__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="avonent-faq__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    {% if section.settings.show_trust_badges %}
      <div class="avonent-faq__trust" aria-label="Avonent purchase benefits">
        <div class="avonent-faq__trust-item">
          <span class="avonent-faq__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 3h6M10 3v5l-4.6 8.2A3.2 3.2 0 0 0 8.2 21h7.6a3.2 3.2 0 0 0 2.8-4.8L14 8V3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.8 14h8.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <span>{{ section.settings.trust_one | escape }}</span>
        </div>
        <div class="avonent-faq__trust-item">
          <span class="avonent-faq__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v8.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </span>
          <span>{{ section.settings.trust_two | escape }}</span>
        </div>
        <div class="avonent-faq__trust-item">
          <span class="avonent-faq__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v5c0 4.8 2.9 8.2 7 10 4.1-1.8 7-5.2 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.7 12 2.1 2.1 4.7-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>{{ section.settings.trust_three | escape }}</span>
        </div>
      </div>
    {% endif %}

    <div class="avonent-faq__list">
      <details class="avonent-faq__item" {% if section.settings.open_first %}open{% endif %}>
        <summary class="avonent-faq__question">
          <span class="avonent-faq__number">01</span>
          <span class="avonent-faq__question-text">What is Avonent?</span>
          <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="avonent-faq__answer rte"><p>Avonent creates premium wellness products designed to make a consistent daily routine simpler. Each product has its own ingredients, directions, and intended use, so always review the product label and product page for details specific to the item you choose.</p></div>
      </details>

      <details class="avonent-faq__item">
        <summary class="avonent-faq__question">
          <span class="avonent-faq__number">02</span>
          <span class="avonent-faq__question-text">How should I use Avonent products?</span>
          <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="avonent-faq__answer rte"><p>Follow the directions on the label of the specific Avonent product you purchase. Serving size and recommended use can vary by formula. Do not exceed the suggested serving unless a qualified healthcare professional tells you otherwise.</p></div>
      </details>

      <details class="avonent-faq__item">
        <summary class="avonent-faq__question">
          <span class="avonent-faq__number">03</span>
          <span class="avonent-faq__question-text">Is every batch third-party lab tested?</span>
          <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="avonent-faq__answer rte"><p>Yes. Every batch of Avonent is third-party tested for identity, purity, potency, and contaminants before it leaves the facility. We believe what is shown on the label should match what is inside the product, so formula and serving details are kept clear and straightforward.</p></div>
      </details>

      <details class="avonent-faq__item">
        <summary class="avonent-faq__question">
          <span class="avonent-faq__number">04</span>
          <span class="avonent-faq__question-text">Can I use Avonent with other supplements or medications?</span>
          <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="avonent-faq__answer rte"><p>Every routine is different. If you take prescription or over-the-counter medication, use other supplements, are pregnant or nursing, have a medical condition, or have a procedure planned, speak with a qualified healthcare professional before adding a new supplement to your routine.</p></div>
      </details>

      <details class="avonent-faq__item">
        <summary class="avonent-faq__question">
          <span class="avonent-faq__number">05</span>
          <span class="avonent-faq__question-text">What is the 30-day money-back guarantee?</span>
          <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="avonent-faq__answer rte"><p>Every eligible Avonent order is covered by our 30-day money-back guarantee. If your purchase is not right for you, contact our support team within 30 days of delivery and we will help you with the next steps under our refund policy.</p></div>
      </details>

      <details class="avonent-faq__item">
        <summary class="avonent-faq__question">
          <span class="avonent-faq__number">06</span>
          <span class="avonent-faq__question-text">Where does Avonent ship from?</span>
          <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="avonent-faq__answer rte"><p>Avonent orders ship from the United States. Available shipping options and the latest estimated delivery timing are shown during checkout before you place your order.</p></div>
      </details>

      {% assign extra_index = 6 %}
      {% for block in section.blocks %}
        {% assign legacy_question = block.settings.question | strip | downcase %}
        {% assign skip_legacy = false %}
        {% if legacy_question == 'what is avonent advanced digestive complex?'
          or legacy_question == 'what kinds of food does the formula help digest?'
          or legacy_question == 'when and how should i take avonent?'
          or legacy_question == 'is every batch third-party tested?'
          or legacy_question == 'can i take avonent with other supplements or medications?'
          or legacy_question == 'is avonent vegan or vegetarian?'
          or legacy_question == 'how quickly should i expect to notice a difference?'
          or legacy_question == 'what is the 30-day money-back guarantee?'
          or legacy_question == 'where does avonent ship from?'
        %}
          {% assign skip_legacy = true %}
        {% endif %}
        {% unless skip_legacy or block.settings.question == blank %}
          {% assign extra_index = extra_index | plus: 1 %}
          <details class="avonent-faq__item" {{ block.shopify_attributes }}>
            <summary class="avonent-faq__question">
              <span class="avonent-faq__number">{% if extra_index < 10 %}0{% endif %}{{ extra_index }}</span>
              <span class="avonent-faq__question-text">{{ block.settings.question | escape }}</span>
              <span class="avonent-faq__toggle" aria-hidden="true"><span></span><span></span></span>
            </summary>
            <div class="avonent-faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {% endunless %}
      {% endfor %}
    </div>

    {% if section.settings.show_support_card %}
      <div class="avonent-faq__support">
        <div class="avonent-faq__support-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.8 9.8 0 0 1-3.8-.8L3 21l1.8-4.6A8.3 8.3 0 0 1 3 11.5a8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 9 8.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 9.3c.3-1.5 1.6-2.4 3.4-2.4 1.9 0 3.3 1 3.3 2.6 0 1.3-.8 2-1.9 2.7-.9.5-1.3 1-1.3 1.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </div>
        <div>
          <h3>{{ section.settings.support_heading | escape }}</h3>
          <p>{{ section.settings.support_text | escape }}</p>
        </div>
        <a class="avonent-faq__support-link" href="{{ section.settings.support_link | default: '/pages/contact' }}">{{ section.settings.support_label | escape }} <span aria-hidden="true">→</span></a>
      </div>
    {% endif %}

    {% if section.settings.show_disclaimer %}
      <p class="avonent-faq__disclaimer">*These statements have not been evaluated by the Food and Drug Administration. Dietary supplements are not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.</p>
    {% endif %}
  </div>
</section>

<style>
  #avonent-faq-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--av-faq-pad-top) 20px var(--av-faq-pad-bottom);
    background: linear-gradient(180deg, var(--av-faq-bg) 0%, #fff 100%);
    color: var(--av-faq-text);
  }
  #avonent-faq-{{ section.id }} * { box-sizing: border-box; }
  #avonent-faq-{{ section.id }} .avonent-faq__orb { position:absolute; z-index:-1; width:420px; height:420px; border-radius:50%; background:rgba(2,198,234,.11); pointer-events:none; }
  #avonent-faq-{{ section.id }} .avonent-faq__orb--one { top:-270px; left:-210px; }
  #avonent-faq-{{ section.id }} .avonent-faq__orb--two { right:-270px; bottom:-280px; }
  #avonent-faq-{{ section.id }} .avonent-faq__container { width:100%; max-width:1040px; margin:0 auto; }
  #avonent-faq-{{ section.id }} .avonent-faq__header { max-width:720px; margin:0 auto 30px; text-align:center; }
  #avonent-faq-{{ section.id }} .avonent-faq__eyebrow { display:inline-flex; align-items:center; gap:9px; margin-bottom:15px; padding:8px 13px; border:1px solid rgba(2,198,234,.28); border-radius:999px; background:rgba(255,255,255,.82); color:#078aa5; font-size:11px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }
  #avonent-faq-{{ section.id }} .avonent-faq__eyebrow span { width:8px; height:8px; border-radius:50%; background:var(--av-faq-accent); box-shadow:0 0 0 5px rgba(2,198,234,.12); }
  #avonent-faq-{{ section.id }} .avonent-faq__heading { margin:0; color:var(--av-faq-text); font-family:var(--font-heading--family, var(--font-body--family)); font-size:clamp(38px,5vw,62px); font-weight:800; line-height:1; letter-spacing:-.045em; }
  #avonent-faq-{{ section.id }} .avonent-faq__subheading { max-width:620px; margin:18px auto 0; color:var(--av-faq-muted); font-size:16px; line-height:1.6; }
  #avonent-faq-{{ section.id }} .avonent-faq__trust { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; max-width:900px; margin:0 auto 18px; }
  #avonent-faq-{{ section.id }} .avonent-faq__trust-item { display:flex; align-items:center; justify-content:center; gap:9px; min-height:54px; padding:10px 14px; border:1px solid var(--av-faq-border); border-radius:14px; background:rgba(255,255,255,.82); font-size:13px; font-weight:750; text-align:center; }
  #avonent-faq-{{ section.id }} .avonent-faq__trust-icon { display:inline-flex; width:23px; height:23px; color:var(--av-faq-accent); }
  #avonent-faq-{{ section.id }} .avonent-faq__trust-icon svg { width:100%; height:100%; }
  #avonent-faq-{{ section.id }} .avonent-faq__list { display:grid; gap:10px; max-width:920px; margin:0 auto; }
  #avonent-faq-{{ section.id }} .avonent-faq__item { overflow:hidden; border:1px solid var(--av-faq-border); border-radius:18px; background:var(--av-faq-card); box-shadow:0 8px 30px rgba(8,48,58,.045); transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  #avonent-faq-{{ section.id }} .avonent-faq__item:hover { transform:translateY(-1px); border-color:rgba(2,198,234,.55); }
  #avonent-faq-{{ section.id }} .avonent-faq__item[open] { border-color:var(--av-faq-accent); box-shadow:0 14px 38px rgba(2,198,234,.11); }
  #avonent-faq-{{ section.id }} .avonent-faq__question { display:grid; grid-template-columns:42px minmax(0,1fr) 42px; align-items:center; gap:14px; min-height:82px; padding:17px 19px; cursor:pointer; list-style:none; }
  #avonent-faq-{{ section.id }} .avonent-faq__question::-webkit-details-marker { display:none; }
  #avonent-faq-{{ section.id }} .avonent-faq__number { display:flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:50%; background:#e6f9fd; color:#078aa5; font-size:11px; font-weight:850; letter-spacing:.06em; }
  #avonent-faq-{{ section.id }} .avonent-faq__item[open] .avonent-faq__number { background:var(--av-faq-accent); color:#002830; }
  #avonent-faq-{{ section.id }} .avonent-faq__question-text { font-family:var(--font-heading--family, var(--font-body--family)); font-size:19px; font-weight:760; line-height:1.3; letter-spacing:-.018em; }
  #avonent-faq-{{ section.id }} .avonent-faq__toggle { position:relative; display:flex; align-items:center; justify-content:center; width:42px; height:42px; border:1px solid var(--av-faq-border); border-radius:50%; background:#f8fdfe; }
  #avonent-faq-{{ section.id }} .avonent-faq__toggle span { position:absolute; width:15px; height:1.5px; border-radius:2px; background:var(--av-faq-text); transition:transform .18s ease; }
  #avonent-faq-{{ section.id }} .avonent-faq__toggle span:last-child { transform:rotate(90deg); }
  #avonent-faq-{{ section.id }} .avonent-faq__item[open] .avonent-faq__toggle span:last-child { transform:rotate(0); }
  #avonent-faq-{{ section.id }} .avonent-faq__answer { margin:0 20px 0 77px; padding:0 62px 23px 0; color:var(--av-faq-muted); font-size:15px; line-height:1.7; }
  #avonent-faq-{{ section.id }} .avonent-faq__answer p { margin:0; }
  #avonent-faq-{{ section.id }} .avonent-faq__support { display:grid; grid-template-columns:50px minmax(0,1fr) auto; align-items:center; gap:16px; max-width:920px; margin:20px auto 0; padding:18px; border:1px solid rgba(2,198,234,.3); border-radius:19px; background:#dff8fd; }
  #avonent-faq-{{ section.id }} .avonent-faq__support-icon { display:flex; align-items:center; justify-content:center; width:50px; height:50px; border-radius:15px; background:var(--av-faq-accent); color:#002830; }
  #avonent-faq-{{ section.id }} .avonent-faq__support-icon svg { width:27px; height:27px; }
  #avonent-faq-{{ section.id }} .avonent-faq__support h3 { margin:0; font-size:17px; font-weight:800; }
  #avonent-faq-{{ section.id }} .avonent-faq__support p { margin:4px 0 0; color:var(--av-faq-muted); font-size:13px; line-height:1.45; }
  #avonent-faq-{{ section.id }} .avonent-faq__support-link { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:46px; padding:12px 18px; border-radius:999px; background:#071114; color:#fff; font-size:13px; font-weight:800; text-decoration:none; }
  #avonent-faq-{{ section.id }} .avonent-faq__disclaimer { max-width:840px; margin:20px auto 0; color:#718088; font-size:11px; line-height:1.55; text-align:center; }
  @media (max-width:749px) {
    #avonent-faq-{{ section.id }} { padding-right:14px; padding-left:14px; }
    #avonent-faq-{{ section.id }} .avonent-faq__heading { font-size:clamp(34px,10.5vw,46px); }
    #avonent-faq-{{ section.id }} .avonent-faq__subheading { font-size:14px; }
    #avonent-faq-{{ section.id }} .avonent-faq__trust { grid-template-columns:1fr; gap:7px; }
    #avonent-faq-{{ section.id }} .avonent-faq__trust-item { justify-content:flex-start; min-height:46px; text-align:left; }
    #avonent-faq-{{ section.id }} .avonent-faq__question { grid-template-columns:34px minmax(0,1fr) 36px; gap:10px; min-height:72px; padding:14px 13px; }
    #avonent-faq-{{ section.id }} .avonent-faq__number { width:34px; height:34px; font-size:10px; }
    #avonent-faq-{{ section.id }} .avonent-faq__question-text { font-size:15px; }
    #avonent-faq-{{ section.id }} .avonent-faq__toggle { width:36px; height:36px; }
    #avonent-faq-{{ section.id }} .avonent-faq__answer { margin:0 13px 0 57px; padding:0 34px 18px 0; font-size:13.5px; line-height:1.65; }
    #avonent-faq-{{ section.id }} .avonent-faq__support { grid-template-columns:42px minmax(0,1fr); gap:11px; padding:15px; }
    #avonent-faq-{{ section.id }} .avonent-faq__support-icon { width:42px; height:42px; }
    #avonent-faq-{{ section.id }} .avonent-faq__support-link { grid-column:1/-1; width:100%; }
  }
  @media (prefers-reduced-motion:reduce) { #avonent-faq-{{ section.id }} .avonent-faq__item, #avonent-faq-{{ section.id }} .avonent-faq__toggle span { transition:none; } }
</style>

<script>
  (() => {
    const root = document.getElementById('avonent-faq-{{ section.id }}');
    if (!root || root.dataset.faqReady === 'true') return;
    root.dataset.faqReady = 'true';
    const items = Array.from(root.querySelectorAll('.avonent-faq__item'));
    items.forEach((item) => item.addEventListener('toggle', () => {
      if (!item.open) return;
      items.forEach((other) => { if (other !== item) other.removeAttribute('open'); });
    }));
  })();
</script>

{% schema %}
{
  "name": "00 Avonent FAQ",
  "tag": "section",
  "class": "section-avonent-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions, answered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clear answers about Avonent, quality testing, product use, shipping, and your 30-day guarantee." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question by default", "default": false },
    { "type": "header", "content": "Trust badges" },
    { "type": "checkbox", "id": "show_trust_badges", "label": "Show trust badges", "default": true },
    { "type": "text", "id": "trust_one", "label": "Trust badge 1", "default": "Third-party lab tested" },
    { "type": "text", "id": "trust_two", "label": "Trust badge 2", "default": "Ships from the USA" },
    { "type": "text", "id": "trust_three", "label": "Trust badge 3", "default": "30-day guarantee" },
    { "type": "header", "content": "Support card" },
    { "type": "checkbox", "id": "show_support_card", "label": "Show support card", "default": true },
    { "type": "text", "id": "support_heading", "label": "Support heading", "default": "Still have a question?" },
    { "type": "textarea", "id": "support_text", "label": "Support text", "default": "Our team is here to help you make an informed decision." },
    { "type": "text", "id": "support_label", "label": "Button label", "default": "Contact Avonent" },
    { "type": "url", "id": "support_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_disclaimer", "label": "Show supplement disclaimer", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Avonent accent", "default": "#02C6EA" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3FCFE" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Heading text", "default": "#071114" },
    { "type": "color", "id": "muted_color", "label": "Body text", "default": "#53636A" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#D5EDF3" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top spacing", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 72 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Additional FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What else would you like customers to know?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add a clear, helpful answer here.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "00 Avonent FAQ" }]
}
{% endschema %}

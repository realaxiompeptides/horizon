{% liquid
  assign section_id = 'avonent-footer-image-' | append: section.id
%}

{% if section.settings.image != blank %}
<section
  id="{{ section_id }}"
  class="avonent-footer-image"
  style="
    --av-footer-image-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
    --av-footer-image-height-desktop: {{ section.settings.height_desktop }}px;
    --av-footer-image-height-mobile: {{ section.settings.height_mobile }}px;
  "
>
  <div class="avonent-footer-image__media">
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        widths: '750,1100,1500,2000,2400',
        sizes: '100vw',
        class: 'avonent-footer-image__image',
        alt: section.settings.heading
    }}
    <div class="avonent-footer-image__shade"></div>

    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="avonent-footer-image__content">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% stylesheet %}
  .avonent-footer-image{
    width:100%;
    margin:0;
    padding:0;
  }
  .avonent-footer-image__media{
    position:relative;
    width:100%;
    height:var(--av-footer-image-height-desktop);
    overflow:hidden;
  }
  .avonent-footer-image__image{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }
  .avonent-footer-image__shade{
    position:absolute;
    inset:0;
    background:rgba(0,31,39,var(--av-footer-image-overlay));
    pointer-events:none;
  }
  .avonent-footer-image__content{
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(900px,calc(100% - 40px));
    padding:0 0 38px;
    color:#fff;
    text-align:left;
  }
  .avonent-footer-image__content h2{
    max-width:700px;
    margin:0;
    color:#fff;
    font-family:var(--font-heading--family,var(--font-body--family));
    font-size:clamp(34px,5vw,58px);
    line-height:1.03;
    letter-spacing:-.035em;
  }
  .avonent-footer-image__content p{
    max-width:640px;
    margin:14px 0 0;
    color:rgba(255,255,255,.9);
    font-family:var(--font-body--family);
    font-size:17px;
    line-height:1.5;
  }
  @media(max-width:749px){
    .avonent-footer-image__media{height:var(--av-footer-image-height-mobile)}
    .avonent-footer-image__content{
      width:calc(100% - 32px);
      padding-bottom:24px;
    }
    .avonent-footer-image__content h2{font-size:34px}
    .avonent-footer-image__content p{font-size:14.5px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Footer Image",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"heading","label":"Optional heading","default":""},
    {"type":"textarea","id":"text","label":"Optional text","default":""},
    {"type":"range","id":"overlay","label":"Dark overlay","min":0,"max":80,"step":5,"unit":"%","default":20},
    {"type":"range","id":"height_desktop","label":"Desktop height","min":280,"max":800,"step":20,"unit":"px","default":460},
    {"type":"range","id":"height_mobile","label":"Mobile height","min":240,"max":700,"step":20,"unit":"px","default":380}
  ],
  "presets":[{"name":"Avonent Footer Image"}]
}
{% endschema %}

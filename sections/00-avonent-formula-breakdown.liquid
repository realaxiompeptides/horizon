        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "00 Avonent Formula",
      "category": "Product",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}

{% liquid
  assign section_id = 'AvonentProofStats-' | append: section.id
  assign background_image = section.settings.background_image
  assign mobile_background_image = section.settings.mobile_background_image | default: background_image
  assign button_link = section.settings.button_link

  if button_link == blank
    assign button_link = '#avonent-bottom-offer'
  endif
%}

<section
  id="{{ section_id }}"
  class="avonent-proof-stats{% if background_image != blank %} avonent-proof-stats--has-image{% endif %}"
  style="
    --aps-bg: {{ section.settings.background_color }};
    --aps-text: {{ section.settings.text_color }};
    --aps-muted: {{ section.settings.muted_text_color }};
    --aps-accent: {{ section.settings.accent_color }};
    --aps-line: {{ section.settings.divider_color }};
    --aps-button: {{ section.settings.button_color }};
    --aps-button-text: {{ section.settings.button_text_color }};
    --aps-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --aps-width: {{ section.settings.content_width }}px;
    --aps-radius: {{ section.settings.corner_radius }}px;
    --aps-top: {{ section.settings.padding_top }}px;
    --aps-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if background_image != blank %}
    <picture class="avonent-proof-stats__media" aria-hidden="true">
      {% if section.settings.mobile_background_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_background_image | image_url: width: 600 }} 600w,
            {{ mobile_background_image | image_url: width: 900 }} 900w,
            {{ mobile_background_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
        >
      {% endif %}
      {{
        background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'avonent-proof-stats__image'
      }}
    </picture>
  {% endif %}

  <div class="avonent-proof-stats__overlay" aria-hidden="true"></div>

  <div class="avonent-proof-stats__inner">
    <header class="avonent-proof-stats__header">
      {% if section.settings.eyebrow != blank %}
        <p class="avonent-proof-stats__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="avonent-proof-stats__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="avonent-proof-stats__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="avonent-proof-stats__grid" role="list" aria-label="Avonent formula facts">
        {% for block in section.blocks %}
          <article class="avonent-proof-stats__stat" role="listitem" {{ block.shopify_attributes }}>
            {% if block.settings.kicker != blank %}
              <span class="avonent-proof-stats__kicker">{{ block.settings.kicker }}</span>
            {% endif %}

            {% if block.settings.value != blank %}
              <p
                class="avonent-proof-stats__value"
                data-count-value="{{ block.settings.value | escape }}"
                aria-label="{{ block.settings.value | escape }}"
              >{{ block.settings.value }}</p>
            {% endif %}

            {% if block.settings.label != blank %}
              <p class="avonent-proof-stats__label">{{ block.settings.label }}</p>
            {% endif %}

            {% if block.settings.detail != blank %}
              <p class="avonent-proof-stats__detail">{{ block.settings.detail }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    <div class="avonent-proof-stats__footer">
      {% if section.settings.button_text != blank %}
        <a class="avonent-proof-stats__button" href="{{ button_link | default: '#' }}">
          <span>{{ section.settings.button_text }}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none">
            <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.guarantee_text != blank %}
        <div class="avonent-proof-stats__guarantee">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none">
            <path d="M12 3 19 6v5c0 4.65-2.98 8.63-7 10-4.02-1.37-7-5.35-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{{ section.settings.guarantee_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.footnote != blank %}
        <div class="avonent-proof-stats__footnote rte">{{ section.settings.footnote }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .avonent-proof-stats {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--aps-top) 0 var(--aps-bottom);
    background: var(--aps-bg);
    color: var(--aps-text);
  }

  .avonent-proof-stats::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(circle at 86% 14%, rgb(141 238 255 / 0.18), transparent 28rem),
      linear-gradient(135deg, rgb(255 255 255 / 0.04), transparent 54%);
    pointer-events: none;
  }

  .avonent-proof-stats__media,
  .avonent-proof-stats__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .avonent-proof-stats__media {
    display: block;
  }

  .avonent-proof-stats__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .avonent-proof-stats__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--aps-bg) 97%, transparent) 0%, color-mix(in srgb, var(--aps-bg) 86%, transparent) 55%, color-mix(in srgb, var(--aps-bg) 72%, transparent) 100%),
      rgb(0 33 48 / var(--aps-overlay));
  }

  .avonent-proof-stats:not(.avonent-proof-stats--has-image) .avonent-proof-stats__overlay {
    display: none;
  }

  .avonent-proof-stats__inner {
    width: min(calc(100% - 40px), var(--aps-width));
    margin: 0 auto;
  }

  .avonent-proof-stats__header {
    width: min(100%, 780px);
    margin: 0 auto 42px;
    text-align: center;
  }

  .avonent-proof-stats__eyebrow {
    margin: 0 0 10px;
    color: var(--aps-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .avonent-proof-stats__heading {
    margin: 0;
    color: var(--aps-text);
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 820;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .avonent-proof-stats__description {
    margin: 17px auto 0;
    color: var(--aps-muted);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.55;
  }

  .avonent-proof-stats__description p,
  .avonent-proof-stats__footnote p {
    margin: 0;
  }

  .avonent-proof-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--aps-line);
    border-bottom: 1px solid var(--aps-line);
  }

  .avonent-proof-stats__stat {
    position: relative;
    min-width: 0;
    padding: 34px clamp(20px, 3vw, 42px);
  }

  .avonent-proof-stats__stat + .avonent-proof-stats__stat {
    border-left: 1px solid var(--aps-line);
  }

  .avonent-proof-stats__kicker {
    display: block;
    margin-bottom: 9px;
    color: var(--aps-accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .avonent-proof-stats__value {
    margin: 0;
    color: var(--aps-text);
    font-size: clamp(38px, 4.5vw, 66px);
    font-weight: 760;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .avonent-proof-stats__value.is-counting {
    will-change: contents;
  }

  .avonent-proof-stats__label {
    margin: 13px 0 0;
    color: var(--aps-text);
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 720;
    line-height: 1.3;
  }

  .avonent-proof-stats__detail {
    margin: 7px 0 0;
    color: var(--aps-muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .avonent-proof-stats__footer {
    width: min(100%, 760px);
    margin: 38px auto 0;
    text-align: center;
  }

  .avonent-proof-stats__button {
    display: flex;
    width: 100%;
    min-height: 62px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 24px;
    color: var(--aps-button-text);
    background: var(--aps-button);
    border: 1px solid color-mix(in srgb, var(--aps-button) 78%, white);
    border-radius: var(--aps-radius);
    box-shadow: 0 18px 44px color-mix(in srgb, var(--aps-button) 22%, transparent);
    font-size: 17px;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .avonent-proof-stats__button svg {
    transition: transform 180ms ease;
  }

  @media (hover: hover) {
    .avonent-proof-stats__button:hover {
      filter: brightness(1.05);
      transform: translateY(-2px);
    }

    .avonent-proof-stats__button:hover svg {
      transform: translateX(4px);
    }
  }

  .avonent-proof-stats__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 17px;
    color: var(--aps-muted);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.3;
  }

  .avonent-proof-stats__guarantee svg {
    flex: 0 0 auto;
    color: var(--aps-accent);
  }

  .avonent-proof-stats__footnote {
    margin-top: 16px;
    color: color-mix(in srgb, var(--aps-muted) 82%, transparent);
    font-size: 10px;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    .avonent-proof-stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .avonent-proof-stats__stat:nth-child(odd) {
      border-left: 0;
    }

    .avonent-proof-stats__stat:nth-child(n + 3) {
      border-top: 1px solid var(--aps-line);
    }
  }

  @media screen and (max-width: 749px) {
    .avonent-proof-stats {
      padding-top: max(36px, var(--aps-top));
      padding-bottom: max(36px, var(--aps-bottom));
    }

    .avonent-proof-stats__overlay {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--aps-bg) 92%, transparent), color-mix(in srgb, var(--aps-bg) 77%, transparent)),
        rgb(0 33 48 / var(--aps-overlay));
    }

    .avonent-proof-stats__inner {
      width: min(calc(100% - 32px), var(--aps-width));
    }

    .avonent-proof-stats__header {
      margin-bottom: 26px;
      text-align: left;
    }

    .avonent-proof-stats__heading {
      font-size: 34px;
    }

    .avonent-proof-stats__description {
      margin-top: 13px;
      font-size: 15px;
    }

    .avonent-proof-stats__grid {
      grid-template-columns: 1fr;
    }

    .avonent-proof-stats__stat {
      padding: 25px 2px;
    }

    .avonent-proof-stats__stat + .avonent-proof-stats__stat,
    .avonent-proof-stats__stat:nth-child(n + 3) {
      border-top: 1px solid var(--aps-line);
      border-left: 0;
    }

    .avonent-proof-stats__value {
      font-size: clamp(43px, 14vw, 58px);
    }

    .avonent-proof-stats__label {
      margin-top: 10px;
      font-size: 16px;
    }

    .avonent-proof-stats__footer {
      margin-top: 30px;
    }

    .avonent-proof-stats__button {
      min-height: 58px;
      border-radius: max(12px, calc(var(--aps-radius) - 2px));
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avonent-proof-stats__button,
    .avonent-proof-stats__button svg {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('{{ section_id }}');
    if (!section || section.dataset.countUpReady === 'true') return;
    section.dataset.countUpReady = 'true';

    const values = Array.from(section.querySelectorAll('.avonent-proof-stats__value[data-count-value]'));
    if (!values.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const parsed = values.map((el) => {
      const raw = (el.dataset.countValue || el.textContent || '').trim();
      const match = raw.match(/^([^0-9]*)([0-9][0-9,]*)(.*)$/);
      if (!match) return null;
      return {
        el,
        raw,
        prefix: match[1] || '',
        target: Number(match[2].replace(/,/g, '')),
        suffix: match[3] || ''
      };
    }).filter(Boolean);

    if (!parsed.length) return;

    const format = (item, value) => `${item.prefix}${Math.max(0, Math.round(value)).toLocaleString('en-US')}${item.suffix}`;

    if (reduceMotion) {
      parsed.forEach((item) => { item.el.textContent = item.raw; });
      return;
    }

    parsed.forEach((item) => {
      item.el.textContent = format(item, 0);
    });

    let hasAnimated = false;
    const run = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      parsed.forEach((item, index) => {
        const duration = 1450 + Math.min(650, Math.log10(Math.max(item.target, 10)) * 180);
        const delay = index * 90;

        window.setTimeout(() => {
          const start = performance.now();
          item.el.classList.add('is-counting');

          const tick = (now) => {
            const progress = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            item.el.textContent = format(item, item.target * eased);

            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              item.el.textContent = item.raw;
              item.el.classList.remove('is-counting');
            }
          };

          requestAnimationFrame(tick);
        }, delay);
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          run();
        }
      }, { threshold: 0.22, rootMargin: '0px 0px -8% 0px' });

      observer.observe(section);
    } else {
      run();
    }
  })();
</script>

{% schema %}
{
  "name": "00 Avonent Proof Stats",
  "tag": "section",
  "class": "avonent-proof-stats-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",

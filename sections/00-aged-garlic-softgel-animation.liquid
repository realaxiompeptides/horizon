<section
  id="AGSoftgel-{{ section.id }}"
  class="ag-softgel"
  style="--bg:{{ section.settings.background }};--a:{{ section.settings.accent }};--ad:{{ section.settings.accent_dark }};--t:{{ section.settings.text_color }};--m:{{ section.settings.muted }};"
>
  <div class="ag-softgel__in">
    <div class="ag-softgel__copy">
      {% if section.settings.eyebrow != blank %}<span class="ag-softgel__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="ag-softgel__text rte">{{ section.settings.body_text }}</div>
      {% if section.settings.note != blank %}<p class="ag-softgel__note">{{ section.settings.note }}</p>{% endif %}
    </div>

    <div class="ag-softgel__visual" aria-hidden="true">
      <div class="ag-softgel__halo"></div>
      <div class="ag-softgel__capsule">
        {% if section.settings.softgel_image != blank %}
          {{ section.settings.softgel_image | image_url: width: 700 | image_tag: widths: '260,420,560,700', sizes: '(min-width:900px) 420px,70vw', loading: 'lazy', class: 'ag-softgel__img', alt: section.settings.softgel_alt }}
        {% else %}
          <img class="ag-softgel__img" src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-aged-garlic-softgel.png?v=1792646955" alt="" loading="lazy" width="520" height="300">
        {% endif %}
        <span class="ag-softgel__oil"></span>
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('AGSoftgel-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      root.classList.toggle('is-active', entry.isIntersecting);
    });
  }, { threshold: 0.35 });
  observer.observe(root);
})();
</script>

{% stylesheet %}
.ag-softgel{overflow:hidden;background:var(--bg);color:var(--t);padding:72px 0}.ag-softgel *{box-sizing:border-box}.ag-softgel__in{width:min(calc(100% - 32px),1120px);margin:auto;display:grid;grid-template-columns:minmax(0,.92fr) minmax(380px,1.08fr);align-items:center;gap:60px}.ag-softgel__copy{max-width:520px}.ag-softgel__eyebrow{display:block;margin-bottom:10px;color:var(--a);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.ag-softgel h2{margin:0;color:var(--t);font-size:clamp(38px,5vw,60px);font-weight:820;line-height:.98;letter-spacing:-.045em}.ag-softgel__text{margin-top:18px;color:var(--m);font-size:16px;line-height:1.7}.ag-softgel__text p{margin:0}.ag-softgel__note{margin:17px 0 0;color:var(--ad);font-size:12px;font-weight:800}.ag-softgel__visual{position:relative;display:grid;place-items:center;min-height:520px;border-radius:30px;background:radial-gradient(circle at 50% 45%,#fff 0 18%,#f7fcff 45%,#e8f7fd 100%);isolation:isolate}.ag-softgel__halo{position:absolute;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgb(2 198 234 / 16%),rgb(2 198 234 / 0) 70%);filter:blur(2px)}.ag-softgel__capsule{position:relative;z-index:2;width:min(78%,430px);height:370px;display:flex;align-items:flex-start;justify-content:center;padding-top:44px}.ag-softgel__img{position:relative;z-index:3;display:block;width:100%;height:auto;max-height:230px;object-fit:contain;filter:drop-shadow(0 22px 20px rgb(98 58 17 / 18%));transform:rotate(-4deg)}.ag-softgel__oil{position:absolute;z-index:1;left:50%;top:176px;width:74px;height:0;transform:translateX(-50%);transform-origin:top center;border-radius:0 0 50% 50%;background:linear-gradient(180deg,rgba(210,116,12,.94) 0%,rgba(246,173,42,.88) 52%,rgba(249,191,70,.12) 100%);filter:drop-shadow(0 12px 10px rgb(157 89 18 / 13%));opacity:0}.ag-softgel__oil::after{content:"";position:absolute;left:50%;bottom:-19px;width:38px;height:38px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(circle at 35% 28%,#ffd66c 0 12%,#e99420 38%,#b96108 82%);box-shadow:inset 5px 4px 9px rgb(255 255 255 / 38%)}.ag-softgel.is-active .ag-softgel__img{animation:agCapsuleFloat 5.4s ease-in-out infinite}.ag-softgel.is-active .ag-softgel__oil{animation:agOilStretch 5.4s cubic-bezier(.65,0,.35,1) infinite}@keyframes agCapsuleFloat{0%,100%{transform:translateY(0) rotate(-4deg)}38%{transform:translateY(5px) rotate(-2deg)}68%{transform:translateY(-3px) rotate(-5deg)}}@keyframes agOilStretch{0%,18%{height:0;opacity:0}28%{height:36px;opacity:.72}46%{height:132px;opacity:.95}61%{height:84px;opacity:.86}74%,100%{height:0;opacity:0}}@media(max-width:899px){.ag-softgel__in{grid-template-columns:1fr;gap:24px}.ag-softgel__copy{max-width:680px}.ag-softgel__visual{min-height:430px}}@media(max-width:749px){.ag-softgel{padding:52px 0}.ag-softgel__in{width:min(calc(100% - 28px),680px)}.ag-softgel h2{font-size:39px}.ag-softgel__text{font-size:14px}.ag-softgel__visual{min-height:390px;border-radius:22px}.ag-softgel__capsule{width:min(88%,380px);height:315px;padding-top:35px}.ag-softgel__oil{top:150px;width:58px}@keyframes agOilStretch{0%,18%{height:0;opacity:0}28%{height:28px;opacity:.72}46%{height:105px;opacity:.95}61%{height:68px;opacity:.86}74%,100%{height:0;opacity:0}}}@media(prefers-reduced-motion:reduce){.ag-softgel.is-active .ag-softgel__img,.ag-softgel.is-active .ag-softgel__oil{animation:none}.ag-softgel__oil{display:none}}
{% endstylesheet %}

{% schema %}
{
  "name":"Animated Softgel Story",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"image_picker","id":"softgel_image","label":"Softgel image"},
    {"type":"text","id":"softgel_alt","label":"Softgel alt text","default":"Aged garlic softgel"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SIMPLE DAILY FORMAT"},
    {"type":"text","id":"heading","label":"Heading","default":"Two softgels. One easy daily routine."},
    {"type":"richtext","id":"body_text","label":"Body text","default":"<p>The softgel format keeps aged garlic simple to take every day, without turning your routine into another chore.</p>"},
    {"type":"text","id":"note","label":"Small note","default":"Follow the serving directions on the product label."},
    {"type":"color","id":"background","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"accent","label":"Avonent blue","default":"#02C6EA"},
    {"type":"color","id":"accent_dark","label":"Deep blue","default":"#0068E8"},
    {"type":"color","id":"text_color","label":"Text","default":"#071A52"},
    {"type":"color","id":"muted","label":"Muted text","default":"#526078"}
  ],
  "presets":[{"name":"Animated Softgel Story"}]
}
{% endschema %}
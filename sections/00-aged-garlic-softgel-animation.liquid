<section
  id="AGSoftgel-{{ section.id }}"
  class="ag-softgel"
  style="--bg:{{ section.settings.background }};--a:{{ section.settings.accent }};--ad:{{ section.settings.accent_dark }};--t:{{ section.settings.text_color }};--m:{{ section.settings.muted }};"
>
  <div class="ag-softgel__in">
    <div class="ag-softgel__copy">
      {% if section.settings.eyebrow != blank %}<span class="ag-softgel__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="ag-softgel__text rte">{{ section.settings.body_text }}</div>
      {% if section.settings.note != blank %}<p class="ag-softgel__note">{{ section.settings.note }}</p>{% endif %}
    </div>

    <div class="ag-softgel__visual" aria-hidden="true">
      <div class="ag-softgel__halo"></div>
      <div class="ag-softgel__capsule">
        <div class="ag-softgel__capsule-inner">
          {% if section.settings.softgel_image != blank %}
            {{ section.settings.softgel_image | image_url: width: 900 | image_tag: widths: '300,450,650,900', sizes: '(min-width:900px) 380px,68vw', loading: 'lazy', class: 'ag-softgel__img', alt: section.settings.softgel_alt }}
          {% else %}
            <img class="ag-softgel__img" src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-aged-garlic-softgel-realistic.png?v=1792648420" alt="{{ section.settings.softgel_alt | escape }}" loading="lazy" width="416" height="256">
          {% endif %}
          <span class="ag-softgel__shine"></span>
        </div>
        <span class="ag-softgel__shadow"></span>
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('AGSoftgel-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      root.classList.toggle('is-active', entry.isIntersecting);
    });
  }, { threshold: 0.35 });
  observer.observe(root);
})();
</script>

{% stylesheet %}
.ag-softgel{overflow:hidden;background:var(--bg);color:var(--t);padding:54px 0}.ag-softgel *{box-sizing:border-box}.ag-softgel__in{width:min(calc(100% - 32px),1120px);margin:auto;display:grid;grid-template-columns:minmax(0,.92fr) minmax(380px,1.08fr);align-items:center;gap:60px}.ag-softgel__copy{max-width:520px}.ag-softgel__eyebrow{display:block;margin-bottom:10px;color:var(--a);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.ag-softgel h2{margin:0;color:var(--t);font-size:clamp(38px,5vw,60px);font-weight:820;line-height:.98;letter-spacing:-.045em}.ag-softgel__text{margin-top:18px;color:var(--m);font-size:16px;line-height:1.7}.ag-softgel__text p{margin:0}.ag-softgel__note{margin:17px 0 0;color:var(--ad);font-size:12px;font-weight:800}.ag-softgel__visual{position:relative;display:grid;place-items:center;min-height:430px;border:1px solid #dcecf5;border-radius:28px;background:radial-gradient(circle at 50% 42%,#fff 0 17%,#f7fcff 48%,#e8f7fd 100%);overflow:hidden;isolation:isolate}.ag-softgel__halo{position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgb(2 198 234 / 14%),rgb(2 198 234 / 0) 70%);filter:blur(3px)}.ag-softgel__capsule{position:relative;z-index:2;display:grid;place-items:center;width:min(78%,430px);height:310px;perspective:900px}.ag-softgel__capsule-inner{position:relative;display:grid;place-items:center;width:min(100%,360px);transform-style:preserve-3d}.ag-softgel__img{position:relative;z-index:2;display:block;width:100%;height:auto;object-fit:contain;filter:drop-shadow(0 20px 18px rgb(108 65 13 / 18%));will-change:transform}.ag-softgel__shine{position:absolute;z-index:3;inset:18% 12%;border-radius:999px;background:linear-gradient(110deg,transparent 20%,rgb(255 255 255 / 0) 34%,rgb(255 255 255 / 48%) 49%,rgb(255 255 255 / 0) 64%,transparent 78%);transform:translateX(-150%) rotate(-9deg);mix-blend-mode:screen;pointer-events:none}.ag-softgel__shadow{position:absolute;z-index:1;left:50%;bottom:36px;width:56%;height:23px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgb(71 49 24 / 24%),rgb(71 49 24 / 0) 70%);filter:blur(7px);will-change:transform,opacity}.ag-softgel.is-active .ag-softgel__capsule-inner{animation:agSoftgelTurn 5.8s cubic-bezier(.45,0,.55,1) infinite}.ag-softgel.is-active .ag-softgel__shine{animation:agSoftgelShine 5.8s ease-in-out infinite}.ag-softgel.is-active .ag-softgel__shadow{animation:agSoftgelShadow 5.8s ease-in-out infinite}@keyframes agSoftgelTurn{0%,100%{transform:translateY(0) rotateZ(-3deg) rotateY(-5deg) scale(1)}26%{transform:translateY(-8px) rotateZ(-1deg) rotateY(7deg) scale(1.012)}52%{transform:translateY(-2px) rotateZ(3deg) rotateY(-4deg) scale(.995)}76%{transform:translateY(-10px) rotateZ(0deg) rotateY(5deg) scale(1.018)}}@keyframes agSoftgelShine{0%,18%{transform:translateX(-150%) rotate(-9deg);opacity:0}30%{opacity:.78}48%{transform:translateX(145%) rotate(-9deg);opacity:0}100%{transform:translateX(145%) rotate(-9deg);opacity:0}}@keyframes agSoftgelShadow{0%,100%{transform:translateX(-50%) scaleX(1);opacity:.62}26%,76%{transform:translateX(-50%) scaleX(.82);opacity:.42}52%{transform:translateX(-50%) scaleX(.94);opacity:.55}}@media(max-width:899px){.ag-softgel__in{grid-template-columns:1fr;gap:24px}.ag-softgel__copy{max-width:680px}.ag-softgel__visual{min-height:430px}}@media(max-width:749px){.ag-softgel{padding:42px 0}.ag-softgel__in{width:min(calc(100% - 28px),680px)}.ag-softgel h2{font-size:39px}.ag-softgel__text{font-size:14px}.ag-softgel__visual{min-height:340px;border-radius:22px}.ag-softgel__capsule{width:min(82%,340px);height:260px}.ag-softgel__capsule-inner{width:min(100%,290px)}.ag-softgel__shadow{bottom:25px}}@media(prefers-reduced-motion:reduce){.ag-softgel.is-active .ag-softgel__capsule-inner,.ag-softgel.is-active .ag-softgel__shine,.ag-softgel.is-active .ag-softgel__shadow{animation:none}.ag-softgel__shine{display:none}}
{% endstylesheet %}

{% schema %}
{
  "name":"Animated Softgel Story",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"image_picker","id":"softgel_image","label":"Softgel image"},
    {"type":"text","id":"softgel_alt","label":"Softgel alt text","default":"Aged garlic softgel"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SIMPLE DAILY FORMAT"},
    {"type":"text","id":"heading","label":"Heading","default":"Two softgels. One easy daily routine."},
    {"type":"richtext","id":"body_text","label":"Body text","default":"<p>The softgel format keeps aged garlic simple to take every day, without turning your routine into another chore.</p>"},
    {"type":"text","id":"note","label":"Small note","default":"Follow the serving directions on the product label."},
    {"type":"color","id":"background","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"accent","label":"Avonent blue","default":"#02C6EA"},
    {"type":"color","id":"accent_dark","label":"Deep blue","default":"#0068E8"},
    {"type":"color","id":"text_color","label":"Text","default":"#071A52"},
    {"type":"color","id":"muted","label":"Muted text","default":"#526078"}
  ],
  "presets":[{"name":"Animated Softgel Story"}]
}
{% endschema %}
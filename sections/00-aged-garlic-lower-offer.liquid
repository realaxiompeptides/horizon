{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variants = product.variants
%}

<section
  id="avonent-garlic-buy"
  class="ag-lower-offer"
  style="--bg:{{ section.settings.background }};--card:{{ section.settings.card_background }};--t:{{ section.settings.text }};--m:{{ section.settings.muted }};--a:{{ section.settings.accent }};--ad:{{ section.settings.accent_dark }};--line:{{ section.settings.line }};"
>
  <div class="ag-lower-offer__in">
    <div class="ag-lower-offer__eyebrow">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <div class="ag-lower-offer__intro rte">{{ section.settings.intro }}</div>

    {% if section.settings.show_stock_meter %}
      <div class="ag-lower-offer__meter">
        <span><i style="width:{{ section.settings.sold_percent }}%"></i></span>
        <strong>{{ section.settings.sold_percent }}% Sold</strong>
      </div>
    {% endif %}

    <div class="ag-lower-offer__topline">
      <div>
        <span>{{ section.settings.offer_label }}</span>
        {% if section.settings.offer_subtext != blank %}<small>{{ section.settings.offer_subtext }}</small>{% endif %}
      </div>
      <div class="ag-lower-offer__price" data-lower-total>
        <strong>{{ current_variant.price | money }}</strong>
        {% if current_variant.compare_at_price > current_variant.price %}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {% endif %}
      </div>
    </div>

    {% form 'product', product, id: 'AGLowerOfferForm-' | append: section.id %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-lower-variant-input>

      <div class="ag-lower-offer__bundles">
        {% for variant in variants limit: 3 %}
          {% assign idx = forloop.index %}
          {% assign title_key = 'bundle_' | append: idx | append: '_title' %}
          {% assign supply_key = 'bundle_' | append: idx | append: '_supply' %}
          {% assign helper_key = 'bundle_' | append: idx | append: '_helper' %}
          {% assign badge_key = 'bundle_' | append: idx | append: '_badge' %}
          {% assign title = section.settings[title_key] %}
          {% assign supply = section.settings[supply_key] %}
          {% assign helper = section.settings[helper_key] %}
          {% assign badge = section.settings[badge_key] %}
          <button
            type="button"
            class="ag-lower-offer__bundle{% if variant.id == current_variant.id %} is-active{% endif %}"
            data-lower-bundle
            data-id="{{ variant.id }}"
            data-price="{{ variant.price }}"
            data-compare="{{ variant.compare_at_price | default: 0 }}"
            {% unless variant.available %}disabled{% endunless %}
          >
            {% if badge != blank %}<span class="ag-lower-offer__badge">{{ badge }}</span>{% endif %}
            <span class="ag-lower-offer__radio"><i></i></span>
            <span class="ag-lower-offer__thumb">
              {% if section.settings.product_image != blank %}
                {{ section.settings.product_image | image_url: width: 220 | image_tag: widths: '90,140,180,220', loading: 'lazy', alt: product.title }}
              {% elsif product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 220 | image_tag: widths: '90,140,180,220', loading: 'lazy', alt: product.title }}
              {% endif %}
              {% if idx > 1 %}<b>×{{ idx }}</b>{% endif %}
            </span>
            <span class="ag-lower-offer__copy">
              <strong>{{ title }}</strong>
              {% if supply != blank %}<small>{{ supply }}</small>{% endif %}
              {% if helper != blank %}<em>{{ helper }}</em>{% endif %}
            </span>
            <span class="ag-lower-offer__bundle-price">
              <strong>{{ variant.price | money }}</strong>
              {% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %}
            </span>
          </button>
        {% endfor %}
      </div>

      <div class="ag-lower-offer__delivery">
        <span class="ag-lower-offer__delivery-dot"></span>
        <span>{{ section.settings.delivery_prefix }} <b>{{ section.settings.delivery_highlight }}</b></span>
      </div>

      <button type="submit" name="add" class="ag-lower-offer__atc">
        <span class="ag-lower-offer__bag" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="M7 10h18l-1 17H8z"></path><path d="M12 10V7a4 4 0 0 1 8 0v3"></path><path d="M22 21h7M25.5 17.5v7"></path></svg>
        </span>
        <span>{{ section.settings.button_text }}</span>
        <strong data-lower-button-price>{{ current_variant.price | money }}</strong>
      </button>
    {% endform %}

    <div class="ag-lower-offer__perks">
      <span>↻ {{ section.settings.perk_1 }}</span>
      <i></i>
      <span>◷ {{ section.settings.perk_2 }}</span>
    </div>

    {% if section.settings.one_time_note != blank %}
      <div class="ag-lower-offer__note">{{ section.settings.one_time_note }}</div>
    {% endif %}

    <div class="ag-lower-offer__payments">
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    </div>

    <div class="ag-lower-offer__guarantee">
      <span>
        <svg viewBox="0 0 32 32"><path d="M16 3 27 7v8c0 7-4.5 11.8-11 14-6.5-2.2-11-7-11-14V7z"></path><path d="m11 16 3 3 7-8"></path></svg>
      </span>
      {{ section.settings.guarantee_text }}
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('avonent-garlic-buy');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const buttons = [...root.querySelectorAll('[data-lower-bundle]')];
  const input = root.querySelector('[data-lower-variant-input]');
  const total = root.querySelector('[data-lower-total]');
  const buttonPrice = root.querySelector('[data-lower-button-price]');
  const currency = {{ cart.currency.iso_code | default: shop.currency | json }};

  const money = (cents) => {
    try {
      return new Intl.NumberFormat(undefined,{style:'currency',currency}).format(Number(cents)/100);
    } catch(e) {
      return '$' + (Number(cents)/100).toFixed(2);
    }
  };

  const setBundle = (button) => {
    if (!button || button.disabled) return;
    buttons.forEach((b) => b.classList.toggle('is-active', b === button));
    if (input) input.value = button.dataset.id;
    const price = money(button.dataset.price || 0);
    const compare = Number(button.dataset.compare || 0);
    if (buttonPrice) buttonPrice.textContent = price;
    if (total) {
      total.innerHTML = '<strong>'+price+'</strong>' + (compare > Number(button.dataset.price || 0) ? '<s>'+money(compare)+'</s>' : '');
    }
  };

  buttons.forEach((button) => button.addEventListener('click', () => setBundle(button)));
})();
</script>

{% stylesheet %}

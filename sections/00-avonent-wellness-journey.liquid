{% liquid
  assign section_id = 'AvonentJourney-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-journey"
  style="
    --avj-bg: {{ section.settings.background_color }};
    --avj-card: {{ section.settings.card_color }};
    --avj-soft: {{ section.settings.soft_color }};
    --avj-text: {{ section.settings.text_color }};
    --avj-muted: {{ section.settings.muted_text_color }};
    --avj-accent: {{ section.settings.accent_color }};
    --avj-border: {{ section.settings.border_color }};
    --avj-width: {{ section.settings.content_width }}px;
    --avj-top: {{ section.settings.padding_top }}px;
    --avj-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="avonent-journey__inner">
    <header class="avonent-journey__header">
      {% if section.settings.eyebrow != blank %}
        <div class="avonent-journey__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="avonent-journey__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="avonent-journey__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="avonent-journey__timeline">
      {% for block in section.blocks %}
        <article
          class="avonent-journey__step{% if forloop.last %} avonent-journey__step--last{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="avonent-journey__rail" aria-hidden="true">
            <span class="avonent-journey__dot">
              <span class="avonent-journey__dot-icon">
                <svg viewBox="0 0 24 24" fill="none" focusable="false">
                  <path d="M5.75 12.4 9.7 16.25 18.3 7.7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </div>

          <div class="avonent-journey__card">
            <div class="avonent-journey__card-heading">
              {% if block.settings.week != blank %}
                <span class="avonent-journey__week">{{ block.settings.week }}</span>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="avonent-journey__title">{{ block.settings.title }}</h3>
              {% endif %}
            </div>

            <ul class="avonent-journey__benefits" role="list">
              {% for index in (1..4) %}
                {% assign benefit_key = 'benefit_' | append: index %}
                {% assign benefit = block.settings[benefit_key] %}
                {% if benefit != blank %}
                  <li class="avonent-journey__benefit">
                    <span class="avonent-journey__check" aria-hidden="true">
                      <svg viewBox="0 0 20 20" fill="none" focusable="false">
                        <path d="M5.25 10.35 8.45 13.5 14.9 6.85" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ benefit }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.disclaimer != blank %}
      <div class="avonent-journey__disclaimer rte">{{ section.settings.disclaimer }}</div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .avonent-journey {
    position: relative;
    overflow: hidden;
    padding: var(--avj-top) 0 var(--avj-bottom);
    background:
      radial-gradient(circle at 8% 8%, rgb(2 198 234 / 0.10), transparent 25rem),
      radial-gradient(circle at 96% 92%, rgb(2 198 234 / 0.08), transparent 24rem),
      var(--avj-bg);
    color: var(--avj-text);
  }

  .avonent-journey__inner {
    width: min(calc(100% - 40px), var(--avj-width));
    margin: 0 auto;
  }

  .avonent-journey__header {
    width: min(100%, 720px);
    margin: 0 auto clamp(36px, 5vw, 64px);
    text-align: center;
  }

  .avonent-journey__eyebrow {
    margin-bottom: 10px;
    color: var(--avj-accent);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .avonent-journey__heading {
    margin: 0;
    color: var(--avj-text);
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 850;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .avonent-journey__description {
    margin: 16px auto 0;
    color: var(--avj-muted);
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.55;
  }

  .avonent-journey__description p,
  .avonent-journey__disclaimer p {
    margin: 0;
  }

  .avonent-journey__timeline {
    width: min(100%, 880px);
    margin: 0 auto;
  }

  .avonent-journey__step {
    position: relative;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 18px;
    padding-bottom: 24px;
  }

  .avonent-journey__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .avonent-journey__rail::after,
  .avonent-journey__rail::before {
    content: '';
    position: absolute;
    top: 46px;
    bottom: -26px;
    left: 50%;
    width: 3px;
    border-radius: 999px;
    transform: translateX(-50%);
  }

  .avonent-journey__rail::after {
    background: color-mix(in srgb, var(--avj-border) 78%, white);
  }

  .avonent-journey__rail::before {
    z-index: 1;
    background: var(--avj-accent);
    transform: translateX(-50%) scaleY(0);
    transform-origin: top;
    transition: transform 520ms cubic-bezier(.2,.7,.2,1);
  }

  .avonent-journey__step.is-complete .avonent-journey__rail::before {
    transform: translateX(-50%) scaleY(1);
  }

  .avonent-journey__step--last .avonent-journey__rail::after,
  .avonent-journey__step--last .avonent-journey__rail::before {
    display: none;
  }

  .avonent-journey__dot {
    position: relative;
    z-index: 2;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    flex: 0 0 46px;
    background: white;
    border: 1px solid color-mix(in srgb, var(--avj-accent) 22%, var(--avj-border));
    border-radius: 50%;
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--avj-accent) 5%, transparent);
    transition: background 300ms ease, border-color 300ms ease, box-shadow 300ms ease, transform 300ms ease;
  }

  .avonent-journey__dot-icon {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    color: color-mix(in srgb, var(--avj-accent) 28%, white);
    background: white;
    border: 1px solid color-mix(in srgb, var(--avj-accent) 18%, var(--avj-border));
    border-radius: 50%;
    transition: color 300ms ease, background 300ms ease, border-color 300ms ease, transform 300ms ease;
  }

  .avonent-journey__dot-icon svg {
    width: 18px;
    height: 18px;
  }

  .avonent-journey__step.is-active .avonent-journey__dot {
    border-color: color-mix(in srgb, var(--avj-accent) 55%, white);
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--avj-accent) 12%, transparent), 0 8px 24px color-mix(in srgb, var(--avj-accent) 24%, transparent);
    transform: scale(1.03);
  }

  .avonent-journey__step.is-active .avonent-journey__dot-icon {
    color: white;
    background: var(--avj-accent);
    border-color: var(--avj-accent);
    transform: scale(1.04);
  }

  .avonent-journey__card {
    padding: clamp(22px, 3vw, 32px);
    background: linear-gradient(145deg, var(--avj-card), color-mix(in srgb, var(--avj-soft) 35%, white));
    border: 1px solid color-mix(in srgb, var(--avj-accent) 22%, var(--avj-border));
    border-radius: 22px;
    box-shadow: 0 18px 50px rgb(17 24 39 / 0.07);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .avonent-journey__card:hover {
    border-color: color-mix(in srgb, var(--avj-accent) 55%, var(--avj-border));
    box-shadow: 0 22px 60px rgb(2 198 234 / 0.12);
    transform: translateY(-2px);
  }

  .avonent-journey__card-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid color-mix(in srgb, var(--avj-accent) 17%, var(--avj-border));
  }

  .avonent-journey__week {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 6px 11px;
    color: #006d82;
    background: color-mix(in srgb, var(--avj-accent) 14%, white);
    border: 1px solid color-mix(in srgb, var(--avj-accent) 25%, white);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .avonent-journey__title {
    margin: 0;
    color: var(--avj-text);
    font-size: clamp(20px, 2.6vw, 27px);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .avonent-journey__benefits {
    display: grid;
    gap: 14px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .avonent-journey__benefit {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    color: var(--avj-muted);
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.4;
  }

  .avonent-journey__check {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    color: white;
    background: linear-gradient(145deg, #00d7f5, var(--avj-accent));
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: 50%;
    box-shadow: 0 6px 16px rgb(2 198 234 / 0.24);
  }

  .avonent-journey__check svg {
    width: 18px;
    height: 18px;
  }

  .avonent-journey__disclaimer {
    width: min(100%, 760px);
    margin: 10px auto 0;
    color: var(--avj-muted);
    font-size: 11px;
    line-height: 1.5;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .avonent-journey__inner {
      width: min(calc(100% - 28px), var(--avj-width));
    }

    .avonent-journey__header {
      margin-bottom: 32px;
    }

    .avonent-journey__step {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 10px;
      padding-bottom: 16px;
    }

    .avonent-journey__dot {
      width: 34px;
      height: 34px;
      flex-basis: 34px;
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--avj-accent) 8%, transparent);
    }

    .avonent-journey__dot-icon {
      width: 24px;
      height: 24px;
    }

    .avonent-journey__dot-icon svg {
      width: 15px;
      height: 15px;
    }

    .avonent-journey__rail::after,
    .avonent-journey__rail::before {
      top: 34px;
      bottom: -18px;
      width: 2px;
    }

    .avonent-journey__card {
      padding: 18px 16px;
      border-radius: 18px;
    }

    .avonent-journey__card-heading {
      display: block;
      padding-bottom: 14px;
    }

    .avonent-journey__week {
      margin-bottom: 9px;
    }

    .avonent-journey__benefits {
      gap: 12px;
      margin-top: 16px;
    }

    .avonent-journey__benefit {
      grid-template-columns: 27px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
    }

    .avonent-journey__check {
      width: 27px;
      height: 27px;
    }

    .avonent-journey__check svg {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avonent-journey__card,
    .avonent-journey__dot,
    .avonent-journey__dot-icon,
    .avonent-journey__rail::before {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const journey = document.getElementById('{{ section_id }}');
    if (!journey || journey.dataset.scrollChecksReady === 'true') return;

    journey.dataset.scrollChecksReady = 'true';
    const steps = Array.from(journey.querySelectorAll('.avonent-journey__step'));
    if (!steps.length) return;

    let ticking = false;

    const updateJourney = () => {
      const triggerLine = window.innerHeight * 0.55;
      let currentStep = 0;

      steps.forEach((step, index) => {
        const dot = step.querySelector('.avonent-journey__dot');
        if (dot && dot.getBoundingClientRect().top <= triggerLine) currentStep = index;
      });

      steps.forEach((step, index) => {
        step.classList.toggle('is-active', index <= currentStep);
        step.classList.toggle('is-complete', index < currentStep);
        step.classList.toggle('is-current', index === currentStep);
      });

      ticking = false;
    };

    const requestJourneyUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateJourney);
    };

    steps[0].classList.add('is-active', 'is-current');
    updateJourney();
    window.addEventListener('scroll', requestJourneyUpdate, { passive: true });
    window.addEventListener('resize', requestJourneyUpdate);
  })();
</script>


    {"type":"textarea","id":"moringa_week2_benefit_2","label":"Week 2 bullet 2","default":"Joints and training days start to feel more supported."},
    {"type":"textarea","id":"moringa_week2_benefit_3","label":"Week 2 bullet 3","default":"You stop forgetting it because it already has a slot in the day."},

    {"type":"header","content":"Week 3"},
    {"type":"text","id":"moringa_week3_title","label":"Week 3 title","default":"The body-wide stuff"},

{% if request.page_type == 'page' and page.handle == 'membership-test' %}
<section id="av-membership-{{ section.id }}" class="av-membership" data-membership-preview>
  <div class="av-m__hero">
    <div class="av-m__wrap">
      <div class="av-m__kicker">AVONENT · MEMBERSHIP</div>
      <h1>Welcome to your<br><span>subscriber dashboard.</span></h1>
      <p>Everything you need to manage your wellness routine, all in one place.</p>
      <div class="av-m__nav"><a href="#av-plan-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf2bd;</i><span>My subscription</span></a><a href="#av-deliveries-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf0d1;</i><span>Deliveries</span></a><a href="#av-billing-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf09d;</i><span>Billing</span></a><a href="#av-benefits-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf06b;</i><span>My benefits</span></a><a href="#av-help-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf590;</i><span>Support</span></a></div>
      <small class="av-m__notice">Private preview · No real billing changes.</small>
    </div>
  </div>
  <div class="av-m__wrap av-m__body">
    <div class="av-m__heading"><div><div class="av-m__kicker">YOUR MEMBERSHIP</div><h2>My subscription</h2></div></div>
    <div class="av-m__alert" data-payment-alert hidden role="status"><div><strong><i class="av-m__fa" aria-hidden="true">&#xf071;</i> Payment unsuccessful</strong><p>We couldn’t process your latest renewal. Update your payment method and retry to restore your delivery.</p></div><button type="button" class="av-m__button" data-action="payment">Update payment method</button></div>
    <div class="av-m__layout" id="av-plan-{{ section.id }}">
      <div class="av-m__card av-m__plan">
        <div class="av-m__product">
          {% assign preview_product = all_products['black-walnut-drops'] %}
          {% if preview_product.featured_image != blank %}
          {{ preview_product.featured_image | image_url: width: 240 | image_tag: class: 'av-m__product-img', loading: 'lazy', alt: preview_product.title }}
          {% else %}
          <div class="av-m__product-placeholder" aria-hidden="true">AVONENT</div>
          {% endif %}
          <div><span class="av-m__status" data-status>Active</span><h3>{{ preview_product.title | default: 'Black Walnut Drops' | escape }}</h3><p>Recurring delivery · Every <span data-frequency>30</span> days</p></div>
        </div>
        <div class="av-m__facts">
          <div><span>Next scheduled delivery</span><strong data-date>—</strong></div>
          <div><span>Delivery frequency</span><strong data-frequency-label>Every 30 days</strong></div>
          <div><span>Subscription pricing</span><strong data-price>$34.99 / delivery</strong></div>
          <div><span>Billing status</span><strong data-billing>Scheduled</strong></div>
        </div>
        <h4>Manage your next delivery</h4>
        <div class="av-m__actions">
          <button type="button" data-action="skip"><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf064;</i></span><strong>Skip next order</strong><small>Skip one shipment</small></button>
          <button type="button" data-action="date"><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf073;</i></span><strong>Reschedule</strong><small>Choose a new date</small></button>
          <button type="button" data-action="frequency"><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf021;</i></span><strong>Change frequency</strong><small>Find your ideal timing</small></button>
          <button type="button" data-action="pause"><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf04c;</i></span><strong>Pause membership</strong><small>Take a temporary break</small></button>
        </div>
        <div class="av-m__manage"><button type="button" data-action="resume" hidden>Resume subscription</button><button type="button" data-action="review">Review membership options</button><button type="button" data-action="cancel">Cancel subscription</button></div>
      </div>
      <aside class="av-m__card av-m__summary">
        <div class="av-m__kicker">SUBSCRIBER PERKS</div>
        <h3>Your VIP membership perks.</h3>
        <p>Enjoy extra value, exclusive opportunities and more flexibility than a standard one-time order.</p>
        <ul><li><strong>Exclusive subscriber pricing</strong><span>Unlock the recurring price on your subscribed products.</span></li><li><strong>VIP sale access</strong><span>Enjoy exclusive VIP sales and early access to promotions.</span></li><li><strong>Special member offers</strong><span>Discover eligible promotions, bundles and product savings.</span></li><li><strong>Free shipping on all recurring orders</strong><span>Free shipping on all recurring orders.</span></li><li><strong>Automatic refills</strong><span>Keep your routine stocked with scheduled deliveries.</span></li><li><strong>Skip or pause anytime</strong><span>Take a break or skip a shipment when you need to.</span></li></ul>
      </aside>
    </div>
    <div class="av-m__deliveries" id="av-deliveries-{{ section.id }}">
      <div class="av-m__kicker">DELIVERY SCHEDULE</div><h2>Your deliveries</h2>
      <div class="av-m__card"><h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf073;</i><span>Upcoming orders</span></h3><p>Review your next three scheduled renewals and manage your next shipment.</p><div data-upcoming class="av-m__order-list"></div></div>
      <div class="av-m__card av-m__history"><h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf1da;</i><span>Order history</span></h3><p>Review your previous deliveries and renewal history.</p><div data-history class="av-m__order-list"></div></div>
    </div>
    <div id="av-benefits-{{ section.id }}" class="av-m__benefits">
      <div class="av-m__kicker">MADE FOR YOUR ROUTINE</div><h2>Make the most of your membership.</h2><p>Discover the exclusive benefits of your AVONENT membership. </p>
      <div class="av-m__perks">
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf02b;</i></span><h3>Exclusive subscriber pricing</h3><p>Unlock the recurring price on your subscribed products.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf521;</i></span><h3>VIP sale access</h3><p>Enjoy exclusive VIP sales and early access to promotions.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf06b;</i></span><h3>Special member offers</h3><p>Discover eligible promotions, bundles and product savings.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf0d1;</i></span><h3>Free shipping on all recurring orders</h3><p>Free shipping on all recurring orders.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf466;</i></span><h3>Automatic refills</h3><p>Keep your routine stocked with scheduled deliveries.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf073;</i></span><h3>Flexible delivery dates</h3><p>Move your next shipment to a date that suits you.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf021;</i></span><h3>Your choice of frequency</h3><p>Choose a delivery interval that fits your routine.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf04c;</i></span><h3>Skip or pause anytime</h3><p>Take a break or skip a shipment when you need to.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf590;</i></span><h3>Dedicated membership support</h3><p>Get assistance with your subscription and order questions.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf2bd;</i></span><h3>Easy account management</h3><p>Manage your subscription, payment and delivery details in one place.</p></article>
      </div>
    </div>
    <div id="av-billing-{{ section.id }}" class="av-m__billing"><div class="av-m__kicker">ACCOUNT SETTINGS</div><h2>Billing &amp; shipping</h2><div class="av-m__account-grid">
      <article class="av-m__card"><h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf3c5;</i><span>Shipping address</span></h3><p data-address-label class="av-m__address-label">Jamie Sample<br>123 Example Street<br>Roseville, CA 95678<br>United States</p><button class="av-m__button av-m__outline" type="button" data-action="address">Manage shipping address</button></article>
      <article class="av-m__card"><h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf09d;</i><span>Payment method</span></h3><p data-card-label>Visa ending in 4242</p><p><strong data-payment-status>Ready for next renewal</strong></p><button class="av-m__button av-m__outline" type="button" data-action="payment">Update payment method</button><button class="av-m__button av-m__outline" type="button" data-action="retry" hidden>Retry payment</button></article>
    </div>
    <details class="av-m__card av-m__test-tools"><summary><i class="av-m__fa" aria-hidden="true">&#xf1de;</i> Preview controls</summary><p>Use these controls to explore different account states.</p><button type="button" class="av-m__button av-m__outline" data-action="fail">Simulate failed payment</button><button type="button" class="av-m__text-btn" data-reset>Reset preview</button></details></div>
    <div class="av-m__help" id="av-help-{{ section.id }}"><div><div class="av-m__kicker">WE'RE HERE FOR YOU</div><h2>Need a hand?</h2><p>Get help with your deliveries, subscription or account.</p></div><a class="av-m__button av-m__outline" href="/pages/contact">Contact support</a></div>
  </div>
  <dialog class="av-m__dialog" aria-labelledby="av-m-title-{{ section.id }}"><div class="av-m__modal">
    <button type="button" class="av-m__close" data-close aria-label="Close"><i class="av-m__fa" aria-hidden="true">&#xf00d;</i></button><div class="av-m__kicker">MY MEMBERSHIP</div>
    <h2 id="av-m-title-{{ section.id }}" data-modal-title></h2><p data-modal-text></p><div data-modal-content></div>
    <p data-modal-status role="status" class="av-m__feedback"></p>
    
  </div></dialog>
</section>
<style>
#av-membership-{{ section.id }}{--m-dark:#0B2637;--m-green:#00647A;--m-accent:#02C6EA;--m-sage:#EAF9FC;--m-line:#CBE8EF;color:var(--m-dark);background:#F5FAFC;line-height:1.5;font-family:inherit}
#av-membership-{{ section.id }} *{box-sizing:border-box}
#av-membership-{{ section.id }} .av-m__wrap{width:min(1120px,100% - 40px);margin:auto}
#av-membership-{{ section.id }} .av-m__hero{background:var(--m-dark);color:white;padding:50px 0 34px}
#av-membership-{{ section.id }} h1,#av-membership-{{ section.id }} h2,#av-membership-{{ section.id }} h3,#av-membership-{{ section.id }} h4{font-family:inherit;color:inherit;letter-spacing:-.035em;line-height:1.13;margin:0 0 12px;font-weight:800}
#av-membership-{{ section.id }} h1{font-size:clamp(38px,6vw,68px);max-width:760px}
#av-membership-{{ section.id }} h1 span{color:var(--m-accent)}
#av-membership-{{ section.id }} h2{font-size:clamp(28px,4vw,40px)}
#av-membership-{{ section.id }} h3{font-size:23px}
#av-membership-{{ section.id }} h4{font-size:19px;margin:24px 0 13px}
#av-membership-{{ section.id }} p{margin:0 0 15px;font-size:15px;color:inherit}
#av-membership-{{ section.id }} .av-m__hero p{font-size:18px;color:#DDF5FA;max-width:620px}
#av-membership-{{ section.id }} .av-m__kicker{font-size:11px;font-weight:800;letter-spacing:.15em;color:var(--m-green);margin-bottom:13px}
#av-membership-{{ section.id }} .av-m__hero .av-m__kicker{color:var(--m-accent)}
#av-membership-{{ section.id }} .av-m__nav{display:flex;flex-wrap:wrap;gap:8px;margin:25px 0 20px}
#av-membership-{{ section.id }} .av-m__nav a{color:white;text-decoration:none;border:1px solid #ffffff55;border-radius:7px;padding:10px 15px;font-weight:700;font-size:14px}
#av-membership-{{ section.id }} .av-m__notice{font-size:12px;color:#DDF5FA}
#av-membership-{{ section.id }} .av-m__body{padding:35px 0 60px}
#av-membership-{{ section.id }} .av-m__heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
#av-membership-{{ section.id }} .av-m__layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:20px;scroll-margin-top:100px}
#av-membership-{{ section.id }} .av-m__card{background:#fff;border:1px solid var(--m-line);border-radius:17px;padding:clamp(18px,3vw,28px);min-width:0}
#av-membership-{{ section.id }} .av-m__product{display:flex;align-items:center;gap:18px}
#av-membership-{{ section.id }} .av-m__product-img,#av-membership-{{ section.id }} .av-m__product-placeholder{width:88px;height:100px;object-fit:contain;flex:0 0 88px;border-radius:10px;background:var(--m-sage)}
#av-membership-{{ section.id }} .av-m__product-placeholder{display:grid;place-items:center;font-size:10px;font-weight:800;letter-spacing:.08em}
#av-membership-{{ section.id }} .av-m__status{display:inline-block;background:var(--m-sage);border-radius:999px;padding:4px 10px;font-size:12px;font-weight:800;margin-bottom:8px}
#av-membership-{{ section.id }} .av-m__product h3{margin-bottom:5px;font-size:22px}
#av-membership-{{ section.id }} .av-m__product p{margin:0}
#av-membership-{{ section.id }} .av-m__facts{display:grid;grid-template-columns:1fr 1fr;gap:15px;background:var(--m-sage);border-radius:12px;margin-top:24px;padding:18px}
#av-membership-{{ section.id }} .av-m__facts span,#av-membership-{{ section.id }} .av-m__facts strong{display:block}
#av-membership-{{ section.id }} .av-m__facts span{font-size:12px;margin-bottom:4px;color:#47616E}
#av-membership-{{ section.id }} .av-m__facts strong{font-size:16px}
#av-membership-{{ section.id }} .av-m__actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#av-membership-{{ section.id }} button,#av-membership-{{ section.id }} a{font:inherit;cursor:pointer}
#av-membership-{{ section.id }} .av-m__actions button{display:flex;flex-direction:column;align-items:flex-start;gap:4px;text-align:left;padding:15px;background:#fff;color:var(--m-dark);border:1px solid #B4D9E3;border-radius:10px;min-height:108px}
#av-membership-{{ section.id }} .av-m__actions button span{font-size:25px;font-weight:700;line-height:1}
#av-membership-{{ section.id }} .av-m__actions button strong{font-size:15px}
#av-membership-{{ section.id }} .av-m__actions button small{font-size:12px;color:#47616E}
#av-membership-{{ section.id }} .av-m__manage{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;border-top:1px solid var(--m-line);padding-top:17px;margin-top:22px}
#av-membership-{{ section.id }} .av-m__manage button,#av-membership-{{ section.id }} .av-m__text-btn{border:0;background:none;color:var(--m-green);font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:3px;padding:7px 0}
#av-membership-{{ section.id }} .av-m__summary{background:var(--m-sage)}
#av-membership-{{ section.id }} .av-m__summary ul{list-style:none;padding:0;margin:22px 0 0;display:grid;gap:17px}
#av-membership-{{ section.id }} .av-m__summary li{padding-left:26px;position:relative}
#av-membership-{{ section.id }} .av-m__summary li:before{content:'✓';position:absolute;left:0;color:var(--m-green);font-weight:900}
#av-membership-{{ section.id }} .av-m__summary li strong,#av-membership-{{ section.id }} .av-m__summary li span{display:block}
#av-membership-{{ section.id }} .av-m__summary li span{font-size:13px;margin-top:4px}
#av-membership-{{ section.id }} .av-m__benefits{padding-top:46px;scroll-margin-top:100px}
#av-membership-{{ section.id }} .av-m__perks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:23px 0}
#av-membership-{{ section.id }} .av-m__perks article{background:#fff;padding:22px;border:1px solid var(--m-line);border-radius:13px}
#av-membership-{{ section.id }} .av-m__perks article>span{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--m-sage);font-size:22px;font-weight:800;color:var(--m-green);margin-bottom:16px}
#av-membership-{{ section.id }} .av-m__perks h3{font-size:18px}
#av-membership-{{ section.id }} .av-m__perks p{font-size:14px;margin:0}
#av-membership-{{ section.id }} .av-m__account-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:30px 0}
#av-membership-{{ section.id }} .av-m__button{display:flex;align-items:center;justify-content:center;min-height:48px;padding:12px 16px;border:1.5px solid var(--m-green);background:var(--m-green);color:white;border-radius:8px;text-decoration:none;font-size:14px;font-weight:800;text-align:center;width:100%}
#av-membership-{{ section.id }} .av-m__outline{background:transparent;color:var(--m-green)}
#av-membership-{{ section.id }} .av-m__help{background:var(--m-dark);color:white;border-radius:16px;padding:28px;display:flex;align-items:center;justify-content:space-between;gap:20px;scroll-margin-top:100px}
#av-membership-{{ section.id }} .av-m__help .av-m__kicker{color:var(--m-accent)}
#av-membership-{{ section.id }} .av-m__help a{color:white;border-color:white;width:auto;flex-shrink:0}
#av-membership-{{ section.id }} .av-m__dialog{border:0;border-radius:18px;background:white;color:var(--m-dark);width:min(540px,100% - 24px);max-height:calc(100dvh - 32px);padding:0;overflow:auto;margin:auto;position:fixed;inset:0}
#av-membership-{{ section.id }} .av-m__dialog::backdrop{background:#0B2637A6;backdrop-filter:blur(4px)}
#av-membership-{{ section.id }} .av-m__modal{padding:24px;position:relative}
#av-membership-{{ section.id }} .av-m__modal h2{padding-right:35px;font-size:29px}
#av-membership-{{ section.id }} .av-m__close{position:absolute;right:12px;top:12px;width:40px;height:40px;border:0;border-radius:8px;background:var(--m-sage);color:var(--m-dark);font-size:25px}
#av-membership-{{ section.id }} [data-modal-content]{display:grid;gap:8px;margin:15px 0}
#av-membership-{{ section.id }} .av-m__feedback{font-weight:700;font-size:14px;color:var(--m-green)}
#av-membership-{{ section.id }} .av-m__fine{display:block;margin-top:12px;font-size:12px;color:#47616E}
#av-membership-{{ section.id }} input{font:inherit;border:1px solid #B4D9E3;border-radius:8px;padding:12px;min-height:48px;width:100%;color:var(--m-dark);background:white}
#av-membership-{{ section.id }} :focus-visible{outline:3px solid #009BB9;outline-offset:3px}
@media(max-width:760px){#av-membership-{{ section.id }} .av-m__wrap{width:calc(100% - 28px)}#av-membership-{{ section.id }} .av-m__hero{padding:37px 0 26px}#av-membership-{{ section.id }} .av-m__layout{grid-template-columns:1fr}#av-membership-{{ section.id }} .av-m__perks{grid-template-columns:1fr 1fr}#av-membership-{{ section.id }} .av-m__perks article{padding:16px}#av-membership-{{ section.id }} .av-m__account-grid{grid-template-columns:1fr}#av-membership-{{ section.id }} .av-m__help{align-items:stretch;flex-direction:column}#av-membership-{{ section.id }} .av-m__help a{width:100%}#av-membership-{{ section.id }} .av-m__facts{padding:14px;gap:12px}#av-membership-{{ section.id }} .av-m__actions button{padding:12px;min-height:105px}}

/* Membership Test uses a normal document scroll, including in mobile theme preview. */
html:has([data-membership-preview]):not([scroll-lock]),
html:has([data-membership-preview]):not([scroll-lock]) body {
  height:auto !important; min-height:100% !important; max-height:none !important;
  overflow-y:visible !important;
}
html:has([data-membership-preview]):not([scroll-lock]) .page-wrapper {
  height:auto !important; max-height:none !important; min-height:100svh;
  overflow:visible !important; flex-shrink:0;
}
html:has([data-membership-preview]) #MainContent,
html:has([data-membership-preview]) #MainContent > .shopify-section:has([data-membership-preview]),
#av-membership-{{ section.id }} {
  display:block; height:auto; max-height:none; min-height:0;
  overflow:visible; flex-shrink:0;
}
#av-membership-{{ section.id }} .av-m__body {display:block;visibility:visible;opacity:1;min-height:0;padding-bottom:calc(64px + env(safe-area-inset-bottom,0px))}
#av-membership-{{ section.id }} .av-m__layout,
#av-membership-{{ section.id }} .av-m__benefits,
#av-membership-{{ section.id }} .av-m__help {scroll-margin-top:calc(var(--header-group-height, 100px) + 20px)}
@media(max-width:760px){
  #av-membership-{{ section.id }} .av-m__hero{padding:27px 0 22px}
  #av-membership-{{ section.id }} .av-m__hero h1{font-size:clamp(30px,8.5vw,42px)}
  #av-membership-{{ section.id }} .av-m__hero p{font-size:16px;margin-bottom:12px}
  #av-membership-{{ section.id }} .av-m__nav{margin:16px 0 12px;gap:6px}
  #av-membership-{{ section.id }} .av-m__nav a{padding:9px 10px;font-size:13px}
  #av-membership-{{ section.id }} .av-m__body{padding-top:24px}
}

#av-membership-{{ section.id }} .av-m__hero{background:linear-gradient(140deg,#0B2637,#103E52)}
#av-membership-{{ section.id }} .av-m__button:not(.av-m__outline){background:#02C6EA;border-color:#02C6EA;color:#082C39}
#av-membership-{{ section.id }} .av-m__status{background:#DDF7FC;color:#075D70}
#av-membership-{{ section.id }} .av-m__status[data-state="failed"]{background:#FFF0DD;color:#843E00}
#av-membership-{{ section.id }} .av-m__status[data-state="cancelled"]{background:#F0F2F4;color:#45515D}
#av-membership-{{ section.id }} [hidden]{display:none!important}
#av-membership-{{ section.id }} button:disabled{opacity:.5;cursor:not-allowed}
#av-membership-{{ section.id }} .av-m__alert{display:flex;align-items:center;gap:18px;background:#FFF5E8;border:1px solid #E8B774;color:#743800;padding:18px;border-radius:12px;margin:0 0 18px}
#av-membership-{{ section.id }} .av-m__alert strong{font-size:18px}

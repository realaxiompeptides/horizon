{% if page.handle == 'membership-test' or page.handle == 'membership-test-sign-in' %}
{% assign membership_dashboard_url = routes.root_url | append: '/pages/membership-test' | replace: '//pages/', '/pages/' %}
{% assign membership_sign_in_url = routes.root_url | append: '/pages/membership-test-sign-in' | replace: '//pages/', '/pages/' %}
{% if page.handle == 'membership-test-sign-in' or customer == blank %}
<section id="av-membership-{{ section.id }}" class="av-membership av-m__sign-in" data-membership-preview data-appstle-membership>
  <div class="av-m__wrap">
    <nav class="av-m__sign-in-nav" aria-label="Customer account">
      <a href="{{ routes.account_url }}">My account</a>
    </nav>
    <div class="av-m__sign-in-panel">
      <h1>Manage your subscription</h1>
      {% if customer %}
        <a class="av-m__button" href="{{ membership_dashboard_url | escape }}">Open your subscription dashboard</a>
      {% else %}
        <p>Use the email associated with your subscription. Shopify will email you a sign-in code.</p>
        <a class="av-m__shopify-sign-in" href="/customer_authentication/login?return_to={{ membership_dashboard_url | url_encode }}">Sign in with Shopify to open your Avonent dashboard</a>
      {% endif %}
    </div>
  </div>
</section>
{% else %}
<section id="av-membership-{{ section.id }}" class="av-membership" data-membership-preview data-appstle-membership data-dashboard data-shop-id="{{ shop.id | default: 107404886176 }}" data-price-country="{{ localization.country.iso_code | escape }}" data-sign-in-url="{{ membership_sign_in_url | escape }}">
  <div class="av-m__hero">
    <div class="av-m__wrap">
      <div class="av-m__kicker">AVONENT · MEMBERSHIP</div>
      <h1>Welcome to your<br><span>subscriber dashboard.</span></h1>
      <p>Everything you need to manage your wellness routine, all in one place.</p>
      <div class="av-m__nav"><a href="#av-plan-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf2bd;</i><span>My subscription</span></a><a href="#av-deliveries-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf0d1;</i><span>Deliveries</span></a><a href="#av-billing-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf09d;</i><span>Billing</span></a><a href="#av-benefits-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf06b;</i><span>My benefits</span></a><a href="#av-help-{{ section.id }}"><i class="av-m__fa" aria-hidden="true">&#xf590;</i><span>Support</span></a></div>
    </div>
  </div>
  <div class="av-m__wrap av-m__body">
    <div class="av-m__card av-m__preview-banner" data-subscription-preview hidden>
      <strong>Test mode</strong>
      <p>No account changes are saved.</p>
      <a href="{{ membership_dashboard_url | escape }}">Return to my real subscriptions</a>
    </div>
    <div class="av-m__heading"><div><div class="av-m__kicker">YOUR MEMBERSHIP</div><h2>My subscription</h2></div></div>
    <div class="av-m__layout" id="av-plan-{{ section.id }}">
      <div class="av-m__card av-m__plan">
        <div class="av-m__product">
          <div>
            <h3>Subscription details</h3>
            <label for="av-contract-{{ section.id }}" class="visually-hidden">Subscription</label>
            <select id="av-contract-{{ section.id }}" data-contract hidden></select>
            <p role="status" data-appstle-status>Loading your subscriptions…</p>
          </div>
        </div>
        <div data-contract-content hidden>
        <div class="av-m__order-nav">
          <a class="av-m__button av-m__outline" href="#av-scheduled-{{ section.id }}">Scheduled orders</a>
          <a class="av-m__button av-m__outline" href="#av-past-{{ section.id }}">Past orders</a>
        </div>
        <ul class="av-m__contract-products" data-contract-products></ul>
        <div class="av-m__facts">
          <div><span>Next billing date</span><strong data-contract-next-billing>—</strong></div>
          <div><span>Delivery frequency</span><strong data-contract-frequency>—</strong></div>
          <div><span>Subscription item subtotal</span><strong data-contract-price>—</strong></div>
          <div><span>Billing status</span><strong data-contract-billing-status>—</strong></div>
        </div>
        <div class="av-m__payment-alert" data-payment-alert hidden>
          <div><strong>Payment failed</strong><p data-payment-failure></p></div>
          <button type="button" class="av-m__button" data-subscription-action="payment" disabled>Update payment</button>
        </div>
        <h4>Manage your next delivery</h4>
        <div class="av-m__actions">
          <button type="button" data-subscription-action="skip" disabled><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf064;</i></span><strong>Skip next order</strong><small>Skip one shipment</small></button>
          <button type="button" data-subscription-action="reschedule" disabled><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf073;</i></span><strong>Reschedule</strong><small>Unavailable for this test</small></button>
          <button type="button" data-subscription-action="frequency" disabled><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf021;</i></span><strong>Change frequency</strong><small>Unavailable for this test</small></button>
          <button type="button" data-subscription-action="pause" disabled><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf04c;</i></span><strong>Pause membership</strong><small>Take a temporary break</small></button>
        </div>
        <div class="av-m__manage"><button type="button" data-subscription-action="resume" disabled>Resume subscription</button></div>
      </div>
      </div>
      <aside class="av-m__card av-m__summary" data-contract-content hidden>
        <div class="av-m__kicker">SUBSCRIBER PERKS</div>
        <h3>Your VIP membership perks.</h3>
        <p>Enjoy extra value, exclusive opportunities and more flexibility than a standard one-time order.</p>
        <ul><li><strong data-vip-price-perk>VIP subscriber pricing</strong><span data-vip-price-note>Your current rate is shown in Subscription details.</span></li><li><strong>VIP sales and early access</strong><span>Get early access to new products and subscriber promotions.</span></li><li><strong>Special member offers</strong><span>Discover eligible promotions, bundles and product savings.</span></li><li><strong>Free shipping on all recurring orders</strong><span>Free shipping on all recurring orders.</span></li><li><strong>Automatic refills</strong><span>Keep your routine stocked with scheduled deliveries.</span></li><li><strong>Skip or pause anytime</strong><span>Take a break or skip a shipment when you need to.</span></li></ul>
      </aside>
    </div>
    <div class="av-m__deliveries" data-contract-content hidden id="av-deliveries-{{ section.id }}">
      <div class="av-m__kicker">DELIVERY SCHEDULE</div><h2>Your deliveries</h2>
      <div class="av-m__card av-m__order-section" id="av-scheduled-{{ section.id }}">
        <h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf073;</i><span>Scheduled orders</span></h3>
        <p>Taxes and shipping are finalized at billing.</p>
        <p data-orders-upcoming-status hidden></p><ul class="av-m__order-list" data-orders-upcoming></ul>
      </div>
      <div class="av-m__card av-m__history av-m__order-section" id="av-past-{{ section.id }}">
        <h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf1da;</i><span>Past orders</span></h3>
        <p data-orders-past-status hidden></p><ul class="av-m__order-list" data-orders-past></ul>
      </div>
    </div>
    <div id="av-benefits-{{ section.id }}" class="av-m__benefits" data-contract-content hidden>
      <div class="av-m__kicker">MADE FOR YOUR ROUTINE</div><h2>Make the most of your membership.</h2><p>Discover the exclusive benefits of your AVONENT membership. </p>
      <div class="av-m__perks">
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf02b;</i></span><h3>Exclusive subscriber pricing</h3><p>Unlock the recurring price on your subscribed products.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf521;</i></span><h3>VIP sales and new products</h3><p>Get early access to new products and subscriber promotions.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf06b;</i></span><h3>Special member offers</h3><p>Discover eligible promotions, bundles and product savings.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf0d1;</i></span><h3>Free shipping on all recurring orders</h3><p>Free shipping on all recurring orders.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf466;</i></span><h3>Automatic refills</h3><p>Keep your routine stocked with scheduled deliveries.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf073;</i></span><h3>Flexible delivery dates</h3><p>Move your next shipment to a date that suits you.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf021;</i></span><h3>Your choice of frequency</h3><p>Choose a delivery interval that fits your routine.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf04c;</i></span><h3>Skip or pause anytime</h3><p>Take a break or skip a shipment when you need to.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf590;</i></span><h3>Dedicated membership support</h3><p>Get assistance with your subscription and order questions.</p></article>
        <article><span class="av-m__icon-tile" aria-hidden="true"><i class="av-m__fa" aria-hidden="true">&#xf2bd;</i></span><h3>Easy account management</h3><p>Manage your subscription, payment and delivery details in one place.</p></article>
      </div>
    </div>
    <div id="av-billing-{{ section.id }}" class="av-m__billing" data-contract-content hidden><div class="av-m__kicker">ACCOUNT SETTINGS</div><h2>Billing &amp; shipping</h2><div class="av-m__account-grid">
      <article class="av-m__card"><h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf3c5;</i><span>Shipping address</span></h3><p>Update where your subscription ships.</p><button class="av-m__button av-m__outline" type="button" data-subscription-action="address" disabled>Manage shipping address</button></article>
      <article class="av-m__card"><h3 class="av-m__icon-heading"><i class="av-m__fa" aria-hidden="true">&#xf09d;</i><span>Payment method</span></h3><p>Request a secure link to update your payment method.</p><button class="av-m__button av-m__outline" type="button" data-subscription-action="payment" disabled>Update payment method</button></article>
    </div>
    </div>
    <dialog class="av-m__dialog" data-action-dialog aria-labelledby="av-action-title-{{ section.id }}" aria-describedby="av-action-description-{{ section.id }}">
      <form method="dialog" class="av-m__modal av-m__cancel-panel">
        <h2 id="av-action-title-{{ section.id }}" tabindex="-1" autofocus></h2>
        <p id="av-action-description-{{ section.id }}"></p>
        <div class="av-m__cancel-actions">
          <button type="submit" value="dismiss" class="av-m__button av-m__outline">Go back</button>
          <button type="submit" value="confirm" class="av-m__button" data-confirm-action></button>
        </div>
      </form>
    </dialog>
    <template data-subscription-order-taxes>
      {% for subscription_order in customer.orders limit: 20 %}
        {% if subscription_order.tax_price != nil %}
          <span data-order-id="{{ subscription_order.id }}" data-order-tax="{{ subscription_order.tax_price | money_with_currency | escape }}"></span>
        {% endif %}
      {% endfor %}
    </template>
    <dialog class="av-m__dialog" data-cancel-dialog aria-labelledby="av-cancel-title-{{ section.id }}">
      <form method="dialog" class="av-m__modal av-m__cancel-panel">
        <div class="av-m__cancel-toolbar">
          <button type="button" data-cancel-back hidden>← Back</button>
          <button type="submit" value="keep" aria-label="Close cancellation dialog">✕</button>
        </div>
        <h2 id="av-cancel-title-{{ section.id }}" tabindex="-1" autofocus>Before you go</h2>
        <div class="av-m__cancel-summary">
          <div class="av-m__cancel-plan">
            <div><strong data-cancel-product></strong><div data-cancel-schedule></div></div>
            <strong data-cancel-price hidden></strong>
          </div>
          <p class="av-m__cancel-savings" data-cancel-savings hidden></p>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="start">
          <p>Here’s what comes with your current subscription.</p>
          <ul class="av-m__retention-benefits">
            <li><strong>Your special VIP rate</strong><span>Keeping this subscription preserves your current plan. If you rejoin later, the rate available at that time applies.</span></li>
            <li><strong>VIP sales and special offers</strong><span>Get early access to new products and subscriber offers.</span></li>
            <li><strong>Flexible deliveries</strong><span>Skip an eligible order when you already have enough.</span></li>
          </ul>
          <div class="av-m__cancel-actions">
            <button type="button" class="av-m__button" data-cancel-next="questions">Answer a few questions</button>
            <button type="button" class="av-m__button av-m__outline" data-cancel-next="confirm">Skip questions</button>
          </div>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="questions" hidden>

          <fieldset class="av-m__cancel-reasons" data-cancel-reason>
            <legend class="visually-hidden">Why do you want to cancel?</legend>
            <label><input type="radio" name="cancelReason" value="stock">I have enough product</label>
            <label><input type="radio" name="cancelReason" value="price">It costs too much</label>
            <label><input type="radio" name="cancelReason" value="timing">Orders arrive too often</label>
            <label><input type="radio" name="cancelReason" value="fit">The product isn’t right for me</label>
            <label><input type="radio" name="cancelReason" value="other">Something else</label>
          </fieldset>
          <div class="av-m__cancel-actions">
            <button type="button" class="av-m__button" data-cancel-next="experience" data-preview-next hidden>Continue</button>
            <button type="button" class="av-m__button av-m__outline" data-cancel-next="review" data-live-next>See my options</button>
            <button type="button" class="av-m__button" data-cancel-next="confirm" data-live-next>Continue to cancellation</button>
          </div>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="experience" hidden>
          <fieldset class="av-m__cancel-reasons">
            <legend class="visually-hidden">What mattered most in your decision?</legend>
            <label><input type="radio" name="experience" value="value">Price or value</label>
            <label><input type="radio" name="experience" value="routine">It didn’t fit my routine</label>
            <label><input type="radio" name="experience" value="other">Something else</label>
          </fieldset>
          <button type="button" class="av-m__button" data-cancel-next="timing" data-preview-next>Continue</button>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="timing" hidden>
          <fieldset class="av-m__cancel-reasons">
            <legend class="visually-hidden">How did the delivery schedule work for you?</legend>
            <label><input type="radio" name="timing" value="soon">Orders arrived too soon</label>
            <label><input type="radio" name="timing" value="right">The timing was right</label>
            <label><input type="radio" name="timing" value="none">Timing wasn’t a factor</label>
          </fieldset>
          <button type="button" class="av-m__button" data-cancel-next="delivery" data-preview-next>Continue</button>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="delivery" hidden>
          <fieldset class="av-m__cancel-reasons">
            <legend class="visually-hidden">Would skipping your next order help?</legend>
            <label><input type="radio" name="delivery" value="yes">Yes, I need more time</label>
            <label><input type="radio" name="delivery" value="no">No, I want to stop future renewals</label>
          </fieldset>
          <button type="button" class="av-m__button" data-cancel-next="decision" data-preview-next>Continue</button>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="decision" hidden>
          <fieldset class="av-m__cancel-reasons">
            <legend class="visually-hidden">Are you sure you want to end your subscription?</legend>
            <label><input type="radio" name="decision" value="end">Yes, I want to end it</label>
            <label><input type="radio" name="decision" value="options">I’d like to see my delivery options</label>
          </fieldset>
          <button type="button" class="av-m__button" data-cancel-next="review" data-preview-next>Continue</button>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="review" hidden>
          <p data-cancel-skip-note hidden></p>
          <div class="av-m__cancel-actions">
            <button type="submit" value="skip" class="av-m__button av-m__outline" hidden>Skip next order</button>
            <button type="button" class="av-m__button" data-cancel-next="confirm">Continue to cancellation</button>
          </div>
        </div>
        <div class="av-m__cancel-step" data-cancel-step="confirm" hidden>
          <p>Cancel to stop future renewals. Orders already placed are handled separately.</p>
          <button type="submit" value="cancel" class="av-m__button">Confirm cancellation</button>
        </div>
        <button type="submit" value="keep" class="av-m__button av-m__outline">Keep subscription</button>
      </form>
    </dialog>
    <dialog class="av-m__dialog" data-address-dialog aria-label="Manage shipping address">
      <form class="av-m__modal av-m__address-form" method="post" data-address-form>
        <h2 class="av-m__full" tabindex="-1" autofocus>Manage shipping address</h2>
        <label>First name<input name="firstName" autocomplete="given-name" required></label>
        <label>Last name<input name="lastName" autocomplete="family-name" required></label>
        <label class="av-m__full">Street address<input name="address1" autocomplete="address-line1" required></label>
        <label class="av-m__full">Apartment or unit<input name="address2" autocomplete="address-line2"></label>
        <label>City<input name="city" autocomplete="address-level2" required></label>
        <label>State or region code<input name="provinceCode" autocomplete="address-level1"></label>
        <label>Postal code<input name="zip" autocomplete="postal-code"></label>
        <label>Country code<input name="countryCode" autocomplete="country" maxlength="2" pattern="[A-Za-z]{2}" required></label>
        <label>Phone<input name="phone" type="tel" autocomplete="tel"></label>
        <p role="status" class="av-m__full" data-address-status></p>
        <button type="submit" class="av-m__button" disabled>Save address</button>
        <button type="button" class="av-m__button av-m__outline" data-close-address>Close</button>
      </form>
    </dialog>
    <div class="av-m__help" id="av-help-{{ section.id }}"><div><div class="av-m__kicker">WE'RE HERE FOR YOU</div><h2>Need a hand?</h2><p>Get help with your deliveries, subscription or account.</p></div><a class="av-m__button av-m__outline" href="/pages/contact">Contact support</a></div>
    <section class="av-m__card av-m__cancellation-settings" data-cancellation-settings hidden>
      <div><h3>Cancel subscription</h3><p>Stop future renewals for this subscription.</p></div>
      <button type="button" class="av-m__button av-m__outline" data-subscription-action="cancel" disabled>Cancel subscription</button>
    </section>
  </div>
</section>
{% endif %}
<script src="{{ 'avonent-membership-test.js' | asset_url }}" defer></script>
<style>
#av-membership-{{ section.id }} .av-m__help{margin-top:clamp(22px,4vw,36px)}
#av-membership-{{ section.id }} .av-m__preview-banner{margin-bottom:20px}
#av-membership-{{ section.id }} .av-m__preview-banner p{margin:5px 0 8px}
#av-membership-{{ section.id }} .av-m__preview-banner[hidden]{display:none!important}
#av-membership-{{ section.id }} [data-contract-content][hidden]{display:none!important}
#av-membership-{{ section.id }} .av-m__contract-products{display:grid;gap:14px;list-style:none;padding:0;margin:16px 0 22px}
#av-membership-{{ section.id }} .av-m__contract-products li{display:flex;gap:14px;align-items:center}
#av-membership-{{ section.id }} .av-m__contract-products img{width:64px;height:64px;object-fit:contain;border-radius:8px}
#av-membership-{{ section.id }} .av-m__cancel-panel{display:grid;gap:14px}
#av-membership-{{ section.id }} .av-m__cancel-panel h2,#av-membership-{{ section.id }} .av-m__cancel-panel p{margin:0}
#av-membership-{{ section.id }} .av-m__cancel-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,175px),1fr));gap:10px}
#av-membership-{{ section.id }}.av-m__sign-in{min-height:64vh;background:#fff;padding:24px 0 64px}
#av-membership-{{ section.id }} .av-m__sign-in-nav{text-align:right}
#av-membership-{{ section.id }} .av-m__sign-in-panel{margin:clamp(36px,8vw,88px) auto 0;max-width:520px;padding:clamp(22px,5vw,38px);background:var(--m-sage);border:1px solid var(--m-line);border-radius:18px;text-align:center}
#av-membership-{{ section.id }} .av-m__sign-in-panel h1{font-size:clamp(29px,5vw,42px);margin-bottom:14px}
#av-membership-{{ section.id }} .av-m__sign-in-form{display:grid;gap:10px;margin:24px 0 16px;text-align:left}
#av-membership-{{ section.id }} .av-m__sign-in-form label{font-size:14px;font-weight:700}
#av-membership-{{ section.id }} .av-m__sign-in-form input{width:100%;min-height:48px;border:1px solid var(--m-line);border-radius:10px;padding:10px 13px;background:#fff;color:var(--m-dark);font:inherit;font-size:16px}
#av-membership-{{ section.id }} .av-m__sign-in-form .av-m__button{margin-top:4px}
#av-membership-{{ section.id }} .av-m__sign-in-form [role="status"]{margin:0}
#av-membership-{{ section.id }} .av-m__shopify-sign-in{color:var(--m-green);font-size:14px;font-weight:700;text-underline-offset:3px}
#av-membership-{{ section.id }}{--m-dark:#0B2637;--m-green:#00647A;--m-accent:#02C6EA;--m-sage:#EAF9FC;--m-line:#CBE8EF;color:var(--m-dark);background:#F5FAFC;line-height:1.5;font-family:inherit}
#av-membership-{{ section.id }} *{box-sizing:border-box}
#av-membership-{{ section.id }} .av-m__wrap{width:min(1120px,100% - 40px);margin:auto}
#av-membership-{{ section.id }} .av-m__hero{background:var(--m-dark);color:white;padding:50px 0 34px}
#av-membership-{{ section.id }} h1,#av-membership-{{ section.id }} h2,#av-membership-{{ section.id }} h3,#av-membership-{{ section.id }} h4{font-family:inherit;color:inherit;letter-spacing:-.035em;line-height:1.13;margin:0 0 12px;font-weight:800}
#av-membership-{{ section.id }} h1{font-size:clamp(38px,6vw,68px);max-width:760px}
#av-membership-{{ section.id }} h1 span{color:var(--m-accent)}
#av-membership-{{ section.id }} h2{font-size:clamp(28px,4vw,40px)}
#av-membership-{{ section.id }} h3{font-size:23px}
#av-membership-{{ section.id }} h4{font-size:19px;margin:24px 0 13px}
#av-membership-{{ section.id }} p{margin:0 0 15px;font-size:15px;color:inherit}

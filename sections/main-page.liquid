#av-membership-{{ section.id }} .av-m__training-grid article{border:1px solid var(--m-line);border-radius:12px;padding:16px;background:#F5FAFC}
#av-membership-{{ section.id }} .av-m__training-grid p{margin:8px 0}
#av-membership-{{ section.id }} .av-m__training-grid small{display:block;color:var(--m-green);font-weight:650}
@media(max-width:760px){#av-membership-{{ section.id }} .av-m__training-grid{grid-template-columns:1fr}}
#av-membership-{{ section.id }} .av-m__cancel-step{display:grid;gap:14px}
#av-membership-{{ section.id }} .av-m__cancel-step[hidden],#av-membership-{{ section.id }} .av-m__cancel-panel [hidden]{display:none!important}
#av-membership-{{ section.id }} [data-address-dialog]{width:min(520px,calc(100% - 24px));max-width:calc(100% - 24px);max-height:calc(100dvh - 24px);overflow:auto;overscroll-behavior:contain}
#av-membership-{{ section.id }} .av-m__address-form label{min-width:0}
#av-membership-{{ section.id }} .av-m__address-form input{width:100%;min-width:0;font-size:16px}
@media(max-width:480px){#av-membership-{{ section.id }} .av-m__address-form{grid-template-columns:minmax(0,1fr)}}
#av-membership-{{ section.id }} .av-m__retention-benefits{list-style:none;padding:14px 16px;margin:0;background:var(--m-sage);border:1px solid var(--m-line);border-radius:12px;display:grid;gap:12px}
#av-membership-{{ section.id }} .av-m__retention-benefits span{display:block;margin-top:2px;font-size:14px}
@media(max-width:420px){#av-membership-{{ section.id }} .av-m__cancel-actions{grid-template-columns:minmax(0,1fr)}}
#av-membership-{{ section.id }} [data-cancel-step="questions"] label{font-weight:700}
#av-membership-{{ section.id }} [data-cancel-step="questions"] select{width:100%;min-height:46px;border:1px solid var(--m-line);border-radius:9px;padding:8px 12px;background:white;color:inherit;font-size:16px}
#av-membership-{{ section.id }} .av-m__cancel-toolbar{display:flex;justify-content:space-between;gap:8px}
#av-membership-{{ section.id }} .av-m__cancel-toolbar button{border:0;background:var(--m-sage);color:var(--m-dark);border-radius:8px;padding:0 14px;min-height:42px;font-weight:700;cursor:pointer}
#av-membership-{{ section.id }} .av-m__cancel-toolbar button:last-child{margin-inline-start:auto}
#av-membership-{{ section.id }} .av-m__cancel-summary{border:1px solid var(--m-line);border-radius:14px;overflow:hidden;background:#f8fcfd}
#av-membership-{{ section.id }} .av-m__cancel-plan{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px}
#av-membership-{{ section.id }} [data-cancel-schedule]{color:var(--m-green);font-size:14px}
#av-membership-{{ section.id }} .av-m__cancel-savings{padding:12px 14px;background:#e0f3e8;color:#18583e;font-weight:700;font-size:14px}
#av-membership-{{ section.id }} .av-m__cancel-reasons{display:grid;gap:8px;border:0;padding:0;margin:0;min-width:0}
#av-membership-{{ section.id }} .av-m__cancel-reasons legend{font-weight:700;margin-bottom:8px}
#av-membership-{{ section.id }} .av-m__cancel-reasons label{display:flex;align-items:center;gap:10px;padding:10px 12px;min-height:44px;border:1px solid var(--m-line);border-radius:10px;font-weight:500;cursor:pointer}
#av-membership-{{ section.id }} .av-m__cancel-reasons label:has(:checked){border-color:var(--m-green);background:var(--m-sage)}
#av-membership-{{ section.id }} .av-m__cancel-reasons input{accent-color:var(--m-green)}
#av-membership-{{ section.id }} [data-cancel-dialog] .av-m__cancel-reasons input[type="radio"]{appearance:auto;-webkit-appearance:radio;inline-size:18px;block-size:18px;width:18px;height:18px;min-width:18px;min-height:18px;max-width:18px;padding:0;margin:0;border:0;box-shadow:none;flex:0 0 18px;accent-color:#176f66}
#av-membership-{{ section.id }} [data-cancel-dialog] .av-m__cancel-panel{gap:13px;padding:clamp(16px,4vw,26px)}
#av-membership-{{ section.id }} [data-cancel-dialog] h2{font-size:clamp(23px,4.4vw,32px);line-height:1.16}
#av-membership-{{ section.id }} [data-cancel-dialog] h2:focus{outline:none}
#av-membership-{{ section.id }} [data-cancel-dialog] .av-m__cancel-plan{align-items:center;padding:12px 14px}
#av-membership-{{ section.id }} [data-cancel-dialog] .av-m__cancel-reasons label{font-size:15px;font-weight:600;line-height:1.35}
#av-membership-{{ section.id }} [data-cancel-dialog] [data-preview-next]{width:100%}
#av-membership-{{ section.id }} .av-m__payment-alert[hidden],#av-membership-{{ section.id }} .av-m__cancellation-settings[hidden]{display:none!important}
#av-membership-{{ section.id }} .av-m__payment-alert{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;background:var(--m-dark);color:white;border-radius:12px;padding:14px 16px;margin-top:18px}
#av-membership-{{ section.id }} .av-m__payment-alert p,#av-membership-{{ section.id }} .av-m__cancellation-settings p{margin:3px 0 0}
#av-membership-{{ section.id }} .av-m__payment-alert .av-m__button{background:white;color:var(--m-dark)}
#av-membership-{{ section.id }} .av-m__cancellation-settings{margin-top:24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}
#av-membership-{{ section.id }} .av-m__order-nav{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 20px}
#av-membership-{{ section.id }} .av-m__order-nav .av-m__button{min-height:42px;padding:8px 13px}
#av-membership-{{ section.id }} .av-m__order-section{scroll-margin-top:calc(var(--header-group-height, 100px) + 20px)}
#av-membership-{{ section.id }} .av-m__order-list{list-style:none;margin:0;padding:0}
#av-membership-{{ section.id }} .av-m__order-list li{padding:11px 0;border-top:1px solid var(--m-line);overflow-wrap:anywhere}
</style>

{% else %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% endif %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}

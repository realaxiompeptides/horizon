#av-membership-{{ section.id }} .av-m__deliveries,#av-membership-{{ section.id }} .av-m__billing{padding-top:40px;scroll-margin-top:calc(var(--header-group-height,100px) + 20px)}
#av-membership-{{ section.id }} .av-m__order-list{display:grid}
#av-membership-{{ section.id }} .av-m__order-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:12px;padding:15px 0;border-top:1px solid var(--m-line)}
#av-membership-{{ section.id }} .av-m__order-row:first-child{border-top:0}

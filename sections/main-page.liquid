<script>
(function(){
const root=document.getElementById('av-membership-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='1';
const q=s=>root.querySelector(s),dialog=q('dialog'),title=q('[data-modal-title]'),desc=q('[data-modal-text]'),content=q('[data-modal-content]'),feedback=q('[data-modal-status]');
let reviewStep=0,reason='',detail='',frequency=30,state='Active',nextDate=addDays(new Date(),30),payment='ready',card='4242',address={first:'Jamie',last:'Sample',line1:'123 Example Street',line2:'',city:'Roseville',region:'CA',postal:'95678',country:'United States',phone:''},history=[];
function addDays(date,days){const d=new Date(date);d.setDate(d.getDate()+days);return d}
function dateLabel(date){return new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric'}).format(date)}
function row(parent,name,detail,flag){const el=document.createElement('div');el.className='av-m__order-row';const left=document.createElement('div'),strong=document.createElement('strong'),small=document.createElement('small'),badge=document.createElement('span');strong.textContent=name;small.textContent=detail;badge.className='av-m__status';badge.textContent=flag;if(flag==='Payment failed')badge.dataset.state='failed';left.append(strong,small);const orderIcon=document.createElement('i');orderIcon.className='av-m__fa av-m__order-icon';orderIcon.setAttribute('aria-hidden','true');orderIcon.textContent=flag==='Delivered'?'\uf058':flag==='Payment failed'?'\uf071':'\uf466';el.append(orderIcon,left,badge);parent.append(el)}
function update(){
const cancelled=state==='Cancelled',paused=state==='Paused',failed=payment!=='ready'&&!cancelled;
q('[data-status]').textContent=cancelled?state:failed?'Payment issue':state;q('[data-status]').dataset.state=cancelled?'cancelled':failed?'failed':'active';
q('[data-frequency]').textContent=frequency;q('[data-frequency-label]').textContent='Every '+frequency+' days';
q('[data-date]').textContent=cancelled?'No future deliveries':dateLabel(nextDate);
q('[data-billing]').textContent=cancelled?'No future renewals':failed?'Payment failed':paused?'Paused':'Scheduled';
q('[data-card-label]').textContent='Visa ending in '+card;q('[data-address-label]').textContent=[address.first+' '+address.last,address.line1,address.line2,[address.city,address.region,address.postal].filter(Boolean).join(', '),address.country].filter(Boolean).join('\n');
q('[data-payment-status]').textContent=payment==='failed'?'Payment failed':payment==='updated'?'Payment updated · retry available':'Ready for next renewal';
q('[data-payment-alert]').hidden=!failed;q('[data-action="retry"]').hidden=payment!=='updated'||cancelled;
q('[data-action="resume"]').hidden=!paused;q('[data-action="fail"]').disabled=cancelled||failed;
root.querySelectorAll('.av-m__actions button,[data-action="cancel"],[data-action="review"]').forEach(b=>b.disabled=cancelled);
const up=q('[data-upcoming]'),past=q('[data-history]');up.replaceChildren();past.replaceChildren();
if(cancelled){const p=document.createElement('p');p.textContent='No upcoming deliveries.';up.append(p)}else for(let i=0;i<3;i++)row(up,dateLabel(addDays(nextDate,i*frequency)),'Black Walnut Drops · $34.99',i===0&&failed?'Payment failed':paused?'Paused':'Scheduled');
history.forEach(h=>row(past,h[0],h[1],h[2]));row(past,'Order #1002',dateLabel(addDays(new Date(),-30))+' · $34.99','Delivered');row(past,'Order #1001',dateLabel(addDays(new Date(),-60))+' · $34.99','Delivered');
}
function button(text,fn,outline=false){const b=document.createElement('button');b.type='button';b.className='av-m__button'+(outline?' av-m__outline':'');b.textContent=text;b.addEventListener('click',fn);return b}
function complete(text){update();content.replaceChildren();feedback.textContent=text}
const reviewPaths={
stock:{label:'I have too much product',question:'How much product do you have left?',answers:['Less than one bottle','One or two bottles','Three or more bottles'],heading:'Give yourself more time',copy:'Skip the next delivery or move it to a date that works for you.',options:[['Skip next order','skip'],['Reschedule delivery','date']]},
price:{label:'It is too expensive',question:'What would help your budget?',answers:['Lower price','Less frequent deliveries','A temporary break'],heading:'Find a better fit for your budget',copy:'Consider a longer delivery interval or a temporary pause.',options:[['Change delivery frequency','frequency'],['Pause membership','pause']]},
timing:{label:'Deliveries are too frequent',question:'How often would you prefer to receive orders?',answers:['Every 30 days','Every 60 days','Every 90 days'],heading:'Choose your delivery schedule',copy:'Adjust your upcoming delivery interval to suit your routine.',options:[['Change delivery frequency','frequency']]},
break:{label:'I need a break',question:'How long would you like to take a break?',answers:['30 days','60 days','90 days'],heading:'Take a break',copy:'Pause upcoming deliveries for a period you choose.',options:[['Pause membership','pause']]},
results:{label:'The product is not right for me',question:'What would you like us to improve?',answers:['Product experience','Product information','Something else'],heading:'Your choice comes first',copy:'You can discontinue your subscription if the product is not right for you.',options:[]},
other:{label:'Something else',question:'What best describes your situation?',answers:['Travel or moving','Only wanted one order','Another reason'],heading:'Manage your membership your way',copy:'Review your schedule or choose to end your subscription.',options:[['Review delivery date','date']]}
};
function renderReview(n){
reviewStep=Math.min(6,Math.max(0,n));const branch=reviewPaths[reason]||reviewPaths.other;content.replaceChildren();feedback.textContent='';
dialog.classList.add('av-m__review-dialog');
const progress=document.createElement('div');progress.className='av-m__review-progress';progress.textContent='MEMBERSHIP REVIEW · '+(reviewStep+1)+' / 7';const bar=document.createElement('progress');bar.max=7;bar.value=reviewStep+1;bar.setAttribute('aria-label','Membership review progress');content.append(progress,bar);
const screens=[['Before you go','Would you like to review your membership benefits and delivery options before cancelling?'],['Why are you considering leaving?','Select the reason that best fits your situation.'],[branch.question,'Select one answer to continue.'],[branch.heading,branch.copy],['Your exclusive member benefits','Keep your $34.99 recurring price and access to exclusive VIP sales, member offers and free shipping on all subscription deliveries.'],['Need a little more flexibility?','You can pause or change your schedule instead of ending your membership.'],['Confirm cancellation','Your subscription will stop renewing.']];
title.textContent=screens[reviewStep][0];desc.textContent=screens[reviewStep][1];
function choice(label,selected,fn){const b=button(label,fn,true);b.classList.add('av-m__survey-choice');b.setAttribute('aria-pressed',String(selected));const mark=document.createElement('span');mark.className='av-m__choice-mark';mark.setAttribute('aria-hidden','true');b.prepend(mark);return b}
if(reviewStep===0){const perks=document.createElement('div');perks.className='av-m__review-perks';["Exclusive subscriber pricing","VIP sale access","Special member offers","Free shipping on all recurring orders","Automatic refills","Flexible delivery dates","Your choice of frequency","Skip or pause anytime","Dedicated membership support","Easy account management"].forEach(x=>{const line=document.createElement('p');const mark=document.createElement('i');mark.className='av-m__fa';mark.setAttribute('aria-hidden','true');mark.textContent='\uf058';line.append(mark,document.createTextNode(' '+x));perks.append(line)});content.append(perks)}
if(reviewStep===1)Object.entries(reviewPaths).forEach(([key,val])=>content.append(choice(val.label,reason===key,()=>{reason=key;detail='';renderReview(1)})));
if(reviewStep===2)branch.answers.forEach(a=>content.append(choice(a,detail===a,()=>{detail=a;renderReview(2)})));
if(reviewStep===3){const note=document.createElement('div');note.className='av-m__response';const heading=document.createElement('strong');heading.textContent='Your feedback';const response=document.createElement('p');response.textContent=[reason?branch.label:'No reason selected',detail].filter(Boolean).join(' · ');note.append(heading,response);content.append(note);branch.options.forEach(([label,mode])=>content.append(button(label,()=>show(mode))))}
if(reviewStep===4){const comparison=document.createElement('div');comparison.className='av-m__comparison';[['Member pricing','$34.99 per delivery'],['VIP sales','Exclusive VIP sale access'],['Member offers','Eligible exclusive promotions'],['Subscription shipping','Free on all recurring orders']].forEach(([a,b])=>{const row=document.createElement('div'),label=document.createElement('strong'),value=document.createElement('span');label.textContent=a;value.textContent=b;row.append(label,value);comparison.append(row)});content.append(comparison,button('Keep my membership',()=>dialog.close()))}
if(reviewStep===5)content.append(button('Pause my membership',()=>show('pause')),button('Change delivery frequency',()=>show('frequency')));
if(reviewStep<6){const next=button(reviewStep===0?'Review my membership':'Continue review',()=>renderReview(reviewStep+1),false);next.disabled=(reviewStep===1&&!reason)||(reviewStep===2&&!detail);content.append(next)}else{const summary=document.createElement('div');summary.className='av-m__response';summary.textContent='Future renewals and scheduled subscription deliveries will stop.';content.append(summary,button('Confirm cancellation',()=>{state='Cancelled';title.textContent='Subscription cancelled';desc.textContent='Your subscription will no longer renew.';complete('Cancellation confirmed in this preview.')}))}
if(reviewStep>0)content.append(button('Back',()=>renderReview(reviewStep-1),true));

if(!dialog.open)dialog.showModal();dialog.scrollTop=0;
}
function show(mode){
if(mode==='review'){reviewStep=0;reason='';detail='';renderReview(0);return}
dialog.classList.remove('av-m__review-dialog');content.replaceChildren();feedback.textContent='';
const modes={skip:['Skip next order','Skip your upcoming shipment and resume on your regular schedule.'],date:['Reschedule delivery','Choose a new date for your upcoming order.'],frequency:['Change delivery frequency','Choose a schedule that suits your routine.'],pause:['Pause membership','Select how long you would like to pause deliveries.'],resume:['Resume subscription','Resume scheduled deliveries.'],review:['Your membership options','Explore subscriber pricing, shipping benefits and flexible delivery choices.'],cancel:['Confirm cancellation','Your subscription will stop renewing.'],address:['Edit shipping address','Update the address for your future subscription deliveries.'],payment:['Update payment method','Choose a preset payment method. No real card details are required.'],retry:['Retry payment','Retry the failed renewal using your updated payment method.']};
if(mode==='fail'){if(state!=='Cancelled'&&payment==='ready'){payment='failed';history.unshift(['Renewal attempt',dateLabel(new Date())+' · $34.99','Payment failed']);update();show('payment')}return}
const m=modes[mode];if(!m)return;title.textContent=m[0];desc.textContent=m[1];
if(mode==='skip')content.append(button('Confirm skip',()=>{nextDate=addDays(nextDate,frequency);complete('Upcoming shipment skipped.')}));
if(mode==='date'){const label=document.createElement('label');label.textContent='New delivery date';const input=document.createElement('input');input.type='date';const today=new Date();const ymd=d=>[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');input.min=ymd(today);input.value=ymd(nextDate);label.append(input);content.append(label,button('Save delivery date',()=>{if(!input.value||!input.checkValidity()){feedback.textContent='Please select a valid future date.';return}nextDate=new Date(input.value+'T12:00:00');complete('Delivery date updated.')}))}
if(mode==='frequency')[30,60,90].forEach(n=>content.append(button('Every '+n+' days',()=>{frequency=n;complete('Delivery frequency updated.')})));
if(mode==='pause')[30,60,90].forEach(n=>content.append(button('Pause for '+n+' days',()=>{state='Paused';nextDate=addDays(new Date(),n);complete('Membership paused for '+n+' days.')})));
if(mode==='resume')content.append(button('Resume deliveries',()=>{state='Active';complete('Subscription resumed.')}));

if(mode==='cancel')content.append(button('Keep my membership',()=>dialog.close(),true),button('Confirm cancellation',()=>{state='Cancelled';title.textContent='Subscription cancelled';desc.textContent='Your subscription will no longer renew.';complete('Cancellation confirmed in this preview.')}));
if(mode==='address'){
const form=document.createElement('form');form.className='av-m__address-form';form.autocomplete='off';
const fields=[['first','First name',true],['last','Last name',true],['line1','Street address',true],['line2','Apartment, suite, etc. (optional)',false],['city','City',true],['region','State / province',true],['postal','ZIP / postal code',true],['country','Country / region',true],['phone','Phone (optional)',false]];
const controls={};
fields.forEach(([key,label,required])=>{const wrap=document.createElement('label');wrap.className='av-m__address-field'+(['line1','line2','country','phone'].includes(key)?' av-m__full':'');const caption=document.createElement('span');caption.textContent=label;const input=document.createElement('input');input.type=key==='phone'?'tel':'text';input.name=key;input.value=address[key]||'';input.required=required;input.autocomplete='off';input.maxLength=120;controls[key]=input;wrap.append(caption,input);form.append(wrap)});
const note=document.createElement('p');note.className='av-m__address-note av-m__full';note.textContent='Private preview: use fictional address details. Changes are not sent or saved to Shopify.';
const save=document.createElement('button');save.type='submit';save.className='av-m__button av-m__full';save.textContent='Save shipping address';form.append(note,save);
form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const next={};fields.forEach(([key])=>next[key]=controls[key].value.trim());if(fields.some(([key,,required])=>required&&!next[key])){feedback.textContent='Please complete the required address fields.';return}address=next;complete('Shipping address updated for future deliveries.')});
content.append(form);
}
if(mode==='payment')['1111','5556'].forEach(n=>content.append(button('Visa ending in '+n,()=>{card=n;if(payment!=='ready')payment='updated';complete('Payment method updated.');if(payment==='updated')content.append(button('Retry payment',()=>show('retry')))})));
if(mode==='retry'){if(payment==='updated'&&state!=='Cancelled')content.append(button('Confirm payment retry',()=>{payment='ready';history.unshift(['Renewal retry',dateLabel(new Date())+' · $34.99','Payment successful']);complete('Payment successful. Your next delivery is scheduled.')}));else content.append(button('Update payment method',()=>show('payment')))}
if(!dialog.open)dialog.showModal();dialog.scrollTop=0;
}
root.addEventListener('click',e=>{const b=e.target.closest('button');if(!b||!root.contains(b))return;if(b.hasAttribute('data-reset')){frequency=30;state='Active';nextDate=addDays(new Date(),30);payment='ready';card='4242';address={first:'Jamie',last:'Sample',line1:'123 Example Street',line2:'',city:'Roseville',region:'CA',postal:'95678',country:'United States',phone:''};history=[];update();return}if(b.hasAttribute('data-close')){dialog.close();return}if(b.dataset.action)show(b.dataset.action)});
dialog.addEventListener('close',()=>{dialog.classList.remove('av-m__review-dialog')});
update();
})();
</script>

{% else %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% endif %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}

#av-membership-{{ section.id }} .av-m__outline{background:transparent;color:var(--m-green)}
#av-membership-{{ section.id }} .av-m__help{background:var(--m-dark);color:white;border-radius:16px;padding:28px;display:flex;align-items:center;justify-content:space-between;gap:20px;scroll-margin-top:100px}
#av-membership-{{ section.id }} .av-m__help .av-m__kicker{color:var(--m-accent)}
#av-membership-{{ section.id }} .av-m__help a{color:white;border-color:white;width:auto;flex-shrink:0}
#av-membership-{{ section.id }} .av-m__dialog{border:0;border-radius:18px;background:white;color:var(--m-dark);width:min(540px,100% - 24px);max-height:calc(100dvh - 32px);padding:0;overflow:auto;margin:auto;position:fixed;inset:0}
#av-membership-{{ section.id }} .av-m__dialog::backdrop{background:#0B2637A6;backdrop-filter:blur(4px)}
#av-membership-{{ section.id }} .av-m__modal{padding:24px;position:relative}
#av-membership-{{ section.id }} .av-m__modal h2{padding-right:35px;font-size:29px}
#av-membership-{{ section.id }} .av-m__close{position:absolute;right:12px;top:12px;width:40px;height:40px;border:0;border-radius:8px;background:var(--m-sage);color:var(--m-dark);font-size:25px}
#av-membership-{{ section.id }} [data-modal-content]{display:grid;gap:8px;margin:15px 0}
#av-membership-{{ section.id }} .av-m__feedback{font-weight:700;font-size:14px;color:var(--m-green)}
#av-membership-{{ section.id }} .av-m__fine{display:block;margin-top:12px;font-size:12px;color:#47616E}
#av-membership-{{ section.id }} input{font:inherit;border:1px solid #B4D9E3;border-radius:8px;padding:12px;min-height:48px;width:100%;color:var(--m-dark);background:white}
#av-membership-{{ section.id }} :focus-visible{outline:3px solid #009BB9;outline-offset:3px}
@media(max-width:760px){#av-membership-{{ section.id }} .av-m__wrap{width:calc(100% - 28px)}#av-membership-{{ section.id }} .av-m__hero{padding:37px 0 26px}#av-membership-{{ section.id }} .av-m__layout{grid-template-columns:1fr}#av-membership-{{ section.id }} .av-m__perks{grid-template-columns:1fr 1fr}#av-membership-{{ section.id }} .av-m__perks article{padding:16px}#av-membership-{{ section.id }} .av-m__account-grid{grid-template-columns:1fr}#av-membership-{{ section.id }} .av-m__help{align-items:stretch;flex-direction:column}#av-membership-{{ section.id }} .av-m__help a{width:100%}#av-membership-{{ section.id }} .av-m__facts{padding:14px;gap:12px}#av-membership-{{ section.id }} .av-m__actions button{padding:12px;min-height:105px}}

/* Membership Test uses a normal document scroll, including in mobile theme preview. */
html:has([data-membership-preview]):not([scroll-lock]),
html:has([data-membership-preview]):not([scroll-lock]) body {
  height:auto !important; min-height:100% !important; max-height:none !important;
  overflow-y:visible !important;
}
html:has([data-membership-preview]):not([scroll-lock]) .page-wrapper {
  height:auto !important; max-height:none !important; min-height:100svh;
  overflow:visible !important; flex-shrink:0;
}
html:has([data-membership-preview]) #MainContent,
html:has([data-membership-preview]) #MainContent > .shopify-section:has([data-membership-preview]),
#av-membership-{{ section.id }} {
  display:block; height:auto; max-height:none; min-height:0;
  overflow:visible; flex-shrink:0;
}
#av-membership-{{ section.id }} .av-m__body {display:block;visibility:visible;opacity:1;min-height:0;padding-bottom:calc(64px + env(safe-area-inset-bottom,0px))}
#av-membership-{{ section.id }} .av-m__layout,
#av-membership-{{ section.id }} .av-m__benefits,
#av-membership-{{ section.id }} .av-m__help {scroll-margin-top:calc(var(--header-group-height, 100px) + 20px)}
@media(max-width:760px){
  #av-membership-{{ section.id }} .av-m__hero{padding:27px 0 22px}
  #av-membership-{{ section.id }} .av-m__hero h1{font-size:clamp(30px,8.5vw,42px)}
  #av-membership-{{ section.id }} .av-m__hero p{font-size:16px;margin-bottom:12px}
  #av-membership-{{ section.id }} .av-m__nav{margin:16px 0 12px;gap:6px}
  #av-membership-{{ section.id }} .av-m__nav a{padding:9px 10px;font-size:13px}
  #av-membership-{{ section.id }} .av-m__body{padding-top:24px}
}

#av-membership-{{ section.id }} .av-m__hero{background:linear-gradient(140deg,#0B2637,#103E52)}
#av-membership-{{ section.id }} .av-m__button:not(.av-m__outline){background:#02C6EA;border-color:#02C6EA;color:#082C39}

    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Avonent-support image"
    },
    {
      "type": "text",
      "id": "after_image_alt",
      "label": "After image alt text",
      "default": "Conceptual illustration of Avonent supporting mixed-meal digestion"
    },
    {
      "type": "text",
      "id": "after_heading",
      "label": "Heading",

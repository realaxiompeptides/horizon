    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Protein. Fats. Carbohydrates. Fiber. Lactose. One mixed meal can contain all five—and each one requires different digestive support.</p>"
    },
    {
      "type": "header",
      "content": "Before support"
    },
    {
      "type": "text",
      "id": "before_tab",

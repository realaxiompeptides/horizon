{% comment %}
  Avonent editorial footer: brand, verified policy routes, support and company information.
  All public-facing details and optional destinations are editable in the theme editor.
{% endcomment %}
{% liquid
  assign af_logo = section.settings.logo | default: settings.logo
  assign af_contact = pages['contact'].url | default: '/pages/contact'
  assign af_track = section.settings.track_url
  if af_track == blank
    assign af_track = pages['track-your-order'].url
  endif
  if af_track == blank
    assign af_track = routes.account_url
  endif
  assign af_subscription = section.settings.subscription_url
  if af_subscription == blank
    assign af_subscription = pages['manage-subscription'].url
  endif
  if af_subscription == blank
    assign af_subscription = af_contact
  endif
%}
<footer
  id="AvonentEditorialFooter-{{ section.id }}"
  class="af-ed"
  style="
    --af-bg: {{ section.settings.background_color }};
    --af-accent: {{ section.settings.accent_color }};
    --af-text: {{ section.settings.text_color }};
    --af-muted: {{ section.settings.muted_color }};
  "
>
  <div class="af-ed__glow" aria-hidden="true"></div>
  <div class="af-ed__inner">
    {% if section.settings.show_newsletter %}
      <div class="af-ed__newsletter">
        <div class="af-ed__newsletter-copy">
          <span class="af-ed__eyebrow">A LITTLE MORE GOOD IN YOUR DAY</span>
          <h2>{{ section.settings.newsletter_title | escape }}</h2>
          <p>{{ section.settings.newsletter_description | escape }}</p>
        </div>
        {% form 'customer', id: 'AvonentFooterNewsletter', class: 'af-ed__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="AfFooterEmail-{{ section.id }}" class="af-ed__sr-only">Email address</label>
          <div class="af-ed__signup">
            <input id="AfFooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
            <button type="submit">Join the list <span aria-hidden="true">↗</span></button>
          </div>
          {% if form.posted_successfully? %}
            <p class="af-ed__form-notice" role="status">Thanks for subscribing.</p>
          {% endif %}
          {% if form.errors %}
            <div class="af-ed__form-notice" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    <div class="af-ed__main">
      <div class="af-ed__brand">
        <a class="af-ed__brand-link" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | escape }} home">
          {% if af_logo != blank %}
            {{ af_logo | image_url: width: 560 | image_tag: class: 'af-ed__logo-image', loading: 'lazy', widths: '200,320,420,560', alt: section.settings.brand_name }}
          {% else %}
            <span class="af-ed__wordmark">{{ section.settings.brand_name | escape }}</span>
          {% endif %}
        </a>
        <p class="af-ed__brand-statement">{{ section.settings.brand_statement | escape }}</p>
        <p class="af-ed__brand-description">{{ section.settings.brand_description | escape }}</p>

        <div class="af-ed__details">
          <div class="af-ed__detail">
            <span class="af-ed__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-12A7 7 0 0 0 5 9c0 5.9 7 12 7 12Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="9" r="2.3" stroke="currentColor" stroke-width="1.7"/></svg>
            </span>
            <div>
              <strong>Business mailing address</strong>
              <span>{{ section.settings.business_address | escape | newline_to_br }}</span>
            </div>
          </div>
          <div class="af-ed__detail">
            <span class="af-ed__detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.5v5l3.3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </span>
            <div>
              <strong>Working hours</strong>
              {% if section.settings.support_hours != blank %}
                <span>{{ section.settings.support_hours | escape }}</span>
              {% else %}
                <span>Contact us for current support hours.</span>
              {% endif %}
            </div>
          </div>
          {% if section.settings.support_email != blank %}
            <div class="af-ed__detail">
              <span class="af-ed__detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7"/></svg>
              </span>
              <div>
                <strong>Email</strong>
                <a href="mailto:{{ section.settings.support_email | escape }}">{{ section.settings.support_email | escape }}</a>
              </div>
            </div>
          {% endif %}
          {% if section.settings.support_phone != blank %}
            <div class="af-ed__detail">
              <span class="af-ed__detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M6.2 3.8 9.1 3l2 4.8-2.1 1.4a15 15 0 0 0 5.7 5.7l1.4-2.1 4.8 2-.8 2.9a2 2 0 0 1-2.2 1.5A17.4 17.4 0 0 1 4.7 6a2 2 0 0 1 1.5-2.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <strong>Phone</strong>
                <a href="tel:{{ section.settings.support_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ section.settings.support_phone | escape }}</a>
              </div>
            </div>
          {% endif %}
        </div>

        {% if section.settings.instagram_url != blank or section.settings.facebook_url != blank or section.settings.tiktok_url != blank %}
          <div class="af-ed__social" aria-label="Follow Avonent">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
            {% endif %}
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a>
            {% endif %}
            {% if section.settings.tiktok_url != blank %}
              <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer">TikTok <span aria-hidden="true">↗</span></a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <nav class="af-ed__links" aria-label="Company">
        <h3>Company</h3>
        <ul>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          {% if pages['about-us'] != blank %}<li><a href="{{ pages['about-us'].url }}">About us</a></li>{% endif %}
          {% if section.settings.company_menu != blank %}
            {% for link in section.settings.company_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          {% endif %}
          <li><a href="{{ af_contact }}">Contact us</a></li>
        </ul>
      </nav>

      <nav class="af-ed__links" aria-label="Help and support">
        <h3>Customer care</h3>
        <ul>
          <li><a href="{{ af_track }}">Track your order</a></li>
          {% if pages['faq'] != blank %}<li><a href="{{ pages['faq'].url }}">FAQs</a></li>{% endif %}
          <li><a href="{{ af_subscription }}">Subscription &amp; cancellation</a></li>
          <li><a href="{{ af_contact }}">Get in touch</a></li>
          {% if section.settings.help_menu != blank %}
            {% for link in section.settings.help_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </nav>

      <nav class="af-ed__links" aria-label="Policies">
        <h3>Policies</h3>
        <ul>
          {% if shop.terms_of_service != blank %}
            <li><a href="{{ shop.terms_of_service.url }}">Terms of service</a></li>
          {% endif %}
          {% if shop.privacy_policy != blank %}
            <li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>
          {% endif %}
          {% if shop.refund_policy != blank %}
            <li><a href="{{ shop.refund_policy.url }}">Returns &amp; refunds</a></li>
          {% endif %}
          {% if shop.shipping_policy != blank %}
            <li><a href="{{ shop.shipping_policy.url }}">Shipping policy</a></li>
          {% endif %}
          {% if section.settings.payment_policy_url != blank %}
            <li><a href="{{ section.settings.payment_policy_url }}">Payment policy</a></li>
          {% endif %}
          <li><a href="{{ af_subscription }}">Subscription &amp; cancellation policy</a></li>
        </ul>
      </nav>
    </div>

    {% if section.settings.show_disclaimer %}
      <div class="af-ed__compliance">
        <span class="af-ed__compliance-heading">Important information</span>
        <div>{{ section.settings.fda_disclaimer }}</div>
        {% if section.settings.additional_disclaimer != blank %}
          <div>{{ section.settings.additional_disclaimer }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="af-ed__bottom">
      <div class="af-ed__bottom-left">
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | escape }}. All rights reserved.</span>
        <span class="af-ed__bottom-divider" aria-hidden="true">·</span>
        <span>Wellness, with intention.</span>
      </div>
      {% if section.settings.show_payment_icons %}
        <div class="af-ed__payments" aria-label="Available payment methods">
          {% for type in shop.enabled_payment_types %}
            <span class="af-ed__payment-icon">{{ type | payment_type_svg_tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  #AvonentEditorialFooter-{{ section.id }} {
    position: relative; isolation: isolate; overflow: hidden; width: 100%;
    background: var(--af-bg); color: var(--af-text);
    font-family: inherit;
  }
  #AvonentEditorialFooter-{{ section.id }} *,
  #AvonentEditorialFooter-{{ section.id }} *::before,
  #AvonentEditorialFooter-{{ section.id }} *::after { box-sizing: border-box; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__glow {
    position: absolute; z-index: -1; pointer-events: none; inset: 0;
    background: radial-gradient(ellipse at 82% -20%, rgba(158,215,161,.14),transparent 50%), radial-gradient(ellipse at -20% 110%,rgba(132,186,135,.10),transparent 52%);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__inner {
    width: min(100% - 48px, 1320px); margin-inline: auto;
  }
  #AvonentEditorialFooter-{{ section.id }} a { color: inherit; text-decoration: none; }
  #AvonentEditorialFooter-{{ section.id }} a:hover,
  #AvonentEditorialFooter-{{ section.id }} a:focus-visible { color: var(--af-accent); }
  #AvonentEditorialFooter-{{ section.id }} a:focus-visible,
  #AvonentEditorialFooter-{{ section.id }} button:focus-visible,
  #AvonentEditorialFooter-{{ section.id }} input:focus-visible { outline: 2px solid var(--af-accent); outline-offset: 4px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__newsletter {
    display: grid; grid-template-columns: 1fr 0.95fr; align-items: center; gap: clamp(32px,5vw,80px);
    padding: clamp(34px,5vw,72px) 0; border-bottom: 1px solid rgba(255,255,255,.17);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__eyebrow {
    color: var(--af-accent); font-size: 10px; font-weight: 800; letter-spacing: .20em;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__newsletter h2 {
    margin: 9px 0 9px; color: var(--af-text); font-size: clamp(27px,3.1vw,42px); line-height: 1.13;
    font-weight: 700; letter-spacing: -.035em;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__newsletter p {
    max-width: 460px; margin: 0; color: var(--af-muted); font-size: 14px; line-height: 1.65;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__signup {
    display: flex; width: 100%; gap: 8px; background: rgba(255,255,255,.07); padding: 7px;
    border: 1px solid rgba(255,255,255,.19); border-radius: 12px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__signup input {
    min-width: 0; flex: 1; font: inherit; font-size: 14px; padding: 15px 15px; color: var(--af-text);
    background: transparent; border: 0; box-shadow: none;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__signup input::placeholder { color: var(--af-muted); opacity: 1; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__signup button {
    border: 0; background: var(--af-accent); color: #0c251b; padding: 12px 20px; border-radius: 8px;
    font: inherit; font-size: 13px; font-weight: 800; white-space: nowrap; cursor: pointer; transition: filter .2s;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__signup button:hover { filter: brightness(1.08); }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__signup button span { margin-left: 9px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__form-notice { margin-top: 10px; color: var(--af-accent); font-size: 13px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__main {
    display: grid; grid-template-columns: minmax(0,1.55fr) repeat(3,minmax(0,.85fr));
    gap: clamp(25px,3.7vw,70px); padding: clamp(44px,6vw,88px) 0 clamp(44px,5vw,70px);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__brand { min-width: 0; padding-right: 10px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__brand-link { display: inline-flex; align-items: center; margin-bottom: 20px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__logo-image {
    width: min(100%,220px); height: auto; max-height: 72px; object-fit: contain; object-position: left;
    filter: brightness(0) invert(1);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__wordmark {
    font-size: clamp(29px,3.1vw,42px); line-height: 1; letter-spacing: -.055em; font-weight: 800; color: var(--af-text);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__brand-statement {
    margin: 0 0 8px; font-size: 18px; font-weight: 650; line-height: 1.4; color: var(--af-text);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__brand-description {
    margin: 0; max-width: 355px; font-size: 13px; line-height: 1.75; color: var(--af-muted);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__details {
    margin-top: 26px; display: flex; flex-direction: column; gap: 20px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail { display: flex; align-items: flex-start; gap: 13px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail-icon {
    width: 34px; height: 34px; flex: none; border-radius: 9px; background: rgba(185,231,152,.09);
    color: var(--af-accent); display: inline-flex; align-items: center; justify-content: center;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail-icon svg { width: 19px; height: 19px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail div { display: flex; flex-direction: column; min-width: 0; gap: 3px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail strong {
    font-size: 12px; font-weight: 750; color: var(--af-text);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail span:not(.af-ed__detail-icon),
  #AvonentEditorialFooter-{{ section.id }} .af-ed__detail a {
    color: var(--af-muted); font-size: 12.5px; line-height: 1.6; overflow-wrap: anywhere;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__social { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 25px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__social a {
    padding: 9px 11px; border-radius: 7px; border: 1px solid rgba(255,255,255,.2);
    color: var(--af-text); font-size: 12px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__social a span { margin-left: 4px; color: var(--af-accent); }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__links h3 {
    color: var(--af-text); font-size: 14px; font-weight: 800; margin: 7px 0 23px; letter-spacing: .01em;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__links ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 17px; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__links li { margin: 0; line-height: 1.45; }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__links a {
    font-size: 13px; font-weight: 450; line-height: 1.5; color: var(--af-muted);
    transition: color .16s ease; overflow-wrap: anywhere;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__compliance {
    padding: 24px 0 24px; border-top: 1px solid rgba(255,255,255,.17); color: var(--af-muted);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__compliance-heading {
    display: block; margin-bottom: 10px; font-size: 11px; font-weight: 750; color: var(--af-text); letter-spacing: .08em; text-transform: uppercase;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__compliance div,
  #AvonentEditorialFooter-{{ section.id }} .af-ed__compliance p {
    color: var(--af-muted); font-size: 11.5px; line-height: 1.68; margin: 0 0 8px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__bottom {
    display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 23px 0 29px;
    border-top: 1px solid rgba(255,255,255,.17);
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__bottom-left {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--af-muted); font-size: 12px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__bottom-divider { color: var(--af-accent); }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__payments {
    display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__payment-icon {
    display: inline-flex; align-items: center; justify-content: center; background: white;
    border-radius: 5px; min-width: 39px; min-height: 26px; padding: 4px;
  }
  #AvonentEditorialFooter-{{ section.id }} .af-ed__payment-icon svg { width: 35px; height: 22px; }
  @media (max-width: 1090px) {
    #AvonentEditorialFooter-{{ section.id }} .af-ed__main {
      grid-template-columns: minmax(0,1.3fr) repeat(2,minmax(0,1fr)); row-gap: 40px;
    }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__links:last-child { grid-column: 2 / 4; }
  }
  @media (max-width: 749px) {
    #AvonentEditorialFooter-{{ section.id }} .af-ed__inner { width: min(100% - 38px,560px); }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__newsletter {
      padding: 35px 0 38px; grid-template-columns: 1fr; gap: 22px;
    }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__newsletter h2 { font-size: 29px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__newsletter p { font-size: 13px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__signup button { padding-inline: 13px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__main {
      grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 25px; row-gap: 37px;
      padding: 42px 0 42px;
    }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__brand { grid-column: 1 / -1; padding-right: 0; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__brand-description { max-width: 440px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__details { display: grid; grid-template-columns: 1fr; gap: 15px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__links h3 { margin: 0 0 17px; font-size: 15px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__links ul { gap: 14px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__links a { font-size: 13px; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__links:last-child { grid-column: 1 / -1; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__bottom { align-items: flex-start; flex-direction: column; }
    #AvonentEditorialFooter-{{ section.id }} .af-ed__payments { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    #AvonentEditorialFooter-{{ section.id }} .af-ed__signup button,
    #AvonentEditorialFooter-{{ section.id }} .af-ed__links a { transition: none; }
  }
</style>
{% schema %}
{
  "name": "Avonent Trust Footer",
  "tag": "section",
  "class": "avonent-footer-section",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand and contact"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo (uses store logo if empty)"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Avonent"
    },
    {
      "type": "text",
      "id": "brand_statement",
      "label": "Short brand statement",
      "default": "Better daily rituals, naturally."
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Carefully selected botanicals and straightforward wellness essentials for everyday life."
    },
    {
      "type": "textarea",
      "id": "business_address",
      "label": "Business mailing address",
      "default": "30 N Gould St\nSheridan, WY 82801\nUnited States"
    },
    {
      "type": "text",
      "id": "support_hours",
      "label": "Working hours (leave blank if unconfirmed)"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Public customer support email"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Public support phone"
    },
    {
      "type": "header",
      "content": "Links and navigation"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Extra company links"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Extra customer care links"
    },
    {
      "type": "url",
      "id": "track_url",
      "label": "Order tracking URL (defaults to account orders)"
    },
    {
      "type": "url",
      "id": "subscription_url",
      "label": "Subscription cancellation page (defaults to contact)"
    },
    {
      "type": "url",
      "id": "payment_policy_url",
      "label": "Payment policy URL"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",

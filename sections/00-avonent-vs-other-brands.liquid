{% liquid
  assign section_id = 'AvonentCompare-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-compare"
  style="
    --avc-bg: {{ section.settings.background_color }};
    --avc-panel: {{ section.settings.panel_color }};
    --avc-panel-soft: {{ section.settings.panel_soft_color }};
    --avc-text: {{ section.settings.text_color }};
    --avc-muted: {{ section.settings.muted_text_color }};
    --avc-accent: {{ section.settings.accent_color }};
    --avc-accent-dark: {{ section.settings.accent_dark_color }};
    --avc-border: {{ section.settings.border_color }};
    --avc-good: {{ section.settings.good_icon_color }};
    --avc-bad: {{ section.settings.bad_icon_color }};
    --avc-button-bg: {{ section.settings.button_background }};
    --avc-button-text: {{ section.settings.button_text_color }};
    --avc-radius: {{ section.settings.corner_radius }}px;
    --avc-top: {{ section.settings.padding_top }}px;
    --avc-bottom: {{ section.settings.padding_bottom }}px;
    --avc-width: {{ section.settings.content_width }}px;
  "
>
  <div class="avonent-compare__inner">

    <div class="avonent-compare__mobile-heading">
      {% if section.settings.eyebrow != blank %}
        <div class="avonent-compare__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="avonent-compare__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="avonent-compare__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="avonent-compare__grid">
      <div class="avonent-compare__left">
        <div class="avonent-compare__columns">
          <div class="avonent-compare__brand avonent-compare__brand--avonent">
            <div class="avonent-compare__brand-head">
              {% if section.settings.avonent_image != blank %}
                <div class="avonent-compare__brand-image">
                  {{
                    section.settings.avonent_image
                    | image_url: width: 320
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 180, 240, 320',
                      alt: section.settings.avonent_label
                  }}
                </div>
              {% endif %}

              <div class="avonent-compare__brand-name">
                {{ section.settings.avonent_label }}
              </div>
            </div>

            {% for block in section.blocks %}
              <div
                class="avonent-compare__row avonent-compare__row--avonent"
                {{ block.shopify_attributes }}
              >
                <span class="avonent-compare__row-icon avonent-compare__row-icon--good" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'shield' %}
                      <svg viewBox="0 0 24 24"><path d="M12 2 4.5 5v5.5c0 5.2 3 9.9 7.5 11.5 4.5-1.6 7.5-6.3 7.5-11.5V5L12 2Zm0 2.2 5.5 2.2v4.1c0 4.1-2.2 7.9-5.5 9.4-3.3-1.5-5.5-5.3-5.5-9.4V6.4L12 4.2Z"/></svg>
                    {% when 'flask' %}
                      <svg viewBox="0 0 24 24"><path d="M9 2h6v2h-1v4.6l4.7 7.7A3.7 3.7 0 0 1 15.5 22h-7a3.7 3.7 0 0 1-3.2-5.7L10 8.6V4H9V2Zm3 7.2-5 8.2a1.7 1.7 0 0 0 1.5 2.6h7a1.7 1.7 0 0 0 1.5-2.6l-5-8.2V4h0v5.2Z"/></svg>
                    {% when 'leaf' %}
                      <svg viewBox="0 0 24 24"><path d="M20.8 3.2C14.1 3.5 8.6 5.8 5.4 9.7 2.8 12.9 3 16.6 5.3 19c2.4 2.3 6.1 2.5 9.3-.1 3.9-3.2 6.2-8.7 6.5-15.4l-.3-.3ZM7 17.5c2.6-4.1 5.8-7.1 10.2-9.6-2.6 4.4-5.5 7.6-9.6 10.2L7 17.5Z"/></svg>
                    {% when 'sparkle' %}
                      <svg viewBox="0 0 24 24"><path d="M12 2c.7 4.1 2.9 6.3 7 7-4.1.7-6.3 2.9-7 7-.7-4.1-2.9-6.3-7-7 4.1-.7 6.3-2.9 7-7Zm7 12c.3 1.8 1.2 2.7 3 3-1.8.3-2.7 1.2-3 3-.3-1.8-1.2-2.7-3-3 1.8-.3 2.7-1.2 3-3Z"/></svg>
                    {% when 'microscope' %}
                      <svg viewBox="0 0 24 24"><path d="M9 2h5v2h-1v5.1a5 5 0 0 1 3.7 4.8H19v2h-2.7A5 5 0 0 1 12 19H7v-2h5a3 3 0 0 0 0-6h-1V4H9V2Zm1 4h2v4h-2V6ZM5 20h14v2H5v-2Z"/></svg>
                    {% when 'globe' %}
                      <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-3.1a15 15 0 0 0-1.6-3.4A8 8 0 0 1 18.9 8ZM12 4c.8 1 1.5 2.3 1.9 4h-3.8c.4-1.7 1.1-3 1.9-4ZM4.3 14A8.2 8.2 0 0 1 4 12c0-.7.1-1.4.3-2h3.4a18 18 0 0 0 0 4H4.3Zm.8 2h3.1a15 15 0 0 0 1.6 3.4A8 8 0 0 1 5.1 16Zm3.1-8H5.1a8 8 0 0 1 4.7-3.4A15 15 0 0 0 8.2 8ZM12 20c-.8-1-1.5-2.3-1.9-4h3.8c-.4 1.7-1.1 3-1.9 4Zm2.3-6H9.7a16 16 0 0 1 0-4h4.6a16 16 0 0 1 0 4Zm-.1 5.4a15 15 0 0 0 1.6-3.4h3.1a8 8 0 0 1-4.7 3.4ZM16.3 14a18 18 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4Z"/></svg>
                    {% when 'heart' %}
                      <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.4-9.5-8.6C.4 8.9 2.1 5 5.8 4.2 8 3.7 10 4.7 12 6.8c2-2.1 4-3.1 6.2-2.6 3.7.8 5.4 4.7 3.3 8.2C19 16.6 12 21 12 21Z"/></svg>
                    {% when 'capsule' %}
                      <svg viewBox="0 0 24 24"><path d="M7.2 3.6a5 5 0 0 1 7.1 0l6.1 6.1a5 5 0 0 1-7.1 7.1l-6.1-6.1a5 5 0 0 1 0-7.1Zm1.4 1.4a3 3 0 0 0 0 4.3l2.4 2.4 4.3-4.3L12.9 5a3 3 0 0 0-4.3 0Zm4 8.3 2.1 2.1a3 3 0 1 0 4.3-4.3L16.7 8.8l-4.1 4.5Z"/></svg>
                    {% when 'droplet' %}
                      <svg viewBox="0 0 24 24"><path d="M12 2s7 7.3 7 12a7 7 0 1 1-14 0C5 9.3 12 2 12 2Zm0 3.1C10.1 7.3 7 11.2 7 14a5 5 0 0 0 10 0c0-2.8-3.1-6.7-5-8.9Z"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24"><path d="m9.2 16.2-4-4 1.4-1.4 2.6 2.6 8.2-8.2 1.4 1.4-9.6 9.6Z"/></svg>
                  {% endcase %}
                </span>

                <span>{{ block.settings.avonent_text }}</span>
              </div>
            {% endfor %}
          </div>

          <div class="avonent-compare__brand avonent-compare__brand--other">
            <div class="avonent-compare__brand-head">
              {% if section.settings.other_image != blank %}
                <div class="avonent-compare__brand-image">
                  {{
                    section.settings.other_image
                    | image_url: width: 320
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 180, 240, 320',
                      alt: section.settings.other_label
                  }}
                </div>
              {% endif %}

              <div class="avonent-compare__brand-name">
                {{ section.settings.other_label }}
              </div>
            </div>

            {% for block in section.blocks %}
              <div class="avonent-compare__row avonent-compare__row--other">
                <span class="avonent-compare__row-icon avonent-compare__row-icon--bad" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="m7.4 6 4.6 4.6L16.6 6 18 7.4 13.4 12l4.6 4.6-1.4 1.4-4.6-4.6L7.4 18 6 16.6l4.6-4.6L6 7.4 7.4 6Z"/></svg>
                </span>

                <span>{{ block.settings.other_text }}</span>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.button_text != blank %}
          <div class="avonent-compare__cta-wrap">
            <a
              class="avonent-compare__button"
              href="{{ section.settings.button_link | default: '#avonent-buy-section' }}"
            >
              <span>{{ section.settings.button_text }}</span>
              <span class="avonent-compare__button-arrow" aria-hidden="true">→</span>
            </a>

            {% if section.settings.guarantee_text != blank %}
              <div class="avonent-compare__guarantee">
                <span class="avonent-compare__guarantee-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 2 4.5 5v5.5c0 5.2 3 9.9 7.5 11.5 4.5-1.6 7.5-6.3 7.5-11.5V5L12 2Zm0 2.2 5.5 2.2v4.1c0 4.1-2.2 7.9-5.5 9.4-3.3-1.5-5.5-5.3-5.5-9.4V6.4L12 4.2Zm-1 10.1-2.3-2.3 1.4-1.4.9.9 2.9-2.9 1.4 1.4-4.3 4.3Z"/></svg>
                </span>
                {{ section.settings.guarantee_text }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="avonent-compare__content">
        {% if section.settings.eyebrow != blank %}
          <div class="avonent-compare__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="avonent-compare__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="avonent-compare__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <div class="avonent-compare__reasons">
          {% for block in section.blocks %}
            {% if block.settings.reason_title != blank or block.settings.reason_text != blank %}
              <div class="avonent-compare__reason">
                <span class="avonent-compare__reason-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.3 14.3-4-4 1.4-1.4 2.6 2.6 5.2-5.2 1.4 1.4-6.6 6.6Z"/></svg>
                </span>

                <div>
                  {% if block.settings.reason_title != blank %}
                    <strong>{{ block.settings.reason_title }}</strong>
                  {% endif %}
                  {% if block.settings.reason_text != blank %}
                    <span>{{ block.settings.reason_text }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  html {
    scroll-behavior: smooth;
  }

  .avonent-compare {
    width: 100%;
    box-sizing: border-box;
    padding: var(--avc-top) 0 var(--avc-bottom);
    background: var(--avc-bg);
    color: var(--avc-text);
  }

  .avonent-compare__inner {
    width: min(calc(100% - 40px), var(--avc-width));
    margin: 0 auto;
  }

  .avonent-compare__mobile-heading {
    display: none;
  }

  .avonent-compare__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(48px, 6vw, 92px);
  }

  .avonent-compare__left,
  .avonent-compare__content {
    min-width: 0;
  }

  .avonent-compare__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 8px;
  }

  .avonent-compare__brand {
    overflow: hidden;
    border: 1px solid var(--avc-border);
    border-radius: var(--avc-radius);
  }

  .avonent-compare__brand--avonent {
    background: var(--avc-panel);
    border-color: color-mix(in srgb, var(--avc-accent) 70%, var(--avc-border));
  }

  .avonent-compare__brand--other {
    background: var(--avc-panel-soft);
  }

  .avonent-compare__brand-head {
    min-height: 154px;
    padding: 18px 16px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
  }

  .avonent-compare__brand-image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 98px;
    margin-bottom: 10px;
  }

  .avonent-compare__brand-image img {
    width: auto;
    max-width: 130px;
    height: 100%;
    object-fit: contain;
  }

  .avonent-compare__brand-name {
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .avonent-compare__row {
    min-height: 76px;
    padding: 14px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-top: 1px solid var(--avc-border);
    color: var(--avc-text);
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.3;
    text-align: center;
  }

  .avonent-compare__brand--avonent .avonent-compare__row {
    border-top-color: color-mix(in srgb, var(--avc-accent) 35%, transparent);
  }

  .avonent-compare__row-icon {
    display: flex;
    width: 20px;
    height: 20px;
  }

  .avonent-compare__row-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .avonent-compare__row-icon--good {
    color: var(--avc-good);
  }

  .avonent-compare__row-icon--bad {
    color: var(--avc-bad);
  }

  .avonent-compare__eyebrow {
    margin-bottom: 8px;
    color: var(--avc-accent);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .avonent-compare__heading {
    margin: 0;
    color: var(--avc-text);
    font-family: var(--font-heading--family);
    font-size: clamp(30px, 3.2vw, 46px);
    font-weight: 650;
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .avonent-compare__description {
    margin-top: 16px;
    max-width: 620px;
    color: var(--avc-muted);
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.55;
  }

  .avonent-compare__reasons {
    display: grid;
    gap: 18px;
    margin-top: 30px;
  }

  .avonent-compare__reason {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 10px;
    color: var(--avc-muted);
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.45;
  }

  .avonent-compare__reason strong {
    color: var(--avc-text);
    font-weight: 750;
  }

  .avonent-compare__reason strong + span::before {
    content: ' — ';
    font-weight: 400;
    color: var(--avc-muted);
  }

  .avonent-compare__reason-check {
    display: flex;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    color: var(--avc-accent);
  }

  .avonent-compare__reason-check svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .avonent-compare__cta-wrap {
    margin-top: 24px;
  }

  .avonent-compare__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 56px;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--avc-button-bg);
    color: var(--avc-button-text);
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .avonent-compare__button:hover {
    transform: translateY(-1px);
    opacity: 0.94;
  }

  .avonent-compare__button-arrow {
    font-size: 19px;
    font-weight: 400;
  }

  .avonent-compare__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: 10px;
    color: var(--avc-muted);
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
  }

  .avonent-compare__guarantee-icon {
    display: flex;
    width: 14px;
    height: 14px;
    color: var(--avc-accent);
  }

  .avonent-compare__guarantee-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  @media screen and (max-width: 899px) {
    .avonent-compare__mobile-heading {
      display: block;
      margin-bottom: 28px;
      text-align: center;
    }

    .avonent-compare__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .avonent-compare__content {
      display: none;
    }

    .avonent-compare__description {
      margin-inline: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .avonent-compare {
      padding-top: max(44px, var(--avc-top));
      padding-bottom: max(44px, var(--avc-bottom));
    }

    .avonent-compare__inner {
      width: min(calc(100% - 20px), var(--avc-width));
    }

    .avonent-compare__mobile-heading {
      margin-bottom: 22px;
    }

    .avonent-compare__eyebrow {
      font-size: 11px;
    }

    .avonent-compare__heading {
      font-size: 27px;
    }

    .avonent-compare__description {
      margin-top: 11px;
      font-size: 13px;
      line-height: 1.45;
    }

    .avonent-compare__columns {
      gap: 6px;
    }

    .avonent-compare__brand-head {
      min-height: 112px;
      padding: 11px 7px 10px;
    }

    .avonent-compare__brand-image {
      height: 64px;
      margin-bottom: 6px;
    }

    .avonent-compare__brand-image img {
      max-width: 90px;
    }

    .avonent-compare__brand-name {
      font-size: 12px;
    }

    .avonent-compare__row {
      min-height: 63px;
      padding: 9px 6px;
      gap: 5px;
      font-size: 9.5px;
      line-height: 1.25;
    }

    .avonent-compare__row-icon {
      width: 16px;
      height: 16px;
    }

    .avonent-compare__cta-wrap {
      margin-top: 18px;
    }

    .avonent-compare__button {
      min-height: 52px;
      font-size: 14px;
    }

    .avonent-compare__guarantee {
      margin-top: 9px;
      font-size: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent vs Other Brands",
  "tag": "section",
  "class": "avonent-compare-section",
  "settings": [
    {
      "type": "header",
      "content": "Comparison columns"
    },
    {
      "type": "image_picker",
      "id": "avonent_image",
      "label": "Avonent product image"
    },
    {
      "type": "text",
      "id": "avonent_label",
      "label": "Avonent column label",
      "default": "AVONENT"
    },
    {
      "type": "image_picker",
      "id": "other_image",
      "label": "Other brands image"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Other brands column label",
      "default": "Other Brands"
    },

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE AVONENT DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Avonent vs. Other Brands"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Intro text",
      "default": "A premium routine should feel simple, transparent, and built around quality. Customize the comparison below with product claims your brand can substantiate."
    },

    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Avonent"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank for the future #avonent-buy-section anchor."
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Text under button",
      "default": "30-day money-back guarantee"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F5FCFE"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Avonent comparison column",
      "default": "#DFF7FC"
    },
    {
      "type": "color",
      "id": "panel_soft_color",
      "label": "Other brands column",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#515B60"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Avonent blue",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "accent_dark_color",
      "label": "Dark blue accent",
      "default": "#62B9D6"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#D7E4E8"
    },
    {
      "type": "color",
      "id": "good_icon_color",
      "label": "Avonent icons",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "bad_icon_color",
      "label": "Other brands icons",
      "default": "#737A7D"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },

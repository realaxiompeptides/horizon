<section class="ag-cmp2" style="--bg:{{ section.settings.background }};--left:{{ section.settings.left_background }};--right:{{ section.settings.right_background }};--t:{{ section.settings.text }};--lt:{{ section.settings.light_text }};--l:{{ section.settings.line }};">
  <div class="ag-cmp2__in">
    <header>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
    </header>

    <div class="ag-cmp2__cols">
      <div class="ag-cmp2__col ag-cmp2__left">
        <div class="ag-cmp2__product-wrap">
          {% if section.settings.product_image != blank %}
            {{ section.settings.product_image | image_url: width: 800 | image_tag: widths: '300,450,600,800', loading: 'lazy', class: 'ag-cmp2__product', alt: section.settings.left_title }}
          {% elsif product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 800 | image_tag: widths: '300,450,600,800', loading: 'lazy', class: 'ag-cmp2__product', alt: product.title }}
          {% endif %}
        </div>
        <h3>{{ section.settings.left_title }}</h3>
        {% for block in section.blocks %}
          <div class="ag-cmp2__row" {{ block.shopify_attributes }}>
            <span class="ag-cmp2__icon ag-cmp2__icon--yes">✓</span>
            <span>{{ block.settings.left_text }}</span>
          </div>
        {% endfor %}
      </div>

      <div class="ag-cmp2__col ag-cmp2__right">
        <div class="ag-cmp2__product-wrap ag-cmp2__product-wrap--empty"></div>
        <h3>{{ section.settings.right_title }}</h3>
        {% for block in section.blocks %}
          <div class="ag-cmp2__row">
            <span class="ag-cmp2__icon ag-cmp2__icon--no">×</span>
            <span>{{ block.settings.right_text }}</span>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ag-cmp2__purchase">
      <ul>{% for i in (1..4) %}{% assign point_key = 'purchase_point_' | append: i %}<li><span aria-hidden="true">✓</span>{{ section.settings[point_key] | escape }}</li>{% endfor %}</ul>
      <a href="#avonent-garlic-buy">{{ section.settings.purchase_button | escape }} <span aria-hidden="true">↓</span></a>
      <p>{{ section.settings.purchase_guarantee | escape }}</p>
    </div>
    {% if section.settings.note != blank %}<p class="ag-cmp2__note">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
.ag-cmp2{background:var(--bg);padding:56px 0 68px;color:var(--lt)}.ag-cmp2 *{box-sizing:border-box}.ag-cmp2__in{width:min(calc(100% - 28px),980px);margin:auto}.ag-cmp2 header{text-align:center;max-width:720px;margin:0 auto 32px}.ag-cmp2 h2{margin:0;color:var(--lt);font-size:clamp(38px,5vw,58px);line-height:1;letter-spacing:-.04em}.ag-cmp2 header p{margin:12px 0 0;color:rgb(255 255 255 / 82%);font-size:14px;line-height:1.5}.ag-cmp2__cols{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:stretch}.ag-cmp2__col{display:flex;flex-direction:column;overflow:hidden;border-radius:18px 18px 10px 10px}.ag-cmp2__left{background:color-mix(in srgb,var(--left) 86%,#fff);color:var(--lt)}.ag-cmp2__right{background:var(--right);color:var(--t)}.ag-cmp2__product-wrap{display:grid;place-items:center;height:180px;padding:18px 18px 0}.ag-cmp2__product-wrap--empty{height:180px}.ag-cmp2__product{display:block;max-width:170px;max-height:160px;width:auto;height:auto;object-fit:contain;filter:drop-shadow(0 14px 18px rgb(0 76 140 / 18%))}.ag-cmp2 h3{margin:0;padding:6px 12px 22px;text-align:center;font-size:25px;font-weight:800}.ag-cmp2__row{min-height:106px;padding:16px 12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;border-top:1px solid var(--l);font-size:14px;line-height:1.35}.ag-cmp2__icon{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;font-size:15px;font-weight:900}.ag-cmp2__icon--yes{background:#fff;color:#02c6ea}.ag-cmp2__icon--no{background:#858585;color:#fff}.ag-cmp2__note{max-width:760px;margin:16px auto 0;color:rgb(255 255 255 / 72%);font-size:10px;line-height:1.5;text-align:center}@media(max-width:749px){.ag-cmp2{padding:42px 0 54px}.ag-cmp2 h2{font-size:38px}.ag-cmp2 header{margin-bottom:26px}.ag-cmp2__cols{gap:7px}.ag-cmp2__product-wrap,.ag-cmp2__product-wrap--empty{height:125px;padding:10px 8px 0}.ag-cmp2__product{max-width:110px;max-height:112px}.ag-cmp2 h3{padding:5px 7px 15px;font-size:20px}.ag-cmp2__row{min-height:112px;padding:13px 7px;font-size:12px}.ag-cmp2__icon{width:23px;height:23px;font-size:13px}}
.ag-cmp2__purchase{max-width:720px;margin:28px auto 0}.ag-cmp2__purchase ul{list-style:none;padding:0;margin:0 0 24px;display:grid;gap:16px}.ag-cmp2__purchase li{display:flex;gap:14px;align-items:center;font-size:clamp(16px,2vw,22px);line-height:1.4}.ag-cmp2__purchase li>span{font-weight:900;font-size:25px}.ag-cmp2__purchase>a{display:flex;justify-content:center;align-items:center;gap:18px;border-radius:12px;padding:18px;background:#fff;color:#0068e8;text-decoration:none;font-size:20px;font-weight:850}.ag-cmp2__purchase>p{text-align:center;margin:16px 0 0;font-size:14px;color:#fff}
{% endstylesheet %}

{% schema %}
{
  "name":"Aged Garlic Comparison V2",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"purchase_point_1","label":"Purchase point 1","default":"Carefully Selected Ingredients"},
    {"type":"text","id":"purchase_point_2","label":"Purchase point 2","default":"24-Month Aged Garlic Extract"},
    {"type":"text","id":"purchase_point_3","label":"Purchase point 3","default":"Odorless Daily Formula"},
    {"type":"text","id":"purchase_point_4","label":"Purchase point 4","default":"Quality-Focused Formula"},
    {"type":"text","id":"purchase_button","label":"Purchase button","default":"Try Risk-Free Today"},
    {"type":"text","id":"purchase_guarantee","label":"Purchase guarantee","default":"30-day money-back guarantee"},
    {"type":"text","id":"heading","label":"Heading","default":"Avonent vs. Other Brands"},
    {"type":"text","id":"subheading","label":"Subheading","default":"A straightforward look at the format and formula differences."},
    {"type":"image_picker","id":"product_image","label":"Avonent product image"},
    {"type":"text","id":"left_title","label":"Left column title","default":"Avonent"},
    {"type":"text","id":"right_title","label":"Right column title","default":"Other Brands"},
    {"type":"text","id":"note","label":"Comparison note","default":"Other supplements vary by brand. Keep every comparison statement accurate to the current Avonent product and supplier documentation."},
    {"type":"color","id":"background","label":"Section background","default":"#0068E8"},
    {"type":"color","id":"left_background","label":"Avonent column","default":"#02C6EA"},
    {"type":"color","id":"right_background","label":"Other column","default":"#FFFFFF"},
    {"type":"color","id":"text","label":"Dark text","default":"#071A52"},
    {"type":"color","id":"light_text","label":"Light text","default":"#FFFFFF"},
    {"type":"color","id":"line","label":"Row borders","default":"#CDE9F4"}
  ],
  "blocks":[
    {"type":"row","name":"Comparison row","settings":[
      {"type":"text","id":"left_text","label":"Avonent text","default":"Ships from USA"},
      {"type":"text","id":"right_text","label":"Other brand text","default":"Origin details vary"}
    ]}
  ],
  "max_blocks":8,
  "presets":[{"name":"Aged Garlic Comparison V2","blocks":[{"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"}]}]
}
{% endschema %}

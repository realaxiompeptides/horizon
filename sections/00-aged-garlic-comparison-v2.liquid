<section class="ag-cmp2" style="--bg:{{ section.settings.background }};--left:{{ section.settings.left_background }};--right:{{ section.settings.right_background }};--t:{{ section.settings.text }};--lt:{{ section.settings.light_text }};--l:{{ section.settings.line }};">
  <div class="ag-cmp2__in">
    <header><h2>{{ section.settings.heading }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}</header>
    <div class="ag-cmp2__cols">
      <div class="ag-cmp2__col ag-cmp2__left">
        {% if section.settings.product_image != blank %}{{ section.settings.product_image | image_url: width: 700 | image_tag: widths: '280,420,560,700', sizes: '(min-width:900px) 300px,42vw', loading: 'lazy', class: 'ag-cmp2__product', alt: section.settings.left_title }}{% endif %}
        <h3>{{ section.settings.left_title }}</h3>
        {% for block in section.blocks %}<div class="ag-cmp2__row" {{ block.shopify_attributes }}><i>✓</i><span>{{ block.settings.left_text }}</span></div>{% endfor %}
      </div>
      <div class="ag-cmp2__col ag-cmp2__right">
        <div class="ag-cmp2__space"></div><h3>{{ section.settings.right_title }}</h3>
        {% for block in section.blocks %}<div class="ag-cmp2__row"><i>×</i><span>{{ block.settings.right_text }}</span></div>{% endfor %}
      </div>
    </div>
    {% if section.settings.note != blank %}<p class="ag-cmp2__note">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>
{% stylesheet %}
.ag-cmp2{background:var(--bg);color:var(--lt);padding:56px 0 72px}.ag-cmp2__in{width:min(calc(100% - 26px),980px);margin:auto}.ag-cmp2 header{text-align:center;max-width:720px;margin:0 auto 36px}.ag-cmp2 h2{margin:0;color:var(--lt);font-size:clamp(38px,5vw,58px);line-height:1;letter-spacing:-.04em}.ag-cmp2 header p{margin:10px 0 0;color:rgb(255 255 255 / 78%);font-size:14px}.ag-cmp2__cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:end}.ag-cmp2__col{overflow:hidden;border-radius:16px 16px 6px 6px}.ag-cmp2__left{background:var(--left);color:var(--lt)}.ag-cmp2__right{background:var(--right);color:var(--t)}.ag-cmp2__product{display:block;width:min(68%,310px);height:auto;margin:-8px auto 5px;filter:drop-shadow(0 16px 18px rgb(53 12 22 / 20%))}.ag-cmp2__space{height:165px}.ag-cmp2 h3{margin:0;padding:15px 16px 21px;text-align:center;font-size:25px}.ag-cmp2__row{min-height:112px;padding:17px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:9px;border-top:1px solid var(--l);font-size:14px;line-height:1.35}.ag-cmp2__row i{display:grid;place-items:center;width:23px;height:23px;border-radius:50%;font-style:normal;font-weight:900}.ag-cmp2__left .ag-cmp2__row i{background:#fff;color:var(--left)}.ag-cmp2__right .ag-cmp2__row i{background:#7b7b7b;color:#fff}.ag-cmp2__note{max-width:760px;margin:17px auto 0;text-align:center;color:rgb(255 255 255 / 70%);font-size:10px;line-height:1.5}@media(max-width:749px){.ag-cmp2{padding:44px 0 60px}.ag-cmp2 h2{font-size:39px}.ag-cmp2__cols{gap:6px}.ag-cmp2 h3{font-size:20px;padding:13px 8px 17px}.ag-cmp2__row{min-height:116px;padding:12px 7px;font-size:12px}.ag-cmp2__space{height:125px}.ag-cmp2__product{width:min(76%,220px)}}
{% endstylesheet %}
{% schema %}
{
  "name":"Aged Garlic Comparison V2",
  "tag":"section",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Avonent vs. basic garlic supplements"},
    {"type":"text","id":"subheading","label":"Subheading","default":"A simple side-by-side view of format and formula differences."},
    {"type":"image_picker","id":"product_image","label":"Avonent product image"},
    {"type":"text","id":"left_title","label":"Left column title","default":"Avonent"},
    {"type":"text","id":"right_title","label":"Right column title","default":"Basic garlic supplement"},
    {"type":"text","id":"note","label":"Comparison note","default":"Keep comparison claims to verifiable product-format differences. Other products vary by brand."},
    {"type":"color","id":"background","label":"Section background","default":"#7D1F2F"},
    {"type":"color","id":"left_background","label":"Avonent column","default":"#A33E4A"},
    {"type":"color","id":"right_background","label":"Other column","default":"#FFFDFC"},
    {"type":"color","id":"text","label":"Dark text","default":"#242124"},
    {"type":"color","id":"light_text","label":"Light text","default":"#FFFFFF"},
    {"type":"color","id":"line","label":"Row borders","default":"#E4C8CD"}
  ],
  "blocks":[{"type":"row","name":"Comparison row","settings":[
    {"type":"text","id":"left_text","label":"Avonent text","default":"Aged garlic format"},
    {"type":"text","id":"right_text","label":"Other brand text","default":"Varies by brand"}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"Aged Garlic Comparison V2","blocks":[{"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"}]}]
}
{% endschema %}
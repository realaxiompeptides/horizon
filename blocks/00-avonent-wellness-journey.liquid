{% liquid
  assign section_id = 'avonent-journey-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="avonent-journey"
  style="
    --avj-bg: {{ section.settings.background_color }};
    --avj-text: {{ section.settings.text_color }};
    --avj-muted: {{ section.settings.muted_text_color }};
    --avj-accent: {{ section.settings.accent_color }};
    --avj-inactive: {{ section.settings.inactive_color }};
    --avj-card-text: {{ section.settings.card_text_color }};
    --avj-line: {{ section.settings.line_color }};
    --avj-check: {{ section.settings.check_color }};
    --avj-max-width: {{ section.settings.content_width }}px;
    --avj-top: {{ section.settings.padding_top }}px;
    --avj-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-avonent-journey
  data-activation-point="{{ section.settings.activation_point }}"
>
  <div class="avonent-journey__inner">

    <header class="avonent-journey__header">
      {% if section.settings.eyebrow != blank %}
        <div class="avonent-journey__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="avonent-journey__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="avonent-journey__subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
    </header>

    <div class="avonent-journey__timeline" data-avj-timeline>
      <div class="avonent-journey__track" aria-hidden="true">
        <span class="avonent-journey__track-base"></span>
        <span class="avonent-journey__track-fill" data-avj-fill></span>
      </div>

      <div class="avonent-journey__steps">
        {% for block in section.blocks %}
          <article
            class="avonent-journey__step"
            data-avj-step
            {{ block.shopify_attributes }}
          >
            <span class="avonent-journey__marker" data-avj-marker aria-hidden="true"></span>

            <div class="avonent-journey__step-content">
              <div class="avonent-journey__week">
                {{ block.settings.title }}
              </div>

              {% if block.settings.points != blank %}
                <div class="avonent-journey__points rte">
                  {{ block.settings.points }}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.disclaimer != blank %}
      <div class="avonent-journey__disclaimer">
        {{ section.settings.disclaimer }}
      </div>
    {% endif %}

  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('{{ section_id }}');

    if (!section || section.dataset.avJourneyInitialized === 'true') return;
    section.dataset.avJourneyInitialized = 'true';

    const timeline = section.querySelector('[data-avj-timeline]');
    const fill = section.querySelector('[data-avj-fill]');
    const steps = Array.from(section.querySelectorAll('[data-avj-step]'));
    const markers = Array.from(section.querySelectorAll('[data-avj-marker]'));

    if (!timeline || !fill || !steps.length || !markers.length) return;

    const activationPercent = Math.min(
      85,
      Math.max(20, Number(section.dataset.activationPoint || 58))
    );

    let ticking = false;

    function updateJourney() {
      ticking = false;

      const viewportTrigger = window.innerHeight * (activationPercent / 100);
      const timelineRect = timeline.getBoundingClientRect();

      const firstMarkerRect = markers[0].getBoundingClientRect();
      const lastMarkerRect = markers[markers.length - 1].getBoundingClientRect();

      const trackStart = firstMarkerRect.top + firstMarkerRect.height / 2;
      const trackEnd = lastMarkerRect.top + lastMarkerRect.height / 2;
      const trackLength = Math.max(1, trackEnd - trackStart);

      let fillProgress = (viewportTrigger - trackStart) / trackLength;
      fillProgress = Math.max(0, Math.min(1, fillProgress));

      fill.style.height = `${fillProgress * 100}%`;

      let currentIndex = -1;

      markers.forEach((marker, index) => {
        const markerRect = marker.getBoundingClientRect();
        const markerCenter = markerRect.top + markerRect.height / 2;
        const active = markerCenter <= viewportTrigger;

        steps[index].classList.toggle('is-passed', active);

        if (active) {
          currentIndex = index;
        }
      });

      steps.forEach((step, index) => {
        step.classList.toggle('is-current', index === currentIndex);
      });

      const beforeTimeline = timelineRect.top > viewportTrigger;

      if (beforeTimeline) {
        fill.style.height = '0%';
        steps.forEach((step) => {
          step.classList.remove('is-passed', 'is-current');
        });
      }
    }

    function requestUpdate() {
      if (ticking) return;

      ticking = true;
      window.requestAnimationFrame(updateJourney);
    }

    updateJourney();

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });

    document.addEventListener('shopify:section:load', requestUpdate);
  })();
</script>

{% stylesheet %}
  .avonent-journey {
    width: 100%;
    padding: var(--avj-top) 0 var(--avj-bottom);
    background: var(--avj-bg);
    color: var(--avj-text);
  }

  .avonent-journey__inner {
    width: min(calc(100% - 40px), var(--avj-max-width));
    margin: 0 auto;
  }

  .avonent-journey__header {
    max-width: 680px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .avonent-journey__eyebrow {
    margin-bottom: 5px;
    color: var(--avj-accent);
    font-family: var(--font-heading--family);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .avonent-journey__heading {
    margin: 0;
    color: var(--avj-text);
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.3vw, 44px);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .avonent-journey__subheading {
    max-width: 560px;
    margin: 15px auto 0;
    color: var(--avj-muted);
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
  }

  .avonent-journey__timeline {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
  }

  .avonent-journey__track {
    position: absolute;
    top: 19px;
    bottom: 19px;
    left: 10px;
    width: 2px;
    pointer-events: none;
  }

  .avonent-journey__track-base,
  .avonent-journey__track-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    border-radius: 99px;
  }

  .avonent-journey__track-base {
    height: 100%;
    background: var(--avj-line);
  }

  .avonent-journey__track-fill {
    height: 0;
    background: var(--avj-accent);
    transition: height 90ms linear;
  }

  .avonent-journey__steps {
    position: relative;
    z-index: 1;
  }

  .avonent-journey__step {
    position: relative;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 18px;
    padding-bottom: 30px;
  }

  .avonent-journey__step:last-child {
    padding-bottom: 0;
  }

  .avonent-journey__marker {
    display: block;
    width: 14px;
    height: 14px;
    margin: 12px 0 0 4px;
    border: 2px solid var(--avj-inactive);
    border-radius: 50%;
    background: var(--avj-inactive);
    box-sizing: border-box;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      transform 220ms ease;
  }

  .avonent-journey__step.is-passed .avonent-journey__marker {
    border-color: var(--avj-accent);
    background: var(--avj-accent);
  }

  .avonent-journey__step.is-current .avonent-journey__marker {
    transform: scale(1.08);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--avj-accent) 14%, transparent);
  }

  .avonent-journey__step-content {
    min-width: 0;
  }

  .avonent-journey__week {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 5px;
    background: var(--avj-inactive);
    color: var(--avj-card-text);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.15;
    transition:
      background-color 220ms ease,
      transform 220ms ease;
  }

  .avonent-journey__step.is-current .avonent-journey__week {
    background: var(--avj-accent);
  }

  .avonent-journey__step.is-current .avonent-journey__week {
    transform: translateX(2px);
  }

  .avonent-journey__points {
    padding: 12px 3px 0 2px;
    color: var(--avj-muted);
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.45;
  }

  .avonent-journey__points ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .avonent-journey__points li {
    position: relative;
    margin: 0;
    padding-left: 23px;
  }

  .avonent-journey__points li::before {
    content: '✓';
    position: absolute;
    top: 0;
    left: 0;
    color: var(--avj-check);
    font-weight: 800;
  }

  .avonent-journey__disclaimer {
    max-width: 680px;
    margin: 26px auto 0;
    color: var(--avj-muted);
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.45;
    text-align: center;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .avonent-journey {
      padding-top: max(48px, var(--avj-top));
      padding-bottom: max(48px, var(--avj-bottom));
    }

    .avonent-journey__inner {
      width: min(calc(100% - 28px), var(--avj-max-width));
    }

    .avonent-journey__header {
      margin-bottom: 25px;
    }

    .avonent-journey__eyebrow {
      font-size: 20px;
    }

    .avonent-journey__heading {
      font-size: 25px;
    }

    .avonent-journey__subheading {
      margin-top: 10px;
      font-size: 13px;
      line-height: 1.45;
    }

    .avonent-journey__track {
      left: 7px;
      top: 18px;
      bottom: 18px;
    }

    .avonent-journey__step {
      grid-template-columns: 16px minmax(0, 1fr);
      gap: 12px;
      padding-bottom: 24px;
    }

    .avonent-journey__marker {
      width: 14px;
      height: 14px;
      margin: 11px 0 0 0;
    }

    .avonent-journey__week {
      min-height: 40px;
      padding: 9px 13px;
      font-size: 12px;
      border-radius: 4px;
    }

    .avonent-journey__points {
      padding-top: 10px;
      font-size: 12px;
    }

    .avonent-journey__points ul {
      gap: 8px;
    }

    .avonent-journey__points li {
      padding-left: 19px;
    }

    .avonent-journey__disclaimer {
      margin-top: 20px;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avonent-journey__track-fill,
    .avonent-journey__marker,
    .avonent-journey__week {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Wellness Journey",
  "tag": "section",
  "class": "avonent-wellness-journey-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Blue heading",
      "default": "Your Wellness"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Journey with Avonent"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Intro text",
      "default": "Consistency matters. Here’s an example of how a simple daily Avonent routine can become easier to maintain over the first few weeks."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Small disclaimer",
      "default": "Individual experiences vary. Follow the directions on your product label and consult a qualified healthcare professional when appropriate."
    },
    {
      "type": "range",
      "id": "activation_point",
      "label": "Scroll activation point",
      "min": 30,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 58,
      "info": "Controls how far down the viewport each step must travel before its Avonent color activates."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Body text",
      "default": "#596269"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Avonent active color",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "inactive_color",
      "label": "Inactive week color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Week label text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Inactive timeline",
      "default": "#B8BEC2"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmarks",
      "default": "#02C6EA"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 480,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "week",
      "name": "Journey Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Week label",
          "default": "Week 1: Build the Routine"
        },
        {
          "type": "richtext",
          "id": "points",
          "label": "Bullet points",
          "default": "<ul><li>Your daily routine starts to feel more intentional</li><li>You learn when the product fits best into your day</li><li>Consistency becomes easier to maintain</li></ul>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Avonent Wellness Journey",
      "blocks": [
        {
          "type": "week",
          "settings": {
            "title": "Week 1: Build the Routine",
            "points": "<ul><li>Your daily routine starts to feel more intentional</li><li>You learn when the product fits best into your day</li><li>Consistency becomes easier to maintain</li></ul>"
          }
        },
        {
          "type": "week",
          "settings": {
            "title": "Week 2: Find Your Rhythm",
            "points": "<ul><li>Your routine starts to feel more automatic</li><li>You can better judge how the product fits your lifestyle</li><li>Staying consistent takes less effort</li></ul>"
          }
        },
        {
          "type": "week",
          "settings": {
            "title": "Week 3: Build Momentum",
            "points": "<ul><li>Your daily habit feels established</li><li>You have more context for your own experience</li><li>Consistency becomes part of your normal routine</li></ul>"
          }
        },
        {
          "type": "week",
          "settings": {
            "title": "Week 4+: Keep It Going",
            "points": "<ul><li>Keep following the serving directions on the label</li><li>Support your routine with sleep, hydration, and nutrition</li><li>Adjust your routine based on your personal experience</li></ul>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

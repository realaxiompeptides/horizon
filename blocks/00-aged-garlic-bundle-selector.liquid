{% liquid
  assign av_product = closest.product | default: product
  assign root_id = 'AgedGarlicBundle-' | append: block.id
%}

{% if av_product != blank %}
<div
  id="avonent-garlic-buy"
  class="aged-garlic-bundle"
  {{ block.shopify_attributes }}
  style="
    --agb-accent:{{ block.settings.accent_color }};
    --agb-accent-dark:{{ block.settings.accent_dark_color }};
    --agb-soft:{{ block.settings.selected_background }};
    --agb-card:{{ block.settings.card_background }};
    --agb-border:{{ block.settings.border_color }};
    --agb-text:{{ block.settings.text_color }};
    --agb-muted:{{ block.settings.muted_color }};
    --agb-gold:{{ block.settings.gold_color }};
  "
>
  {% if block.settings.heading != blank %}<div class="aged-garlic-bundle__heading">{{ block.settings.heading }}</div>{% endif %}
  <div id="{{ root_id }}" class="aged-garlic-bundle__options" role="radiogroup" aria-label="Choose quantity">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'bundle_' | append: i | append: '_title'
        assign subtitle_key = 'bundle_' | append: i | append: '_subtitle'
        assign variant_key = 'bundle_' | append: i | append: '_variant'
        assign badge_key = 'bundle_' | append: i | append: '_badge'
        assign bag_count_key = 'bundle_' | append: i | append: '_bag_count'

        assign bundle_title = block.settings[title_key]
        assign bundle_subtitle = block.settings[subtitle_key]
        assign bundle_variant_match = block.settings[variant_key] | strip
        assign bundle_badge = block.settings[badge_key]
        assign bag_count = block.settings[bag_count_key] | default: i

        assign bundle_variant = blank
        for candidate in av_product.variants
          assign candidate_id = candidate.id | append: ''
          if candidate.title == bundle_variant_match or candidate_id == bundle_variant_match
            assign bundle_variant = candidate
            break
          endif
        endfor
        if bundle_variant == blank
          assign bundle_variant = av_product.selected_or_first_available_variant
        endif

        assign per_bag = bundle_variant.price | divided_by: bag_count
        assign is_selected = false
        if i == 2
          assign is_selected = true
        endif
      %}
      <button
        type="button"
        class="aged-garlic-bundle__option{% if is_selected %} is-selected{% endif %}"
        role="radio"
        aria-checked="{% if is_selected %}true{% else %}false{% endif %}"
        data-aged-garlic-bundle
        data-variant-id="{{ bundle_variant.id }}"
        data-configured="{% if bundle_variant_match != blank and bundle_variant.title == bundle_variant_match %}true{% else %}false{% endif %}"
        {% unless bundle_variant.available %}disabled{% endunless %}
      >
        {% if bundle_badge != blank %}<span class="aged-garlic-bundle__badge">{{ bundle_badge }}</span>{% endif %}
        <span class="aged-garlic-bundle__radio" aria-hidden="true"><span></span></span>
        <span class="aged-garlic-bundle__copy">
          <strong>{{ bundle_title }}</strong>
          {% if bundle_subtitle != blank %}<small>{{ bundle_subtitle }}</small>{% endif %}
        </span>
        <span class="aged-garlic-bundle__price">
          <strong>{{ bundle_variant.price | money }}</strong>
          {% if bag_count > 1 %}<small>{{ per_bag | money }} each</small>{% endif %}
        </span>
      </button>
    {% endfor %}
  </div>
  {% if block.settings.shipping_note != blank %}
    <div class="aged-garlic-bundle__shipping-note">{{ block.settings.shipping_note }}</div>
  {% endif %}
</div>

<script>
(() => {
  const root = document.getElementById({{ root_id | json }});
  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';
  const options = Array.from(root.querySelectorAll('[data-aged-garlic-bundle]'));

  function getForm() {
    const section = root.closest('.shopify-section') || document;
    return section.querySelector('product-form-component form[data-type="add-to-cart-form"]')
      || section.querySelector('form[action*="/cart/add"]');
  }

  function setVariant(option) {
    if (!option || option.disabled) return;
    options.forEach((item) => {
      const selected = item === option;
      item.classList.toggle('is-selected', selected);
      item.setAttribute('aria-checked', selected ? 'true' : 'false');
    });

    const form = getForm();
    if (!form) return;
    const variantInput = form.querySelector('input[name="id"][ref="variantId"], input[name="id"]');
    if (variantInput) {
      variantInput.value = option.dataset.variantId;
      variantInput.setAttribute('value', option.dataset.variantId);
      variantInput.dispatchEvent(new Event('change', { bubbles:true }));
    }
    const quantityInput = form.querySelector('input[name="quantity"]');
    if (quantityInput) {
      quantityInput.value = '1';
      quantityInput.setAttribute('value','1');
      quantityInput.dispatchEvent(new Event('change',{bubbles:true}));
    }
  }

  options.forEach((option) => option.addEventListener('click', () => setVariant(option)));
  const initial = root.querySelector('.is-selected:not(:disabled)') || options.find((o) => !o.disabled);
  [0,250,900].forEach((delay) => window.setTimeout(() => setVariant(initial), delay));
})();
</script>
{% endif %}

{% stylesheet %}
  .aged-garlic-bundle { width:100%; }
  .aged-garlic-bundle__heading { margin:2px 0 9px; color:var(--agb-text); font-size:13px; font-weight:800; letter-spacing:.01em; }
  .aged-garlic-bundle__options { display:grid; gap:9px; }
  .aged-garlic-bundle__option {
    position:relative; display:grid; grid-template-columns:20px minmax(0,1fr) auto; align-items:center;
    gap:11px; width:100%; min-height:72px; margin:0; padding:12px 14px; appearance:none;
    border:1px solid var(--agb-border); border-radius:13px; background:var(--agb-card); color:var(--agb-text);
    font:inherit; text-align:left; cursor:pointer; transition:border-color .16s ease,box-shadow .16s ease,background .16s ease,transform .16s ease;
  }
  .aged-garlic-bundle__option:hover:not(:disabled) { border-color:color-mix(in srgb,var(--agb-accent) 55%,var(--agb-border)); }
  .aged-garlic-bundle__option.is-selected {
    border-color:var(--agb-accent); background:var(--agb-soft); box-shadow:0 0 0 1px var(--agb-accent),0 7px 22px rgb(63 20 31 / 8%);
  }
  .aged-garlic-bundle__option:disabled { opacity:.5; cursor:not-allowed; }
  .aged-garlic-bundle__radio { display:grid; place-items:center; width:18px; height:18px; border:1.5px solid #A89C9F; border-radius:50%; background:#fff; }
  .aged-garlic-bundle__radio span { width:8px; height:8px; border-radius:50%; background:transparent; }
  .aged-garlic-bundle__option.is-selected .aged-garlic-bundle__radio { border-color:var(--agb-accent); }
  .aged-garlic-bundle__option.is-selected .aged-garlic-bundle__radio span { background:var(--agb-accent); }
  .aged-garlic-bundle__copy { display:flex; flex-direction:column; min-width:0; }
  .aged-garlic-bundle__copy strong { font-size:14px; font-weight:800; line-height:1.15; }
  .aged-garlic-bundle__copy small { margin-top:4px; color:var(--agb-muted); font-size:11px; font-weight:550; line-height:1.2; }
  .aged-garlic-bundle__price { display:flex; flex-direction:column; align-items:flex-end; min-width:max-content; }
  .aged-garlic-bundle__price strong { font-size:16px; font-weight:800; line-height:1; }
  .aged-garlic-bundle__price small { margin-top:5px; color:var(--agb-muted); font-size:10.5px; font-weight:600; }
  .aged-garlic-bundle__badge {
    position:absolute; top:-9px; right:12px; min-height:19px; padding:3px 9px; border-radius:999px;
    background:var(--agb-accent); color:#fff; font-size:9.5px; font-weight:850; line-height:1.2; letter-spacing:.03em; text-transform:uppercase;
  }
  .aged-garlic-bundle__option:nth-child(3) .aged-garlic-bundle__badge { background:var(--agb-gold); color:#fff; }
  .aged-garlic-bundle__shipping-note { margin-top:8px; color:var(--agb-muted); font-size:11px; font-weight:550; text-align:center; }
{% endstylesheet %}

{% schema %}
{
  "name":"Aged Garlic Bundle Selector",
  "tag":null,
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Choose your quantity"},
    {"type":"text","id":"bundle_1_title","label":"Bundle 1 title","default":"1 Bag"},
    {"type":"text","id":"bundle_1_subtitle","label":"Bundle 1 subtitle","default":"Try it"},
    {"type":"text","id":"bundle_1_variant","label":"Bundle 1 Shopify variant title or ID","default":"1 Bag"},
    {"type":"range","id":"bundle_1_bag_count","label":"Bundle 1 bag count","min":1,"max":6,"step":1,"default":1},
    {"type":"text","id":"bundle_1_badge","label":"Bundle 1 badge","default":""},
    {"type":"text","id":"bundle_2_title","label":"Bundle 2 title","default":"2 Bags"},
    {"type":"text","id":"bundle_2_subtitle","label":"Bundle 2 subtitle","default":"Save more"},
    {"type":"text","id":"bundle_2_variant","label":"Bundle 2 Shopify variant title or ID","default":"2 Bags"},
    {"type":"range","id":"bundle_2_bag_count","label":"Bundle 2 bag count","min":1,"max":6,"step":1,"default":2},
    {"type":"text","id":"bundle_2_badge","label":"Bundle 2 badge","default":"Most Popular"},
    {"type":"text","id":"bundle_3_title","label":"Bundle 3 title","default":"3 Bags"},
    {"type":"text","id":"bundle_3_subtitle","label":"Bundle 3 subtitle","default":"Lowest cost per bag"},
    {"type":"text","id":"bundle_3_variant","label":"Bundle 3 Shopify variant title or ID","default":"3 Bags"},
    {"type":"range","id":"bundle_3_bag_count","label":"Bundle 3 bag count","min":1,"max":6,"step":1,"default":3},
    {"type":"text","id":"bundle_3_badge","label":"Bundle 3 badge","default":"Best Value"},
    {"type":"text","id":"shipping_note","label":"Note below offers","default":"Shipping shown at checkout"},
    {"type":"color","id":"accent_color","label":"Burgundy","default":"#6D172B"},
    {"type":"color","id":"accent_dark_color","label":"Dark burgundy","default":"#4B0F1F"},
    {"type":"color","id":"gold_color","label":"Gold","default":"#B58A45"},
    {"type":"color","id":"selected_background","label":"Selected card","default":"#FFF7EE"},
    {"type":"color","id":"card_background","label":"Card","default":"#FFFFFF"},
    {"type":"color","id":"border_color","label":"Border","default":"#E6D9D2"},
    {"type":"color","id":"text_color","label":"Text","default":"#1A1718"},
    {"type":"color","id":"muted_color","label":"Muted","default":"#6E6265"}
  ],
  "presets":[{"name":"Aged Garlic Bundle Selector"}]
}
{% endschema %}
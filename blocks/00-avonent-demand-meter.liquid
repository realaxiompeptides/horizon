{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign current_inventory = selected_variant.inventory_quantity | default: 0
  assign starting_inventory = block.settings.starting_inventory

  if starting_inventory <= 0
    assign starting_inventory = 100
  endif

  assign claimed_units = starting_inventory | minus: current_inventory

  if claimed_units < 0
    assign claimed_units = 0
  endif

  assign calculated_percent = claimed_units | times: 100.0 | divided_by: starting_inventory | round

  if calculated_percent < block.settings.minimum_percent
    assign calculated_percent = block.settings.minimum_percent
  endif

  if calculated_percent > block.settings.maximum_percent
    assign calculated_percent = block.settings.maximum_percent
  endif
%}

<div
  class="avonent-demand-meter"
  {{ block.shopify_attributes }}
  style="
    --av-demand-bg: {{ block.settings.background_color }};
    --av-demand-track: {{ block.settings.track_color }};
    --av-demand-fill: {{ block.settings.fill_color }};
    --av-demand-text: {{ block.settings.text_color }};
    --av-demand-muted: {{ block.settings.muted_text_color }};
    --av-demand-border: {{ block.settings.border_color }};
    --av-demand-radius: {{ block.settings.corner_radius }}px;
    --av-demand-padding-top: {{ block.settings.padding_top }}px;
    --av-demand-padding-bottom: {{ block.settings.padding_bottom }}px;
    --av-demand-inner-padding-y: {{ block.settings.inner_padding_y }}px;
    --av-demand-inner-padding-x: {{ block.settings.inner_padding_x }}px;
  "
>
  <div class="avonent-demand-meter__outer">

    {% if block.settings.heading != blank %}
      <div class="avonent-demand-meter__heading">
        {{ block.settings.heading }}
      </div>
    {% endif %}

    <div class="avonent-demand-meter__main">

      <div
        class="avonent-demand-meter__track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ calculated_percent }}"
        aria-label="{{ calculated_percent }} percent"
      >
        <div
          class="avonent-demand-meter__fill"
          style="width: {{ calculated_percent }}%;"
        ></div>
      </div>

      <div class="avonent-demand-meter__value">
        {{ calculated_percent }}%
        {% if block.settings.percent_text != blank %}
          {{ block.settings.percent_text }}
        {% endif %}
      </div>

    </div>

    {% if block.settings.subtext != blank %}
      <div class="avonent-demand-meter__subtext">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .avonent-demand-meter {
    width: 100%;

    padding-top:
      var(--av-demand-padding-top);

    padding-bottom:
      var(--av-demand-padding-bottom);
  }

  .avonent-demand-meter__outer {
    width: 100%;

    padding:
      var(--av-demand-inner-padding-y)
      var(--av-demand-inner-padding-x);

    background:
      var(--av-demand-bg);

    border:
      1px solid
      var(--av-demand-border);

    border-radius:
      var(--av-demand-radius);

    box-shadow:
      0 5px 18px
      rgba(0, 0, 0, 0.035);
  }

  .avonent-demand-meter__heading {
    margin-bottom: 8px;

    color:
      var(--av-demand-text);

    font-family:
      var(--font-body--family);

    font-size: 12px;
    font-weight: 650;

    line-height: 1.2;
  }

  .avonent-demand-meter__main {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 12px;
  }

  .avonent-demand-meter__track {
    position: relative;

    width: 100%;
    height: 9px;

    overflow: hidden;

    border-radius: 999px;

    background:
      var(--av-demand-track);
  }

  .avonent-demand-meter__fill {
    position: absolute;

    top: 0;
    left: 0;
    bottom: 0;

    height: 100%;

    border-radius: inherit;

    background:
      var(--av-demand-fill);

    transition:
      width 240ms ease;
  }

  .avonent-demand-meter__value {
    color:
      var(--av-demand-fill);

    font-family:
      var(--font-body--family);

    font-size: 13px;
    font-weight: 750;

    line-height: 1;

    white-space: nowrap;
  }

  .avonent-demand-meter__subtext {
    margin-top: 7px;

    color:
      var(--av-demand-muted);

    font-family:
      var(--font-body--family);

    font-size: 10px;
    font-weight: 400;

    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .avonent-demand-meter__heading {
      margin-bottom: 7px;

      font-size: 11px;
    }

    .avonent-demand-meter__main {
      gap: 9px;
    }

    .avonent-demand-meter__track {
      height: 8px;
    }

    .avonent-demand-meter__value {
      font-size: 12px;
    }

    .avonent-demand-meter__subtext {
      margin-top: 6px;

      font-size: 9px;
    }
  }

  @media screen and (max-width: 360px) {
    .avonent-demand-meter__main {
      gap: 7px;
    }

    .avonent-demand-meter__value {
      font-size: 11px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "00 Avonent Demand Meter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "percent_text",
      "label": "Text after percentage",
      "default": "Claimed"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Small text",
      "default": ""
    },

    {
      "type": "header",
      "content": "Inventory calculation"
    },
    {
      "type": "number",
      "id": "starting_inventory",
      "label": "Starting inventory",
      "default": 100,
      "info": "Enter the inventory quantity at the beginning of the promotion."
    },
    {
      "type": "range",
      "id": "minimum_percent",
      "label": "Minimum displayed percentage",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "maximum_percent",
      "label": "Maximum displayed percentage",
      "min": 70,
      "max": 99,
      "step": 1,
      "unit": "%",
      "default": 96
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8FCFD"
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Track",
      "default": "#E2EDF0"
    },
    {
      "type": "color",
      "id": "fill_color",
      "label": "Fill",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Small text",
      "default": "#6D7478"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E7EFF2"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Roundness",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "inner_padding_y",
      "label": "Inside vertical padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "inner_padding_x",
      "label": "Inside horizontal padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "00 Avonent Demand Meter"
    }
  ]
}
{% endschema %}

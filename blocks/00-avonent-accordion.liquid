{% doc %}
  Avonent accordion block.

  Premium single-open accordion for product details.
  Only one item can be open at a time.

  Default items:
  - Description
  - Benefits
  - Recommended Use
  - Do You Offer a Guarantee?
{% enddoc %}

{% liquid
  assign root_id = 'AvonentAccordion-' | append: block.id
%}



<div
  id="{{ root_id }}"
  class="avonent-accordion"
  {{ block.shopify_attributes }}
  style="
    --ava-text: {{ block.settings.text_color }};
    --ava-muted: {{ block.settings.muted_text_color }};
    --ava-border: {{ block.settings.border_color }};
    --ava-bg: {{ block.settings.background_color }};
    --ava-accent: {{ block.settings.accent_color }};
    --ava-radius: {{ block.settings.corner_radius }}px;
    --ava-title-size: {{ block.settings.title_size }}px;
    --ava-body-size: {{ block.settings.body_size }}px;
    --ava-top: {{ block.settings.spacing_top }}px;
    --ava-bottom: {{ block.settings.spacing_bottom }}px;
  "
>
  {% for i in (1..6) %}
    {% liquid
      assign enabled_key = 'item_' | append: i | append: '_enabled'
      assign title_key = 'item_' | append: i | append: '_title'
      assign content_key = 'item_' | append: i | append: '_content'

      assign enabled = block.settings[enabled_key]
      assign title = block.settings[title_key]
      assign content = block.settings[content_key]


    %}

    {% if enabled and title != blank %}
      <details
        class="avonent-accordion__item{% if i == 2 %} avonent-accordion__item--benefits{% endif %}"
        data-av-accordion-item
        {% if block.settings.open_first and forloop.first %}
          open
        {% endif %}
      >
        <summary class="avonent-accordion__summary">
          <span class="avonent-accordion__title">
            {{ title }}
          </span>

          <span class="avonent-accordion__icon" aria-hidden="true">
            <span class="avonent-accordion__icon-line"></span>
            <span class="avonent-accordion__icon-line avonent-accordion__icon-line--vertical"></span>
          </span>
        </summary>

        <div class="avonent-accordion__content">
          <div class="avonent-accordion__content-inner rte">
            {{ content }}
          </div>
        </div>
      </details>
    {% endif %}
  {% endfor %}
</div>

<script>
  (() => {
    const root = document.getElementById('{{ root_id }}');
    if (!root || root.dataset.avAccordionInitialized === 'true') return;

    root.dataset.avAccordionInitialized = 'true';

    const items = Array.from(
      root.querySelectorAll('[data-av-accordion-item]')
    );

    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;

        items.forEach((otherItem) => {
          if (otherItem !== item && otherItem.open) {
            otherItem.open = false;
          }
        });
      });
    });
  })();
</script>

{% stylesheet %}
  .avonent-accordion {
    width: 100%;
    box-sizing: border-box;

    padding-top: var(--ava-top);
    padding-bottom: var(--ava-bottom);

    color: var(--ava-text);
  }

  .avonent-accordion__item {
    width: 100%;
    box-sizing: border-box;

    margin: 0 0 9px;

    overflow: hidden;

    border: 1px solid var(--ava-border);
    border-radius: var(--ava-radius);

    background: var(--ava-bg);
  }

  .avonent-accordion__item:last-child {
    margin-bottom: 0;
  }

  .avonent-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 16px;

    width: 100%;
    min-height: 54px;

    padding: 14px 16px;

    list-style: none;
    cursor: pointer;

    color: var(--ava-text);

    font-family: var(--font-body--family);
    font-size: var(--ava-title-size);
    font-weight: 650;
    line-height: 1.25;

    user-select: none;
  }

  .avonent-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .avonent-accordion__summary::marker {
    display: none;
    content: '';
  }

  .avonent-accordion__title {
    min-width: 0;
  }

  .avonent-accordion__icon {
    position: relative;

    flex: 0 0 auto;

    width: 16px;
    height: 16px;

    color: var(--ava-text);
  }

  .avonent-accordion__icon-line {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 12px;
    height: 1.5px;

    border-radius: 999px;

    background: currentColor;

    transform: translate(-50%, -50%);
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .avonent-accordion__icon-line--vertical {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .avonent-accordion__item[open]
    .avonent-accordion__icon-line--vertical {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .avonent-accordion__content {
    border-top: 1px solid color-mix(in srgb, var(--ava-border) 75%, transparent);
  }

  .avonent-accordion__content-inner {
    padding: 13px 16px 16px;

    color: var(--ava-muted);

    font-family: var(--font-body--family);
    font-size: var(--ava-body-size);
    font-weight: 400;
    line-height: 1.55;
  }

  .avonent-accordion__content-inner p {
    margin: 0 0 10px;
  }

  .avonent-accordion__content-inner p:last-child {
    margin-bottom: 0;
  }

  .avonent-accordion__content-inner strong {
    color: var(--ava-text);
    font-weight: 650;
  }

  .avonent-accordion__item--benefits .avonent-accordion__content-inner ul {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .avonent-accordion__item--benefits .avonent-accordion__content-inner li {
    position: relative;
    margin: 0;
    padding-left: 28px;
  }

  .avonent-accordion__item--benefits .avonent-accordion__content-inner li::before {
    content: '✓';
    position: absolute;
    top: 0.08em;
    left: 0;
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    color: #fff;
    background: #18a66b;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
  }

  .avonent-accordion__summary:hover {
    color: var(--ava-accent);
  }

  @media screen and (max-width: 749px) {
    .avonent-accordion__item {
      margin-bottom: 8px;
    }

    .avonent-accordion__summary {
      min-height: 52px;
      padding: 13px 14px;
      font-size: max(13px, var(--ava-title-size));
    }

    .avonent-accordion__content-inner {
      padding: 12px 14px 14px;
      font-size: max(12px, var(--ava-body-size));
    }
  }
{% endstylesheet %}


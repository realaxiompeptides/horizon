{% liquid
  assign rating = block.settings.rating
%}

<div
  class="avonent-rating"
  {{ block.shopify_attributes }}
  style="
    --avr-star: {{ block.settings.star_color }};
    --avr-text: {{ block.settings.text_color }};
    --avr-star-size: {{ block.settings.star_size }}px;
    --avr-text-size: {{ block.settings.text_size }}px;
    --avr-gap: {{ block.settings.gap }}px;
    --avr-top: {{ block.settings.spacing_top }}px;
    --avr-bottom: {{ block.settings.spacing_bottom }}px;
  "
>
  {% if block.settings.link != blank %}
    <a
      href="{{ block.settings.link }}"
      class="avonent-rating__link"
      aria-label="Read customer reviews"
    >
  {% endif %}

  <div class="avonent-rating__inner">

    {% if block.settings.show_stars %}
      <div
        class="avonent-rating__stars"
        aria-label="{{ rating }} out of 5 stars"
      >
        {% for i in (1..5) %}
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12 2.6l2.85 5.78 6.38.93-4.62 4.5 1.09 6.36L12 17.17l-5.7 3 1.09-6.36-4.62-4.5 6.38-.93L12 2.6z"
              fill="currentColor"
            />
          </svg>
        {% endfor %}
      </div>
    {% endif %}

    <div class="avonent-rating__content">

      {% if block.settings.show_rating_number %}
        <strong class="avonent-rating__score">
          Rated {{ rating }}
        </strong>
      {% endif %}

      {% if block.settings.review_text != blank %}

        {% if block.settings.show_rating_number %}
          <span class="avonent-rating__separator">
            ·
          </span>
        {% endif %}

        <span class="avonent-rating__text">
          {{ block.settings.review_text }}
        </span>

      {% endif %}

    </div>

  </div>

  {% if block.settings.link != blank %}
    </a>
  {% endif %}
</div>

{% stylesheet %}

  .avonent-rating {
    display: block;
    width: 100%;
    box-sizing: border-box;

    padding-top: var(--avr-top);
    padding-bottom: var(--avr-bottom);
  }

  .avonent-rating__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .avonent-rating__inner {
    display: flex;
    align-items: center;

    width: 100%;

    gap: var(--avr-gap);

    padding: 0;

    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .avonent-rating__stars {
    display: flex;
    align-items: center;
    flex: 0 0 auto;

    gap: 1px;

    color: var(--avr-star);
  }

  .avonent-rating__stars svg {
    display: block;

    width: var(--avr-star-size);
    height: var(--avr-star-size);
  }

  .avonent-rating__content {
    display: flex;
    align-items: center;

    min-width: 0;

    gap: 5px;

    color: var(--avr-text);

    font-family: var(--font-body--family);
    font-size: var(--avr-text-size);

    line-height: 1.25;
  }

  .avonent-rating__score {
    flex: 0 0 auto;

    font-weight: 650;
    white-space: nowrap;
  }

  .avonent-rating__separator {
    flex: 0 0 auto;
    opacity: 0.45;
  }

  .avonent-rating__text {
    font-weight: 400;
  }

  .avonent-rating__link:hover .avonent-rating__text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (max-width: 749px) {

    .avonent-rating__inner {
      gap: 7px;
    }

    .avonent-rating__content {
      gap: 4px;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Rating",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review text",
      "default": "Thousands of 5-Star Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating_number",
      "label": "Show rating number",
      "default": true
    },
    {
      "type": "url",
      "id": "link",
      "label": "Reviews link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Sizing"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Stars to text gap",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Avonent Rating"
    }
  ]
}
{% endschema %}

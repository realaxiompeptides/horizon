{% render 'theme-drawer-styles' %}
{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = closest.product.selected_or_first_available_variant
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy

  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif

  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t

  if variant
    if variant.quantity_rule.min > variant.inventory_quantity and inventory_managed and inventory_policy == 'deny'
      assign quantity_rule_soldout = true
    endif

    if variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    elsif inventory_managed and inventory_quantity <= 0 and inventory_policy == 'deny' or quantity_rule_soldout
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.sold_out' | t
    else
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.unavailable' | t
    endif
  endif
%}

<span
  class="buy-buttons-block buy-buttons-block--{{ block.id }}"
  {% if block_settings.text_color != blank %}
    style="--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb  }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if product != blank -%}
    {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
      data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
      data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >
        {%- if template.suffix == 'avonent'
          and block_settings.avonent_subscription_first
          and variant.selling_plan_allocations.first != blank
        -%}
          <input
            type="hidden"
            name="selling_plan"
            value="{{ variant.selling_plan_allocations.first.selling_plan.id }}"
            data-avonent-selling-plan
          >
        {%- endif -%}
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section, block: block -%}
          <span class="buy-buttons-block__bar">
        {%- endif -%}
        <div
          class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
          style="{% render 'spacing-style', settings: block_settings %}"
          ref="productFormButtons"
        >
          {%- unless block_settings.gift_card_form and product.gift_card? -%}
            <span
              class="product-form-text__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
            </span>
          {%- endunless -%}

          {%- liquid
            assign has_quantity_rules = false
            if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
              assign has_quantity_rules = true
            endif
          -%}

          {%- if has_quantity_rules -%}
            {%- assign cart_quantity = cart | item_count_for_variant: variant.id -%}
            <div
              class="quantity-label"
              ref="quantityLabel"
            >
              {{ 'products.product.quantity' | t }}
              <span
                class="quantity-label__cart-count{% if cart_quantity == 0 %} hidden{% endif %}"
                ref="quantityLabelCartCount"
                >({{ cart_quantity }}
                {{ 'products.product.in_cart' | t }})</span
              >
            </div>
          {%- endif -%}

          {% content_for 'block', type: 'quantity', id: 'quantity' %}

          {%- if has_quantity_rules -%}
            <div
              class="quantity-rules"
              ref="quantityRules"
            >
              {%- if variant.quantity_rule.increment > 1 -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_increments' | t: increment: variant.quantity_rule.increment }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.min > 1 -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_minimum' | t: minimum: variant.quantity_rule.min }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.max != null -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_maximum' | t: maximum: variant.quantity_rule.max }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if product.quantity_price_breaks_configured? and variant.quantity_price_breaks.size > 0 -%}
            {%- liquid
              assign use_currency = settings.currency_code_enabled_product_pages
            -%}
            <volume-pricing
              class="volume-pricing"
              data-section-id="{{ section.id }}"
              ref="volumePricing"
            >
              <span class="volume-pricing__title">{{ 'content.volume_pricing' | t }}</span>
              <div class="volume-pricing__table">
                <div class="volume-pricing__row volume-pricing__row--even">
                  <span>{{ variant.quantity_rule.min }}+</span>
                  <span>
                    {%- if use_currency -%}
                      {{- variant.price | money_with_currency | strip -}}
                    {%- else -%}
                      {{- variant.price | money | strip -}}
                    {%- endif -%}
                    /{{ 'content.each_abbreviation' | t -}}
                  </span>
                </div>
                {%- for price_break in variant.quantity_price_breaks limit: 2 -%}
                  {%- liquid
                    assign row_index = forloop.index
                    if row_index == 1
                      assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                    else
                      assign row_class = 'volume-pricing__row volume-pricing__row--even'
                    endif
                  -%}
                  <div class="{{ row_class }}">
                    <span>{{ price_break.minimum_quantity }}+</span>
                    <span>
                      {%- if use_currency -%}
                        {{- price_break.price | money_with_currency | strip -}}
                      {%- else -%}
                        {{- price_break.price | money | strip -}}
                      {%- endif -%}
                      /{{ 'content.each_abbreviation' | t -}}
                    </span>
                  </div>
                {%- endfor -%}

                {%- if variant.quantity_price_breaks.size > 2 -%}
                  <div class="volume-pricing__collapsible-wrapper">
                    {%- for price_break in variant.quantity_price_breaks offset: 2 -%}
                      {%- liquid
                        assign collapsed_index = forloop.index
                        assign total_index = collapsed_index | plus: 2
                        assign modulo_result = total_index | modulo: 2
                        if modulo_result == 1
                          assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                        else
                          assign row_class = 'volume-pricing__row volume-pricing__row--even'
                        endif
                      -%}
                      <div class="{{ row_class }}">
                        <span>{{ price_break.minimum_quantity }}+</span>
                        <span>
                          {%- if use_currency -%}
                            {{- price_break.price | money_with_currency | strip -}}
                          {%- else -%}
                            {{- price_break.price | money | strip -}}
                          {%- endif -%}
                          /{{ 'content.each_abbreviation' | t -}}
                        </span>
                      </div>
                    {%- endfor -%}
                  </div>

                  <button
                    type="button"
                    class="volume-pricing__toggle button-unstyled"
                    ref="volumePricingToggle"
                    on:click="/toggleExpanded"
                  >
                    <span class="volume-pricing__toggle-text">
                      <span class="volume-pricing__show-more">+ {{ 'actions.show_more' | t }}</span>
                      <span class="volume-pricing__show-less">- {{ 'actions.show_less' | t }}</span>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            </volume-pricing>
          {%- endif -%}
          {% content_for 'block',
            type: 'add-to-cart',
            id: 'add-to-cart',
            can_add_to_cart: can_add_to_cart,
            add_to_cart_text: add_to_cart_text
          %}

          {% content_for 'block',
            type: 'accelerated-checkout',
            id: 'accelerated-checkout',
            can_add_to_cart: can_add_to_cart,
            form_obj: form
          %}
        </div>
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          </span>
        {%- endif -%}
      {%- endform -%}
    </product-form-component>

    {%- if template.suffix == 'avonent'
      and block_settings.avonent_subscription_first
      and variant.selling_plan_allocations.first != blank
    -%}
      <div
        class="avonent-one-time-switch"
        id="AvonentOneTimeSwitch-{{ block.id }}"
        data-section-id="{{ section.id }}"
        style="
          --avots-accent: {{ block_settings.avonent_link_color }};
          --avots-text: {{ block_settings.avonent_text_color }};
          --avots-muted: {{ block_settings.avonent_muted_color }};
          --avots-size: {{ block_settings.avonent_link_size }}px;
          --avots-top: {{ block_settings.avonent_spacing_top }}px;
          --avots-bottom: {{ block_settings.avonent_spacing_bottom }}px;
        "
      >
        {% if block_settings.avonent_show_recurring_note %}
          <div class="avonent-one-time-switch__note" data-subscription-note>
            <span class="avonent-one-time-switch__note-item">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 7v5h-5"></path>
                <path d="M19.2 12a7.5 7.5 0 1 1-2.1-5.2L20 9"></path>
              </svg>
              <span>{{ block_settings.avonent_refill_text }}</span>
            </span>
            <span class="avonent-one-time-switch__divider" aria-hidden="true"></span>
            <span class="avonent-one-time-switch__note-item">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
              <span>{{ block_settings.avonent_cancel_text }}</span>
            </span>
          </div>
        {% endif %}

        <button type="button" class="avonent-one-time-switch__link" data-one-time-toggle aria-pressed="false">
          <span data-one-time-text>{{ block_settings.avonent_one_time_text }}</span>
          <span data-subscription-text hidden>{{ block_settings.avonent_subscription_text }}</span>
        </button>

        <p class="avonent-one-time-switch__status" data-one-time-status hidden>
          {{ block_settings.avonent_one_time_status }}
        </p>
      </div>

      <script>
        (() => {
          const root = document.getElementById('AvonentOneTimeSwitch-{{ block.id }}');
          if (!root || root.dataset.initialized === 'true') return;
          root.dataset.initialized = 'true';

          const section =
            root.closest('.shopify-section') ||
            root.closest('[data-section-id]') ||
            document;
          const form =
            section.querySelector('.buy-buttons-block--{{ block.id }} form[data-type="add-to-cart-form"]') ||
            section.querySelector('form[action*="/cart/add"]');
          const input = form?.querySelector('[data-avonent-selling-plan]');
          const toggle = root.querySelector('[data-one-time-toggle]');
          const oneTimeText = root.querySelector('[data-one-time-text]');
          const subscriptionText = root.querySelector('[data-subscription-text]');
          const recurringNote = root.querySelector('[data-subscription-note]');
          const status = root.querySelector('[data-one-time-status]');
          if (!form || !input || !toggle) return;

          const planId = input.value;
          let mode = 'subscription';

          function neutralizeExternalPlans() {
            form
              .querySelectorAll('[name="selling_plan"]:not([data-avonent-selling-plan])')
              .forEach((control) => {
                if (control.matches('[type="radio"], [type="checkbox"]')) {
                  control.checked = false;
                }
                control.disabled = true;
              });
          }

          function announce() {
            document.dispatchEvent(new Event('selling-plan:change'));
            document.dispatchEvent(
              new CustomEvent('avonent:purchase-mode-change', {
                detail: {
                  mode,
                  sellingPlanId: mode === 'subscription' ? planId : null
                }
              })
            );
          }

          function enforcePurchaseMode() {
            const oneTime = mode === 'one_time';
            neutralizeExternalPlans();
            input.disabled = oneTime;
            input.value = oneTime ? '' : planId;

            if (oneTime) input.removeAttribute('value');
            else input.setAttribute('value', planId);
          }

          function render() {
            const oneTime = mode === 'one_time';
            enforcePurchaseMode();

            toggle.setAttribute('aria-pressed', oneTime ? 'true' : 'false');
            oneTimeText.hidden = oneTime;
            subscriptionText.hidden = !oneTime;
            if (recurringNote) recurringNote.hidden = oneTime;
            if (status) status.hidden = !oneTime;
            announce();
          }

          toggle.addEventListener('click', () => {
            mode = mode === 'subscription' ? 'one_time' : 'subscription';
            render();
          });

          // Horizon builds FormData at submit time. Re-assert the selected
          // purchase mode immediately before that happens so Appstle cannot
          // clear or replace the selling-plan value.
          form.addEventListener('submit', enforcePurchaseMode, true);

          // Horizon constructs its own FormData after the submit event. The
          // formdata event is the last reliable point to put the selling plan
          // onto the actual /cart/add request (rather than only the UI).
          form.addEventListener('formdata', (event) => {
            if (mode === 'subscription') {
              event.formData.set('selling_plan', planId);
            } else {
              event.formData.delete('selling_plan');
            }
          });

          form.addEventListener(
            'click',
            (event) => {
              if (event.target.closest('button[type="submit"], [name="add"]')) {
                enforcePurchaseMode();
              }
            },
            true
          );

          const observer = new MutationObserver(neutralizeExternalPlans);
          observer.observe(form, { childList: true, subtree: true });

          render();
        })();
      </script>
    {%- endif -%}
  {%- else -%}
    <div class="product-form-buttons">
      <button
        type="submit"
        name="add"
        class="button"
        disabled
      >
        {{ 'blocks.sold_out' | t }}
      </button>
    </div>
  {%- endif -%}
</span>

{% if block_settings.show_pickup_availability %}
  <script
    src="{{ 'local-pickup.js' | asset_url }}"
    type="module"
  ></script>

  {%- assign pick_up_availabilities = closest.product.selected_or_first_available_variant.store_availabilities
    | where: 'pick_up_enabled', true
  -%}

  <local-pickup
    class="spacing-style product__pickup-availabilities"
    {% if pick_up_availabilities.size == 0 %}
      hidden
    {% endif %}
    data-section-id="{{ section.id }}"
    data-product-url="{{ closest.product.url }}"
    data-variant-id="{{ closest.product.selected_or_first_available_variant.id }}"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.text_color != blank %}
        --color: {{ block_settings.text_color }};
        --color-rgb: {{ block_settings.text_color.rgb }}
      {% endif %}
    "
    ref="localPickupButton"
  >
    {% if can_add_to_cart %}
      <div class="pickup-availability__row">
        <div class="pickup-availability__column">
          <span class="svg-wrapper">
            {% if pick_up_availabilities.first.available %}
              {{- 'icon-available.svg' | inline_asset_content -}}
            {% else %}
              {{- 'icon-unavailable.svg' | inline_asset_content -}}
            {% endif %}
          </span>
        </div>
        <div class="pickup-availability__column">
          {% if pick_up_availabilities.first.available %}
            <p class="pickup-location__text-sm">
              {{ 'content.pickup_available_at_html' | t: location: pick_up_availabilities.first.location.name }}
            </p>
            <p class="pickup-location__text-xs">
              {{ 'content.pickup_ready_in' | t: pickup_time: pick_up_availabilities.first.pick_up_time }}
            </p>
          {% else %}
            <p class="pickup-location__text-sm">
              {{ 'content.pickup_not_available' | t }}
            </p>
          {% endif %}
          <button
            on:click="#pickup-drawer-{{ block.id }}/toggle"
            class="button-unstyled pickup-location__button"
          >
            {{ 'actions.view_store_information' | t }}
          </button>
        </div>
      </div>
    {% endif %}
  </local-pickup>

  {% if can_add_to_cart %}
    <theme-drawer
      id="pickup-drawer-{{ block.id }}"
      class="pickup-drawer"
      data-skip-node-update
      no-persist
    >
      <dialog
        ref="panel"
        class="theme-drawer__dialog color-custom-drawer"
        aria-labelledby="pickup-dialog-heading-{{ block.id }}"
        data-testid="pickup-location-dialog"
      >
        <h2
          id="pickup-dialog-heading-{{ block.id }}"
          class="visually-hidden"
        >
          {{ 'actions.view_store_information' | t }}
        </h2>
        <div class="theme-drawer__header pickup-availability__header-container">
          <div class="pickup-availability__column">
            <h4 class="pickup-location__h4">{{ closest.product.title }}</h4>
            {% unless closest.product.has_only_default_variant %}
              <p class="pickup-location__text-sm">
                {{ closest.product.selected_or_first_available_variant.title }}
              </p>
            {% endunless %}
          </div>
          <button
            on:click="#pickup-drawer-{{ block.id }}/close"
            class="theme-drawer__close-button"
            type="button"
            aria-label="{{ 'actions.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
        {% for pick_up_availability in pick_up_availabilities %}
          <div class="pickup-location__wrapper">
            <p class="pickup-location__text-bold">{{ pick_up_availability.location.name }}</p>
            <div class="pickup-location__address-wrapper">
              <span class="pickup-location__availability-wrapper">
                {% if pick_up_availability.available %}
                  {{- 'icon-available.svg' | inline_asset_content -}}
                  {% assign pickup_time = pick_up_availability.pick_up_time | downcase %}
                  {{ 'content.pickup_available_in' | t: pickup_time: pickup_time }}
                {% else %}
                  {{- 'icon-unavailable.svg' | inline_asset_content -}}
                  {{ 'content.pickup_not_available' | t }}
                {% endif %}
              </span>
              <address class="pickup-location__address">
                {{ pick_up_availability.location.address | format_address }}
                {{ pick_up_availability.location.address.phone }}
              </address>
            </div>
          </div>
        {% endfor %}
      </dialog>
    </theme-drawer>
  {% endif %}
{% endif %}

{% render 'buy-buttons-styles' %}
{% stylesheet %}
  .template-product--avonent .appstle_sub_widget,
  .template-product--avonent [data-appstle-subscription-widget],
  .template-product--avonent .appstle_subscription_wrapper,
  .avonent-product-main-section .appstle_sub_widget,
  .avonent-product-main-section [data-appstle-subscription-widget],
  .avonent-product-main-section .appstle_subscription_wrapper {
    display: none !important;
  }

  .avonent-one-time-switch {
    width: 100%;
    padding-block: var(--avots-top) var(--avots-bottom);
    text-align: center;
  }

  .avonent-one-time-switch__note {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0 0 9px;
    color: #111111;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
  }

  .avonent-one-time-switch__note-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .avonent-one-time-switch__note-item svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    fill: none;
    stroke: #111111;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avonent-one-time-switch__divider {
    width: 1px;
    height: 14px;
    background: #cbd5d9;
  }

  .avonent-one-time-switch__status {
    margin: 9px 0 0;
    color: var(--avots-text);
    font-size: 13px;
    line-height: 1.4;
  }

  .avonent-one-time-switch__link {
    appearance: none;
    display: inline;
    margin: 0;
    padding: 2px 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    background: transparent;
    color: var(--avots-accent);
    font: inherit;
    font-size: var(--avots-size);
    line-height: 1.45;
    text-align: center;
    cursor: pointer;
  }

  .avonent-one-time-switch__link:hover { opacity: 0.78; }

  .avonent-one-time-switch__link:focus-visible {
    outline: 2px solid var(--avots-accent);
    outline-offset: 4px;
  }

  .avonent-one-time-switch__status {
    margin: 9px 0 0;
    color: var(--avots-text);
  }

  .avonent-one-time-switch [hidden] { display: none !important; }
{% endstylesheet %}


{% schema %}
{
  "name": "t:names.product_buy_buttons",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "stacking",
      "label": "t:settings.always_stack_buttons",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "Avonent subscription purchase"
    },
    {
      "type": "checkbox",
      "id": "avonent_subscription_first",
      "label": "Default to Subscribe & Save",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "avonent_show_recurring_note",
      "label": "Show recurring-order note",
      "default": true
    },
    {
      "type": "text",
      "id": "avonent_refill_text",
      "label": "Refill text",
      "default": "Refills ship every 30 days"
    },
    {
      "type": "text",
      "id": "avonent_cancel_text",
      "label": "Cancel text",
      "default": "Skip or cancel anytime"
    },
    {
      "type": "textarea",
      "id": "avonent_one_time_text",
      "label": "One-time purchase text",
      "default": "One-Time Purchase $39.99 + $4.95 Shipping (No Free Gifts Included)."
    },
    {
      "type": "text",
      "id": "avonent_subscription_text",
      "label": "Switch-back text",
      "default": "Switch back to Subscribe & Save — $29.99"
    },
    {
      "type": "text",
      "id": "avonent_one_time_status",
      "label": "One-time selected message",
      "default": "One-time purchase selected · No recurring charges"
    },
    {
      "type": "color",
      "id": "avonent_link_color",
      "label": "Purchase link color",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "avonent_text_color",
      "label": "Selected message color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "avonent_muted_color",
      "label": "Recurring note color",
      "default": "#596269"
    },
    {
      "type": "range",
      "id": "avonent_link_size",
      "label": "Purchase link size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",

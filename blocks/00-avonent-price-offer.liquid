{% doc %}
  Avonent purchase-mode / price offer.
  Moringa uses a fixed $49.99 one-time display price and Shopify's real
  selling-plan allocation for Subscribe & Save when available.
{% enddoc %}

{% liquid
  assign av_product = product
  if av_product == blank
    assign av_product = closest.product
  endif

  if request.visual_preview_mode and av_product == blank
    assign av_product = collections.all.products.first
  endif

  assign av_variant = av_product.selected_or_first_available_variant
  assign is_moringa = false
  if template.suffix == 'moringa' or av_product.handle contains 'moringa' or av_product.title contains 'Moringa'
    assign is_moringa = true
  endif

  assign first_allocation = av_variant.selling_plan_allocations.first
  assign has_subscription = false
  assign selling_plan_id = blank
  assign subscription_price = av_variant.price

  if first_allocation != blank
    assign has_subscription = true
    assign subscription_price = first_allocation.price
    assign selling_plan_id = first_allocation.selling_plan.id
  endif

  assign one_time_price = av_variant.price
  if is_moringa
    assign one_time_price = 4999
  endif

  assign subscription_savings = 0
  assign subscription_savings_percent = 0
  if has_subscription and one_time_price > subscription_price
    assign subscription_savings = one_time_price | minus: subscription_price
    assign subscription_savings_percent = subscription_savings | times: 100.0 | divided_by: one_time_price | round
  endif

  assign default_is_subscription = false
  if has_subscription and block.settings.default_purchase_type == 'subscription'
    assign default_is_subscription = true
  endif
  if is_moringa and has_subscription
    assign default_is_subscription = true
  endif

  assign current_price = one_time_price
  if default_is_subscription
    assign current_price = subscription_price
  endif

  assign root_id = 'AvonentPriceOffer-' | append: block.id
%}

{% if av_product != blank and av_variant != blank %}
  <div
    id="{{ root_id }}"
    class="avonent-price-offer{% if is_moringa %} avonent-price-offer--moringa{% endif %}"
    {{ block.shopify_attributes }}
    data-avonent-price-offer
    data-section-id="{{ section.id }}"
    data-plan-id="{{ selling_plan_id }}"
    data-one-time-price="{{ one_time_price }}"
    data-subscription-price="{{ subscription_price }}"
    data-default-mode="{% if default_is_subscription %}subscription{% else %}one_time{% endif %}"
    style="
      --avpo-accent: {{ block.settings.accent_color }};
      --avpo-text: {{ block.settings.text_color }};
      --avpo-muted: {{ block.settings.muted_text_color }};
      --avpo-border: {{ block.settings.border_color }};
      --avpo-bg: {{ block.settings.background_color }};
      --avpo-top: {{ block.settings.spacing_top }}px;
      --avpo-bottom: {{ block.settings.spacing_bottom }}px;
    "
  >
    {% if is_moringa and has_subscription %}
      <div class="avonent-purchase-choice" role="radiogroup" aria-label="Purchase option">
        <button
          type="button"
          class="avonent-purchase-choice__option{% if default_is_subscription %} is-selected{% endif %}"
          data-avpo-mode="subscription"
          role="radio"
          aria-checked="{% if default_is_subscription %}true{% else %}false{% endif %}"
        >
          <span class="avonent-purchase-choice__radio" aria-hidden="true"><span></span></span>
          <span class="avonent-purchase-choice__copy">
            <strong>{{ block.settings.subscription_label }}</strong>
            <small>{{ block.settings.subscription_helper }}</small>
          </span>
          <span class="avonent-purchase-choice__price">
            <strong>{{ subscription_price | money }}</strong>
            <s>$49.99</s>
            {% if subscription_savings_percent > 0 %}<em>Save {{ subscription_savings_percent }}%</em>{% endif %}
          </span>
          <span class="avonent-purchase-choice__badge">BEST VALUE</span>
        </button>

        <button
          type="button"
          class="avonent-purchase-choice__option{% unless default_is_subscription %} is-selected{% endunless %}"
          data-avpo-mode="one_time"
          role="radio"
          aria-checked="{% unless default_is_subscription %}true{% else %}false{% endunless %}"
        >
          <span class="avonent-purchase-choice__radio" aria-hidden="true"><span></span></span>
          <span class="avonent-purchase-choice__copy">
            <strong>{{ block.settings.one_time_label }}</strong>
            <small>No recurring charges</small>
          </span>
          <span class="avonent-purchase-choice__price"><strong>$49.99</strong></span>
        </button>
      </div>
    {% else %}
      <div class="avonent-price-offer__row">
        <div class="avonent-price-offer__label-wrap">
          <span class="avonent-price-offer__label">
            {% if is_moringa %}{{ block.settings.subscription_label }}{% elsif default_is_subscription %}{{ block.settings.subscription_label }}{% else %}{{ block.settings.one_time_label }}{% endif %}
          </span>
          {% if is_moringa %}
            <span class="avonent-price-offer__helper">Delivered every 30 days · Skip or cancel anytime</span>
          {% elsif block.settings.show_subscription_helper and default_is_subscription %}
            <span class="avonent-price-offer__helper">{{ block.settings.subscription_helper }}</span>
          {% endif %}
        </div>
        <div class="avonent-price-offer__price-wrap">
          <strong class="avonent-price-offer__price">{% if is_moringa %}$34.99{% else %}{{ current_price | money }}{% endif %}</strong>
          {% if is_moringa %}<s class="avonent-price-offer__compare">$49.99</s>{% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if is_moringa %}
    <script>
      (() => {
        const root = document.getElementById('{{ root_id }}');
        if (!root || root.dataset.avpoInitialized === 'true') return;
        root.dataset.avpoInitialized = 'true';

        const planId = String(root.dataset.planId || '');
        let mode = planId ? 'subscription' : 'one_time';
        const modeButtons = Array.from(root.querySelectorAll('[data-avpo-mode]'));

        function getScope() {
          return root.closest('.shopify-section') || document;
        }

        function getForm() {
          const scope = getScope();
          return (
            scope.querySelector('.buy-buttons-block product-form-component form[data-type="add-to-cart-form"]') ||
            scope.querySelector('product-form-component form[data-type="add-to-cart-form"]') ||
            scope.querySelector('form[action*="/cart/add"]')
          );
        }

        function ensurePlanInput() {
          const form = getForm();
          if (!form || !planId) return null;
          let input = form.querySelector('[data-avonent-moringa-plan]');
          if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selling_plan';
            input.setAttribute('data-avonent-moringa-plan', '');
            form.appendChild(input);
          }
          return input;
        }

        function syncPlan() {
          const input = ensurePlanInput();
          if (!input) return;
          if (mode === 'subscription') {
            input.disabled = false;
            input.value = planId;
            input.setAttribute('value', planId);
          } else {
            input.disabled = true;
            input.value = '';
            input.removeAttribute('value');
          }
        }

        function ensureOneTimeText() {
          const form = getForm();
          if (!form) return;
          const buttons = form.querySelector('.product-form-buttons');
          if (!buttons) return;

          let note = form.querySelector('[data-moringa-one-time-note]');
          if (!note) {
            note = document.createElement('button');
            note.type = 'button';
            note.className = 'moringa-one-time-note';
            note.setAttribute('data-moringa-one-time-note', '');
            note.textContent = 'One-Time Purchase — $49.99';
            buttons.insertAdjacentElement('afterend', note);
            note.addEventListener('click', () => applyMode('one_time'));
          }
          note.textContent = 'One-Time Purchase — $49.99';
        }

        function forceBottomOfferPrice() {
          document.querySelectorAll('.avonent-bottom-offer').forEach((offer) => {
            const toggle = offer.querySelector('[data-abo-purchase-toggle]');
            const toggleText = offer.querySelector('[data-abo-purchase-toggle-text]');

            if (toggle) {
              toggle.dataset.oneTimeCopy = 'One-Time Purchase $49.99';
            }
            if (toggleText && toggle?.getAttribute('aria-pressed') !== 'true') {
              toggleText.textContent = 'One-Time Purchase $49.99';
            }

            offer.querySelectorAll('[data-abo-bundle]').forEach((input) => {
              const qty = Number(input.dataset.quantity || input.value || 1);
              const total = (49.99 * qty).toFixed(2);
              input.dataset.oneTimePrice = `$${total}`;
              input.dataset.oneTimeComparePrice = '';
              input.dataset.oneTimeSavingsPrice = '';
            });
          });
        }

        function applyMode(nextMode) {
          mode = nextMode === 'subscription' && planId ? 'subscription' : 'one_time';
          syncPlan();
          modeButtons.forEach((button) => {
            const selected = button.dataset.avpoMode === mode;
            button.classList.toggle('is-selected', selected);
            button.setAttribute('aria-checked', selected ? 'true' : 'false');
          });
          ensureOneTimeText();
          forceBottomOfferPrice();
          document.dispatchEvent(new Event('selling-plan:change'));
          document.dispatchEvent(new CustomEvent('avonent:purchase-mode-change', {
            detail: { mode, sellingPlanId: mode === 'subscription' ? planId : null }
          }));
        }

        modeButtons.forEach((button) => button.addEventListener('click', () => applyMode(button.dataset.avpoMode)));

        document.addEventListener('submit', (event) => {
          const form = getForm();
          if (!form || event.target !== form) return;
          syncPlan();
        }, true);

        document.addEventListener('formdata', (event) => {
          const form = getForm();
          if (!form || event.target !== form) return;
          if (mode === 'subscription' && planId) event.formData.set('selling_plan', planId);
          else event.formData.delete('selling_plan');
        });

        [0, 150, 500, 1200, 2500, 4500].forEach((delay) => {
          setTimeout(() => {
            ensureOneTimeText();
            forceBottomOfferPrice();
            syncPlan();
          }, delay);
        });

        document.addEventListener('shopify:section:load', () => {
          ensureOneTimeText();
          forceBottomOfferPrice();
          syncPlan();
        });

        applyMode(mode);
      })();
    </script>
  {% endif %}
{% endif %}

{% stylesheet %}
  .avonent-price-offer {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--avpo-top);
    padding-bottom: var(--avpo-bottom);
    font-family: var(--font-body--family);
  }

  .avonent-purchase-choice { display:grid; gap:10px; width:100%; margin-block:2px 4px; }
  .avonent-purchase-choice__option {
    position:relative; display:grid; grid-template-columns:22px minmax(0,1fr) auto; align-items:center;
    gap:11px; width:100%; min-height:68px; padding:13px 14px; border:1px solid var(--avpo-border);
    border-radius:12px; background:#fff; color:var(--avpo-text); font:inherit; text-align:left; cursor:pointer;
  }
  .avonent-purchase-choice__option.is-selected { border-color:var(--avpo-accent); background:color-mix(in srgb,var(--avpo-accent) 8%,#fff); box-shadow:0 0 0 1px var(--avpo-accent); }
  .avonent-purchase-choice__radio { display:grid; place-items:center; width:20px; height:20px; border:1.5px solid #aab4b8; border-radius:50%; background:#fff; }
  .avonent-purchase-choice__radio span { width:9px; height:9px; border-radius:50%; background:transparent; }
  .avonent-purchase-choice__option.is-selected .avonent-purchase-choice__radio { border-color:var(--avpo-accent); }
  .avonent-purchase-choice__option.is-selected .avonent-purchase-choice__radio span { background:var(--avpo-accent); }
  .avonent-purchase-choice__copy { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .avonent-purchase-choice__copy strong { font-size:15px; font-weight:800; line-height:1.1; }
  .avonent-purchase-choice__copy small { color:var(--avpo-muted); font-size:10px; line-height:1.25; }
  .avonent-purchase-choice__price { display:flex; flex-direction:column; align-items:flex-end; gap:2px; white-space:nowrap; }
  .avonent-purchase-choice__price strong { font-size:16px; font-weight:850; }
  .avonent-purchase-choice__price s { color:var(--avpo-muted); font-size:11px; }
  .avonent-purchase-choice__price em { color:var(--avpo-accent); font-size:10px; font-style:normal; font-weight:800; }
  .avonent-purchase-choice__badge { position:absolute; top:-9px; right:12px; padding:4px 9px; border-radius:999px; background:var(--avpo-accent); color:#fff; font-size:9px; font-weight:850; }

  .avonent-price-offer__row { display:flex; align-items:center; justify-content:space-between; gap:18px; width:100%; padding:10px 0; border-top:1px solid var(--avpo-border); border-bottom:1px solid var(--avpo-border); background:var(--avpo-bg); }
  .avonent-price-offer__label-wrap { display:flex; flex-direction:column; gap:3px; }
  .avonent-price-offer__label { color:var(--avpo-accent); font-size:16px; font-weight:750; }
  .avonent-price-offer__helper { color:var(--avpo-muted); font-size:10px; }
  .avonent-price-offer__price-wrap { display:flex; align-items:center; gap:8px; }
  .avonent-price-offer__price { color:var(--avpo-text); font-size:17px; font-weight:800; }
  .avonent-price-offer__compare { color:var(--avpo-muted); font-size:12px; }

  .moringa-one-time-note {
    appearance:none; display:block; width:max-content; max-width:100%; margin:8px auto 0; padding:3px 0;
    border:0; border-bottom:1px solid currentColor; background:transparent; color:#02c6ea;
    font:inherit; font-size:12px; font-weight:750; line-height:1.35; cursor:pointer; text-align:center;
  }

  @media screen and (min-width:990px) {
    body:has(.avonent-price-offer--moringa) .avonent-purchase-choice { grid-template-columns:1fr 1fr; }
    body:has(.avonent-price-offer--moringa) .avonent-purchase-choice__option { min-height:82px; }
  }

  @media screen and (max-width:749px) {
    .avonent-purchase-choice__copy strong { font-size:13px; }
    .avonent-purchase-choice__price strong { font-size:14px; }
    .avonent-purchase-choice__option { min-height:64px; padding:11px 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Price Offer",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Purchase labels" },
    { "type": "text", "id": "one_time_label", "label": "One-time label", "default": "One-Time Purchase" },
    { "type": "text", "id": "subscription_label", "label": "Subscription label", "default": "Subscribe & Save" },
    {
      "type": "select",
      "id": "default_purchase_type",
      "label": "Preview/default purchase type",
      "options": [
        { "value": "one_time", "label": "One-Time Purchase" },
        { "value": "subscription", "label": "Subscribe & Save" }
      ],
      "default": "one_time"
    },
    { "type": "checkbox", "id": "show_subscription_helper", "label": "Show subscription helper text", "default": true },
    { "type": "text", "id": "subscription_helper", "label": "Subscription helper text", "default": "Delivered every 30 days · Skip or cancel anytime" },
    { "type": "header", "content": "Sale" },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
    { "type": "text", "id": "sale_name", "label": "Sale name", "default": "SUMMER SALE" },
    { "type": "checkbox", "id": "show_savings_amount", "label": "Show dollar savings", "default": true },
    { "type": "checkbox", "id": "show_savings_percent", "label": "Show percentage savings instead", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Purchase label", "default": "#02C6EA" },
    { "type": "color", "id": "text_color", "label": "Current price", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Old price / helper text", "default": "#667177" },
    { "type": "color", "id": "border_color", "label": "Divider", "default": "#DCE6E9" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "sale_badge_background", "label": "Sale badge background", "default": "#02C6EA" },
    { "type": "color", "id": "sale_badge_text_color", "label": "Sale badge text", "default": "#FFFFFF" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "corner_radius", "label": "Corner roundness", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "spacing_top", "label": "Top spacing", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 3 }
  ],
  "presets": [{ "name": "Avonent Price Offer" }]
}
{% endschema %}
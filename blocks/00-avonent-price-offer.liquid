{% doc %}
  Avonent purchase-mode / price offer.
  On the Moringa template this block shows one Subscribe & Save row above
  the bundle selector. One-Time Purchase is rendered beneath the native
  Add to Cart button and switches the live product form to one-time mode.
{% enddoc %}

{% liquid
  assign av_product = product | default: closest.product
  if request.visual_preview_mode and av_product == blank
    assign av_product = collections.all.products.first
  endif

  assign av_variant = av_product.selected_or_first_available_variant
  assign is_moringa = false
  if template.suffix == 'moringa' or av_product.handle contains 'moringa' or av_product.title contains 'Moringa'
    assign is_moringa = true
  endif

  assign subscription_allocation = av_variant.selling_plan_allocations.first
  assign selling_plan_id = blank
  assign subscription_price = av_variant.price
  if subscription_allocation != blank
    assign selling_plan_id = subscription_allocation.selling_plan.id
    assign subscription_price = subscription_allocation.price
  endif

  assign one_time_price = av_variant.price
  if is_moringa
    assign one_time_price = 4999
  endif

  assign root_id = 'AvonentPriceOffer-' | append: block.id
%}

{% if av_product != blank and av_variant != blank %}
  <div
    id="{{ root_id }}"
    class="avonent-price-offer{% if is_moringa %} avonent-price-offer--moringa{% endif %}"
    {{ block.shopify_attributes }}
    data-avonent-price-offer
    data-plan-id="{{ selling_plan_id }}"
    data-section-id="{{ section.id }}"
    style="
      --avpo-accent: {{ block.settings.accent_color }};
      --avpo-text: {{ block.settings.text_color }};
      --avpo-muted: {{ block.settings.muted_text_color }};
      --avpo-border: {{ block.settings.border_color }};
      --avpo-bg: {{ block.settings.background_color }};
      --avpo-top: {{ block.settings.spacing_top }}px;
      --avpo-bottom: {{ block.settings.spacing_bottom }}px;
    "
  >
    {% if is_moringa %}
      <button
        type="button"
        class="avonent-price-offer__row avonent-price-offer__row--selectable is-selected"
        data-moringa-subscribe
        aria-pressed="true"
      >
        <span class="avonent-price-offer__label-wrap">
          <strong class="avonent-price-offer__label">{{ block.settings.subscription_label }}</strong>
          {% if block.settings.show_subscription_helper %}
            <small class="avonent-price-offer__helper">{{ block.settings.subscription_helper }}</small>
          {% endif %}
        </span>

        <span class="avonent-price-offer__price-wrap">
          <strong class="avonent-price-offer__price">$34.99</strong>
          <s class="avonent-price-offer__compare">$49.99</s>
          <em class="avonent-price-offer__save">Save 30%</em>
        </span>
      </button>
    {% else %}
      <div class="avonent-price-offer__row">
        <span class="avonent-price-offer__label-wrap">
          <strong class="avonent-price-offer__label">{{ block.settings.one_time_label }}</strong>
        </span>
        <span class="avonent-price-offer__price-wrap">
          <strong class="avonent-price-offer__price">{{ av_variant.price | money }}</strong>
        </span>
      </div>
    {% endif %}
  </div>

  {% if is_moringa %}
    <script>
      (() => {
        const root = document.getElementById('{{ root_id }}');
        if (!root || root.dataset.avpoInitialized === 'true') return;
        root.dataset.avpoInitialized = 'true';

        const planId = String(root.dataset.planId || '');
        const subscribeRow = root.querySelector('[data-moringa-subscribe]');
        let mode = planId ? 'subscription' : 'one_time';

        function getScope() {
          return root.closest('.shopify-section') || document;
        }

        function getMainForm() {
          const scope = getScope();
          return (
            scope.querySelector('.buy-buttons-block product-form-component form[data-type="add-to-cart-form"]') ||
            scope.querySelector('product-form-component form[data-type="add-to-cart-form"]') ||
            scope.querySelector('form[action*="/cart/add"]')
          );
        }

        function ensurePlanInput(form) {
          if (!form || !planId) return null;
          let input = form.querySelector('[data-avonent-moringa-selling-plan]');
          if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selling_plan';
            input.setAttribute('data-avonent-moringa-selling-plan', '');
            form.appendChild(input);
          }
          return input;
        }

        function enforceMainFormMode() {
          const form = getMainForm();
          if (!form) return;
          const input = ensurePlanInput(form);
          if (!input) return;

          if (mode === 'subscription' && planId) {
            input.disabled = false;
            input.value = planId;
            input.setAttribute('value', planId);
          } else {
            input.disabled = true;
            input.value = '';
            input.removeAttribute('value');
          }
        }

        function ensureOneTimeLink() {
          const form = getMainForm();
          if (!form) return;
          const buttons = form.querySelector('.product-form-buttons');
          if (!buttons) return;

          let link = form.querySelector('[data-moringa-one-time-link]');
          if (!link) {
            link = document.createElement('button');
            link.type = 'button';
            link.className = 'moringa-one-time-link';
            link.setAttribute('data-moringa-one-time-link', '');
            link.textContent = 'One-Time Purchase — $49.99';
            buttons.insertAdjacentElement('afterend', link);
            link.addEventListener('click', () => setMode('one_time'));
          }

          link.classList.toggle('is-selected', mode === 'one_time');
          link.setAttribute('aria-pressed', mode === 'one_time' ? 'true' : 'false');
        }

        function announceMode() {
          document.dispatchEvent(new Event('selling-plan:change'));
          document.dispatchEvent(new CustomEvent('avonent:purchase-mode-change', {
            detail: {
              mode,
              sellingPlanId: mode === 'subscription' ? planId : null
            }
          }));
        }

        function renderMode() {
          if (subscribeRow) {
            const selected = mode === 'subscription';
            subscribeRow.classList.toggle('is-selected', selected);
            subscribeRow.setAttribute('aria-pressed', selected ? 'true' : 'false');
          }
          ensureOneTimeLink();
          enforceMainFormMode();
        }

        function setMode(nextMode) {
          mode = nextMode === 'subscription' && planId ? 'subscription' : 'one_time';
          renderMode();
          announceMode();
        }

        subscribeRow?.addEventListener('click', () => setMode('subscription'));

        document.addEventListener('click', (event) => {
          const form = getMainForm();
          const addButton = event.target.closest('button[type="submit"][name="add"], button[type="submit"][data-add-to-cart]');
          if (!form || !addButton || !form.contains(addButton)) return;
          enforceMainFormMode();
        }, true);

        document.addEventListener('submit', (event) => {
          const form = getMainForm();
          if (!form || event.target !== form) return;
          enforceMainFormMode();
        }, true);

        document.addEventListener('formdata', (event) => {
          const form = getMainForm();
          if (!form || event.target !== form) return;
          if (mode === 'subscription' && planId) event.formData.set('selling_plan', planId);
          else event.formData.delete('selling_plan');
        });

        function wireBottomOffer(offer) {
          if (!offer || offer.dataset.moringaPlanGuard === 'true') return;
          const form = offer.querySelector('form[data-type="add-to-cart-form"], form[action*="/cart/add"]');
          const input = offer.querySelector('[data-abo-selling-plan-input]');
          const toggle = offer.querySelector('[data-abo-purchase-toggle]');
          if (!form || !input) return;

          const bottomPlanId = String(input.dataset.planId || input.value || planId || '');
          if (!bottomPlanId) return;
          offer.dataset.moringaPlanGuard = 'true';

          const isSubscription = () => {
            if (!toggle) return !input.disabled;
            return toggle.getAttribute('aria-pressed') !== 'true';
          };

          const enforceBottomMode = () => {
            if (isSubscription()) {
              input.disabled = false;
              input.value = bottomPlanId;
              input.setAttribute('value', bottomPlanId);
            } else {
              input.disabled = true;
              input.value = '';
              input.removeAttribute('value');
            }
          };

          form.addEventListener('click', (event) => {
            if (event.target.closest('button[type="submit"], [name="add"]')) enforceBottomMode();
          }, true);

          form.addEventListener('submit', enforceBottomMode, true);

          document.addEventListener('formdata', (event) => {
            if (event.target !== form) return;
            if (isSubscription()) event.formData.set('selling_plan', bottomPlanId);
            else event.formData.delete('selling_plan');
          });

          toggle?.addEventListener('click', () => {
            window.setTimeout(enforceBottomMode, 0);
          });

          enforceBottomMode();
        }

        function wireBottomOffers() {
          document.querySelectorAll('[data-avonent-bottom-offer]').forEach(wireBottomOffer);
        }

        const observer = new MutationObserver(() => {
          ensureOneTimeLink();
          enforceMainFormMode();
          wireBottomOffers();
        });
        observer.observe(getScope(), { childList: true, subtree: true });

        document.addEventListener('shopify:section:load', () => {
          ensureOneTimeLink();
          enforceMainFormMode();
          wireBottomOffers();
        });

        [0, 100, 350, 900, 1800, 3500].forEach((delay) => {
          window.setTimeout(() => {
            renderMode();
            wireBottomOffers();
          }, delay);
        });

        setMode(mode);
      })();
    </script>
  {% endif %}
{% endif %}

{% stylesheet %}
  .avonent-price-offer {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--avpo-top);
    padding-bottom: var(--avpo-bottom);
    font-family: var(--font-body--family);
  }

  .avonent-price-offer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: 100%;
    margin: 0;
    padding: 11px 0;
    border: 0;
    border-top: 1px solid var(--avpo-border);
    border-bottom: 1px solid var(--avpo-border);
    background: var(--avpo-bg);
    color: var(--avpo-text);
    font: inherit;
    text-align: left;
  }

  .avonent-price-offer__row--selectable {
    cursor: pointer;
  }

  .avonent-price-offer__row--selectable.is-selected .avonent-price-offer__label {
    color: var(--avpo-accent);
  }

  .avonent-price-offer__label-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .avonent-price-offer__label {
    color: var(--avpo-accent);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
  }

  .avonent-price-offer__helper {
    color: var(--avpo-muted);
    font-size: 10px;
    line-height: 1.25;
  }

  .avonent-price-offer__price-wrap {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 8px;
    white-space: nowrap;
  }

  .avonent-price-offer__price {
    color: var(--avpo-text);
    font-size: 18px;
    font-weight: 850;
    line-height: 1;
  }

  .avonent-price-offer__compare {
    color: var(--avpo-muted);
    font-size: 12px;
  }

  .avonent-price-offer__save {
    padding: 4px 7px;
    border-radius: 6px;
    background: var(--avpo-accent);
    color: #fff;
    font-size: 9px;
    font-style: normal;
    font-weight: 800;
    line-height: 1;
  }

  .moringa-one-time-link {
    appearance: none;
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 8px auto 0;
    padding: 2px 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: #02c6ea;
    font: inherit;
    font-size: 12px;
    font-weight: 750;
    line-height: 1.35;
    text-align: center;
    cursor: pointer;
  }

  .moringa-one-time-link.is-selected {
    color: var(--avpo-text, #111111);
    border-bottom-color: transparent;
  }

  @media screen and (max-width: 749px) {
    .avonent-price-offer__row { gap: 10px; }
    .avonent-price-offer__label { font-size: 14px; }
    .avonent-price-offer__price { font-size: 16px; }
    .avonent-price-offer__save { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Price Offer",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Purchase labels" },
    { "type": "text", "id": "one_time_label", "label": "One-time label", "default": "One-Time Purchase" },
    { "type": "text", "id": "subscription_label", "label": "Subscription label", "default": "Subscribe & Save" },
    {
      "type": "select",
      "id": "default_purchase_type",
      "label": "Preview/default purchase type",
      "options": [
        { "value": "one_time", "label": "One-Time Purchase" },
        { "value": "subscription", "label": "Subscribe & Save" }
      ],
      "default": "subscription"
    },
    { "type": "checkbox", "id": "show_subscription_helper", "label": "Show subscription helper text", "default": true },
    { "type": "text", "id": "subscription_helper", "label": "Subscription helper text", "default": "Recurring delivery · Cancel anytime" },
    { "type": "header", "content": "Sale" },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
    { "type": "text", "id": "sale_name", "label": "Sale name", "default": "SUMMER SALE" },
    { "type": "checkbox", "id": "show_savings_amount", "label": "Show dollar savings", "default": true },
    { "type": "checkbox", "id": "show_savings_percent", "label": "Show percentage savings instead", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Purchase label", "default": "#02C6EA" },
    { "type": "color", "id": "text_color", "label": "Current price", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Old price / helper text", "default": "#667177" },
    { "type": "color", "id": "border_color", "label": "Divider", "default": "#DCE6E9" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "sale_badge_background", "label": "Sale badge background", "default": "#02C6EA" },
    { "type": "color", "id": "sale_badge_text_color", "label": "Sale badge text", "default": "#FFFFFF" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "corner_radius", "label": "Corner roundness", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "spacing_top", "label": "Top spacing", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 3 }
  ],
  "presets": [
    { "name": "Avonent Price Offer" }
  ]
}
{% endschema %}
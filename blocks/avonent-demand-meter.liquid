{% liquid
  assign av_product = closest.product | default: product
  assign av_variant = av_product.selected_or_first_available_variant

  assign starting_inventory = block.settings.starting_inventory | default: 100
  assign current_inventory = 0
  assign demand_percent = 0
  assign inventory_tracked = false

  if av_variant != blank and av_variant.inventory_management != blank
    assign inventory_tracked = true
    assign current_inventory = av_variant.inventory_quantity | default: 0
  endif

  if starting_inventory <= 0
    assign starting_inventory = 100
  endif

  if inventory_tracked
    assign claimed_units = starting_inventory | minus: current_inventory

    if claimed_units < 0
      assign claimed_units = 0
    endif

    assign demand_percent = claimed_units | times: 100.0 | divided_by: starting_inventory | round

    if demand_percent < block.settings.minimum_percent
      assign demand_percent = block.settings.minimum_percent
    endif

    if demand_percent > block.settings.maximum_percent
      assign demand_percent = block.settings.maximum_percent
    endif
  endif
%}

<div
  class="avonent-demand-meter"
  {{ block.shopify_attributes }}
  style="
    --avdm-bg: {{ block.settings.background_color }};
    --avdm-track: {{ block.settings.track_color }};
    --avdm-fill: {{ block.settings.fill_color }};
    --avdm-text: {{ block.settings.text_color }};
    --avdm-border: {{ block.settings.border_color }};
    --avdm-radius: {{ block.settings.corner_radius }}px;
    --avdm-top: {{ block.settings.padding_top }}px;
    --avdm-bottom: {{ block.settings.padding_bottom }}px;
    --avdm-inner-y: {{ block.settings.inner_padding_y }}px;
    --avdm-inner-x: {{ block.settings.inner_padding_x }}px;
    --avdm-bar-height: {{ block.settings.bar_height }}px;
  "
>
  {% if inventory_tracked %}

    <div class="avonent-demand-meter__card">

      {% if block.settings.heading != blank %}
        <div class="avonent-demand-meter__heading">
          {{ block.settings.heading }}
        </div>
      {% endif %}

      <div class="avonent-demand-meter__row">

        <div
          class="avonent-demand-meter__track"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ demand_percent }}"
        >
          <span
            class="avonent-demand-meter__fill"
            style="width: {{ demand_percent }}%;"
          ></span>
        </div>

        <div class="avonent-demand-meter__value">
          <strong>{{ demand_percent }}%</strong>

          {% if block.settings.percent_text != blank %}
            <span>{{ block.settings.percent_text }}</span>
          {% endif %}
        </div>

      </div>

      {% if block.settings.subtext != blank %}
        <div class="avonent-demand-meter__subtext">
          {{ block.settings.subtext }}
        </div>
      {% endif %}

    </div>

  {% elsif request.design_mode %}

    <div class="avonent-demand-meter__editor-message">
      <strong>Avonent Demand Meter</strong>
      <span>
        This product is not currently tracking inventory.
        Enable “Track quantity” on the product variant to calculate the meter.
      </span>
    </div>

  {% endif %}
</div>

{% stylesheet %}

  .avonent-demand-meter {
    width: 100%;
    padding-top: var(--avdm-top);
    padding-bottom: var(--avdm-bottom);
  }

  .avonent-demand-meter__card {
    width: 100%;

    padding:
      var(--avdm-inner-y)
      var(--avdm-inner-x);

    background: var(--avdm-bg);

    border:
      1px solid
      var(--avdm-border);

    border-radius:
      var(--avdm-radius);

    box-shadow:
      0 5px 18px
      rgba(0, 0, 0, 0.035);
  }

  .avonent-demand-meter__heading {
    margin: 0 0 8px;

    color:
      var(--avdm-text);

    font-family:
      var(--font-body--family);

    font-size: 12px;
    font-weight: 650;

    line-height: 1.2;
  }

  .avonent-demand-meter__row {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 12px;

    width: 100%;
  }

  .avonent-demand-meter__track {
    position: relative;

    width: 100%;
    height:
      var(--avdm-bar-height);

    overflow: hidden;

    background:
      var(--avdm-track);

    border-radius:
      999px;
  }

  .avonent-demand-meter__fill {
    position: absolute;

    top: 0;
    bottom: 0;
    left: 0;

    display: block;

    height: 100%;

    border-radius:
      inherit;

    background:
      var(--avdm-fill);

    transition:
      width 250ms ease;
  }

  .avonent-demand-meter__value {
    display: flex;

    align-items: baseline;

    gap: 4px;

    color:
      var(--avdm-fill);

    font-family:
      var(--font-body--family);

    line-height: 1;

    white-space: nowrap;
  }

  .avonent-demand-meter__value strong {
    font-size: 14px;
    font-weight: 750;

    letter-spacing:
      -0.015em;
  }

  .avonent-demand-meter__value span {
    font-size: 12px;
    font-weight: 650;
  }

  .avonent-demand-meter__subtext {
    margin-top: 6px;

    color:
      var(--avdm-text);

    opacity: 0.6;

    font-family:
      var(--font-body--family);

    font-size: 10px;

    line-height: 1.35;
  }

  .avonent-demand-meter__editor-message {
    display: flex;
    flex-direction: column;

    gap: 4px;

    width: 100%;

    padding: 12px 14px;

    border:
      1px dashed
      #02c6ea;

    border-radius:
      12px;

    background:
      #f3fcfe;

    color:
      #111111;

    font-family:
      var(--font-body--family);

    font-size: 11px;

    line-height: 1.35;
  }

  .avonent-demand-meter__editor-message strong {
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {

    .avonent-demand-meter__heading {
      margin-bottom: 7px;
      font-size: 11px;
    }

    .avonent-demand-meter__row {
      gap: 9px;
    }

    .avonent-demand-meter__value strong {
      font-size: 13px;
    }

    .avonent-demand-meter__value span {
      font-size: 11px;
    }

    .avonent-demand-meter__subtext {
      margin-top: 5px;
      font-size: 9px;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "00 Avonent Demand Meter",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Offer availability"
    },
    {
      "type": "text",
      "id": "percent_text",
      "label": "Text after percentage",
      "default": "claimed"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Small text",
      "default": ""
    },
    {
      "type": "header",
      "content": "Inventory calculation"
    },
    {
      "type": "number",
      "id": "starting_inventory",
      "label": "Starting inventory",
      "default": 100,
      "info": "Use the actual inventory quantity at the beginning of the offer."
    },
    {
      "type": "range",
      "id": "minimum_percent",
      "label": "Minimum percentage",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "maximum_percent",
      "label": "Maximum percentage",
      "min": 70,
      "max": 99,
      "step": 1,
      "unit": "%",
      "default": 96
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7FCFD"
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Empty bar",
      "default": "#E4EFF2"
    },
    {
      "type": "color",
      "id": "fill_color",
      "label": "Progress",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E5EEF1"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar thickness",
      "min": 5,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner roundness",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "inner_padding_y",
      "label": "Inside vertical padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "inner_padding_x",
      "label": "Inside horizontal padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Avonent Demand Meter",
      "category": "Product"
    }
  ]
}
{% endschema %}

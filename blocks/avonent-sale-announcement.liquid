{% liquid
  assign block_id = 'avonent-sale-' | append: block.id
%}

<slideshow-slide
  ref="slides[]"
  class="announcement-bar__slide avonent-sale-bar"
  {{ block.shopify_attributes }}
  aria-hidden="false"
>
  <div
    id="{{ block_id }}"
    class="avonent-sale-bar__inner"
    style="
      --avonent-sale-bg: {{ block.settings.background_color }};
      --avonent-sale-color: {{ block.settings.text_color }};
      --avonent-sale-height: {{ block.settings.bar_height }}px;
    "
    data-avonent-sale-timer
    data-duration-minutes="{{ block.settings.timer_minutes }}"
  >
    {% if block.settings.link != blank %}
      <a
        href="{{ block.settings.link }}"
        class="avonent-sale-bar__full-link"
        aria-label="{{ block.settings.heading | escape }}"
      ></a>
    {% endif %}

    <div class="avonent-sale-bar__content">
      <div class="avonent-sale-bar__message">
        <div class="avonent-sale-bar__heading">
          {{ block.settings.heading }}
        </div>

        {% if block.settings.subheading != blank %}
          <div class="avonent-sale-bar__subheading">
            {{ block.settings.subheading }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.show_countdown %}
        <div
          class="avonent-sale-bar__timer"
          role="timer"
          aria-label="Sale countdown"
        >
          <div class="avonent-sale-bar__numbers">
            <div class="avonent-sale-bar__time-unit">
              <span data-avonent-hours>02</span>
              <small>Hrs</small>
            </div>

            <span class="avonent-sale-bar__colon">:</span>

            <div class="avonent-sale-bar__time-unit">
              <span data-avonent-minutes>00</span>
              <small>Mins</small>
            </div>

            <span class="avonent-sale-bar__colon">:</span>

            <div class="avonent-sale-bar__time-unit">
              <span data-avonent-seconds>00</span>
              <small>Secs</small>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</slideshow-slide>

<script>
  (() => {
    const root = document.getElementById('{{ block_id }}');

    if (!root || root.dataset.timerInitialized === 'true') {
      return;
    }

    root.dataset.timerInitialized = 'true';

    const hoursElement = root.querySelector('[data-avonent-hours]');
    const minutesElement = root.querySelector('[data-avonent-minutes]');
    const secondsElement = root.querySelector('[data-avonent-seconds]');

    if (!hoursElement || !minutesElement || !secondsElement) {
      return;
    }

    const durationMinutes =
      parseInt(root.dataset.durationMinutes, 10) || 120;

    const durationMilliseconds = durationMinutes * 60 * 1000;
    const storageKey = 'avonent_sale_timer_{{ block.id }}';

    function createNewEndTime() {
      const endTime = Date.now() + durationMilliseconds;

      try {
        localStorage.setItem(storageKey, String(endTime));
      } catch (error) {}

      return endTime;
    }

    function getEndTime() {
      try {
        const savedEndTime = Number(localStorage.getItem(storageKey));

        if (savedEndTime && savedEndTime > Date.now()) {
          return savedEndTime;
        }
      } catch (error) {}

      return createNewEndTime();
    }

    let endTime = getEndTime();

    function updateTimer() {
      let remaining = endTime - Date.now();

      if (remaining <= 0) {
        endTime = createNewEndTime();
        remaining = endTime - Date.now();
      }

      const totalSeconds = Math.max(0, Math.floor(remaining / 1000));

      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      hoursElement.textContent = String(hours).padStart(2, '0');
      minutesElement.textContent = String(minutes).padStart(2, '0');
      secondsElement.textContent = String(seconds).padStart(2, '0');
    }

    updateTimer();
    window.setInterval(updateTimer, 1000);
  })();
</script>

{% stylesheet %}
  .avonent-sale-bar {
    width: 100%;
  }

  .avonent-sale-bar__inner {
    position: relative;
    width: 100%;
    min-height: var(--avonent-sale-height);
    background: var(--avonent-sale-bg);
    color: var(--avonent-sale-color);
    padding: 8px 18px;
    overflow: hidden;
  }

  .avonent-sale-bar__content {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: 100%;

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
  }

  .avonent-sale-bar__message {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 0;
  }

  .avonent-sale-bar__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;
  }

  .avonent-sale-bar__subheading {
    margin-top: 4px;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.15;
    color: inherit;
    opacity: 0.92;
  }

  .avonent-sale-bar__timer {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avonent-sale-bar__numbers {
    display: flex;
    align-items: flex-start;
    font-variant-numeric: tabular-nums;
  }

  .avonent-sale-bar__time-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 42px;
  }

  .avonent-sale-bar__time-unit > span {
    font-family: var(--font-heading--family);
    font-size: 28px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: inherit;
  }

  .avonent-sale-bar__time-unit small {
    margin-top: 4px;
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    color: inherit;
    opacity: 0.9;
    text-transform: none;
  }

  .avonent-sale-bar__colon {
    margin: 0 4px;
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-weight: 700;
    line-height: 0.95;
    color: inherit;
    opacity: 0.95;
  }

  .avonent-sale-bar__full-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  @media screen and (max-width: 749px) {
    .avonent-sale-bar__inner {
      padding: 8px 12px;
    }

    .avonent-sale-bar__content {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .avonent-sale-bar__heading {
      font-size: 18px;
    }

    .avonent-sale-bar__subheading {
      margin-top: 3px;
      font-size: 10px;
      line-height: 1.1;
    }

    .avonent-sale-bar__time-unit {
      min-width: 30px;
    }

    .avonent-sale-bar__time-unit > span {
      font-size: 21px;
    }

    .avonent-sale-bar__time-unit small {
      margin-top: 3px;
      font-size: 8px;
    }

    .avonent-sale-bar__colon {
      margin: 0 2px;
      font-size: 20px;
    }
  }

  @media screen and (max-width: 390px) {
    .avonent-sale-bar__heading {
      font-size: 16px;
    }

    .avonent-sale-bar__subheading {
      font-size: 9px;
    }

    .avonent-sale-bar__time-unit {
      min-width: 26px;
    }

    .avonent-sale-bar__time-unit > span {
      font-size: 18px;
    }

    .avonent-sale-bar__colon {
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Summer Sale",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Sale message"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUMMER SALE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Text under heading",
      "default": "Shop Now and Get Up To 50% Off"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Bar link"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "range",
      "id": "timer_minutes",
      "label": "Countdown length",
      "min": 30,
      "max": 240,
      "step": 10,
      "unit": "min",
      "default": 120
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Minimum bar height",
      "min": 48,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Avonent Summer Sale"
    }
  ]
}
{% endschema %}

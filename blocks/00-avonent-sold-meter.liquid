{% liquid
  assign av_product = closest.product | default: product
  assign av_variant = av_product.selected_or_first_available_variant

  assign starting_inventory = block.settings.starting_inventory | default: 100
  assign sold_percent = 0
  assign inventory_tracked = false
  assign current_inventory = 0

  if av_variant != blank and av_variant.inventory_management != blank
    assign inventory_tracked = true
    assign current_inventory = av_variant.inventory_quantity | default: 0
  endif

  if starting_inventory <= 0
    assign starting_inventory = 100
  endif

  if inventory_tracked
    assign sold_units = starting_inventory | minus: current_inventory

    if sold_units < 0
      assign sold_units = 0
    endif

    assign sold_percent = sold_units
      | times: 100.0
      | divided_by: starting_inventory
      | round

    if sold_percent < 0
      assign sold_percent = 0
    endif

    if sold_percent > 100
      assign sold_percent = 100
    endif
  endif
%}

<div
  class="avonent-sold-meter"
  {{ block.shopify_attributes }}
  style="
    --av-sm-background: {{ block.settings.background_color }};
    --av-sm-track: {{ block.settings.track_color }};
    --av-sm-fill: {{ block.settings.fill_color }};
    --av-sm-text: {{ block.settings.text_color }};
    --av-sm-border: {{ block.settings.border_color }};
    --av-sm-radius: {{ block.settings.corner_radius }}px;
    --av-sm-bar-height: {{ block.settings.bar_height }}px;
    --av-sm-padding-y: {{ block.settings.padding_y }}px;
    --av-sm-padding-x: {{ block.settings.padding_x }}px;
    --av-sm-top-space: {{ block.settings.spacing_top }}px;
    --av-sm-bottom-space: {{ block.settings.spacing_bottom }}px;
  "
>
  {% if inventory_tracked %}
    <div class="avonent-sold-meter__card">

      {% if block.settings.heading != blank %}
        <div class="avonent-sold-meter__heading">
          {{ block.settings.heading }}
        </div>
      {% endif %}

      <div class="avonent-sold-meter__row">

        <div
          class="avonent-sold-meter__track"
          role="progressbar"
          aria-label="{{ sold_percent }} percent sold"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ sold_percent }}"
        >
          <span
            class="avonent-sold-meter__fill"
            style="width: {{ sold_percent }}%;"
          ></span>
        </div>

        <div class="avonent-sold-meter__value">
          <strong>{{ sold_percent }}%</strong>

          {% if block.settings.sold_text != blank %}
            <span>{{ block.settings.sold_text }}</span>
          {% endif %}
        </div>

      </div>

      {% if block.settings.subtext != blank %}
        <div class="avonent-sold-meter__subtext">
          {{ block.settings.subtext }}
        </div>
      {% endif %}

    </div>

  {% elsif request.design_mode %}

    <div class="avonent-sold-meter__preview">

      {% if block.settings.heading != blank %}
        <div class="avonent-sold-meter__heading">
          {{ block.settings.heading }}
        </div>
      {% endif %}

      <div class="avonent-sold-meter__row">

        <div class="avonent-sold-meter__track">
          <span
            class="avonent-sold-meter__fill"
            style="width: {{ block.settings.editor_preview_percent }}%;"
          ></span>
        </div>

        <div class="avonent-sold-meter__value">
          <strong>
            {{ block.settings.editor_preview_percent }}%
          </strong>

          {% if block.settings.sold_text != blank %}
            <span>{{ block.settings.sold_text }}</span>
          {% endif %}
        </div>

      </div>

      <div class="avonent-sold-meter__editor-note">
        Preview only. Enable Shopify inventory tracking on this
        product variant for the live percentage to calculate
        automatically.
      </div>

    </div>

  {% endif %}
</div>

{% stylesheet %}

  .avonent-sold-meter {
    width: 100%;

    padding-top:
      var(--av-sm-top-space);

    padding-bottom:
      var(--av-sm-bottom-space);
  }


  .avonent-sold-meter__card,
  .avonent-sold-meter__preview {
    width: 100%;

    padding:
      var(--av-sm-padding-y)
      var(--av-sm-padding-x);

    box-sizing: border-box;

    background:
      var(--av-sm-background);

    border:
      1px solid
      var(--av-sm-border);

    border-radius:
      var(--av-sm-radius);
  }


  .avonent-sold-meter__heading {
    margin: 0 0 9px;

    font-family:
      var(--font-body--family);

    font-size: 12px;

    font-weight: 600;

    line-height: 1.2;

    color:
      var(--av-sm-text);
  }


  .avonent-sold-meter__row {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 14px;

    width: 100%;
  }


  .avonent-sold-meter__track {
    position: relative;

    width: 100%;

    height:
      var(--av-sm-bar-height);

    overflow: hidden;

    background:
      var(--av-sm-track);

    border-radius:
      999px;
  }


  .avonent-sold-meter__fill {
    position: absolute;

    inset:
      0
      auto
      0
      0;

    display: block;

    width: 0;

    height: 100%;

    background:
      var(--av-sm-fill);

    border-radius:
      inherit;

    transition:
      width 300ms ease;
  }


  .avonent-sold-meter__value {
    display: flex;

    align-items: baseline;

    gap: 4px;

    white-space: nowrap;

    color:
      var(--av-sm-fill);

    font-family:
      var(--font-body--family);

    line-height: 1;
  }


  .avonent-sold-meter__value strong {
    font-size: 14px;

    font-weight: 700;

    letter-spacing:
      -0.02em;
  }


  .avonent-sold-meter__value span {
    font-size: 12px;

    font-weight: 600;
  }


  .avonent-sold-meter__subtext {
    margin-top: 7px;

    font-family:
      var(--font-body--family);

    font-size: 10px;

    line-height: 1.35;

    color:
      var(--av-sm-text);

    opacity: 0.65;
  }


  .avonent-sold-meter__editor-note {
    margin-top: 8px;

    font-family:
      var(--font-body--family);

    font-size: 9px;

    line-height: 1.35;

    color:
      var(--av-sm-text);

    opacity: 0.55;
  }


  @media screen and (max-width: 749px) {

    .avonent-sold-meter__card,
    .avonent-sold-meter__preview {
      padding:
        max(10px, var(--av-sm-padding-y))
        max(12px, var(--av-sm-padding-x));
    }


    .avonent-sold-meter__heading {
      margin-bottom: 8px;

      font-size: 11px;
    }


    .avonent-sold-meter__row {
      gap: 10px;
    }


    .avonent-sold-meter__value strong {
      font-size: 13px;
    }


    .avonent-sold-meter__value span {
      font-size: 11px;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "Avonent % Sold Bar",
  "tag": null,

  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "sold_text",
      "label": "Text after percentage",
      "default": "Sold"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Small text underneath",
      "default": ""
    },

    {
      "type": "header",
      "content": "Inventory calculation"
    },
    {
      "type": "number",
      "id": "starting_inventory",
      "label": "Starting inventory",
      "default": 100,
      "info": "Set this to the inventory quantity at the start of the promotion. The sold percentage is calculated using the product's live Shopify inventory."
    },
    {
      "type": "range",
      "id": "editor_preview_percent",
      "label": "Theme editor preview",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 76,
      "info": "Only used for preview when the selected product does not have inventory tracking enabled."
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7FCFD"
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Empty bar",
      "default": "#DCEEF3"
    },
    {
      "type": "color",
      "id": "fill_color",
      "label": "Filled bar",
      "default": "#02C6EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E3EEF1"
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar thickness",
      "min": 5,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner roundness",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Inside vertical padding",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Inside horizontal padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],

  "presets": [
    {
      "name": "Avonent % Sold Bar",
      "category": "Product"
    }
  ]
}
{% endschema %}

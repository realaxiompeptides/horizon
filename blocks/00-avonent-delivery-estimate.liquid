      "default": "Soon",
      "info": "Shown briefly before the dynamic delivery date loads."
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "·"
    },
    {
      "type": "text",
      "id": "shipping_text",

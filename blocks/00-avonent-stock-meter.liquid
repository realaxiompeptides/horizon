{% doc %}
  Avonent stock meter.

  Displays an editable percentage-sold progress bar.
  Supports either a manually entered percentage or
  a percentage calculated from Shopify variant inventory.
{% enddoc %}

{% liquid
  assign av_product = closest.product | default: product
  assign av_variant = av_product.selected_or_first_available_variant

  assign sold_percent = block.settings.manual_percent
  assign inventory_tracked = false

  if sold_percent == blank
    assign sold_percent = 76
  endif

  if block.settings.calculation_mode == 'inventory'
    if av_variant != blank and av_variant.inventory_management != blank

      assign inventory_tracked = true

      assign current_inventory = av_variant.inventory_quantity
      assign starting_inventory = block.settings.starting_inventory

      if current_inventory == blank
        assign current_inventory = 0
      endif

      if starting_inventory == blank or starting_inventory < 1
        assign starting_inventory = 100
      endif

      assign sold_units = starting_inventory | minus: current_inventory

      if sold_units < 0
        assign sold_units = 0
      endif

      assign sold_percent = sold_units
        | times: 100.0
        | divided_by: starting_inventory
        | round

    endif
  endif

  if sold_percent < 0
    assign sold_percent = 0
  endif

  if sold_percent > 100
    assign sold_percent = 100
  endif
%}

<div
  class="avonent-stock-meter"
  {{ block.shopify_attributes }}
  style="
    --avsm-background: {{ block.settings.background_color }};
    --avsm-track: {{ block.settings.track_color }};
    --avsm-fill: {{ block.settings.fill_color }};
    --avsm-text: {{ block.settings.text_color }};
    --avsm-border: {{ block.settings.border_color }};
    --avsm-radius: {{ block.settings.corner_radius }}px;
    --avsm-bar-height: {{ block.settings.bar_height }}px;
    --avsm-padding-y: {{ block.settings.padding_y }}px;
    --avsm-padding-x: {{ block.settings.padding_x }}px;
    --avsm-space-top: {{ block.settings.spacing_top }}px;
    --avsm-space-bottom: {{ block.settings.spacing_bottom }}px;
  "
>
  <div class="avonent-stock-meter__card">

    {% if block.settings.heading != blank %}
      <div class="avonent-stock-meter__heading">
        {{ block.settings.heading }}
      </div>
    {% endif %}

    <div class="avonent-stock-meter__row">

      <div
        class="avonent-stock-meter__track"
        role="progressbar"
        aria-label="{{ sold_percent }} percent sold"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ sold_percent }}"
      >
        <span
          class="avonent-stock-meter__fill"
          style="width: {{ sold_percent }}%;"
        ></span>
      </div>

      <div class="avonent-stock-meter__value">
        <strong>{{ sold_percent }}%</strong>

        {% if block.settings.sold_text != blank %}
          <span>
            {{ block.settings.sold_text }}
          </span>
        {% endif %}
      </div>

    </div>

    {% if block.settings.subtext != blank %}
      <div class="avonent-stock-meter__subtext">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if request.design_mode %}
      {% if block.settings.calculation_mode == 'inventory' and inventory_tracked == false %}
        <div class="avonent-stock-meter__editor-note">
          Inventory calculation is enabled, but this product
          variant is not currently tracking inventory.
          Enable “Track quantity” on the variant or switch
          this block to Manual percentage.
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>

{% stylesheet %}

  /*
   * AVONENT STOCK METER
   */

  .avonent-stock-meter {
    display: block;

    width: 100%;

    box-sizing: border-box;

    padding-top:
      var(--avsm-space-top);

    padding-bottom:
      var(--avsm-space-bottom);
  }


  /*
   * CARD
   */

  .avonent-stock-meter__card {
    width: 100%;

    box-sizing: border-box;

    padding:
      var(--avsm-padding-y)
      var(--avsm-padding-x);

    background:
      var(--avsm-background);

    border:
      1px solid
      var(--avsm-border);

    border-radius:
      var(--avsm-radius);
  }


  /*
   * OPTIONAL HEADING
   */

  .avonent-stock-meter__heading {
    margin:
      0
      0
      9px;

    color:
      var(--avsm-text);

    font-family:
      var(--font-body--family);

    font-size:
      12px;

    font-weight:
      600;

    line-height:
      1.2;
  }


  /*
   * PROGRESS ROW
   */

  .avonent-stock-meter__row {
    display:
      grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items:
      center;

    gap:
      14px;

    width:
      100%;
  }


  /*
   * PROGRESS TRACK
   */

  .avonent-stock-meter__track {
    position:
      relative;

    width:
      100%;

    height:
      var(--avsm-bar-height);

    overflow:
      hidden;

    background:
      var(--avsm-track);

    border-radius:
      999px;
  }


  /*
   * PROGRESS FILL
   */

  .avonent-stock-meter__fill {
    position:
      absolute;

    inset:
      0
      auto
      0
      0;

    display:
      block;

    height:
      100%;

    background:
      var(--avsm-fill);

    border-radius:
      inherit;

    transition:
      width
      300ms
      ease;
  }


  /*
   * PERCENTAGE
   */

  .avonent-stock-meter__value {
    display:
      flex;

    align-items:
      baseline;

    gap:
      4px;

    color:
      var(--avsm-fill);

    font-family:
      var(--font-body--family);

    line-height:
      1;

    white-space:
      nowrap;
  }


  .avonent-stock-meter__value strong {
    font-size:
      14px;

    font-weight:
      700;

    letter-spacing:
      -0.02em;
  }


  .avonent-stock-meter__value span {
    font-size:
      12px;

    font-weight:
      600;
  }


  /*
   * SUPPORTING TEXT
   */

  .avonent-stock-meter__subtext {
    margin-top:
      7px;

    color:
      var(--avsm-text);

    font-family:
      var(--font-body--family);

    font-size:
      10px;

    line-height:
      1.35;

    opacity:
      0.68;
  }


  /*
   * THEME EDITOR MESSAGE
   */

  .avonent-stock-meter__editor-note {
    margin-top:
      9px;

    padding-top:
      8px;

    border-top:
      1px dashed
      var(--avsm-border);

    color:
      var(--avsm-text);

    font-family:
      var(--font-body--family);

    font-size:
      10px;

    line-height:
      1.4;

    opacity:
      0.62;
  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    .avonent-stock-meter__row {
      gap:
        10px;
    }

    .avonent-stock-meter__value strong {
      font-size:
        13px;
    }

    .avonent-stock-meter__value span {
      font-size:
        11px;
    }

  }

{% endstylesheet %}

{% schema %}
{
  "name": "Avonent Stock Meter",
  "tag": null,

  "settings": [
    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },

    {
      "type": "text",
      "id": "sold_text",
      "label": "Text after percentage",
      "default": "Sold"
    },

    {
      "type": "text",
      "id": "subtext",
      "label": "Small text underneath"
    },

    {
      "type": "header",
      "content": "Percentage"
    },

    {
      "type": "select",
      "id": "calculation_mode",
      "label": "Calculation mode",
      "options": [
        {
          "value": "manual",
          "label": "Manual percentage"
        },
        {
          "value": "inventory",
          "label": "Calculate from Shopify inventory"
        }
      ],
      "default": "manual"
    },

    {
      "type": "range",
      "id": "manual_percent",
      "label": "Percentage sold",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 76,
      "visible_if": "{{ block.settings.calculation_mode == 'manual' }}"
    },

    {
      "type": "number",
      "id": "starting_inventory",
      "label": "Starting inventory",
      "default": 100,
      "info": "Used only in inventory mode. Enter the real quantity available at the beginning of the promotion.",
      "visible_if": "{{ block.settings.calculation_mode == 'inventory' }}"
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7FCFD"
    },

    {
      "type": "color",
      "id": "track_color",
      "label": "Empty bar",
      "default": "#DCEEF3"
    },

    {
      "type": "color",
      "id": "fill_color",
      "label": "Filled bar",
      "default": "#02C6EA"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E3EEF1"
    },

    {
      "type": "header",
      "content": "Appearance"
    },

    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar thickness",
      "min": 5,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },

    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner roundness",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding_y",
      "label": "Inside vertical padding",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "padding_x",
      "label": "Inside horizontal padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],

  "presets": [
    {
      "name": "Avonent Stock Meter",
      "category": "Product"
    }
  ]
}
{% endschema %}

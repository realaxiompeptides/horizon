<div
  class="avonent-benefits"
  {{ block.shopify_attributes }}
  style="
    --avb-icon: {{ block.settings.icon_color }};
    --avb-text: {{ block.settings.text_color }};
    --avb-bg: {{ block.settings.background_color }};
    --avb-radius: {{ block.settings.corner_radius }}px;
    --avb-icon-size: {{ block.settings.icon_size }}px;
    --avb-text-size: {{ block.settings.text_size }}px;
    --avb-row-gap: {{ block.settings.row_gap }}px;
    --avb-column-gap: {{ block.settings.column_gap }}px;
    --avb-padding-y: {{ block.settings.padding_y }}px;
    --avb-padding-x: {{ block.settings.padding_x }}px;
    --avb-top: {{ block.settings.spacing_top }}px;
    --avb-bottom: {{ block.settings.spacing_bottom }}px;
    --avb-columns-desktop: {{ block.settings.columns_desktop }};
    --avb-columns-mobile: {{ block.settings.columns_mobile }};
  "
>
  <div class="avonent-benefits__inner">

    {% for i in (1..8) %}

      {% liquid
        assign enabled_key = 'benefit_' | append: i | append: '_enabled'
        assign text_key = 'benefit_' | append: i | append: '_text'
        assign icon_key = 'benefit_' | append: i | append: '_icon'

        assign enabled = block.settings[enabled_key]
        assign benefit_text = block.settings[text_key]
        assign icon = block.settings[icon_key]
      %}

      {% if enabled and benefit_text != blank %}

        <div class="avonent-benefits__item">

          <span class="avonent-benefits__icon">

            {% case icon %}

              {% when 'bolt' %}
                <svg viewBox="0 0 24 24">
                  <path d="M13.2 2L5 13h6l-.8 9L19 10h-6l.2-8z"/>
                </svg>

              {% when 'heart' %}
                <svg viewBox="0 0 24 24">
                  <path d="M12 21s-7.5-4.4-9.5-9.2C.7 7.5 3.2 4 7 4c2.2 0 4 1.2 5 2.8C13 5.2 14.8 4 17 4c3.8 0 6.3 3.5 4.5 7.8C19.5 16.6 12 21 12 21z"/>
                </svg>

              {% when 'shield' %}
                <svg viewBox="0 0 24 24">
                  <path d="M12 2l8 3v6c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5l8-3zm0 3.1L7 7v4c0 3.4 2 6.4 5 7.8 3-1.4 5-4.4 5-7.8V7l-5-1.9z"/>
                </svg>

              {% when 'shield_check' %}
                <svg viewBox="0 0 24 24">
                  <path d="M12 2l8 3v6c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5l8-3zm-1.2 13.5l5.5-5.5-1.6-1.6-3.9 3.9-1.9-1.9-1.6 1.6 3.5 3.5z"/>
                </svg>

              {% when 'gut' %}
                <svg viewBox="0 0 24 24">
                  <path d="M9 2v5c0 1.7 1.3 3 3 3s3 1.3 3 3v2a2 2 0 01-4 0v-1H8v1a5 5 0 0010 0v-2c0-3.3-2.7-6-6-6V2H9zm-4 8v6c0 3.3 2.7 6 6 6h1v-3h-1a3 3 0 01-3-3v-6H5z"/>
                </svg>

              {% when 'activity' %}
                <svg viewBox="0 0 24 24">
                  <path d="M2 13h5l2-7 4 13 2-6h7v-2h-5.5L13 3 9 16l-1.5-5H2z"/>
                </svg>

              {% when 'brain' %}
                <svg viewBox="0 0 24 24">
                  <path d="M9 3a4 4 0 00-4 4v.5A4.5 4.5 0 004 16a4 4 0 004 4h1V3zm6 0v17h1a4 4 0 004-4 4.5 4.5 0 00-1-8.5V7a4 4 0 00-4-4z"/>
                </svg>

              {% when 'leaf' %}
                <svg viewBox="0 0 24 24">
                  <path d="M20.9 3.1C13 3.2 6.5 5.9 4.2 10.4c-1.5 3-.8 6.2 1.3 8.3L3 21.2l1.8 1.8 2.5-2.5c2.2 1.4 5 1.5 7.5.1 4.4-2.5 6.2-9.2 6.1-17.5z"/>
                </svg>

              {% when 'moon' %}
                <svg viewBox="0 0 24 24">
                  <path d="M20.8 15.5A8.5 8.5 0 018.5 3.2 9.5 9.5 0 1020.8 15.5z"/>
                </svg>

              {% when 'sun' %}
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M11 1h2v4h-2zM11 19h2v4h-2zM1 11h4v2H1zM19 11h4v2h-4z"/>
                </svg>

              {% when 'droplet' %}
                <svg viewBox="0 0 24 24">
                  <path d="M12 2S5.5 9.5 5.5 15a6.5 6.5 0 0013 0C18.5 9.5 12 2 12 2z"/>
                </svg>

              {% when 'sparkle' %}
                <svg viewBox="0 0 24 24">
                  <path d="M12 2l1.7 5.1L19 9l-5.3 1.9L12 16l-1.7-5.1L5 9l5.3-1.9L12 2z"/>
                </svg>

              {% when 'flame' %}
                <svg viewBox="0 0 24 24">
                  <path d="M13.5 2c.5 4-2.7 5.4-4.2 8.1-.8 1.5-.4 3.1.8 4.1-.1-2.1 1.2-3.5 2.5-4.9 2.2 2.2 4.2 4.3 4.2 7.3a4.8 4.8 0 01-9.6 0c0-1.8.7-3.2 1.6-4.6C6.1 14 5 16 5 18a7 7 0 0014 0c0-6-4.1-9.2-5.5-16z"/>
                </svg>

              {% else %}
                <svg viewBox="0 0 24 24">
                  <path d="M9.2 17.6L3.6 12l2.1-2.1 3.5 3.5 9-9 2.2 2.1z"/>
                </svg>

            {% endcase %}

          </span>

          <span class="avonent-benefits__text">
            {{ benefit_text }}
          </span>

        </div>

      {% endif %}

    {% endfor %}

  </div>
</div>

{% stylesheet %}

  .avonent-benefits {
    display: block;
    width: 100%;
    box-sizing: border-box;

    padding-top: var(--avb-top);
    padding-bottom: var(--avb-bottom);
  }

  .avonent-benefits__inner {
    display: grid;

    grid-template-columns:
      repeat(
        var(--avb-columns-desktop),
        minmax(0, 1fr)
      );

    width: 100%;

    box-sizing: border-box;

    gap:
      var(--avb-row-gap)
      var(--avb-column-gap);

    padding:
      var(--avb-padding-y)
      var(--avb-padding-x);

    background: var(--avb-bg);

    border: none;

    border-radius:
      var(--avb-radius);
  }

  .avonent-benefits__item {
    display: flex;
    align-items: center;

    min-width: 0;

    gap: 7px;
  }

  .avonent-benefits__icon {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: var(--avb-icon-size);
    height: var(--avb-icon-size);

    color: var(--avb-icon);
  }

  .avonent-benefits__icon svg {
    display: block;

    width: 100%;
    height: 100%;

    fill: currentColor;
  }

  .avonent-benefits__text {
    min-width: 0;

    color: var(--avb-text);

    font-family: var(--font-body--family);
    font-size: var(--avb-text-size);
    font-weight: 500;

    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {

    .avonent-benefits__inner {
      grid-template-columns:
        repeat(
          var(--avb-columns-mobile),
          minmax(0, 1fr)
        );
    }

    .avonent-benefits__item {
      gap: 6px;
    }

  }

{% endstylesheet %}


{% doc %}
  Avonent bundle quantity selector.

  This block ONLY renders bundle/quantity cards.
  It does NOT render an Add to Cart button.
  It does NOT render free-gift controls or helper headings/text.

  Selecting a card updates Horizon's native product form quantity.
  Optionally, a card can map to an exact Shopify variant title or numeric variant ID.
{% enddoc %}

{% liquid
  assign av_product = closest.product | default: product

  if request.visual_preview_mode and av_product == blank
    assign av_product = collections.all.products.first
  endif

  assign default_variant = av_product.selected_or_first_available_variant
  assign selected_bundle = block.settings.default_bundle | default: '1'
  assign root_id = 'AvonentBundle-' | append: block.id
%}

{% if av_product != blank %}
  <div
    id="{{ root_id }}"
    class="avonent-bundle"
    {{ block.shopify_attributes }}
    style="
      --avb-accent: {{ block.settings.accent_color }};
      --avb-accent-soft: {{ block.settings.selected_background }};
      --avb-text: {{ block.settings.text_color }};
      --avb-muted: {{ block.settings.muted_text_color }};
      --avb-border: {{ block.settings.border_color }};
      --avb-card-bg: {{ block.settings.card_background }};
      --avb-radius: {{ block.settings.card_radius }}px;
      --avb-gap: {{ block.settings.card_gap }}px;
      --avb-top: {{ block.settings.spacing_top }}px;
      --avb-bottom: {{ block.settings.spacing_bottom }}px;
    "
    data-section-id="{{ section.id }}"
  >
    <div
      class="avonent-bundle__options"
      role="radiogroup"
      aria-label="Bundle quantity"
    >
      {% for i in (1..4) %}
        {% liquid
          assign enabled_key = 'bundle_' | append: i | append: '_enabled'
          assign title_key = 'bundle_' | append: i | append: '_title'
          assign subtitle_key = 'bundle_' | append: i | append: '_subtitle'
          assign mapping_key = 'bundle_' | append: i | append: '_variant'
          assign quantity_key = 'bundle_' | append: i | append: '_quantity'
          assign badge_key = 'bundle_' | append: i | append: '_badge'
          assign savings_key = 'bundle_' | append: i | append: '_savings_text'
          assign image_key = 'bundle_' | append: i | append: '_image'

          assign bundle_enabled = block.settings[enabled_key]
          assign bundle_title = block.settings[title_key]
          assign bundle_subtitle = block.settings[subtitle_key]
          assign bundle_mapping = block.settings[mapping_key] | strip
          assign bundle_quantity = block.settings[quantity_key] | default: 1
          assign bundle_badge = block.settings[badge_key]
          assign bundle_savings_override = block.settings[savings_key]
          assign bundle_image_override = block.settings[image_key]

          assign bundle_variant = default_variant

          if bundle_mapping != blank
            for candidate_variant in av_product.variants
              assign candidate_id_string = candidate_variant.id | append: ''
              if candidate_id_string == bundle_mapping or candidate_variant.title == bundle_mapping
                assign bundle_variant = candidate_variant
                break
              endif
            endfor
          endif

          assign one_time_unit = bundle_variant.price
          assign one_time_compare_unit = bundle_variant.compare_at_price
          if one_time_compare_unit == blank or one_time_compare_unit <= one_time_unit
            assign one_time_compare_unit = one_time_unit
          endif

          assign subscription_allocation = bundle_variant.selling_plan_allocations | first
          assign subscription_unit = one_time_unit
          if subscription_allocation != blank
            assign subscription_unit = subscription_allocation.price
          endif

          assign bundle_total = subscription_unit | times: bundle_quantity
          assign bundle_compare_total = one_time_unit | times: bundle_quantity

          assign automatic_savings_percent = 0
          if bundle_compare_total > bundle_total
            assign savings_amount = bundle_compare_total | minus: bundle_total
            assign automatic_savings_percent = savings_amount | times: 100.0 | divided_by: bundle_compare_total | round
          endif

          assign bundle_image = bundle_image_override
          if bundle_image == blank and bundle_variant.featured_media != blank
            assign bundle_image = bundle_variant.featured_media.preview_image
          endif
          if bundle_image == blank
            assign bundle_image = av_product.featured_image
          endif

          assign is_default = false
          assign i_string = i | append: ''
          if i_string == selected_bundle
            assign is_default = true
          endif
        %}

        {% if bundle_enabled %}
          <button
            type="button"
            class="avonent-bundle__option{% if is_default %} is-selected{% endif %}"
            role="radio"
            aria-checked="{% if is_default %}true{% else %}false{% endif %}"
            data-av-bundle-option
            data-bundle-number="{{ i }}"
            data-variant-id="{{ bundle_variant.id }}"
            data-quantity="{{ bundle_quantity }}"
            data-available="{{ bundle_variant.available }}"
            data-subscription-unit="{{ subscription_unit }}"
            data-subscription-compare-unit="{{ one_time_unit }}"
            data-one-time-unit="{{ one_time_unit }}"
            data-one-time-compare-unit="{{ one_time_compare_unit }}"
            {% unless bundle_variant.available %}disabled{% endunless %}
          >
            {% if bundle_badge != blank %}
              <span class="avonent-bundle__badge">
                {{ bundle_badge }}
              </span>
            {% endif %}

            <span class="avonent-bundle__radio" aria-hidden="true">
              <span></span>
            </span>

            {% if block.settings.show_images and bundle_image != blank %}
              <span class="avonent-bundle__image-wrap">
                {{
                  bundle_image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    widths: '60, 90, 120, 180',
                    class: 'avonent-bundle__image',
                    alt: bundle_title
                }}
              </span>
            {% endif %}

            <span class="avonent-bundle__copy">
              <span class="avonent-bundle__title">
                {{ bundle_title }}
              </span>

              {% if bundle_subtitle != blank %}
                <span class="avonent-bundle__subtitle">
                  {{ bundle_subtitle }}
                </span>
              {% endif %}

              {% if bundle_savings_override != blank %}
                <span class="avonent-bundle__savings" data-av-bundle-savings data-custom-text="true">
                  {{ bundle_savings_override }}
                </span>
              {% elsif automatic_savings_percent > 0 %}
                <span class="avonent-bundle__savings" data-av-bundle-savings>
                  Save {{ automatic_savings_percent }}%
                </span>
              {% endif %}
            </span>

            <span class="avonent-bundle__price">
              <strong data-av-bundle-price>{{ bundle_total | money }}</strong>

              {% if bundle_compare_total > bundle_total %}
                <s data-av-bundle-compare>{{ bundle_compare_total | money }}</s>
              {% endif %}

              {% unless bundle_variant.available %}
                <small>Sold out</small>
              {% endunless %}
            </span>
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('{{ root_id }}');
      if (!root || root.dataset.avBundleInitialized === 'true') return;

      root.dataset.avBundleInitialized = 'true';

      const sectionId = root.dataset.sectionId;
      const options = Array.from(root.querySelectorAll('[data-av-bundle-option]'));
      const currencyCode = {{ cart.currency.iso_code | default: shop.currency | json }};
      let purchaseMode = 'subscription';

      function formatMoney(cents) {
        const amount = Number(cents || 0) / 100;

        try {
          return new Intl.NumberFormat(undefined, {
            style: 'currency',
            currency: currencyCode,
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }).format(amount);
        } catch (error) {
          return '$' + amount.toFixed(2);
        }
      }

      function applyPurchaseMode(mode) {
        purchaseMode = mode === 'one_time' ? 'one_time' : 'subscription';

        options.forEach((option) => {
          const quantity = Math.max(1, Number(option.dataset.quantity || 1));
          const unitPrice = Number(
            purchaseMode === 'subscription'
              ? option.dataset.subscriptionUnit
              : option.dataset.oneTimeUnit
          );
          const compareUnit = Number(
            purchaseMode === 'subscription'
              ? option.dataset.subscriptionCompareUnit
              : option.dataset.oneTimeCompareUnit
          );

          const total = unitPrice * quantity;
          const compareTotal = compareUnit * quantity;
          const price = option.querySelector('[data-av-bundle-price]');
          const compare = option.querySelector('[data-av-bundle-compare]');
          const savings = option.querySelector('[data-av-bundle-savings]');

          if (price) price.textContent = formatMoney(total);

          if (compare) {
            const showCompare = compareTotal > total;
            compare.textContent = showCompare ? formatMoney(compareTotal) : '';
            compare.hidden = !showCompare;
          }

          if (savings && !savings.dataset.customText) {
            const percent =
              compareTotal > total
                ? Math.round(((compareTotal - total) / compareTotal) * 100)
                : 0;
            savings.textContent = percent > 0 ? `Save ${percent}%` : '';
            savings.hidden = percent <= 0;
          }
        });

        root.dataset.purchaseMode = purchaseMode;
      }

      function getNativeForm() {
        const section =
          root.closest('.shopify-section') ||
          root.closest('[data-section-id]') ||
          document;

        return (
          section.querySelector('.buy-buttons-block product-form-component form[data-type="add-to-cart-form"]') ||
          document.querySelector(
            `product-form-component[data-section-id="${sectionId}"] form[data-type="add-to-cart-form"]`
          )
        );
      }

      function getNativeQuantityInput(form) {
        return form?.querySelector('input[name="quantity"]');
      }

      function getNativeVariantInput(form) {
        return form?.querySelector('input[name="id"][ref="variantId"], input[name="id"]');
      }

      function setNativeQuantity(quantity) {
        const form = getNativeForm();
        const input = getNativeQuantityInput(form);

        if (!input) return;

        const parsedQuantity = Math.max(1, parseInt(quantity, 10) || 1);

        input.value = String(parsedQuantity);
        input.setAttribute('value', String(parsedQuantity));

        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }

      function setNativeVariant(variantId) {
        if (!variantId) return;

        const form = getNativeForm();
        const input = getNativeVariantInput(form);

        if (!input) return;

        input.value = variantId;
        input.setAttribute('value', variantId);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }

      function selectBundle(option) {
        if (!option || option.disabled) return;

        options.forEach((item) => {
          const selected = item === option;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-checked', selected ? 'true' : 'false');
        });

        setNativeQuantity(option.dataset.quantity);
        setNativeVariant(option.dataset.variantId);
      }

      function syncSelectedBundle() {
        const selected =
          root.querySelector('[data-av-bundle-option].is-selected:not(:disabled)') ||
          options.find((option) => !option.disabled);

        if (selected) selectBundle(selected);
      }

      options.forEach((option) => {
        option.addEventListener('click', () => selectBundle(option));
      });

      // The bundle selector can render before Horizon creates the product form.
      // Synchronize the visually selected bundle immediately before Add to cart,
      // including on the first click after a fresh page load.
      document.addEventListener(
        'click',
        (event) => {
          const addButton = event.target.closest(
            'button[type="submit"][name="add"], button[type="submit"][data-add-to-cart]'
          );
          if (!addButton) return;

          const form = getNativeForm();
          if (!form || !form.contains(addButton)) return;

          syncSelectedBundle();
        },
        true
      );

      document.addEventListener('avonent:purchase-mode-change', (event) => {
        applyPurchaseMode(event.detail?.mode);
      });

      let initial = root.querySelector(
        '[data-av-bundle-option].is-selected:not(:disabled)'
      );

      if (!initial) {
        initial = options.find((option) => !option.disabled);
      }

      applyPurchaseMode('subscription');

      if (initial) {
        selectBundle(initial);
      }

      // Re-apply both price mode and quantity after Horizon/Appstle finish
      // hydrating or replacing product-form inputs.
      [0, 250, 900, 1600].forEach((delay) => {
        window.setTimeout(() => {
          applyPurchaseMode(purchaseMode);
          syncSelectedBundle();
        }, delay);
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .avonent-bundle {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--avb-top);
    padding-bottom: var(--avb-bottom);
    color: var(--avb-text);
  }

  .avonent-bundle__options {
    display: grid;
    gap: var(--avb-gap);
    width: 100%;
  }

  .avonent-bundle__option {
    position: relative;

    display: grid;
    grid-template-columns: 20px 52px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;

    width: 100%;
    min-height: 76px;
    margin: 0;
    padding: 12px 13px;

    appearance: none;
    border: 1px solid var(--avb-border);
    border-radius: var(--avb-radius);
    background: var(--avb-card-bg);
    color: var(--avb-text);

    font: inherit;
    text-align: left;
    cursor: pointer;

    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .avonent-bundle__option:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--avb-accent) 55%, var(--avb-border));
  }

  .avonent-bundle__option.is-selected {
    border-color: var(--avb-accent);
    background: var(--avb-accent-soft);
    box-shadow: 0 0 0 1px var(--avb-accent);
  }

  .avonent-bundle__option:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .avonent-bundle__radio {
    display: grid;
    place-items: center;

    width: 18px;
    height: 18px;

    border: 1.5px solid #AAB4B8;
    border-radius: 50%;
    background: #FFFFFF;
  }

  .avonent-bundle__radio span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: transparent;
  }

  .avonent-bundle__option.is-selected .avonent-bundle__radio {
    border-color: var(--avb-accent);
  }

  .avonent-bundle__option.is-selected .avonent-bundle__radio span {
    background: var(--avb-accent);
  }

  .avonent-bundle__image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 52px;
    height: 52px;

    overflow: hidden;

    border-radius: 9px;
    background: #FFFFFF;
  }

  .avonent-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .avonent-bundle__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .avonent-bundle__title {
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.15;
  }

  .avonent-bundle__subtitle {
    margin-top: 3px;

    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.25;

    color: var(--avb-muted);
  }

  .avonent-bundle__savings {
    margin-top: 4px;

    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;

    color: var(--avb-accent);
  }

  .avonent-bundle__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;

    min-width: max-content;

    font-family: var(--font-body--family);
  }

  .avonent-bundle__price strong {
    font-size: 14px;
    font-weight: 750;
    line-height: 1.1;
  }

  .avonent-bundle__price s {
    margin-top: 3px;

    font-size: 11px;
    line-height: 1;

    color: var(--avb-muted);
  }

  .avonent-bundle__price small {
    margin-top: 4px;

    font-size: 10px;
    font-weight: 650;

    color: var(--avb-muted);
  }

  .avonent-bundle__badge {
    position: absolute;
    top: -9px;
    right: 12px;
    z-index: 3;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 19px;
    padding: 2px 10px;

    border-radius: 999px;

    background: var(--avb-accent);
    color: #FFFFFF;

    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;

    white-space: nowrap;
  }

  /*
   * The Avonent bundle cards replace the +/- quantity selector only.
   * Horizon's native Add to Cart button remains untouched.
   */
  .product-details:has(.avonent-bundle) .buy-buttons-block .quantity-selector-wrapper {
    display: none;
  }

  .product-details:has(.avonent-bundle) .buy-buttons-block .product-form-buttons {
    grid-template-columns: 1fr;
  }

  .product-details:has(.avonent-bundle) .buy-buttons-block .add-to-cart-button {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .avonent-bundle__options {
      gap: 9px;
    }

    .avonent-bundle__option {
      grid-template-columns: 18px 44px minmax(0, 1fr) auto;
      gap: 8px;

      min-height: 68px;
      padding: 10px;

      border-radius: 11px;
    }

    .avonent-bundle__image-wrap {
      width: 44px;
      height: 44px;
      border-radius: 8px;
    }

    .avonent-bundle__title {
      font-size: 13px;
    }

    .avonent-bundle__subtitle,
    .avonent-bundle__savings {
      font-size: 10px;
    }

    .avonent-bundle__price strong {
      font-size: 13px;
    }

    .avonent-bundle__price s {
      font-size: 10px;
    }

    .avonent-bundle__badge {
      top: -8px;
      right: 9px;

      min-height: 18px;
      padding-inline: 8px;

      font-size: 9px;
    }

    .product-details:has(.avonent-bundle) .buy-buttons-block {
      margin-top: 2px;
    }

    .product-details:has(.avonent-bundle) .buy-buttons-block .product-form-buttons {
      gap: 8px;
    }

    .product-details:has(.avonent-bundle) .buy-buttons-block .add-to-cart-button {
      min-height: 52px;
    }
  }

  @media screen and (max-width: 370px) {
    .avonent-bundle__option {
      grid-template-columns: 18px 38px minmax(0, 1fr) auto;
      padding-inline: 8px;
    }

    .avonent-bundle__image-wrap {
      width: 38px;
      height: 38px;
    }

    .avonent-bundle__subtitle {
      display: none;
    }
  }
{% endstylesheet %}


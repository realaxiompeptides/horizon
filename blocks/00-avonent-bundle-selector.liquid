{% doc %}
  Avonent bundle selector.

  Controls the quantity used by Horizon's NATIVE buy-buttons block.
  It does not render its own Add to Cart button.

  Each bundle can:
  - Add a chosen quantity of the current product variant.
  - Optionally map to any exact Shopify variant title or numeric variant ID.
  - Show an optional free-gift dropdown.

  The gift dropdown currently records the customer's selection as a line-item
  property on the native product form. A later Avonent gift-cart block can use
  the same selection to add an actual gift product automatically.
{% enddoc %}

{% liquid
  assign av_product = closest.product | default: product

  if request.visual_preview_mode and av_product == blank
    assign av_product = collections.all.products.first
  endif

  assign default_variant = av_product.selected_or_first_available_variant
  assign selected_bundle = block.settings.default_bundle | default: '2'
  assign root_id = 'AvonentBundle-' | append: block.id
%}

{% if av_product != blank %}
  <div
    id="{{ root_id }}"
    class="avonent-bundle"
    {{ block.shopify_attributes }}
    style="
      --avb-accent: {{ block.settings.accent_color }};
      --avb-accent-soft: {{ block.settings.selected_background }};
      --avb-text: {{ block.settings.text_color }};
      --avb-muted: {{ block.settings.muted_text_color }};
      --avb-border: {{ block.settings.border_color }};
      --avb-card-bg: {{ block.settings.card_background }};
      --avb-radius: {{ block.settings.card_radius }}px;
      --avb-gap: {{ block.settings.card_gap }}px;
      --avb-top: {{ block.settings.spacing_top }}px;
      --avb-bottom: {{ block.settings.spacing_bottom }}px;
    "
    data-section-id="{{ section.id }}"
    data-default-bundle="{{ selected_bundle }}"
  >

        {% if block.settings.subheading != blank %}
          <div class="avonent-bundle__subheading">
            {{ block.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="avonent-bundle__options"
      role="radiogroup"
      aria-label="Choose bundle quantity"
    >
      {% for i in (1..4) %}
        {% liquid
          assign enabled_key = 'bundle_' | append: i | append: '_enabled'
          assign title_key = 'bundle_' | append: i | append: '_title'
          assign subtitle_key = 'bundle_' | append: i | append: '_subtitle'
          assign mapping_key = 'bundle_' | append: i | append: '_variant'
          assign quantity_key = 'bundle_' | append: i | append: '_quantity'
          assign badge_key = 'bundle_' | append: i | append: '_badge'
          assign savings_key = 'bundle_' | append: i | append: '_savings_text'
          assign image_key = 'bundle_' | append: i | append: '_image'

          assign bundle_enabled = block.settings[enabled_key]
          assign bundle_title = block.settings[title_key]
          assign bundle_subtitle = block.settings[subtitle_key]
          assign bundle_mapping = block.settings[mapping_key] | strip
          assign bundle_quantity = block.settings[quantity_key] | default: 1
          assign bundle_badge = block.settings[badge_key]
          assign bundle_savings_override = block.settings[savings_key]
          assign bundle_image_override = block.settings[image_key]

          assign bundle_variant = default_variant

          if bundle_mapping != blank
            for candidate_variant in av_product.variants
              assign candidate_id_string = candidate_variant.id | append: ''
              if candidate_id_string == bundle_mapping or candidate_variant.title == bundle_mapping
                assign bundle_variant = candidate_variant
                break
              endif
            endfor
          endif

          assign bundle_total = bundle_variant.price | times: bundle_quantity
          assign compare_unit = bundle_variant.compare_at_price

          if compare_unit == blank or compare_unit <= bundle_variant.price
            assign compare_unit = bundle_variant.price
          endif

          assign bundle_compare_total = compare_unit | times: bundle_quantity
          assign automatic_savings_percent = 0

          if bundle_compare_total > bundle_total
            assign savings_amount = bundle_compare_total | minus: bundle_total
            assign automatic_savings_percent = savings_amount | times: 100.0 | divided_by: bundle_compare_total | round
          endif

          assign bundle_image = bundle_image_override

          if bundle_image == blank and bundle_variant.featured_media != blank
            assign bundle_image = bundle_variant.featured_media.preview_image
          endif

          if bundle_image == blank
            assign bundle_image = av_product.featured_image
          endif

          assign is_default = false
          assign i_string = i | append: ''

          if i_string == selected_bundle
            assign is_default = true
          endif
        %}

        {% if bundle_enabled %}
          <div
            class="avonent-bundle__option-shell{% if is_default %} is-selected{% endif %}"
            data-av-bundle-shell
            data-bundle-number="{{ i }}"
          >
            <button
              type="button"
              class="avonent-bundle__option"
              role="radio"
              aria-checked="{% if is_default %}true{% else %}false{% endif %}"
              data-av-bundle-option
              data-bundle-number="{{ i }}"
              data-variant-id="{{ bundle_variant.id }}"
              data-quantity="{{ bundle_quantity }}"
              data-available="{{ bundle_variant.available }}"
              {% unless bundle_variant.available %}disabled{% endunless %}
            >
              {% if bundle_badge != blank %}
                <span class="avonent-bundle__badge">
                  {{ bundle_badge }}
                </span>
              {% endif %}

              <span class="avonent-bundle__radio" aria-hidden="true">
                <span></span>
              </span>

              {% if block.settings.show_images and bundle_image != blank %}
                <span class="avonent-bundle__image-wrap">
                  {{
                    bundle_image
                    | image_url: width: 180
                    | image_tag:
                      loading: 'lazy',
                      widths: '60, 90, 120, 180',
                      class: 'avonent-bundle__image',
                      alt: bundle_title
                  }}
                </span>
              {% endif %}

              <span class="avonent-bundle__copy">
                <span class="avonent-bundle__title">
                  {{ bundle_title }}
                </span>

                {% if bundle_subtitle != blank %}
                  <span class="avonent-bundle__subtitle">
                    {{ bundle_subtitle }}
                  </span>
                {% endif %}

                {% if bundle_savings_override != blank %}
                  <span class="avonent-bundle__savings">
                    {{ bundle_savings_override }}
                  </span>
                {% elsif automatic_savings_percent > 0 %}
                  <span class="avonent-bundle__savings">
                    Save {{ automatic_savings_percent }}%
                  </span>
                {% endif %}
              </span>

              <span class="avonent-bundle__price">
                <strong>{{ bundle_total | money }}</strong>

                {% if bundle_compare_total > bundle_total %}
                  <s>{{ bundle_compare_total | money }}</s>
                {% endif %}

                {% unless bundle_variant.available %}
                  <small>Sold out</small>
                {% endunless %}
              </span>
            </button>
                    {% if gift_2 != blank %}
                      <option value="{{ gift_2 | escape }}">{{ gift_2 }}</option>
                    {% endif %}
                    {% if gift_3 != blank %}
                      <option value="{{ gift_3 | escape }}">{{ gift_3 }}</option>
                    {% endif %}
                  </select>

                  <span class="avonent-bundle__select-chevron" aria-hidden="true">
                    <svg viewBox="0 0 20 20">
                      <path d="M5.5 7.5 10 12l4.5-4.5 1.4 1.4L10 14.8 4.1 8.9z"/>
                    </svg>
                  </span>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('{{ root_id }}');

      if (!root || root.dataset.avBundleInitialized === 'true') return;
      root.dataset.avBundleInitialized = 'true';

      const sectionId = root.dataset.sectionId;
      const shells = Array.from(root.querySelectorAll('[data-av-bundle-shell]'));
      const options = Array.from(root.querySelectorAll('[data-av-bundle-option]'));

      function getNativeForm() {
        const section =
          root.closest('.shopify-section') ||
          root.closest('[data-section-id]') ||
          document;

        return (
          section.querySelector('.buy-buttons-block product-form-component form[data-type="add-to-cart-form"]') ||
          document.querySelector(
            `product-form-component[data-section-id="${sectionId}"] form[data-type="add-to-cart-form"]`
          )
        );
      }

      function getNativeQuantityInput(form) {
        return form?.querySelector('input[name="quantity"]');
      }

      function getNativeVariantInput(form) {
        return form?.querySelector('input[name="id"][ref="variantId"], input[name="id"]');
      }

        return input;
      }

      function setNativeQuantity(quantity) {
        const form = getNativeForm();
        const input = getNativeQuantityInput(form);

        if (!input) return;

        const parsedQuantity = Math.max(1, parseInt(quantity, 10) || 1);

        input.value = String(parsedQuantity);
        input.setAttribute('value', String(parsedQuantity));

        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.dispatchEvent(new Event('blur', { bubbles: true }));
      }

      function setNativeVariant(variantId) {
        if (!variantId) return;

        const form = getNativeForm();
        const input = getNativeVariantInput(form);

        if (!input) return;

        input.value = variantId;
        input.setAttribute('value', variantId);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }

      function selectBundle(option) {
        if (!option || option.disabled) return;

        const number = option.dataset.bundleNumber;
        const shell = root.querySelector(
          `[data-av-bundle-shell][data-bundle-number="${number}"]`
        );

        shells.forEach((item) => {
          item.classList.toggle('is-selected', item === shell);
        });

        options.forEach((item) => {
          const selected = item === option;
          item.setAttribute('aria-checked', selected ? 'true' : 'false');
        });

        setNativeQuantity(option.dataset.quantity);
        setNativeVariant(option.dataset.variantId);
      }

      options.forEach((option) => {
        option.addEventListener('click', () => selectBundle(option));
      });
      });

      let initial = root.querySelector(
        '[data-av-bundle-option][aria-checked="true"]:not(:disabled)'
      );

      if (!initial) {
        initial = options.find((option) => !option.disabled);
      }

      if (initial) selectBundle(initial);

      document.addEventListener('shopify:section:load', () => {
        const selected = root.querySelector(
          '[data-av-bundle-option][aria-checked="true"]:not(:disabled)'
        );
        if (selected) selectBundle(selected);
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .avonent-bundle {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--avb-top);
    padding-bottom: var(--avb-bottom);
    color: var(--avb-text);
  }

  .avonent-bundle__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .avonent-bundle__heading {
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .avonent-bundle__subheading {
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.25;
    color: var(--avb-muted);
    text-align: right;
  }

  .avonent-bundle__options {
    display: grid;
    gap: var(--avb-gap);
    width: 100%;
  }

  .avonent-bundle__option-shell {
    position: relative;
    width: 100%;
    border: 1px solid var(--avb-border);
    border-radius: var(--avb-radius);
    background: var(--avb-card-bg);
    overflow: visible;

    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .avonent-bundle__option-shell.is-selected {
    border-color: var(--avb-accent);
    background: var(--avb-accent-soft);
    box-shadow: 0 0 0 1px var(--avb-accent);
  }

  .avonent-bundle__option {
    position: relative;
    display: grid;
    grid-template-columns: 20px 52px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;

    width: 100%;
    min-height: 76px;
    margin: 0;
    padding: 12px 13px;

    appearance: none;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: var(--avb-text);

    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .avonent-bundle__option:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .avonent-bundle__radio {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 1.5px solid #AAB4B8;
    border-radius: 50%;
    background: #fff;
  }

  .avonent-bundle__radio span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: transparent;
  }

  .avonent-bundle__option-shell.is-selected .avonent-bundle__radio {
    border-color: var(--avb-accent);
  }

  .avonent-bundle__option-shell.is-selected .avonent-bundle__radio span {
    background: var(--avb-accent);
  }

  .avonent-bundle__image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    overflow: hidden;
    border-radius: 9px;
    background: #fff;
  }

  .avonent-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .avonent-bundle__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .avonent-bundle__title {
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.15;
  }

  .avonent-bundle__subtitle {
    margin-top: 3px;
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.25;
    color: var(--avb-muted);
  }

  .avonent-bundle__savings {
    margin-top: 4px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--avb-accent);
  }

  .avonent-bundle__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    min-width: max-content;
    font-family: var(--font-body--family);
  }

  .avonent-bundle__price strong {
    font-size: 14px;
    font-weight: 750;
    line-height: 1.1;
  }

  .avonent-bundle__price s {
    margin-top: 3px;
    font-size: 11px;
    line-height: 1;
    color: var(--avb-muted);
  }

  .avonent-bundle__price small {
    margin-top: 4px;
    font-size: 10px;
    font-weight: 650;
    color: var(--avb-muted);
  }

  .avonent-bundle__badge {
    position: absolute;
    top: -9px;
    right: 12px;
    z-index: 3;

    min-height: 19px;
    padding: 2px 10px;

    display: inline-flex;
    align-items: center;

    border-radius: 999px;
    background: var(--avb-accent);
    color: #fff;

    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  /*
   * The bundle cards ARE the quantity chooser.
   * Keep Horizon's native Add to Cart button, but hide the redundant
   * +/- quantity stepper when this Avonent selector is present.
   */
  .product-details:has(.avonent-bundle) .buy-buttons-block .quantity-selector-wrapper {
    display: none;
  }

  .product-details:has(.avonent-bundle) .buy-buttons-block .product-form-buttons {
    grid-template-columns: 1fr;
  }

  .product-details:has(.avonent-bundle) .buy-buttons-block .add-to-cart-button {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .avonent-bundle__header {
      align-items: center;
      margin-bottom: 9px;
    }

    .avonent-bundle__heading {
      font-size: 15px;
    }

    .avonent-bundle__subheading {
      font-size: 10px;
    }

    .avonent-bundle__options {
      gap: 9px;
    }

    .avonent-bundle__option {
      grid-template-columns: 18px 44px minmax(0, 1fr) auto;
      gap: 8px;
      min-height: 68px;
      padding: 10px;
    }

    .avonent-bundle__image-wrap {
      width: 44px;
      height: 44px;
      border-radius: 8px;
    }

    .avonent-bundle__title {
      font-size: 13px;
    }

    .avonent-bundle__subtitle,
    .avonent-bundle__savings {
      font-size: 10px;
    }

    .avonent-bundle__price strong {
      font-size: 13px;
    }

    .avonent-bundle__price s {
      font-size: 10px;
    }

    .avonent-bundle__badge {
      top: -8px;
      right: 9px;
      min-height: 18px;
      padding-inline: 8px;
      font-size: 9px;
    }


    /*
     * Clean up the native Horizon buying area on mobile while preserving it.
     */
    .product-details:has(.avonent-bundle) .buy-buttons-block {
      margin-top: 2px;
    }

    .product-details:has(.avonent-bundle) .buy-buttons-block .product-form-buttons {
      gap: 8px;
    }

    .product-details:has(.avonent-bundle) .buy-buttons-block .add-to-cart-button {
      min-height: 52px;
    }
  }

  @media screen and (max-width: 370px) {
    .avonent-bundle__option {
      grid-template-columns: 18px 38px minmax(0, 1fr) auto;
      padding-inline: 8px;
    }

    .avonent-bundle__image-wrap {
      width: 38px;
      height: 38px;
    }

    .avonent-bundle__subtitle {
      display: none;
    }
  }
{% endstylesheet %}


      "label": "Small text",
      "default": "More value with multi-packs"
    },
    {
      "type": "select",
      "id": "default_bundle",
      "label": "Selected bundle by default",
      "options": [
        {"value":"1","label":"Bundle 1"},
        {"value":"2","label":"Bundle 2"},
        {"value":"3","label":"Bundle 3"},
        {"value":"4","label":"Bundle 4"}

      "type": "00-avonent-wellness-journey",
      "blocks": {
        "week_1": {
          "type": "week",
          "settings": {
            "title": "Week 1: Build the Routine",
            "points": "<ul><li>Your daily routine starts to feel more intentional</li><li>You learn when the product fits best into your day</li><li>Consistency becomes easier to maintain</li></ul>"
          }
        },
        "week_2": {
          "type": "week",
          "settings": {
            "title": "Week 2: Find Your Rhythm",
            "points": "<ul><li>Your routine starts to feel more automatic</li><li>You can better judge how the product fits your lifestyle</li><li>Staying consistent takes less effort</li></ul>"
          }
        },
        "week_3": {
          "type": "week",
          "settings": {
            "title": "Week 3: Build Momentum",
            "points": "<ul><li>Your daily habit feels established</li><li>You have more context for your own experience</li><li>Consistency becomes part of your normal routine</li></ul>"
          }
        },
        "week_4": {
          "type": "week",
          "settings": {
            "title": "Week 4+: Keep It Going",
            "points": "<ul><li>Keep following the serving directions on the label</li><li>Support your routine with sleep, hydration, and nutrition</li><li>Adjust your routine based on your personal experience</li></ul>"
          }
        }

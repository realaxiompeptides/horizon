        "accordion": {
          "type": "00-avonent-accordion",
          "name": "Avonent Accordion",
          "settings": {
            "open_first": false,
            "item_1_enabled": true,
            "item_1_title": "Description",
            "item_1_content": "<p><strong>Avonent Advanced Digestive Complex</strong> is a comprehensive 10-in-1 formula designed to support digestion from multiple angles. Each two-capsule serving delivers 1,015 mg of targeted digestive support, including 500 mg of artichoke leaf extract, a 300 mg botanical blend, 125 mg of ox bile, 50 mg of DigeZyme® multi-enzyme complex, and 40 mg of slippery elm bark extract.</p><p>Instead of relying on a single enzyme, this formula combines digestive enzymes, bile support, and soothing botanicals to help your body process everyday meals more comfortably. DigeZyme® helps break down proteins, fats, carbohydrates, fiber, and lactose, while artichoke and ox bile support normal bile activity and the digestion of dietary fats.</p><p>Slippery elm and complementary botanicals round out the formula with gentle digestive support—giving you a complete daily routine for digestive comfort, balance, and consistency.</p>",
            "item_2_enabled": true,
            "item_2_title": "Benefits",
            "item_2_content": "<ul><li><strong>More comfortable digestion:</strong> supports digestive comfort before and after everyday meals.</li><li><strong>Complete food breakdown:</strong> helps digest proteins, fats, carbohydrates, fiber, and lactose.</li><li><strong>Targeted fat digestion:</strong> supports normal bile activity and the breakdown of dietary fats.</li><li><strong>Less post-meal heaviness:</strong> helps ease occasional bloating, gas, and uncomfortable fullness.</li><li><strong>Liver and gallbladder support:</strong> supports normal digestive function involving the liver, bile, and gallbladder.</li><li><strong>Daily digestive balance:</strong> promotes regularity and healthy everyday digestive function.</li><li><strong>Better nutrient breakdown:</strong> supports the digestive process your body uses to access nutrients from food.</li><li><strong>Simple 10-in-1 support:</strong> combines multiple digestive ingredients in one convenient two-capsule serving.</li></ul>",
            "item_3_enabled": true,
            "item_3_title": "Recommended Use",
            "item_3_content": "<p><strong>Take 2 capsules daily</strong> with water, preferably with a meal. Taking the capsules shortly before or with food allows the formula to support the digestive process when you need it most.</p><p>Use consistently as part of your daily wellness routine, and do not exceed the suggested serving.</p>",
            "item_4_enabled": true,
            "item_4_title": "Do You Offer a Guarantee?",
            "item_4_content": "<p>Yes! All Avonent orders are backed by our 30-day satisfaction guarantee.</p><p>If you're not completely satisfied, contact our support team and we'll review your order and help make it right according to our refund policy.</p>",
            "item_5_enabled": false,
            "item_5_title": "Ingredients",
            "item_5_content": "<p>Add ingredient information here.</p>",
            "item_6_enabled": false,
            "item_6_title": "Shipping",
            "item_6_content": "<p>Add shipping information here.</p>",

    "avonent_customer_reviews": {
      "type": "00-avonent-customer-reviews",
      "blocks": {
        "review_Cx36Nk": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "One bottle replaced my complicated routine",
            "review": "I used to take multiple digestive products depending on what I ate, which got expensive and confusing. This gives me enzymes, botanicals, and bile support together in one formula. I’ve been feeling better after meals, and it’s much easier to stay consistent when everything is in one bottle. Already ordered another one.",
            "customer_name": "Kevin D.",
            "verified": true,
            "date": "August 19, 2026",
            "tag_1": "Good Formula",
            "tag_2": "Easy Routine"
          }
        },
        "review_8LK8CK": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "I don’t feel so heavy after meals anymore",
            "review": "I’ve tried a few digestive supplements, but most of them either did nothing or were annoying to keep up with. After taking this consistently, I noticed I wasn’t feeling nearly as heavy and uncomfortable after dinner. My stomach just feels calmer overall. It’s become one of those supplements I actually remember to take every day.",
            "customer_name": "Jordan M.",
            "verified": true,
            "date": "August 3, 2026",
            "tag_1": "Less Bloating",
            "tag_2": "Digestive Comfort"
          }
        },
        "review_XTXXjQ": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Finally feeling more regular",
            "review": "Not to overshare, but regularity has always been a struggle for me. About two weeks into using Avonent, things started feeling much more consistent and predictable. I also like that it combines several ingredients instead of making me buy a bunch of separate supplements. Definitely keeping this in my routine.",
            "customer_name": "Brian T.",
            "verified": true,
            "date": "August 7, 2026",
            "tag_1": "Daily Regularity",
            "tag_2": "Gut Balance"
          }
        },
        "review_r4U3Cb": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "A noticeable difference after heavier meals",
            "review": "Heavy or fatty meals used to leave me feeling uncomfortable for hours. Since adding this to my routine, I’ve noticed those meals feel much easier on my stomach. I specifically liked seeing digestive enzymes and ox bile included in the formula. The capsules are easy to take and haven’t bothered my stomach at all.",
            "customer_name": "Ashley R.",
            "verified": true,
            "date": "August 11, 2026",
            "tag_1": "Meal Support",
            "tag_2": "Fat Digestion"
          }
        },
        "review_xR9fam": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "My stomach feels calmer throughout the day",
            "review": "I bought this because I was tired of feeling bloated and off after almost every meal. I wasn’t expecting an overnight miracle, but after staying consistent for a couple of weeks, I realized my stomach had been feeling noticeably calmer. I’m also not dealing with that uncomfortable full feeling as often. Very happy I gave it a try.",
            "customer_name": "Rachel M.",
            "verified": true,
            "date": "August 15, 2026",
            "tag_1": "Bloat Support",
            "tag_2": "Daily Comfort"
          }
        }
      },

        "accordion": {
          "type": "00-avonent-accordion",
          "name": "Avonent Accordion",
          "settings": {
            "open_first": false,
            "item_1_enabled": true,
            "item_1_title": "What It Is",
            "item_1_content": "<p><strong>Avonent Berberine + Ceylon Cinnamon</strong> is a three-ingredient metabolic-support formula built around 1,200 mg of true Ceylon cinnamon, 400 mg of Berberine HCl, and 200 mg of MCT oil per daily serving.</p><p>Each bottle contains 120 softgels. A full serving is 4 softgels, giving you exactly 30 daily servings per bottle.</p>",
            "item_2_enabled": true,
            "item_2_title": "Formula Benefits",
            "item_2_content": "<ul><li><strong>Healthy glucose metabolism:</strong> Ceylon cinnamon and berberine are included to support normal metabolic function as part of a balanced lifestyle.*</li><li><strong>True Ceylon cinnamon:</strong> Cinnamomum verum, not common cassia.</li><li><strong>Berberine HCl:</strong> a widely studied botanical compound used in metabolic-wellness formulas.</li><li><strong>MCT oil softgel base:</strong> a convenient oil-based format for everyday use.</li><li><strong>Simple monthly routine:</strong> 30 servings per bottle.</li></ul><p>*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>",
            "item_3_enabled": true,
            "item_3_title": "Recommended Use",
            "item_3_content": "<p><strong>Serving size: 4 softgels daily.</strong> Follow the directions on the product label and do not exceed the suggested serving.</p><p><strong>Important:</strong> Berberine can interact with medications. Talk with a qualified healthcare professional before use if you take prescription medication, are pregnant or nursing, or have a medical condition.</p>",
            "item_4_enabled": true,
            "item_4_title": "30-Day Guarantee",
            "item_4_content": "<p>Your order is covered by Avonent's 30-day satisfaction guarantee. If you are not satisfied, contact support within 30 days and we will help according to the refund policy.</p>",
            "item_5_enabled": true,
            "item_5_title": "Ingredients",
            "item_5_content": "<p><strong>Per daily serving (4 softgels):</strong> Ceylon Cinnamon 1,200 mg, Berberine HCl 400 mg, and MCT Oil 200 mg.</p>",
            "item_6_enabled": true,
            "item_6_title": "Supply",
            "item_6_content": "<p>Each bottle contains 120 softgels. At 4 softgels per daily serving, one bottle provides 30 servings — a full 30-day supply.</p>",
            "text_color": "#111111",
            "muted_text_color": "#444444",

    "avonent_faq_mCxfYk": {
      "type": "avonent-faq",
      "blocks": {
        "faq_tcHqcn": {
          "type": "faq",
          "settings": {
            "question": "What is Avonent Berberine + Ceylon Cinnamon?",
            "answer": "<p>It is a three-ingredient softgel formula with Ceylon cinnamon, Berberine HCl, and MCT oil, designed to support healthy glucose metabolism and general metabolic wellness as part of a balanced lifestyle.*</p>"
          }
        },
        "faq_BHckdg": {
          "type": "faq",
          "settings": {
            "question": "What is in each daily serving?",
            "answer": "<p>Each 4-softgel daily serving provides 1,200 mg Ceylon cinnamon, 400 mg Berberine HCl, and 200 mg MCT oil.</p>"
          }
        },
        "faq_iRYHGm": {
          "type": "faq",
          "settings": {
            "question": "Why Ceylon cinnamon instead of common cassia?",
            "answer": "<p>Ceylon cinnamon is Cinnamomum verum, often called true cinnamon. It is naturally much lower in coumarin than common cassia cinnamon and gives the formula a clearly identified cinnamon source.</p>"
          }
        },
        "faq_Bca8ym": {
          "type": "faq",
          "settings": {
            "question": "How do I take it?",
            "answer": "<p>The serving size is 4 softgels daily. Follow the directions on the label and do not exceed the suggested serving.</p>"
          }
        },
        "faq_WCe6tR": {
          "type": "faq",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "<p>Each bottle contains 120 softgels. At 4 softgels per daily serving, that equals 30 servings — a full 30-day supply.</p>"
          }
        },
        "faq_L88rQi": {
          "type": "faq",
          "settings": {
            "question": "Can I take this with medications?",
            "answer": "<p>Berberine can interact with medications. Speak with a qualified healthcare professional before use if you take prescription medication, are pregnant or nursing, or have a medical condition.</p>"
          }
        },
        "faq_XLnfyJ": {
          "type": "faq",
          "settings": {
            "question": "Is this a subscription product?",
            "answer": "<p>The bottle is designed as a 30-day supply. Subscription availability is shown on the purchase options when a recurring plan is enabled for the product.</p>"
          }
        },
        "faq_YnLFVE": {
          "type": "faq",
          "settings": {
            "question": "What is the return policy?",
            "answer": "<p>Avonent offers a 30-day satisfaction guarantee. Contact support within 30 days and we will help according to the current refund policy.</p>"
          }
        },
        "faq_irXchY": {
          "type": "faq",
          "settings": {
            "question": "Where does Avonent ship?",
            "answer": "<p>Available shipping options, costs, and estimated delivery timing are shown at checkout before you place your order.</p>"
          }
        }
      },

{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}
{% render 'cart-typography-styles' %}

<div class="cart-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <span class="cart-totals__item cart-totals__original">
        <span class="cart-totals__original-label">
          {{ 'content.cart_subtotal' | t }}
        </span>

        <span
          class="cart-totals__original-value cart-secondary-typography"
          data-testid="cart-subtotal-value"
        >
          {{- cart.items_subtotal_price | money -}}
        </span>
      </span>

      <ul
        class="cart-discounts"
        role="list"
        aria-label="{{ 'content.discounts' | t }}"
      >
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="cart-discounts__item">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount.title | escape }}
            </span>

            <span class="cart-discounts__value cart-secondary-typography">
              -{{ discount.total_allocated_amount | money -}}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>


  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">

      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>

                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}

          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}


      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}


      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'

          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor

          assign discount_codes = discount_codes | uniq

          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        %}

        {% capture cart_discount_accordion_children %}
          <details
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">
                {{ 'content.discount' | t }}
              </span>

              <span class="cart-totals__icon">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>

            <div class="details-content">
              <div id="cart-discount-disclosure">

                <cart-discount-component
                  {% if section_id != blank %}
                    data-section-id="{{ section_id }}"
                  {% endif %}
                >
                  <div class="cart-discount__content">

                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>

                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                        data-skip-node-update
                      >

                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>

                  </div>

                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>

                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>

                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>

                  <ul class="cart-discount__codes">
                    {% for discount_code in discount_codes %}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          {{ discount_code }}
                        </p>

                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>

                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}

        {% render 'accordion-custom-component',
          children: cart_discount_accordion_children,
          class: 'cart-discount'
        %}
      {% endif %}

    </div>
  {% endif %}


  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif
  -%}


  <div class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}">

    <span
      class="cart-totals__item cart-totals__total"
      role="status"
    >
      <span class="cart-totals__total-label cart-primary-typography">
        {{ 'content.cart_estimated_total' | t }}
      </span>

      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart-totals__total-value cart-secondary-typography"
        data-testid="cart-total-value"
        data-cart-subtotal
      >
        {{ total_price }}
      </text-component>
    </span>


    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}


    <div class="cart-totals__item cart-totals__tax-note cart-primary-typography">
      {% render 'tax-info',
        has_discounts_enabled: settings.show_add_discount_code
      %}
    </div>

  </div>
</div>


<div class="cart__ctas avonent-cart-ctas">

  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button avonent-cart-checkout"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >

    <span
      class="avonent-cart-checkout__lock"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24">
        <rect
          x="5"
          y="10"
          width="14"
          height="11"
          rx="2"
        ></rect>

        <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
      </svg>
    </span>

    <span class="button-text">
      Secure Checkout
    </span>

    <span
      class="avonent-cart-checkout__arrow"
      aria-hidden="true"
    >
      →
    </span>

  </button>


  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}
          additional-checkout-buttons--vertical
        {% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}


  {% if section_id contains 'cart-drawer' %}
    <div class="avonent-cart-trust">

      {% if shop.enabled_payment_types.size > 0 %}
        <div
          class="avonent-cart-trust__payments"
          aria-label="Accepted payment methods"
        >
          {% for type in shop.enabled_payment_types %}
            <span class="avonent-cart-trust__payment">
              {{ type | payment_type_svg_tag }}
            </span>
          {% endfor %}
        </div>
      {% endif %}


      <div class="avonent-cart-trust__rating">

        <span
          class="avonent-cart-trust__stars"
          aria-hidden="true"
        >
          ★★★★★
        </span>

        <span class="avonent-cart-trust__rating-copy">
          <strong>10,000+</strong>
          Trusted Customers
        </span>

      </div>


      <div class="avonent-cart-trust__badges">

        <div class="avonent-cart-trust__badge">

          <span class="avonent-cart-trust__icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 3 19 6v5c0 4.8-2.9 8.2-7 10-4.1-1.8-7-5.2-7-10V6z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </span>

          <span class="avonent-cart-trust__badge-text">
            <strong>Secure</strong>
            <small>Checkout</small>
          </span>

        </div>


        <div class="avonent-cart-trust__badge">

          <span class="avonent-cart-trust__icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M9 3h6"></path>
              <path d="M10 3v6l-5 8.2A2.4 2.4 0 0 0 7 21h10a2.4 2.4 0 0 0 2-3.8L14 9V3"></path>
              <path d="M8.5 14h7"></path>
            </svg>
          </span>

          <span class="avonent-cart-trust__badge-text">
            <strong>Third-Party</strong>
            <small>Lab Tested</small>
          </span>

        </div>


        <div class="avonent-cart-trust__badge">

          <span class="avonent-cart-trust__icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M6 3v18"></path>
              <path d="M6 4h10l-2 3 2 3H6"></path>
            </svg>
          </span>

          <span class="avonent-cart-trust__badge-text">
            <strong>Ships From</strong>
            <small>USA</small>
          </span>

        </div>

      </div>

    </div>
  {% endif %}

</div>


{% stylesheet %}

  /*
   * ORIGINAL HORIZON CART STYLES
   */

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }


  /*
   * AVONENT CART DRAWER
   */

  .cart-drawer__summary .avonent-cart-ctas {
    gap: 14px;
  }


  /*
   * CHECKOUT BUTTON
   */

  .cart-drawer__summary .avonent-cart-checkout {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    width: 100%;
    min-height: 56px;

    padding:
      14px
      20px;

    border: 0;
    border-radius: 12px;

    background: #111111;
    color: #ffffff;

    box-shadow: none;

    font-family:
      var(--font-body--family);

    font-size: 14px;
    font-weight: 700;

    line-height: 1;

    letter-spacing: 0.045em;

    text-transform: uppercase;

    transition:
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .cart-drawer__summary
  .avonent-cart-checkout:hover {
    background: #02c6ea;
    color: #071216;

    transform: translateY(-1px);
  }

  .cart-drawer__summary
  .avonent-cart-checkout:disabled {
    opacity: 0.45;

    cursor: not-allowed;

    transform: none;
  }

  .avonent-cart-checkout__lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 17px;

    width: 17px;
    height: 17px;
  }

  .avonent-cart-checkout__lock svg {
    display: block;

    width: 100%;
    height: 100%;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avonent-cart-checkout__arrow {
    font-size: 18px;

    font-weight: 400;

    line-height: 1;
  }


  /*
   * TRUST AREA
   */

  .avonent-cart-trust {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: 100%;

    gap: 14px;

    padding-top: 1px;
  }


  /*
   * PAYMENT ICONS
   */

  .avonent-cart-trust__payments {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    width: 100%;

    gap: 6px;
  }

  .avonent-cart-trust__payment {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 24px;
  }

  .avonent-cart-trust__payment svg {
    display: block;

    width: auto;
    height: 24px;
  }


  /*
   * REVIEW / CUSTOMER PROOF
   */

  .avonent-cart-trust__rating {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    width: 100%;

    gap: 7px;

    font-family:
      var(--font-body--family);
  }

  .avonent-cart-trust__stars {
    color: #02c6ea;

    font-size: 14px;

    line-height: 1;

    letter-spacing: 1px;
  }

  .avonent-cart-trust__rating-copy {
    color: #111111;

    font-size: 12px;
    font-weight: 450;

    line-height: 1.2;
  }

  .avonent-cart-trust__rating-copy strong {
    font-weight: 700;
  }


  /*
   * 3 TRUST ITEMS
   */

  .avonent-cart-trust__badges {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    width: 100%;

    padding-top: 14px;

    border-top:
      1px solid
      #e8ecee;
  }

  .avonent-cart-trust__badge {
    display: flex;
    flex-direction: column;
    align-items: center;

    min-width: 0;

    padding:
      0
      8px;

    text-align: center;
  }

  .avonent-cart-trust__badge +
  .avonent-cart-trust__badge {
    border-left:
      1px solid
      #e8ecee;
  }

  .avonent-cart-trust__icon {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 29px;

    width: 29px;
    height: 29px;

    margin-bottom: 6px;

    border-radius: 50%;

    background:
      #eafaff;

    color:
      #02c6ea;
  }

  .avonent-cart-trust__icon svg {
    display: block;

    width: 15px;
    height: 15px;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avonent-cart-trust__badge-text {
    display: flex;
    flex-direction: column;

    min-width: 0;

    color: #111111;

    font-family:
      var(--font-body--family);

    line-height: 1.2;
  }

  .avonent-cart-trust__badge-text strong {
    font-size: 10px;
    font-weight: 650;
  }

  .avonent-cart-trust__badge-text small {
    margin-top: 2px;

    color: #6d7478;

    font-size: 9px;
    font-weight: 400;
  }


  /*
   * CART DRAWER TOTALS POLISH
   */

  .cart-drawer__summary
  .cart-totals__total {
    color: #111111;
  }

  .cart-drawer__summary
  .cart-totals__total-label {
    font-family:
      var(--font-body--family);

    font-size: 12px;
    font-weight: 650;

    letter-spacing: 0.045em;

    text-transform: uppercase;
  }

  .cart-drawer__summary
  .cart-totals__total-value {
    font-family:
      var(--font-heading--family);

    font-weight: 650;

    letter-spacing: -0.02em;
  }

  .cart-drawer__summary
  .cart-totals__tax-note {
    margin-top: 2px;

    line-height: 1.35;
  }


  /*
   * DISCOUNT + NOTE DRAWER POLISH
   */

  .cart-drawer__summary
  .cart-actions {
    border-color: #e8ecee;
  }

  .cart-drawer__summary
  .cart-actions__divider {
    border-color: #e8ecee;
  }

  .cart-drawer__summary
  .cart-discount__input,
  .cart-drawer__summary
  .cart-note__instructions {
    border-color: #dfe5e7;

    background: #ffffff;

    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .cart-drawer__summary
  .cart-discount__input:focus,
  .cart-drawer__summary
  .cart-note__instructions:focus {
    border-color: #02c6ea;

    outline: none;

    box-shadow:
      0 0 0 2px
      rgba(2, 198, 234, 0.12);
  }


  /*
   * TABLET / DESKTOP
   */

  @media screen and (min-width: 750px) {

    .cart-summary--extend {
      height: 100%;
    }

    .cart-drawer__summary
    .avonent-cart-checkout {
      min-height: 57px;

      font-size: 14px;
    }

    .avonent-cart-trust {
      gap: 16px;
    }

    .avonent-cart-trust__payment,
    .avonent-cart-trust__payment svg {
      height: 25px;
    }

    .avonent-cart-trust__stars {
      font-size: 15px;
    }

    .avonent-cart-trust__rating-copy {
      font-size: 13px;
    }

    .avonent-cart-trust__badge-text strong {
      font-size: 11px;
    }

    .avonent-cart-trust__badge-text small {
      font-size: 10px;
    }

  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    .cart-drawer__summary
    .avonent-cart-ctas {
      gap: 13px;
    }

    .cart-drawer__summary
    .avonent-cart-checkout {
      min-height: 54px;

      padding-inline: 16px;

      border-radius: 11px;

      font-size: 13px;
    }

    .avonent-cart-trust {
      gap: 13px;
    }

    .avonent-cart-trust__badges {
      padding-top: 13px;
    }

    .avonent-cart-trust__badge {
      padding-inline: 6px;
    }

  }


  /*
   * VERY SMALL PHONES
   */

  @media screen and (max-width: 360px) {

    .cart-drawer__summary
    .avonent-cart-checkout {
      min-height: 52px;

      font-size: 12px;

      gap: 7px;
    }

    .avonent-cart-checkout__arrow {
      font-size: 16px;
    }

    .avonent-cart-trust__payment,
    .avonent-cart-trust__payment svg {
      height: 21px;
    }

    .avonent-cart-trust__stars {
      font-size: 12px;
    }

    .avonent-cart-trust__rating-copy {
      font-size: 10px;
    }

    .avonent-cart-trust__badge {
      padding-inline: 3px;
    }

    .avonent-cart-trust__icon {
      width: 27px;
      height: 27px;

      flex-basis: 27px;
    }

    .avonent-cart-trust__badge-text strong {
      font-size: 9px;
    }

    .avonent-cart-trust__badge-text small {
      font-size: 8px;
    }

  }

{% endstylesheet %}

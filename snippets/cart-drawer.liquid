{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
  assign protection_product = all_products['shipping-protection']
  assign protection_variant = protection_product.selected_or_first_available_variant
  assign protection_line_key = ''
  assign protection_quantity = 0

  for item in cart.items
    if item.product.handle == 'shipping-protection'
      assign protection_line_key = item.key
      assign protection_quantity = item.quantity
      break
    endif
  endfor

  assign regular_item_count = cart.item_count | minus: protection_quantity
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}

  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>


  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products',
          force_empty: true,
          context: 'drawer'
        %}
      </div>
    </div>
  {% endcapture %}


  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >

    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer avonent-cart-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >

      <cart-drawer-component
        auto-open
        data-protection-variant-id="{{ protection_variant.id }}"
        data-protection-handle="shipping-protection"
      >

        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>


        <div
          class="
            cart-drawer__inner
            {% if cart.empty? %}
              cart-drawer--empty
            {% endif %}
          "
          data-hydration-key="cart-drawer-inner"
        >

          {%- if cart.empty? -%}

            <div class="theme-drawer__header avonent-cart-drawer__header">

              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>

            </div>

          {%- else -%}

            {% capture cart_badge_html %}
              <span
                class="
                  theme-drawer__badge
                  {% if cart.item_count == 0 %}
                    visually-hidden
                  {% endif %}
                "
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>

              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}:
                  {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}

            {% assign cart_drawer_title = 'content.cart_title' | t %}

            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}

          {%- endif -%}


          {%- unless cart.empty? -%}
            <div
              class="avonent-cart-reservation"
              data-avonent-cart-reservation
              role="timer"
              aria-live="polite"
            >
              <span class="avonent-cart-reservation__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 7.7v4.8l3.2 1.9M9.2 3.5h5.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>
                Cart reserved for
                <strong data-avonent-cart-countdown>05:00</strong>
              </span>
            </div>
          {%- endunless -%}


          {% capture cart_items_children %}

            {%- if cart.empty? -%}

              {{ empty_cart_drawer_content }}

            {%- else -%}

              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >

                <scroll-hint class="cart-drawer__items">

                  {% render 'cart-products',
                    context: 'drawer'
                  %}

                </scroll-hint>


                <div class="cart-drawer__summary">

                  {%- if protection_variant != blank and regular_item_count > 0 -%}
                    <div
                      class="avonent-shipping-protection"
                      data-avonent-protection
                      data-line-key="{{ protection_line_key }}"
                      data-enabled="{% if protection_line_key != blank %}true{% else %}false{% endif %}"
                    >
                      <span class="avonent-shipping-protection__icon" aria-hidden="true">
                        <svg viewBox="0 0 48 48" fill="none">
                          <path d="M10 17.5 24 10l14 7.5v10.2c0 7.2-5.8 12.6-14 15.3-8.2-2.7-14-8.1-14-15.3V17.5Z" fill="currentColor" opacity=".14"/>
                          <path d="M10 17.5 24 10l14 7.5v10.2c0 7.2-5.8 12.6-14 15.3-8.2-2.7-14-8.1-14-15.3V17.5Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                          <path d="m18.5 26.2 3.7 3.7 7.8-8.1" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>

                      <div class="avonent-shipping-protection__copy">
                        <div class="avonent-shipping-protection__heading">
                          <strong>Shipping Protection</strong>
                          <span>{{ protection_variant.price | money }}</span>
                        </div>
                        <p>Protect your order from loss, damage, or theft in transit.</p>
                      </div>

                      <button
                        type="button"
                        class="avonent-shipping-protection__toggle"
                        role="switch"
                        aria-label="Add shipping protection"
                        aria-checked="{% if protection_line_key != blank %}true{% else %}false{% endif %}"
                        data-avonent-protection-toggle
                      >
                        <span></span>
                      </button>
                    </div>
                  {%- endif -%}

                  {% render 'cart-summary',
                    section_id: 'cart-drawer-section'
                  %}

                </div>

              </scroll-hint>

            {%- endif -%}

          {% endcapture %}


          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}

        </div>

      </cart-drawer-component>

    </dialog>

  </theme-drawer>


  {% if render_wrapper %}
    </div>
  {% endif %}

{%- endif -%}


{% stylesheet %}

  /*
   * HORIZON CART DRAWER BASE
   */

  cart-drawer-component {
    --cart-drawer-padding:
      var(--theme-drawer-padding);

    --font-paragraph--line-height: 1;

    display: contents;
  }


  .cart-drawer__inner {
    display: flex;
    flex-direction: column;

    height: 100%;

    overflow: hidden;
  }


  .cart-drawer__inner
    > .cart-items-component {
    flex: 1;

    min-height: 0;
    height: auto;
  }


  .cart-drawer__content {
    display: flex;
    flex-direction: column;

    padding: 0;

    background-color:
      var(--color-background);

    flex-grow: 1;

    overflow-y: auto;
  }


  .cart-drawer__items {
    display: flex;
    flex-direction: column;

    padding-inline:
      var(--cart-drawer-padding);

    overflow-y: auto;
  }


  .cart-drawer__items
    .cart-items__table-row {
    padding-bottom:
      var(--gap-xl);

    border-bottom:
      var(--style-border-width)
      solid
      rgb(
        var(--color-foreground-rgb)
        /
        var(--opacity-10-25)
      );

    margin-bottom:
      var(--gap-xl);
  }


  .cart-drawer__items
    .cart-items__table-row:has(
      + .cart-items__nested-line
    ) {
    border-bottom: none;

    margin-bottom: 0;
  }


  .cart-drawer__items
    .cart-items__table-row:last-child {
    border-bottom: none;

    padding-block-end: 0;

    margin-block-end: 0;
  }


  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }


  .cart-drawer__summary {
    --cart-drawer-summary-padding:
      var(--padding-lg);

    position: sticky;

    bottom: 0;
    z-index: 1;

    display: flex;
    flex-direction: column;
    align-items: center;

    gap:
      var(--gap-xl);

    padding:
      var(--cart-drawer-summary-padding);

    margin-top: auto;

    background-color:
      var(--color-background);

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black var(--cart-drawer-summary-padding)
      );

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding:
        var(--padding-2xl);
    }
  }


  .theme-drawer__dialog[
    cart-summary-sticky='false'
  ]
  .cart-drawer__summary {
    position: static;

    mask-image: none;
  }


  .theme-drawer__dialog[
    cart-summary-sticky='false'
  ]
  .cart-drawer__items {
    overflow: unset;
  }


  .cart-actions summary {
    padding-inline: 0;

    padding-block:
      var(--padding-sm);

    line-height: 1.2;

    min-height:
      var(--minimum-touch-target);
  }


  .cart-drawer__summary
    .cart__summary-totals:not(
      :has(
        .cart__subtotal-container:empty
      )
    ) {
    border-block-start:
      var(--style-border-width)
      solid
      rgb(
        var(--color-foreground-rgb)
        /
        var(--opacity-10-25)
      );

    padding-block-start:
      var(--padding-2xl);
  }


  .cart-drawer__summary
    .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start:
        var(--margin-3xs);
    }
  }


  .cart-drawer--empty
    .cart-drawer__content {
    text-align: center;

    align-items: center;
    justify-content: center;

    min-height: auto;
  }


  .cart-drawer--empty
    .cart-drawer__items {
    padding-inline: 0;
  }


  cart-drawer-component:not(
    :has(.cart-form)
  )
  .cart-drawer__content {
    text-align: center;

    align-items: center;
    justify-content: center;
  }


  cart-drawer-component:not(
    :has(.cart-form)
  )
  .cart-drawer__items {
    padding-inline: 0;
  }


  /*
   * AVONENT DRAWER WIDTH
   */

  #cart-drawer
    .theme-drawer__dialog {
    --theme-drawer-width:
      min(
        500px,
        100vw
      );

    width:
      var(--theme-drawer-width);

    max-width:
      var(--theme-drawer-width);

    background:
      #ffffff;

    border-left:
      1px solid
      #e7ebed;
  }


  /*
   * HEADER
   */

  #cart-drawer
    .theme-drawer__header {
    min-height: 74px;

    padding:
      18px
      22px;

    border-bottom:
      1px solid
      #e7ebed;

    background:
      #ffffff;
  }


  #cart-drawer
    .theme-drawer__title {
    color:
      #111111;

    font-family:
      var(--font-heading--family);

    font-size: 25px;

    font-weight: 650;

    line-height: 1;

    letter-spacing:
      -0.025em;
  }


  #cart-drawer
    .theme-drawer__badge {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-width: 25px;
    height: 25px;

    margin-left: 8px;

    padding-inline: 6px;

    border-radius: 999px;

    background:
      #eafaff;

    color:
      #078daa;

    font-family:
      var(--font-body--family);

    font-size: 11px;

    font-weight: 700;
  }


  /*
   * CLOSE BUTTON
   */

  #cart-drawer
    .theme-drawer__close-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    border:
      1px solid
      #dfe5e7;

    border-radius: 50%;

    background:
      #ffffff;

    color:
      #111111;

    box-shadow: none;

    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }


  #cart-drawer
    .theme-drawer__close-button:hover {
    border-color:
      #bdeef7;

    background:
      #eafaff;

    color:
      #02c6ea;

    transform:
      rotate(3deg);
  }


  /*
   * CART ITEM AREA
   */

  #cart-drawer
    .cart-drawer__items {
    padding-inline:
      22px;

    padding-top:
      20px;
  }


  #cart-drawer
    .cart-drawer__items
    .cart-items__table-row {
    padding-bottom:
      22px;

    margin-bottom:
      22px;

    border-color:
      #edf0f1;
  }


  /*
   * SUMMARY
   */

  #cart-drawer
    .cart-drawer__summary {
    --cart-drawer-summary-padding:
      22px;

    gap:
      16px;

    padding:
      22px;

    border-top:
      1px solid
      #e7ebed;

    background:
      #ffffff;

    mask-image: none;

    box-shadow:
      0
      -14px
      36px
      rgba(0, 0, 0, 0.035);
  }


  /*
   * EMPTY CART
   */

  #cart-drawer
    .cart-drawer--empty
    .cart-drawer__content {
    padding:
      40px
      22px;
  }


  #cart-drawer
    .cart-drawer--empty
    .theme-drawer__title {
    text-align: center;
  }


  /*
   * SCROLLBARS
   */

  #cart-drawer
    .cart-drawer__content,
  #cart-drawer
    .cart-drawer__items {
    scrollbar-width: thin;

    scrollbar-color:
      #dfe5e7
      transparent;
  }


  #cart-drawer
    .cart-drawer__content::-webkit-scrollbar,
  #cart-drawer
    .cart-drawer__items::-webkit-scrollbar {
    width: 5px;
  }


  #cart-drawer
    .cart-drawer__content::-webkit-scrollbar-thumb,
  #cart-drawer
    .cart-drawer__items::-webkit-scrollbar-thumb {
    border-radius: 999px;

    background:
      #dfe5e7;
  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    #cart-drawer
      .theme-drawer__dialog {
      --theme-drawer-width:
        100%;

      width: 100%;
      max-width: 100%;
    }


    #cart-drawer
      .theme-drawer__header {
      min-height: 68px;

      padding:
        14px
        16px;
    }


    #cart-drawer
      .theme-drawer__title {
      font-size: 23px;
    }


    #cart-drawer
      .theme-drawer__close-button {
      width: 38px;
      height: 38px;
    }


    #cart-drawer
      .cart-drawer__items {
      padding-inline:
        16px;

      padding-top:
        17px;
    }


    #cart-drawer
      .cart-drawer__items
      .cart-items__table-row {
      padding-bottom:
        18px;

      margin-bottom:
        18px;
    }


    #cart-drawer
      .cart-drawer__summary {
      --cart-drawer-summary-padding:
        16px;

      gap:
        14px;

      padding:
        18px
        16px
        calc(
          18px
          +
          env(
            safe-area-inset-bottom
          )
        );
    }

  }


  /*
   * SMALL PHONES
   */

  @media screen and (max-width: 360px) {

    #cart-drawer
      .theme-drawer__header {
      min-height: 64px;

      padding-inline:
        13px;
    }


    #cart-drawer
      .theme-drawer__title {
      font-size: 21px;
    }


    #cart-drawer
      .cart-drawer__close-button {
      width: 35px;
      height: 35px;
    }


    #cart-drawer
      .cart-drawer__items {
      padding-inline:
        13px;
    }


    #cart-drawer
      .cart-drawer__summary {
      padding-inline:
        13px;
    }

  }


  /*
   * DESKTOP
   */

  @media screen and (min-width: 750px) {

    #cart-drawer
      .theme-drawer__dialog {
      --theme-drawer-width:
        470px;
    }

  }


  /*
   * LARGE DESKTOP
   */

  @media screen and (min-width: 1400px) {

    #cart-drawer
      .theme-drawer__dialog {
      --theme-drawer-width:
        500px;
    }

  }


  /*
   * AVONENT CART TIMER + SHIPPING PROTECTION
   */

  #cart-drawer .avonent-cart-reservation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    padding: 11px 16px;
    background: linear-gradient(135deg, #02c6ea, #00a9d3);
    color: #ffffff;
    font-size: 14px;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  #cart-drawer .avonent-cart-reservation__icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
  }

  #cart-drawer .avonent-cart-reservation__icon svg {
    width: 100%;
    height: 100%;
  }

  #cart-drawer .avonent-cart-reservation strong {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
  }

  #cart-drawer .avonent-shipping-protection {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px;
    border: 1px solid #bceef7;
    border-radius: 16px;
    background: linear-gradient(135deg, #f5fdff, #eafaff);
    color: #111111;
  }

  #cart-drawer .avonent-shipping-protection__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #ffffff;
    color: #02c6ea;
    box-shadow: 0 5px 18px rgba(2, 198, 234, 0.14);
  }

  #cart-drawer .avonent-shipping-protection__icon svg {
    width: 38px;
    height: 38px;
  }

  #cart-drawer .avonent-shipping-protection__copy {
    min-width: 0;
  }

  #cart-drawer .avonent-shipping-protection__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 5px 10px;
    color: #111111;
    font-size: 14px;
    line-height: 1.2;
  }

  #cart-drawer .avonent-shipping-protection__heading span {
    color: #078daa;
    font-weight: 800;
  }

  #cart-drawer .avonent-shipping-protection__copy p {
    margin: 5px 0 0;
    color: #56636a;
    font-size: 12px;
    line-height: 1.4;
  }

  #cart-drawer .avonent-shipping-protection__toggle {
    position: relative;
    width: 46px;
    height: 27px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #cbd4d8;
    cursor: pointer;
    transition: background 160ms ease, opacity 160ms ease;
  }

  #cart-drawer .avonent-shipping-protection__toggle span {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    transition: transform 160ms ease;
  }

  #cart-drawer .avonent-shipping-protection__toggle[aria-checked='true'] {
    background: #02c6ea;
  }

  #cart-drawer .avonent-shipping-protection__toggle[aria-checked='true'] span {
    transform: translateX(19px);
  }

  #cart-drawer .avonent-shipping-protection__toggle:focus-visible {
    outline: 3px solid rgba(2, 198, 234, 0.3);
    outline-offset: 3px;
  }

  #cart-drawer .avonent-shipping-protection__toggle[disabled] {
    cursor: wait;
    opacity: 0.58;
  }

  #cart-drawer .cart-drawer__items .cart-items__table-row:has(a[href*='/products/shipping-protection']) {
    display: none;
  }

  @media screen and (max-width: 380px) {
    #cart-drawer .avonent-shipping-protection {
      grid-template-columns: 42px minmax(0, 1fr) 44px;
      gap: 9px;
      padding: 12px;
    }

    #cart-drawer .avonent-shipping-protection__icon {
      width: 42px;
      height: 42px;
    }

    #cart-drawer .avonent-shipping-protection__heading {
      display: block;
    }

    #cart-drawer .avonent-shipping-protection__heading span {
      display: block;
      margin-top: 2px;
    }
  }


  /*
   * REDUCED MOTION
   */

  @media screen and (prefers-reduced-motion: no-preference) {

    html:active-view-transition-type(
      empty-cart-drawer
    ) {

      .theme-drawer__close-button {
        view-transition-name:
          cart-drawer-close-button;
      }

    }

  }


  :active-view-transition {

    .cart-drawer__header,
    .cart-drawer__content {
      background:
        transparent;
    }

  }


  /*
   * COMPACT CONVERSION FOOTER
   */

  #cart-drawer .cart-drawer__summary {
    --cart-drawer-summary-padding: 14px;
    gap: 8px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  }

  #cart-drawer .avonent-shipping-protection {
    grid-template-columns: 42px minmax(0, 1fr) 44px;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 14px;
  }

  #cart-drawer .avonent-shipping-protection__icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
  }

  #cart-drawer .avonent-shipping-protection__icon svg {
    width: 33px;
    height: 33px;
  }

  #cart-drawer .avonent-shipping-protection__heading {
    font-size: 13px;
  }

  #cart-drawer .avonent-shipping-protection__copy p {
    margin-top: 3px;
    font-size: 11px;
    line-height: 1.32;
  }

  #cart-drawer .avonent-shipping-protection__toggle[disabled] {
    opacity: 1;
    cursor: pointer;
  }

  #cart-drawer .cart-drawer__summary .cart-totals {
    gap: 0;
    margin: 0;
    padding: 7px 0 0;
    border-block-start: 1px solid #e7ebed;
  }

  #cart-drawer .cart-drawer__summary .cart-totals__container {
    row-gap: 0;
  }


{% liquid
  assign av_cb_product = product
  assign av_cb_variant = av_cb_product.selected_or_first_available_variant
  assign av_cb_form_id = 'AvonentCinnamonBerberine-' | append: section.id
  assign av_cb_unit_price = av_cb_variant.price | default: av_cb_product.price
%}

<div class="av-cb" data-av-cb data-unit-price="{{ av_cb_unit_price }}">
  <style>
    .av-cb{--blue:#02c6ea;--deep:#087e9d;--ink:#08171d;--muted:#5f7078;--line:#d9ebef;--soft:#eefbfe;--soft2:#f7fdff;background:#fff;color:var(--ink);font-family:inherit}
    .av-cb *{box-sizing:border-box}.av-cb a{text-decoration:none}.av-cb__wrap{width:min(1200px,calc(100% - 32px));margin:0 auto}
    .av-cb__hero{padding:34px 0 26px;background:linear-gradient(180deg,#fff 0%,#f4fcfe 100%)}
    .av-cb__hero-grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:48px;align-items:center}
    .av-cb__media{min-height:520px;border:1px solid var(--line);border-radius:28px;background:radial-gradient(circle at 50% 38%,#fff 0 24%,#e9faff 58%,#dff7fc 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:28px}
    .av-cb__media img{max-width:100%;max-height:500px;object-fit:contain;filter:drop-shadow(0 28px 35px rgba(0,0,0,.12))}
    .av-cb__formula-bottle{width:min(330px,85%);aspect-ratio:4/5;border-radius:28px;background:#fff;border:1px solid #d8edf2;box-shadow:0 28px 70px rgba(5,103,128,.13);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:34px}
    .av-cb__formula-bottle b{font-size:38px;line-height:1}.av-cb__formula-bottle span{font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin-top:10px;color:var(--deep)}.av-cb__formula-bottle small{margin-top:16px;color:var(--muted)}
    .av-cb__eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--deep);margin-bottom:12px}
    .av-cb__eyebrow:before{content:"";width:28px;height:3px;border-radius:99px;background:var(--blue)}
    .av-cb__title{font-size:clamp(38px,5vw,66px);line-height:.98;letter-spacing:-.045em;margin:0 0 16px;font-weight:800}
    .av-cb__subtitle{font-size:18px;line-height:1.55;color:var(--muted);margin:0 0 22px;max-width:650px}
    .av-cb__chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}.av-cb__chip{padding:9px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:12px;font-weight:700}
    .av-cb__price{display:flex;align-items:baseline;gap:10px;margin:0 0 15px}.av-cb__price strong{font-size:30px}.av-cb__price span{font-size:13px;color:var(--muted)}
    .av-cb__bundle-label{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin:0 0 9px}
    .av-cb__bundles{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}
    .av-cb__bundle{position:relative;border:1.5px solid var(--line);border-radius:16px;padding:15px 11px;background:#fff;cursor:pointer;text-align:left;transition:.18s ease}
    .av-cb__bundle:hover,.av-cb__bundle.is-active{border-color:var(--blue);box-shadow:0 0 0 2px rgba(2,198,234,.12)}.av-cb__bundle.is-active{background:var(--soft)}
    .av-cb__bundle strong{display:block;font-size:16px}.av-cb__bundle span{display:block;font-size:12px;color:var(--muted);margin-top:3px}.av-cb__badge{position:absolute!important;top:-9px;right:9px;background:var(--blue);color:#fff!important;border-radius:999px;padding:3px 7px;font-size:9px!important;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
    .av-cb__buy{width:100%;min-height:56px;border:0;border-radius:14px;background:#111;color:#fff;font-weight:800;font-size:16px;cursor:pointer;display:flex;justify-content:center;align-items:center;gap:8px}.av-cb__buy[disabled]{opacity:.45;cursor:not-allowed}
    .av-cb__micro{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:10px}.av-cb__micro b{color:var(--ink)}
    .av-cb__trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.av-cb__trust-grid{display:grid;grid-template-columns:repeat(4,1fr)}.av-cb__trust-item{padding:18px;text-align:center;border-right:1px solid var(--line)}.av-cb__trust-item:last-child{border-right:0}.av-cb__trust-item b{display:block;font-size:14px}.av-cb__trust-item span{display:block;font-size:11px;color:var(--muted);margin-top:2px}
    .av-cb__section{padding:72px 0}.av-cb__section--soft{background:var(--soft2)}.av-cb__section--blue{background:var(--deep);color:#fff}
    .av-cb__head{text-align:center;max-width:760px;margin:0 auto 34px}.av-cb__head h2{font-size:clamp(30px,4vw,48px);line-height:1.05;letter-spacing:-.035em;margin:8px 0 12px}.av-cb__head p{font-size:16px;line-height:1.65;color:var(--muted);margin:0}.av-cb__section--blue .av-cb__head p{color:#d5f2f8}.av-cb__section--blue .av-cb__eyebrow{color:#8deeff}
    .av-cb__formula{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.av-cb__formula-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:26px;min-height:260px}.av-cb__formula-card .num{font-size:38px;font-weight:850;letter-spacing:-.04em;color:var(--blue)}.av-cb__formula-card .unit{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.09em;font-weight:800}.av-cb__formula-card h3{font-size:22px;margin:18px 0 9px}.av-cb__formula-card p{font-size:14px;line-height:1.6;color:var(--muted);margin:0}
    .av-cb__compare{display:grid;grid-template-columns:1fr 1fr;gap:18px}.av-cb__compare-card{border-radius:24px;padding:28px;background:#fff;border:1px solid var(--line)}.av-cb__compare-card--av{background:#0a92b3;border-color:#42cce8;color:#fff}.av-cb__compare-card h3{font-size:25px;margin:0 0 18px}.av-cb__row{display:flex;gap:10px;align-items:flex-start;padding:12px 0;border-top:1px solid rgba(255,255,255,.18)}.av-cb__compare-card:not(.av-cb__compare-card--av) .av-cb__row{border-color:var(--line)}.av-cb__check{width:22px;height:22px;border-radius:50%;background:var(--blue);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 22px}.av-cb__compare-card--av .av-cb__check{background:#8deeff;color:#07303b}.av-cb__row b{font-size:14px}.av-cb__row span{display:block;font-size:12px;opacity:.75;margin-top:2px}
    .av-cb__education{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch}.av-cb__edu{border-radius:24px;padding:30px;background:#fff;border:1px solid var(--line)}.av-cb__edu--ceylon{background:var(--soft);border-color:#aeeaf4}.av-cb__edu .label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;color:var(--deep)}.av-cb__edu h3{font-size:30px;margin:8px 0 12px}.av-cb__edu p{color:var(--muted);line-height:1.6;margin:0}
    .av-cb__timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.av-cb__week{border-radius:18px;padding:22px;background:#fff;border:1px solid var(--line)}.av-cb__week b{color:var(--deep);font-size:12px;letter-spacing:.08em;text-transform:uppercase}.av-cb__week h3{font-size:18px;margin:8px 0}.av-cb__week p{font-size:13px;line-height:1.55;color:var(--muted);margin:0}
    .av-cb__guarantee{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:24px;padding:30px}.av-cb__seal{width:100px;height:100px;border-radius:50%;border:8px double var(--blue);display:grid;place-items:center;text-align:center;color:var(--deep);font-weight:900;line-height:1}.av-cb__guarantee h2{font-size:30px;margin:0 0 6px}.av-cb__guarantee p{margin:0;color:var(--muted);line-height:1.55}.av-cb__cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;border-radius:12px;padding:0 22px;background:var(--blue);color:#fff;font-weight:800}
    .av-cb__faq{max-width:850px;margin:0 auto}.av-cb__faq details{background:#fff;border:1px solid var(--line);border-radius:14px;margin:9px 0;padding:0 18px}.av-cb__faq summary{cursor:pointer;font-weight:800;padding:18px 0;list-style:none}.av-cb__faq summary::-webkit-details-marker{display:none}.av-cb__faq p{color:var(--muted);line-height:1.6;margin:0 0 18px}
    .av-cb__disclaimer{font-size:10px!important;color:#7b8a90!important;max-width:860px;margin:24px auto 0!important;text-align:center;line-height:1.5!important}
    .av-cb__sticky{display:none}
    @media(max-width:900px){.av-cb__hero-grid{grid-template-columns:1fr;gap:24px}.av-cb__media{min-height:390px}.av-cb__trust-grid{grid-template-columns:repeat(2,1fr)}.av-cb__trust-item:nth-child(2){border-right:0}.av-cb__formula,.av-cb__timeline{grid-template-columns:1fr 1fr}.av-cb__education,.av-cb__compare{grid-template-columns:1fr}.av-cb__guarantee{grid-template-columns:auto 1fr}.av-cb__guarantee .av-cb__cta{grid-column:1/-1}.av-cb__title{font-size:46px}}
    @media(max-width:600px){.av-cb__wrap{width:min(100% - 22px,1200px)}.av-cb__hero{padding-top:16px}.av-cb__media{min-height:315px;border-radius:20px}.av-cb__formula-bottle{width:75%;padding:22px}.av-cb__formula-bottle b{font-size:30px}.av-cb__title{font-size:38px}.av-cb__subtitle{font-size:15px}.av-cb__bundles{grid-template-columns:1fr}.av-cb__bundle{padding:13px 14px}.av-cb__trust-grid{grid-template-columns:1fr 1fr}.av-cb__trust-item{padding:14px 8px}.av-cb__section{padding:50px 0}.av-cb__formula,.av-cb__timeline{grid-template-columns:1fr}.av-cb__guarantee{grid-template-columns:1fr;text-align:center}.av-cb__seal{margin:auto}.av-cb__sticky{position:fixed;display:flex;z-index:40;left:10px;right:10px;bottom:10px;background:#fff;border:1px solid var(--line);box-shadow:0 12px 40px rgba(0,0,0,.16);border-radius:14px;padding:9px;align-items:center;justify-content:space-between;gap:10px}.av-cb__sticky b{font-size:12px}.av-cb__sticky a{background:#111;color:#fff;padding:12px 18px;border-radius:10px;font-size:12px;font-weight:800}.av-cb{padding-bottom:72px}}
  </style>

  <section class="av-cb__hero" id="av-cb-top">
    <div class="av-cb__wrap av-cb__hero-grid">
      <div class="av-cb__media">
        {% if av_cb_product.featured_image %}
          {{ av_cb_product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '500,700,900,1200', sizes: '(min-width: 900px) 48vw, 92vw', alt: 'Avonent Berberine + Ceylon Cinnamon softgels' }}
        {% else %}
          <div class="av-cb__formula-bottle">
            <b>AVONENT</b>
            <span>Berberine + Ceylon Cinnamon</span>
            <small>120 softgels · 30 daily servings</small>
          </div>
        {% endif %}
      </div>

      <div>
        <div class="av-cb__eyebrow">Advanced Metabolic Support</div>
        <h1 class="av-cb__title">Berberine + True Ceylon Cinnamon</h1>
        <p class="av-cb__subtitle">Three complementary ingredients in one simple softgel routine: <strong>1,200 mg Ceylon cinnamon</strong>, <strong>400 mg Berberine HCl</strong>, and <strong>200 mg MCT oil</strong> per daily serving.</p>
        <div class="av-cb__chips">
          <span class="av-cb__chip">True Ceylon · Cinnamomum verum</span>
          <span class="av-cb__chip">Berberine HCl</span>
          <span class="av-cb__chip">MCT Oil Softgels</span>
          <span class="av-cb__chip">30-Day Supply</span>
        </div>

        <div class="av-cb__price">
          <strong data-av-cb-price>{{ av_cb_unit_price | money }}</strong>
          <span data-av-cb-supply>30-day supply</span>
        </div>

        {% form 'product', av_cb_product, id: av_cb_form_id, class: 'av-cb__form' %}
          <input type="hidden" name="id" value="{{ av_cb_variant.id }}">
          <input type="hidden" name="quantity" value="1" data-av-cb-quantity>
          <p class="av-cb__bundle-label">Choose your supply</p>
          <div class="av-cb__bundles" role="group" aria-label="Choose supply">
            <button class="av-cb__bundle is-active" type="button" data-av-cb-bundle="1">
              <strong>Buy 1</strong><span>30-Day Supply</span>
            </button>
            <button class="av-cb__bundle" type="button" data-av-cb-bundle="2">
              <span class="av-cb__badge">Most Popular</span>
              <strong>Buy 2</strong><span>60-Day Supply</span>
            </button>
            <button class="av-cb__bundle" type="button" data-av-cb-bundle="3">
              <span class="av-cb__badge">Best Value</span>
              <strong>Buy 3</strong><span>90-Day Supply</span>
            </button>
          </div>
          <button class="av-cb__buy" type="submit" {% unless av_cb_variant.available %}disabled{% endunless %}>
            {% if av_cb_variant.available %}Add to Cart · <span data-av-cb-button-price>{{ av_cb_unit_price | money }}</span>{% else %}Currently Unavailable{% endif %}
          </button>
        {% endform %}
        <div class="av-cb__micro">
          <span><b>120 softgels</b> per bottle</span>
          <span><b>4 softgels</b> per serving</span>
          <span><b>30 servings</b> per bottle</span>
        </div>
      </div>
    </div>
  </section>

  <div class="av-cb__trust">
    <div class="av-cb__wrap av-cb__trust-grid">
      <div class="av-cb__trust-item"><b>True Ceylon Cinnamon</b><span>Not common cassia</span></div>
      <div class="av-cb__trust-item"><b>Berberine HCl</b><span>Metabolic-wellness formula</span></div>
      <div class="av-cb__trust-item"><b>MCT Oil Softgel</b><span>Oil-based format</span></div>
      <div class="av-cb__trust-item"><b>30-Day Guarantee</b><span>Shop with confidence</span></div>
    </div>
  </div>

  <section class="av-cb__section av-cb__section--soft">
    <div class="av-cb__wrap">
      <header class="av-cb__head">
        <div class="av-cb__eyebrow">Inside the formula</div>
        <h2>Three ingredients. One simple 30-day formula.</h2>
        <p>No mystery blend. Every core ingredient and daily amount is clearly stated.</p>
      </header>
      <div class="av-cb__formula">
        <article class="av-cb__formula-card"><div class="num">1,200</div><div class="unit">mg per daily serving</div><h3>True Ceylon Cinnamon</h3><p>Cinnamomum verum gives the formula a clearly identified cinnamon source and supports healthy glucose metabolism as part of a balanced lifestyle.*</p></article>
        <article class="av-cb__formula-card"><div class="num">400</div><div class="unit">mg per daily serving</div><h3>Berberine HCl</h3><p>A researched botanical compound commonly used in metabolic-wellness formulas to support normal glucose and lipid metabolism.*</p></article>
        <article class="av-cb__formula-card"><div class="num">200</div><div class="unit">mg per daily serving</div><h3>MCT Oil</h3><p>An oil-based carrier that helps create the convenient softgel format instead of a dry powder-only capsule.</p></article>
      </div>
    </div>
  </section>

  <section class="av-cb__section">
    <div class="av-cb__wrap">
      <header class="av-cb__head"><div class="av-cb__eyebrow">Not all cinnamon is the same</div><h2>True Ceylon vs. common cassia.</h2><p>The cinnamon source is part of the product story—not an afterthought.</p></header>
      <div class="av-cb__education">
        <article class="av-cb__edu av-cb__edu--ceylon"><div class="label">Avonent uses</div><h3>Ceylon Cinnamon</h3><p><strong>Cinnamomum verum</strong>, often called “true cinnamon.” It is naturally much lower in coumarin than common cassia cinnamon and gives the formula a premium, clearly identified cinnamon source.</p></article>
        <article class="av-cb__edu"><div class="label">Common alternative</div><h3>Cassia Cinnamon</h3><p>The cinnamon most shoppers see in ordinary grocery and supplement products. Cassia is a different species and naturally contains substantially more coumarin than Ceylon cinnamon.</p></article>
      </div>
    </div>
  </section>

  <section class="av-cb__section av-cb__section--blue">
    <div class="av-cb__wrap">
      <header class="av-cb__head"><div class="av-cb__eyebrow">The Avonent difference</div><h2>A more complete cinnamon formula.</h2><p>Instead of a generic single-ingredient capsule, Avonent combines three clearly disclosed components in one monthly routine.</p></header>
      <div class="av-cb__compare">
        <article class="av-cb__compare-card av-cb__compare-card--av">
          <h3>Avonent</h3>
          <div class="av-cb__row"><span class="av-cb__check">✓</span><div><b>True Ceylon clearly identified</b><span>Cinnamomum verum</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">✓</span><div><b>Ceylon + Berberine</b><span>Two botanical actives in one formula</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">✓</span><div><b>Exact daily amounts shown</b><span>1,200 mg + 400 mg + 200 mg</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">✓</span><div><b>MCT oil softgel base</b><span>Oil-based format</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">✓</span><div><b>Exactly 30 servings</b><span>Built around monthly consistency</span></div></div>
        </article>
        <article class="av-cb__compare-card">
          <h3>Typical basic formula</h3>
          <div class="av-cb__row"><span class="av-cb__check">–</span><div><b>Cinnamon variety may be vague</b><span>Often simply labeled “cinnamon”</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">–</span><div><b>Often single ingredient</b><span>May require separate products</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">–</span><div><b>Serving details can vary</b><span>Compare labels carefully</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">–</span><div><b>Common powder capsule format</b><span>No MCT oil base</span></div></div>
          <div class="av-cb__row"><span class="av-cb__check">–</span><div><b>Supply length varies</b><span>Not always designed as a month</span></div></div>
        </article>
      </div>
    </div>
  </section>

  <section class="av-cb__section av-cb__section--soft">
    <div class="av-cb__wrap">
      <header class="av-cb__head"><div class="av-cb__eyebrow">Your 30-day routine</div><h2>Consistency beats complexity.</h2><p>One bottle contains 120 softgels and 30 full daily servings.</p></header>
      <div class="av-cb__timeline">
        <article class="av-cb__week"><b>Week 1</b><h3>Start the routine</h3><p>Take the labeled 4-softgel serving each day and anchor it to the same part of your routine.</p></article>
        <article class="av-cb__week"><b>Week 2</b><h3>Make it automatic</h3><p>Keep the serving consistent alongside meals, movement, hydration, and sleep.</p></article>
        <article class="av-cb__week"><b>Week 3</b><h3>Stay consistent</h3><p>You are more than halfway through the bottle. Keep using the formula exactly as directed.</p></article>
        <article class="av-cb__week"><b>Week 4</b><h3>Finish the bottle</h3><p>Complete the 30-serving routine and decide whether it fits your long-term wellness habits.</p></article>
      </div>
    </div>
  </section>

  <section class="av-cb__section">
    <div class="av-cb__wrap">
      <div class="av-cb__guarantee">
        <div class="av-cb__seal">30<br><small>DAYS</small></div>
        <div><h2>Try the full 30-day bottle.</h2><p>Your order is covered by Avonent’s 30-day satisfaction guarantee. Contact support within 30 days for help under the current refund policy.</p></div>
        <a class="av-cb__cta" href="#av-cb-top">Choose Your Supply</a>
      </div>
    </div>
  </section>

  <section class="av-cb__section av-cb__section--soft">
    <div class="av-cb__wrap">
      <header class="av-cb__head"><div class="av-cb__eyebrow">Questions, answered</div><h2>Berberine + Ceylon Cinnamon FAQ</h2></header>
      <div class="av-cb__faq">
        <details><summary>What is in each daily serving?</summary><p>Each 4-softgel daily serving provides 1,200 mg Ceylon cinnamon, 400 mg Berberine HCl, and 200 mg MCT oil.</p></details>
        <details><summary>How long does one bottle last?</summary><p>Each bottle contains 120 softgels. At 4 softgels per daily serving, that equals 30 servings — a full 30-day supply.</p></details>
        <details><summary>Why Ceylon instead of common cassia?</summary><p>Ceylon cinnamon is Cinnamomum verum, often called true cinnamon. It is naturally much lower in coumarin than common cassia cinnamon.</p></details>
        <details><summary>Why combine Ceylon cinnamon with berberine?</summary><p>The formula pairs two distinct botanical ingredients commonly used in metabolic-wellness products, giving you one combined daily routine instead of separate bottles.*</p></details>
        <details><summary>What does the MCT oil do?</summary><p>MCT oil provides the oil base for the softgel format and distinguishes this product from a basic dry powder-only capsule.</p></details>
        <details><summary>Can I take it with medications?</summary><p>Berberine can interact with medications. Speak with a qualified healthcare professional before use if you take prescription medication, are pregnant or nursing, or have a medical condition.</p></details>
        <details><summary>Is this currently a subscription?</summary><p>This bottle is designed as a 30-day supply. Recurring delivery is only available when a subscription option is shown in the purchase area.</p></details>
      </div>
      <p class="av-cb__disclaimer">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual experiences vary.</p>
    </div>
  </section>

  <div class="av-cb__sticky">
    <b>Berberine + Ceylon · {{ av_cb_unit_price | money }}</b>
    <a href="#av-cb-top">Choose Supply</a>
  </div>

  <script>
    (() => {
      const root = document.currentScript.closest('[data-av-cb]');
      if (!root) return;
      const unit = Number(root.dataset.unitPrice || 0);
      const qtyInput = root.querySelector('[data-av-cb-quantity]');
      const total = root.querySelector('[data-av-cb-price]');
      const btnTotal = root.querySelector('[data-av-cb-button-price]');
      const supply = root.querySelector('[data-av-cb-supply]');
      const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'en-US', {style:'currency', currency:'USD'}).format(cents / 100);
      root.querySelectorAll('[data-av-cb-bundle]').forEach(btn => {
        btn.addEventListener('click', () => {
          const qty = Number(btn.dataset.avCbBundle || 1);
          root.querySelectorAll('[data-av-cb-bundle]').forEach(x => x.classList.toggle('is-active', x === btn));
          if (qtyInput) qtyInput.value = qty;
          if (total) total.textContent = money(unit * qty);
          if (btnTotal) btnTotal.textContent = money(unit * qty);
          if (supply) supply.textContent = String(qty * 30) + '-day supply';
        });
      });
    })();
  </script>
</div>

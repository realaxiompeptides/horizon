{% liquid
  assign av_cb_product = product
  assign av_cb_variant = av_cb_product.selected_or_first_available_variant
  assign av_cb_form_id = 'AvonentCinnamonBerberineForm-' | append: av_cb_product.id
  assign av_cb_unit_price = av_cb_variant.price | default: av_cb_product.price
  assign av_cb_subscription = av_cb_variant.selling_plan_allocations.first
  assign av_cb_guarantee_image = av_cb_product.metafields.custom.av_cb_guarantee_image.value
  assign av_cb_guarantee_highlight = av_cb_product.metafields.custom.av_cb_guarantee_highlight_text.value | default: '30-Day'
  assign av_cb_guarantee_color = av_cb_product.metafields.custom.av_cb_guarantee_highlight_color.value | default: '#02C6EA'
  assign av_cb_stock_title = av_cb_product.metafields.custom.av_cb_low_stock_title.value | default: 'WARNING: Low Stock Notice'
  assign av_cb_stock_text = av_cb_product.metafields.custom.av_cb_low_stock_text.value | default: 'Inventory can move quickly during promotions. If Avonent fits your routine, ordering while stock is available can help avoid interruptions.'
  assign av_cb_display_title = av_cb_product.metafields.custom.av_cb_display_title.value | default: 'Berberine + True Ceylon Cinnamon'
  assign av_cb_rating_text = av_cb_product.metafields.custom.av_cb_rating_text.value | default: 'Rated 4.9 • Thousands of 5-Star Reviews'
  assign av_cb_benefit_1 = av_cb_product.metafields.custom.av_cb_benefit_1.value | default: 'Supports Healthy Glucose Metabolism*'
  assign av_cb_benefit_2 = av_cb_product.metafields.custom.av_cb_benefit_2.value | default: 'Supports Healthy Insulin Sensitivity*'
  assign av_cb_benefit_3 = av_cb_product.metafields.custom.av_cb_benefit_3.value | default: 'Supports Healthy Circulation & Metabolic Function*'
  assign av_cb_benefit_4 = av_cb_product.metafields.custom.av_cb_benefit_4.value | default: 'Supports Steady Everyday Metabolic Wellness*'
  assign av_cb_sold_percent = av_cb_product.metafields.custom.av_cb_sold_percent.value | default: 93
  assign av_cb_sale_badge = av_cb_product.metafields.custom.av_cb_sale_badge.value | default: 'Launch Sale'
  assign av_cb_compare_price = av_cb_product.metafields.custom.av_cb_compare_price.value
  assign av_cb_bundle_2_badge = av_cb_product.metafields.custom.av_cb_bundle_2_badge.value | default: 'Most Popular'
  assign av_cb_bundle_3_badge = av_cb_product.metafields.custom.av_cb_bundle_3_badge.value | default: 'Best Value'
  assign av_cb_low_stock_line = av_cb_product.metafields.custom.av_cb_low_stock_line.value | default: 'Low Stock – Selling Fast'
%}

<div class="av-cb" data-av-cb data-unit-price="{{ av_cb_unit_price }}" data-compare-price="{{ av_cb_compare_price | escape }}">
  <style>

    .av-cb__benefit-tile strong{font-size:18px;line-height:1.25;font-weight:600;color:inherit;max-width:220px}
    .av-cb__benefits-image-wrap{min-height:380px;display:flex;align-items:flex-end;justify-content:center;margin-top:12px}
    .av-cb__benefits-image{display:block;width:min(760px,100%);max-height:520px;object-fit:contain;object-position:center bottom}
    .av-cb__benefits-image-placeholder{width:min(760px,100%);min-height:380px;display:grid;place-items:end center;color:rgba(255,255,255,.78);border:1px dashed rgba(255,255,255,.32);border-bottom:0;border-radius:24px 24px 0 0;padding:28px;text-align:center;font-size:13px}
    .av-cb__benefits-disclaimer{font-size:10px;line-height:1.45;text-align:center;opacity:.72;margin:12px auto 18px;max-width:760px}
    @media(max-width:600px){.av-cb__benefits-section{padding:42px 18px 0}.av-cb__benefits-head{margin-bottom:26px}.av-cb__benefits-head h2{font-size:31px}.av-cb__benefits-head p{font-size:14px}.av-cb__benefits-grid{gap:26px 18px;margin-bottom:26px}.av-cb__benefit-icon{width:52px;height:52px}.av-cb__benefit-icon svg{width:46px;height:46px}.av-cb__benefit-icon img{max-width:48px;max-height:48px}.av-cb__benefit-tile strong{font-size:15px}.av-cb__benefits-image-wrap{min-height:320px;margin-top:6px}.av-cb__benefits-image{max-height:440px}.av-cb__benefits-image-placeholder{min-height:320px}}
    @media(max-width:600px){.av-cb__rating{font-size:12.5px;margin-bottom:10px}.av-cb__stars{font-size:16px}.av-cb__benefits{gap:13px;margin:15px 0 20px}.av-cb__benefit{font-size:14.5px;gap:10px}.av-cb__benefit-check{width:18px;height:18px;flex-basis:18px}.av-cb__sold{padding:13px 14px;margin-bottom:14px}.av-cb__sold-track{height:8px}.av-cb__sold-text{font-size:14px}.av-cb__pricing{gap:9px;margin-bottom:10px}.av-cb__sale-price{font-size:24px}.av-cb__compare-price{font-size:17px}.av-cb__sale-badge{font-size:10.5px;min-height:28px;padding:0 9px}.av-cb__low-stock-line{font-size:14px;margin:5px 0 14px;gap:8px}.av-cb__bundle{grid-template-columns:48px 1fr auto;gap:11px;padding:13px 12px}.av-cb__bundle-thumb{width:48px;height:48px}.av-cb__bundle-copy strong{font-size:16px}.av-cb__bundle-price strong{font-size:16px}.av-cb__bundle-price s{font-size:12px}.av-cb__refill-row{font-size:11px;gap:8px;margin-top:9px}.av-cb__refill-icon{width:18px;height:18px}.av-cb__top-stack{width:min(100% - 22px,1200px);margin:3px auto 24px;gap:8px}.av-cb__guarantee-card{grid-template-columns:62px 1fr;gap:12px;padding:15px 16px;border-radius:15px}.av-cb__guarantee-image{width:62px;height:62px}.av-cb__guarantee-image img{max-width:62px;max-height:62px}.av-cb__guarantee-seal{width:58px;height:58px;border-width:5px}.av-cb__guarantee-copy h3{font-size:17px}.av-cb__guarantee-copy p{font-size:12.5px}.av-cb__low-stock{padding:14px 15px;border-radius:15px;gap:9px}.av-cb__low-stock-icon{width:20px;height:20px;font-size:11px}.av-cb__low-stock h3{font-size:15px}.av-cb__low-stock p{font-size:12.5px}.av-cb__accordion summary{padding:14px 16px;font-size:16px}.av-cb__accordion-body{padding:0 16px 14px;font-size:12.5px}.av-cb__stats-section{padding:32px 22px 24px;border-radius:18px;background-position:center}.av-cb__stats-heading{font-size:31px;margin-bottom:22px}.av-cb__stat{grid-template-columns:92px 1fr;gap:14px;padding:17px 0}.av-cb__stat-number{font-size:50px}.av-cb__stat-label{font-size:14px}.av-cb__stats-cta{min-height:54px;margin-top:22px;font-size:15px}.av-cb__stats-guarantee{font-size:12px;margin-top:10px}}

  </style>

  <section class="av-cb__hero" id="av-cb-top">
    <div class="av-cb__wrap av-cb__hero-grid">
      <div class="av-cb__media">
        {% if av_cb_product.featured_image %}
          {{ av_cb_product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '500,700,900,1200', sizes: '(min-width: 900px) 48vw, 92vw', alt: 'Avonent Berberine + Ceylon Cinnamon softgels' }}
        {% else %}
          <div class="av-cb__formula-bottle">
            <b>AVONENT</b>
            <span>Berberine + Ceylon Cinnamon</span>
            <small>120 softgels · 30 daily servings</small>
          </div>
        {% endif %}
      </div>

      <div>
        <div class="av-cb__rating">
          <span class="av-cb__stars" aria-hidden="true">★★★★★</span>
          <span class="av-cb__rating-text">{{ av_cb_rating_text }}</span>
        </div>

        <h1 class="av-cb__title">{{ av_cb_display_title }}</h1>

        <div class="av-cb__benefits">
          {% assign av_cb_benefits = av_cb_benefit_1 | append: '||' | append: av_cb_benefit_2 | append: '||' | append: av_cb_benefit_3 | append: '||' | append: av_cb_benefit_4 | split: '||' %}
          {% for benefit in av_cb_benefits %}
            <div class="av-cb__benefit">
              <span class="av-cb__benefit-check" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="m4.2 10.2 3.4 3.4 8.2-8.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span>{{ benefit }}</span>
            </div>
          {% endfor %}
        </div>

        <div class="av-cb__sold" style="--sold: {{ av_cb_sold_percent }}%;">
          <div class="av-cb__sold-row">
            <div class="av-cb__sold-track" aria-hidden="true"><div class="av-cb__sold-fill"></div></div>
            <div class="av-cb__sold-text">{{ av_cb_sold_percent }}% Sold</div>
          </div>
        </div>

        <div class="av-cb__pricing">
          <span class="av-cb__sale-price" data-av-cb-price>{{ av_cb_unit_price | money }}</span>
          {% if av_cb_compare_price != blank %}
            <span class="av-cb__compare-price" data-av-cb-compare-price>${{ av_cb_compare_price }}</span>
          {% endif %}
          <span class="av-cb__sale-badge">{{ av_cb_sale_badge }}</span>
        </div>

        <div class="av-cb__low-stock-line"><span>{{ av_cb_low_stock_line }}</span></div>

        {% form 'product', av_cb_product, id: av_cb_form_id, class: 'av-cb__form' %}
          <input type="hidden" name="id" value="{{ av_cb_variant.id }}">
          <input type="hidden" name="quantity" value="1" data-av-cb-quantity>

          <div class="av-cb__bundles" role="group" aria-label="Choose supply">
            {% for qty in (1..3) %}
              {% if qty == 1 %}
                {% assign av_cb_bundle_title = av_cb_bundle_1_title %}
                {% assign av_cb_bundle_subtitle = av_cb_bundle_1_subtitle %}
              {% elsif qty == 2 %}
                {% assign av_cb_bundle_title = av_cb_bundle_2_title %}
                {% assign av_cb_bundle_subtitle = av_cb_bundle_2_subtitle %}
              {% else %}
                {% assign av_cb_bundle_title = av_cb_bundle_3_title %}
                {% assign av_cb_bundle_subtitle = av_cb_bundle_3_subtitle %}
              {% endif %}
              <button class="av-cb__bundle{% if qty == 1 %} is-active{% endif %}" type="button" data-av-cb-bundle="{{ qty }}">
                {% if qty == 2 and av_cb_bundle_2_badge != blank %}<span class="av-cb__badge">{{ av_cb_bundle_2_badge }}</span>{% endif %}
                {% if qty == 3 and av_cb_bundle_3_badge != blank %}<span class="av-cb__badge">{{ av_cb_bundle_3_badge }}</span>{% endif %}
                <span class="av-cb__bundle-thumb">
                  {% if av_cb_product.featured_image %}
                    {{ av_cb_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: av_cb_display_title }}
                  {% else %}
                    <span class="av-cb__bundle-thumb-fallback">AVONENT</span>
                  {% endif %}
                </span>
                <span class="av-cb__bundle-copy">
                  <strong>{{ av_cb_bundle_title }}</strong>
                  <span>{{ av_cb_bundle_subtitle }}</span>
                </span>
                <span class="av-cb__bundle-price">
                  <strong data-av-cb-bundle-price="{{ qty }}"></strong>
                  {% if av_cb_compare_price != blank %}<s data-av-cb-bundle-compare="{{ qty }}"></s>{% endif %}
                </span>
              </button>
            {% endfor %}
          </div>

          <button class="av-cb__buy" type="submit" {% unless av_cb_variant.available %}disabled{% endunless %}>
            {% if av_cb_variant.available %}{{ av_cb_add_to_cart_text }} · <span data-av-cb-button-price>{{ av_cb_unit_price | money }}</span>{% else %}Currently Unavailable{% endif %}
          </button>
        {% endform %}

        <div class="av-cb__refill-row" aria-label="Refill details">
          <span class="av-cb__refill-item">
            <span class="av-cb__refill-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M20 6v5h-5M4 18v-5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.2 10a7 7 0 0 0-11.9-3L4 9M5.8 14a7 7 0 0 0 11.9 3L20 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {{ av_cb_refill_text }}
          </span>
          <span class="av-cb__refill-divider" aria-hidden="true"></span>
          <span class="av-cb__refill-item">
            <span class="av-cb__refill-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {{ av_cb_cancel_text }}
          </span>
        </div>
      </div>
    </div>
  </section>


  <div class="av-cb__top-stack">
    <div class="av-cb__guarantee-card" style="--guarantee-highlight: {{ av_cb_guarantee_color }}; --guarantee-text: #171717;">
      <div class="av-cb__guarantee-image">
        {% if av_cb_guarantee_image != blank %}
          {{ av_cb_guarantee_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', alt: 'Avonent 30-Day Money-Back Guarantee' }}
        {% else %}
          <div class="av-cb__guarantee-seal"><span>30<br><small>DAYS</small></span></div>
        {% endif %}
      </div>
      <div class="av-cb__guarantee-copy">
        <h3>{{ av_cb_guarantee_heading }}</h3>
        <p><mark>{{ av_cb_guarantee_highlight }}</mark> {{ av_cb_guarantee_body }}</p>
      </div>
    </div>

    <div class="av-cb__low-stock" style="--low-stock: #D62828; --low-stock-bg: #FFF5F5;">
      <div class="av-cb__low-stock-icon" aria-hidden="true">!</div>
      <div>
        <h3>{{ av_cb_stock_title }}</h3>
        <p>{{ av_cb_stock_text }}</p>
      </div>
    </div>

    <div class="av-cb__accordion-list" data-av-cb-accordion-list>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_1_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_1_body | newline_to_br }}</div>
      </details>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_2_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_2_body | newline_to_br }}</div>
      </details>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_3_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_3_body | newline_to_br }}</div>
      </details>
    </div>

    <div class="av-cb__trust-image-section" style="margin-top:10px;">
      {% if av_cb_trust_image != blank %}
        <span style="display:block;width:100%;">{{ av_cb_trust_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 1200px, calc(100vw - 22px)', alt: av_cb_trust_image_alt, style: 'display:block;width:100%;height:auto;border-radius:18px;' }}</span>
      {% else %}
        <img src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-why-trust-avonent.png?v=1793242624" alt="{{ av_cb_trust_image_alt | escape }}" loading="lazy" style="display:block;width:100%;height:auto;border-radius:18px;">
      {% endif %}
    </div>

    {% unless av_cb_stats_show == false %}
      {% assign av_cb_stats_opacity = av_cb_stats_overlay_opacity | divided_by: 100.0 %}
      <section
        class="av-cb__stats-section"
        data-av-cb-stats
        style="--stats-overlay: {{ av_cb_stats_overlay_color }}; --stats-opacity: {{ av_cb_stats_opacity }}; --stats-text: {{ av_cb_stats_text_color }};{% if av_cb_stats_bg != blank %} --stats-bg: url('{{ av_cb_stats_bg | image_url: width: 1800 }}');{% endif %}"
      >
        <h2 class="av-cb__stats-heading">{{ av_cb_stats_heading }}</h2>
        <div class="av-cb__stats-list">
          {% for i in (1..4) %}
            {% case i %}
              {% when 1 %}
                {% assign av_cb_stat_start = av_cb_stat_1_start %}
                {% assign av_cb_stat_end = av_cb_stat_1_end %}
                {% assign av_cb_stat_label = av_cb_stat_1_label %}
              {% when 2 %}
                {% assign av_cb_stat_start = av_cb_stat_2_start %}
                {% assign av_cb_stat_end = av_cb_stat_2_end %}
                {% assign av_cb_stat_label = av_cb_stat_2_label %}
              {% when 3 %}
                {% assign av_cb_stat_start = av_cb_stat_3_start %}
                {% assign av_cb_stat_end = av_cb_stat_3_end %}
                {% assign av_cb_stat_label = av_cb_stat_3_label %}
              {% else %}
                {% assign av_cb_stat_start = av_cb_stat_4_start %}
                {% assign av_cb_stat_end = av_cb_stat_4_end %}
                {% assign av_cb_stat_label = av_cb_stat_4_label %}
            {% endcase %}
            {% if av_cb_stat_label != blank %}
              <div class="av-cb__stat">
                {% if av_cb_stat_end != blank %}
                  <span class="av-cb__stat-number" data-start="{{ av_cb_stat_start }}" data-end="{{ av_cb_stat_end }}" data-duration="{{ av_cb_stats_duration }}">{{ av_cb_stat_start }}%</span>
                {% else %}
                  <span class="av-cb__stat-number" aria-label="Add a verified percentage in Shopify">—%</span>
                {% endif %}
                <div class="av-cb__stat-label">{{ av_cb_stat_label | newline_to_br }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <a class="av-cb__stats-cta" href="#av-cb-top">{{ av_cb_stats_cta }}</a>
        <div class="av-cb__stats-guarantee">
          <span class="av-cb__stats-guarantee-icon" aria-hidden="true">
            {% if av_cb_stats_guarantee_icon != blank %}
              {{ av_cb_stats_guarantee_icon | image_url: width: 40 | image_tag: loading: 'lazy', widths: '20,30,40', alt: '' }}
            {% else %}
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5 19 6v5.5c0 4.4-2.7 7.8-7 9-4.3-1.2-7-4.6-7-9V6l7-2.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m8.8 12 2 2 4.5-4.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endif %}
          </span>
          <span>{{ av_cb_stats_guarantee }}</span>
        </div>
      </section>
    {% endunless %}
  </div>

  <section class="av-cb__carousel-section" data-av-cb-carousel>
    <h2 class="av-cb__carousel-heading">{{ av_cb_carousel_heading }}</h2>
    <div class="av-cb__carousel-shell">
      <div class="av-cb__carousel-track" data-av-cb-carousel-track>
        {% for i in (1..4) %}
          {% case i %}
            {% when 1 %}
              {% assign av_cb_card_image = av_cb_carousel_1_image %}
              {% assign av_cb_card_title = av_cb_carousel_1_title %}
              {% assign av_cb_card_body = av_cb_carousel_1_body %}
            {% when 2 %}
              {% assign av_cb_card_image = av_cb_carousel_2_image %}
              {% assign av_cb_card_title = av_cb_carousel_2_title %}
              {% assign av_cb_card_body = av_cb_carousel_2_body %}
            {% when 3 %}
              {% assign av_cb_card_image = av_cb_carousel_3_image %}
              {% assign av_cb_card_title = av_cb_carousel_3_title %}
              {% assign av_cb_card_body = av_cb_carousel_3_body %}
            {% else %}
              {% assign av_cb_card_image = av_cb_carousel_4_image %}
              {% assign av_cb_card_title = av_cb_carousel_4_title %}
              {% assign av_cb_card_body = av_cb_carousel_4_body %}
          {% endcase %}
          <article class="av-cb__carousel-card" data-av-cb-carousel-card>
            <div class="av-cb__carousel-media">
              {% if av_cb_card_image != blank %}
                {{ av_cb_card_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1000,1200', sizes: '(min-width: 900px) 520px, 82vw', alt: av_cb_card_title }}
              {% elsif av_cb_product.featured_image %}
                {{ av_cb_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1000,1200', sizes: '(min-width: 900px) 520px, 82vw', alt: av_cb_card_title }}
              {% endif %}
            </div>
            <div class="av-cb__carousel-content">
              <h3>{{ av_cb_card_title }}</h3>
              <p>{{ av_cb_card_body | newline_to_br }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
    <div class="av-cb__carousel-controls">
      <div class="av-cb__carousel-dots" aria-label="Formula carousel pagination">
        {% for i in (1..4) %}
          <button type="button" class="av-cb__carousel-dot{% if i == 1 %} is-active{% endif %}" data-av-cb-carousel-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ i }}"></button>
        {% endfor %}
      </div>
      <div class="av-cb__carousel-arrows">
        <button type="button" class="av-cb__carousel-arrow" data-av-cb-carousel-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" fill="none"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="av-cb__carousel-arrow" data-av-cb-carousel-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" fill="none"><path d="m9.5 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section class="av-cb__science-section" data-av-cb-science style="--science-bg:{{ av_cb_science_bg }};--science-accent:{{ av_cb_science_accent }};">
    <div class="av-cb__science-wrap">
      <header class="av-cb__science-head">
        <h2>{{ av_cb_science_heading | replace: 'Benefits.', '<em>Benefits.</em>' }}</h2>
        <p>{{ av_cb_science_intro | newline_to_br }}</p>
      </header>

      <div class="av-cb__science-cards">
        {% for i in (1..4) %}
          {% case i %}
            {% when 1 %}
              {% assign av_cb_science_image = av_cb_science_1_image %}
              {% assign av_cb_science_title = av_cb_science_1_title %}
              {% assign av_cb_science_subtitle = av_cb_science_1_subtitle %}
              {% assign av_cb_science_body = av_cb_science_1_body %}
            {% when 2 %}
              {% assign av_cb_science_image = av_cb_science_2_image %}
              {% assign av_cb_science_title = av_cb_science_2_title %}
              {% assign av_cb_science_subtitle = av_cb_science_2_subtitle %}
              {% assign av_cb_science_body = av_cb_science_2_body %}
            {% when 3 %}
              {% assign av_cb_science_image = av_cb_science_3_image %}
              {% assign av_cb_science_title = av_cb_science_3_title %}
              {% assign av_cb_science_subtitle = av_cb_science_3_subtitle %}
              {% assign av_cb_science_body = av_cb_science_3_body %}
            {% else %}
              {% assign av_cb_science_image = av_cb_science_4_image %}
              {% assign av_cb_science_title = av_cb_science_4_title %}
              {% assign av_cb_science_subtitle = av_cb_science_4_subtitle %}
              {% assign av_cb_science_body = av_cb_science_4_body %}
          {% endcase %}
          <details class="av-cb__science-card">
            <summary>
              <span class="av-cb__science-thumb">
                {% if av_cb_science_image != blank %}
                  {{ av_cb_science_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180,300,500', sizes: '150px', alt: av_cb_science_title }}
                {% else %}
                  {% case i %}
                    {% when 1 %}
                      <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="19" r="8" stroke="currentColor" stroke-width="3"/><circle cx="32" cy="45" r="8" stroke="currentColor" stroke-width="3"/><path d="M18 8c-5 8-5 40 0 48M46 8c5 8 5 40 0 48" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                    {% when 2 %}
                      <svg viewBox="0 0 64 64" fill="none"><path d="M12 46c12-24 30-28 40-27-3 16-14 30-36 30" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 46c9-8 17-15 30-21" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                    {% when 3 %}
                      <svg viewBox="0 0 64 64" fill="none"><path d="M18 43c0-11 5-18 14-18s14 7 14 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M24 22c2-8 6-12 8-12s6 4 8 12" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="32" cy="38" r="5" stroke="currentColor" stroke-width="3"/></svg>
                    {% else %}
                      <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="22" stroke="currentColor" stroke-width="3"/><path d="M32 18v14l10 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% endcase %}
                {% endif %}
              </span>
              <span class="av-cb__science-copy">
                <h3>{{ av_cb_science_title }}</h3>
                <p>{{ av_cb_science_subtitle }}</p>
              </span>
              <span class="av-cb__science-toggle" aria-hidden="true"></span>
            </summary>
            <div class="av-cb__science-body">{{ av_cb_science_body | newline_to_br }}</div>
          </details>
        {% endfor %}
      </div>

      <div class="av-cb__science-cta-wrap">
        <a href="#av-cb-top" class="av-cb__science-cta">{{ av_cb_science_cta }}</a>
        <div class="av-cb__science-guarantee">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5 19 6v5.5c0 4.4-2.7 7.8-7 9-4.3-1.2-7-4.6-7-9V6l7-2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.8 12 2 2 4.5-4.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{{ av_cb_science_guarantee }}</span>
        </div>
      </div>
    </div>

    <div class="av-cb__science-ticker" aria-label="Formula highlights">
      <div class="av-cb__science-ticker-track">
        {% for pass in (1..2) %}
          <div class="av-cb__science-ticker-group" {% if pass == 2 %}aria-hidden="true"{% endif %}>
            {% for i in (1..4) %}
              {% case i %}
                {% when 1 %}{% assign av_cb_ticker_text = av_cb_science_ticker_1 %}
                {% when 2 %}{% assign av_cb_ticker_text = av_cb_science_ticker_2 %}
                {% when 3 %}{% assign av_cb_ticker_text = av_cb_science_ticker_3 %}
                {% else %}{% assign av_cb_ticker_text = av_cb_science_ticker_4 %}
              {% endcase %}
              <span class="av-cb__science-ticker-item">
                <span class="av-cb__science-ticker-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="m4.2 10.2 3.4 3.4 8.2-8.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                {{ av_cb_ticker_text }}
              </span>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>


  <section class="av-cb__journey">
    <div class="av-cb__journey-wrap">
      <div class="av-cb__journey-image">
        {% if av_cb_journey_image != blank %}
          {{ av_cb_journey_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,1800', sizes: '(min-width:900px) 900px, calc(100vw - 22px)', alt: av_cb_journey_heading }}
        {% elsif av_cb_product.featured_image %}
          {{ av_cb_product.featured_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,1800', sizes: '(min-width:900px) 900px, calc(100vw - 22px)', alt: av_cb_journey_heading }}
        {% else %}
          <div class="av-cb__journey-image-placeholder">Add your journey banner in the “CB Journey Image” product metafield.</div>
        {% endif %}
      </div>

      <header class="av-cb__journey-head">
        <div class="av-cb__journey-eyebrow">{{ av_cb_journey_eyebrow }}</div>
        <h2>{{ av_cb_journey_heading }}</h2>
        <p>{{ av_cb_journey_intro | newline_to_br }}</p>
      </header>

      <div class="av-cb__timeline">
        {% for i in (1..4) %}
          {% case i %}
            {% when 1 %}{% assign jlabel = av_cb_journey_1_label %}{% assign jbody = av_cb_journey_1_body %}
            {% when 2 %}{% assign jlabel = av_cb_journey_2_label %}{% assign jbody = av_cb_journey_2_body %}
            {% when 3 %}{% assign jlabel = av_cb_journey_3_label %}{% assign jbody = av_cb_journey_3_body %}
            {% else %}{% assign jlabel = av_cb_journey_4_label %}{% assign jbody = av_cb_journey_4_body %}
          {% endcase %}
          <div class="av-cb__timeline-item">
            <span class="av-cb__timeline-dot" aria-hidden="true"></span>
            <div class="av-cb__timeline-label">{{ jlabel }}</div>
            <div class="av-cb__timeline-list">
              {% assign journey_lines = jbody | newline_to_br | split: '<br />' %}
              {% for line in journey_lines %}
                {% if line != blank %}
                  <div class="av-cb__timeline-line"><span class="av-cb__timeline-check">✓</span><span>{{ line }}</span></div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>


  <section class="av-cb__benefits-section" style="--benefits-bg:{{ av_cb_benefits_bg }};--benefits-text:{{ av_cb_benefits_text }};">
    <div class="av-cb__benefits-inner">
      <header class="av-cb__benefits-head">
        <h2>{{ av_cb_benefits_heading }}</h2>
        <p>{{ av_cb_benefits_subheading | newline_to_br }}</p>
      </header>

      <div class="av-cb__benefits-grid">
        {% for i in (1..4) %}
          {% case i %}
            {% when 1 %}
              {% assign av_cb_benefit_icon = av_cb_benefits_icon_1 %}
              {% assign av_cb_benefit_title = av_cb_benefits_item_1 %}
            {% when 2 %}
              {% assign av_cb_benefit_icon = av_cb_benefits_icon_2 %}
              {% assign av_cb_benefit_title = av_cb_benefits_item_2 %}
            {% when 3 %}
              {% assign av_cb_benefit_icon = av_cb_benefits_icon_3 %}
              {% assign av_cb_benefit_title = av_cb_benefits_item_3 %}
            {% else %}
              {% assign av_cb_benefit_icon = av_cb_benefits_icon_4 %}
              {% assign av_cb_benefit_title = av_cb_benefits_item_4 %}
          {% endcase %}
          <div class="av-cb__benefit-tile">
            <span class="av-cb__benefit-icon" aria-hidden="true">
              {% if av_cb_benefit_icon != blank %}
                {{ av_cb_benefit_icon | image_url: width: 140 | image_tag: loading: 'lazy', widths: '70,100,140', alt: '' }}
              {% else %}
                {% case i %}
                  {% when 1 %}
                    <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="20" r="8" stroke="currentColor" stroke-width="3"/><circle cx="32" cy="44" r="8" stroke="currentColor" stroke-width="3"/><path d="M18 8c-5 8-5 40 0 48M46 8c5 8 5 40 0 48" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 64 64" fill="none"><path d="M18 44c0-11 5-18 14-18s14 7 14 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M24 22c2-8 6-12 8-12s6 4 8 12" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="32" cy="38" r="5" stroke="currentColor" stroke-width="3"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 64 64" fill="none"><path d="M14 43c12-22 30-25 38-24-3 13-13 28-34 29" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 44c8-8 15-14 28-20" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="22" stroke="currentColor" stroke-width="3"/><path d="M32 18v14l10 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endcase %}
              {% endif %}
            </span>
            <strong>{{ av_cb_benefit_title }}</strong>
          </div>
        {% endfor %}
      </div>

      <div class="av-cb__benefits-image-wrap">
        {% if av_cb_benefits_image != blank %}
          {{ av_cb_benefits_image | image_url: width: 1800 | image_tag: class: 'av-cb__benefits-image', loading: 'lazy', widths: '600,900,1200,1600,1800', sizes: '(min-width:900px) 760px, 100vw', alt: av_cb_benefits_heading }}
        {% elsif av_cb_product.featured_image %}
          {{ av_cb_product.featured_image | image_url: width: 1600 | image_tag: class: 'av-cb__benefits-image', loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width:900px) 760px, 100vw', alt: av_cb_display_title }}
        {% else %}
          <div class="av-cb__benefits-image-placeholder">Add your bottom product image in the “CB Benefits Bottom Image” product metafield.</div>
        {% endif %}
      </div>
      <p class="av-cb__benefits-disclaimer">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
    </div>
  </section>


  <div class="av-cb__sticky">
    <b>{{ av_cb_product.title }} · {{ av_cb_unit_price | money }}</b>
    <a href="#av-cb-top">Choose Supply</a>
  </div>

  <script>
    (() => {
      const root = document.currentScript.closest('[data-av-cb]');
      document.documentElement.classList.add('av-cb-cinnamon-page');
      const saleHeading = document.querySelector('.avonent-sale-bar__heading');
      if (saleHeading) saleHeading.textContent = 'FALL SALE';
      const saleBar = document.querySelector('.avonent-sale-bar__inner');
      if (saleBar) {
        saleBar.style.setProperty('--av-sale-bg', '#A84F1B');
        saleBar.style.setProperty('--av-sale-color', '#FFFFFF');
      }
      if (!root) return;
      const unit = Number(root.dataset.unitPrice || 0);
      const compareDollars = Number.parseFloat(root.dataset.comparePrice || '');
      const compareUnit = Number.isFinite(compareDollars) ? Math.round(compareDollars * 100) : null;
      const qtyInput = root.querySelector('[data-av-cb-quantity]');
      const total = root.querySelector('[data-av-cb-price]');
      const btnTotal = root.querySelector('[data-av-cb-button-price]');
      const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'en-US', {style:'currency', currency:'USD'}).format(cents / 100);
      root.querySelectorAll('[data-av-cb-bundle-price]').forEach(el => {
        const qty = Number(el.dataset.avCbBundlePrice || 1);
        el.textContent = money(unit * qty);
      });
      if (compareUnit) {
        root.querySelectorAll('[data-av-cb-bundle-compare]').forEach(el => {
          const qty = Number(el.dataset.avCbBundleCompare || 1);
          el.textContent = money(compareUnit * qty);
        });
      }
      root.querySelectorAll('[data-av-cb-bundle]').forEach(btn => {
        btn.addEventListener('click', () => {
          const qty = Number(btn.dataset.avCbBundle || 1);
          root.querySelectorAll('[data-av-cb-bundle]').forEach(x => x.classList.toggle('is-active', x === btn));
          if (qtyInput) qtyInput.value = qty;
          if (total) total.textContent = money(unit * qty);
          if (btnTotal) btnTotal.textContent = money(unit * qty);
        });
      });
      const statsSections = root.querySelectorAll('[data-av-cb-stats]');
      const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      statsSections.forEach(section => {
        const numbers = section.querySelectorAll('.av-cb__stat-number');
        const run = () => {
          numbers.forEach(el => {
            if (el.dataset.animated === 'true') return;
            el.dataset.animated = 'true';
            const start = Number(el.dataset.start || 0);
            const end = Number(el.dataset.end || 0);
            const duration = Math.max(150, Number(el.dataset.duration || 1200));
            if (reduceMotion || start === end) {
              el.textContent = Math.round(end) + '%';
              return;
            }
            const started = performance.now();
            const tick = now => {
              const progress = Math.min(1, (now - started) / duration);
              const eased = 1 - Math.pow(1 - progress, 3);
              const value = Math.round(start + (end - start) * eased);
              el.textContent = value + '%';
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        };
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                run();
                observer.disconnect();
              }
            });
          }, {threshold:.28});
          observer.observe(section);
        } else {
          run();
        }
      });
      const carousels = root.querySelectorAll('[data-av-cb-carousel]');
      carousels.forEach(carousel => {
        const track = carousel.querySelector('[data-av-cb-carousel-track]');
        const cards = Array.from(carousel.querySelectorAll('[data-av-cb-carousel-card]'));
        const dots = Array.from(carousel.querySelectorAll('[data-av-cb-carousel-dot]'));
        const prev = carousel.querySelector('[data-av-cb-carousel-prev]');
        const next = carousel.querySelector('[data-av-cb-carousel-next]');
        if (!track || !cards.length) return;
        const setActive = index => dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        const goTo = index => {
          const safe = Math.max(0, Math.min(cards.length - 1, index));
          track.scrollTo({left: cards[safe].offsetLeft - track.offsetLeft, behavior:'smooth'});
          setActive(safe);
        };
        const currentIndex = () => {
          const trackLeft = track.getBoundingClientRect().left;
          let best = 0;
          let distance = Infinity;
          cards.forEach((card, i) => {
            const d = Math.abs(card.getBoundingClientRect().left - trackLeft);
            if (d < distance) { distance = d; best = i; }
          });
          return best;
        };
        prev?.addEventListener('click', () => goTo(currentIndex() - 1));
        next?.addEventListener('click', () => goTo(currentIndex() + 1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
        let scrollTimer;
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => setActive(currentIndex()), 80);
        }, {passive:true});
      });
      const scienceSections = root.querySelectorAll('[data-av-cb-science]');
      scienceSections.forEach(section => {
        const cards = Array.from(section.querySelectorAll('.av-cb__science-card'));
        cards.forEach(card => {
          card.addEventListener('toggle', () => {
            if (!card.open) return;
            cards.forEach(other => {
              if (other !== card) other.open = false;
            });
          });
        });
      });
      const accordions = root.querySelectorAll('.av-cb__accordion');
      accordions.forEach(item => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          accordions.forEach(other => {
            if (other !== item) other.open = false;
          });
        });
      });
    })();
  </script>
</div>


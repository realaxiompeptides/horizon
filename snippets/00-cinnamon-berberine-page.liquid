    <div class="av-cb__faq-wrap">
      <h2 class="av-cb__faq-heading">{{ av_cb_faq_heading }}</h2>
      <div class="av-cb__faq-list">
        {% for i in (1..6) %}
          {% case i %}
            {% when 1 %}{% assign faq_q = av_cb_faq_1_q %}{% assign faq_a = av_cb_faq_1_a %}
            {% when 2 %}{% assign faq_q = av_cb_faq_2_q %}{% assign faq_a = av_cb_faq_2_a %}
            {% when 3 %}{% assign faq_q = av_cb_faq_3_q %}{% assign faq_a = av_cb_faq_3_a %}
            {% when 4 %}{% assign faq_q = av_cb_faq_4_q %}{% assign faq_a = av_cb_faq_4_a %}
            {% when 5 %}{% assign faq_q = av_cb_faq_5_q %}{% assign faq_a = av_cb_faq_5_a %}
            {% else %}{% assign faq_q = av_cb_faq_6_q %}{% assign faq_a = av_cb_faq_6_a %}
          {% endcase %}
          {% if faq_q != blank and faq_a != blank %}
            <details class="av-cb__faq-item">
              <summary><span>{{ faq_q }}</span><span class="av-cb__faq-plus" aria-hidden="true"></span></summary>
              <div class="av-cb__faq-answer">{{ faq_a | newline_to_br }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>


  <div class="av-cb__sticky" aria-label="Quick add to cart">
    <span class="av-cb__sticky-img">
      {% if av_cb_product.featured_image %}
        {{ av_cb_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: av_cb_product.title }}
      {% endif %}
    </span>
    <span class="av-cb__sticky-copy">
      <span class="av-cb__sticky-title">Ceylon Cinnamon + Berberine HCl</span>
      <span class="av-cb__sticky-price" data-av-cb-sticky-price>{{ av_cb_subscription_unit_price | money }}</span>
    </span>
    <button class="av-cb__sticky-add" type="button" data-av-cb-sticky-add>Add to Cart</button>
  </div>

  <script>
    (() => {
      const root = document.currentScript.closest('[data-av-cb]');
      document.documentElement.classList.add('av-cb-cinnamon-page');
      const headerLogo = document.querySelector('a.header-logo');
      if (headerLogo && !headerLogo.querySelector('.av-cb-header-logo')) {
        headerLogo.innerHTML = '<span class="av-cb-header-logo" aria-label="Avonent"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="20.5" stroke="currentColor" stroke-width="2.8"/><path d="M26.8 8.8 15.9 25h8.1l-2.7 14.2L33.5 21h-8.2l1.5-12.2Z" stroke="currentColor" stroke-width="2.8" stroke-linejoin="round"/></svg><span>Avonent</span></span>';
      }
      const saleHeading = document.querySelector('.avonent-sale-bar__heading');
      if (saleHeading) saleHeading.textContent = 'FALL SALE';
      const saleSubheading = document.querySelector('.avonent-sale-bar__subheading');
      if (saleSubheading) saleSubheading.textContent = 'Save up to 65% today';
      const saleBar = document.querySelector('.avonent-sale-bar__inner');
      if (saleBar) {
        saleBar.style.setProperty('--av-sale-bg', '#A84F1B');
        saleBar.style.setProperty('--av-sale-color', '#FFFFFF');
      }
      if (!root) return;
      const subscriptionUnit = Number(root.dataset.subscriptionUnitPrice || 0);
      const oneTimeUnit = Number(root.dataset.oneTimeUnitPrice || 0);
      const oneTimeCompareUnit = Number(root.dataset.oneTimeCompareUnitPrice || 0);
      const qtyInput = root.querySelector('[data-av-cb-quantity]');
      const sellingPlanInput = root.querySelector('[data-av-cb-selling-plan]');
      const total = root.querySelector('[data-av-cb-price]');
      const topCompare = root.querySelector('[data-av-cb-compare-price]');
      const btnTotal = root.querySelector('[data-av-cb-button-price]');
      const btnCompare = root.querySelector('[data-av-cb-button-compare]');
      const stickyPrice = root.querySelector('[data-av-cb-sticky-price]');
      const refillRow = root.querySelector('.av-cb__refill-row');
      const purchaseToggle = root.querySelector('[data-av-cb-purchase-toggle]');
      const purchaseToggleText = root.querySelector('[data-av-cb-purchase-toggle-text]');
      const purchaseHeading = root.querySelector('[data-av-cb-purchase-heading]');
      const bundleButtons = Array.from(root.querySelectorAll('[data-av-cb-bundle]'));
      const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'en-US', {style:'currency', currency:'USD'}).format(Number(cents || 0) / 100);
      let purchaseMode = sellingPlanInput ? 'subscription' : 'one-time';

      const selectedBundle = () => root.querySelector('[data-av-cb-bundle].is-active') || bundleButtons[0];
      const valuesFor = (btn) => {
        const qty = Number(btn?.dataset.avCbBundle || 1);
        const isSubscription = purchaseMode === 'subscription' && sellingPlanInput;
        return {
          qty,
          price: Number(isSubscription ? btn?.dataset.subscriptionPrice : btn?.dataset.oneTimePrice) || 0,
          compare: Number(isSubscription ? btn?.dataset.subscriptionCompare : btn?.dataset.oneTimeCompare) || 0
        };
      };
      const setCompare = (el, value, base) => {
        if (!el) return;
        const show = Number(value) > Number(base);
        el.textContent = show ? money(value) : '';
        el.hidden = !show;
      };
      const renderMode = () => {
        const isSubscription = purchaseMode === 'subscription' && sellingPlanInput;
        if (sellingPlanInput) {
          sellingPlanInput.disabled = !isSubscription;
          if (isSubscription) sellingPlanInput.value = sellingPlanInput.dataset.planId || root.dataset.subscriptionPlanId || '';
        }
        if (refillRow) refillRow.hidden = !isSubscription;
        if (purchaseToggle) purchaseToggle.setAttribute('aria-pressed', String(!isSubscription));
        if (purchaseHeading) purchaseHeading.textContent = isSubscription ? 'Subscribe & Save' : 'One-Time Purchase';

        bundleButtons.forEach((btn) => {
          const values = valuesFor(btn);
          const priceEl = btn.querySelector('[data-av-cb-bundle-price]');
          const compareEl = btn.querySelector('[data-av-cb-bundle-compare]');
          if (priceEl) priceEl.textContent = money(values.price);
          setCompare(compareEl, values.compare, values.price);
        });

        const active = selectedBundle();
        const values = valuesFor(active);
        if (qtyInput) qtyInput.value = values.qty;
        if (total) total.textContent = money(values.price);
        if (btnTotal) btnTotal.textContent = money(values.price);
        if (stickyPrice) stickyPrice.textContent = money(values.price);
        setCompare(topCompare, values.compare, values.price);
        setCompare(btnCompare, values.compare, values.price);

        if (purchaseToggleText) {
          if (isSubscription) purchaseToggleText.innerHTML = 'One-Time Purchase <strong>' + money(oneTimeUnit * values.qty) + '</strong> + $4.95 Shipping';
          else purchaseToggleText.innerHTML = 'Switch back to Subscribe & Save — <strong>' + money(subscriptionUnit * values.qty) + '</strong>';
        }
      };

      bundleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          bundleButtons.forEach(x => x.classList.toggle('is-active', x === btn));
          renderMode();
        });
      });
      purchaseToggle?.addEventListener('click', () => {
        purchaseMode = purchaseMode === 'subscription' ? 'one-time' : 'subscription';
        renderMode();
      });
      renderMode();

      const deliveryDate = root.querySelector('[data-av-cb-delivery-date]');
      if (deliveryDate) {
        const date = new Date();
        date.setDate(date.getDate() + 5);
        const day = date.getDate();
        const mod100 = day % 100;
        const suffix = mod100 >= 11 && mod100 <= 13 ? 'th' : ({1:'st',2:'nd',3:'rd'}[day % 10] || 'th');
        deliveryDate.textContent = date.toLocaleDateString(document.documentElement.lang || 'en-US', {month:'long'}) + ' ' + day + suffix;
      }
      const statsSections = root.querySelectorAll('[data-av-cb-stats]');
      const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      statsSections.forEach(section => {
        const numbers = section.querySelectorAll('.av-cb__stat-number');
        const run = () => {
          numbers.forEach(el => {
            if (el.dataset.animated === 'true') return;
            el.dataset.animated = 'true';
            const start = Number(el.dataset.start || 0);
            const end = Number(el.dataset.end || 0);
            const duration = Math.max(150, Number(el.dataset.duration || 1200));
            if (reduceMotion || start === end) {
              el.textContent = Math.round(end) + '%';
              return;
            }
            const started = performance.now();
            const tick = now => {
              const progress = Math.min(1, (now - started) / duration);
              const eased = 1 - Math.pow(1 - progress, 3);
              const value = Math.round(start + (end - start) * eased);
              el.textContent = value + '%';
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        };
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                run();
                observer.disconnect();
              }
            });
          }, {threshold:.28});
          observer.observe(section);
        } else {
          run();
        }
      });
      const carousels = root.querySelectorAll('[data-av-cb-carousel]');
      carousels.forEach(carousel => {
        const track = carousel.querySelector('[data-av-cb-carousel-track]');
        const cards = Array.from(carousel.querySelectorAll('[data-av-cb-carousel-card]'));
        const dots = Array.from(carousel.querySelectorAll('[data-av-cb-carousel-dot]'));
        const prev = carousel.querySelector('[data-av-cb-carousel-prev]');
        const next = carousel.querySelector('[data-av-cb-carousel-next]');
        if (!track || !cards.length) return;
        const setActive = index => dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        const goTo = index => {
          const safe = Math.max(0, Math.min(cards.length - 1, index));
          track.scrollTo({left: cards[safe].offsetLeft - track.offsetLeft, behavior:'smooth'});
          setActive(safe);
        };
        const currentIndex = () => {
          const trackLeft = track.getBoundingClientRect().left;
          let best = 0;
          let distance = Infinity;
          cards.forEach((card, i) => {
            const d = Math.abs(card.getBoundingClientRect().left - trackLeft);
            if (d < distance) { distance = d; best = i; }
          });
          return best;
        };
        prev?.addEventListener('click', () => goTo(currentIndex() - 1));
        next?.addEventListener('click', () => goTo(currentIndex() + 1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
        let scrollTimer;
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => setActive(currentIndex()), 80);
        }, {passive:true});
      });
      const scienceSections = root.querySelectorAll('[data-av-cb-science]');
      scienceSections.forEach(section => {
        const cards = Array.from(section.querySelectorAll('.av-cb__science-card'));
        cards.forEach(card => {
          card.addEventListener('toggle', () => {
            if (!card.open) return;
            cards.forEach(other => {
              if (other !== card) other.open = false;
            });
          });
        });
      });
      const faqSection = root.querySelector('[data-av-cb-faq]');
      if (faqSection) {
        const faqItems = Array.from(faqSection.querySelectorAll('.av-cb__faq-item'));
        faqItems.forEach(item => {
          item.addEventListener('toggle', () => {
            if (!item.open) return;
            faqItems.forEach(other => {
              if (other !== item) other.open = false;
            });
          });
        });
      }
      const stickyBar = root.querySelector('.av-cb__sticky');
      const firstAddToCart = root.querySelector('.av-cb__buy');
      if (stickyBar && firstAddToCart) {
        let stickyTicking = false;
        const updateStickyVisibility = () => {
          stickyBar.classList.toggle('is-visible', firstAddToCart.getBoundingClientRect().bottom < 0);
          stickyTicking = false;
        };
        const requestStickyUpdate = () => {
          if (stickyTicking) return;
          stickyTicking = true;
          requestAnimationFrame(updateStickyVisibility);
        };
        updateStickyVisibility();
        window.addEventListener('scroll', requestStickyUpdate, {passive:true});
        window.addEventListener('resize', requestStickyUpdate, {passive:true});
      }

      const stickyAdd = root.querySelector('[data-av-cb-sticky-add]');
      if (stickyAdd) {
        stickyAdd.addEventListener('click', () => {
          const top = root.querySelector('#av-cb-top');
          top?.scrollIntoView({behavior:'smooth', block:'start'});
        });
      }

      const accordions = root.querySelectorAll('.av-cb__accordion');
      accordions.forEach(item => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          accordions.forEach(other => {
            if (other !== item) other.open = false;
          });
        });
      });
    })();
  </script>
</div>

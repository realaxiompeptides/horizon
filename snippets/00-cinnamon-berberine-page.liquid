<section class="av-cb__reviews">
    <div class="av-cb__wrap">
      <div class="av-cb__reviews-head">
        <span aria-hidden="true">★★★★★</span>
        <h2>{{ editor.settings.reviews_heading }}</h2>
        <p>{{ editor.settings.reviews_intro }}</p>
      </div>

      {% assign av_cb_has_review_photo = false %}
      {% for review in editor.blocks %}
        {% if review.type == 'review' and review.settings.photo != blank %}
          {% assign av_cb_has_review_photo = true %}
        {% endif %}
      {% endfor %}
      {% if av_cb_has_review_photo %}
        <div class="av-cb__photo-track" tabindex="0" role="region" aria-label="Customer photos">
          {% for review in editor.blocks %}
            {% if review.type == 'review' and review.settings.photo != blank %}
              <figure {{ review.shopify_attributes }}>{{ review.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', alt: review.settings.name }}</figure>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="av-cb__review-track" tabindex="0" role="region" aria-label="Customer reviews">
        {% for review in editor.blocks %}
          {% if review.type == 'review' %}
            {% if review.settings.quote != blank %}
              {% assign av_cb_review_rating = review.settings.rating_display | default: review.settings.rating %}
              <article class="av-cb__review-card" {{ review.shopify_attributes }}>
                <div class="av-cb__review-rating" aria-label="{{ av_cb_review_rating }} out of 5 stars">

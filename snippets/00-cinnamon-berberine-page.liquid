    .av-cb__micro{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:10px}.av-cb__micro b{color:var(--ink)}
    .av-cb__trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.av-cb__trust-grid{display:grid;grid-template-columns:repeat(4,1fr)}.av-cb__trust-item{padding:18px;text-align:center;border-right:1px solid var(--line)}.av-cb__trust-item:last-child{border-right:0}.av-cb__trust-item b{display:block;font-size:14px}.av-cb__trust-item span{display:block;font-size:11px;color:var(--muted);margin-top:2px}

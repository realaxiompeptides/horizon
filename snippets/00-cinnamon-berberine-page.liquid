<div class="av-cb" data-av-cb data-subscription-unit-price="{{ av_cb_subscription_unit_price }}" data-one-time-unit-price="{{ av_cb_one_time_unit_price }}" data-one-time-compare-unit-price="{{ av_cb_one_time_compare_unit }}" data-subscription-plan-id="{{ av_cb_subscription_plan_id }}">
  <style>
    .av-cb{--blue:#A84F1B;--deep:#7D3612;--ink:#171513;--muted:#645C57;--line:#E7D2C4;--soft:#FFF4EC;--soft2:#FFFBF7;background:#fff;color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
    html.av-cb-cinnamon-page .avonent-sale-bar__inner{--av-sale-bg:#A84F1B!important;--av-sale-color:#fff!important;background:#A84F1B!important;color:#fff!important}
    html.av-cb-cinnamon-page .avonent-sale-bar{background:#A84F1B!important;color:#fff!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__inner{min-height:50px!important;padding:6px 12px!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__content{display:flex!important;align-items:center!important;justify-content:center!important;gap:18px!important;width:auto!important;max-width:100%!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__message{display:flex!important;flex-direction:column!important;align-items:center!important;text-align:center!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__heading{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif!important;font-size:15px!important;font-weight:800!important;line-height:1!important;letter-spacing:.02em!important;color:#fff!important;white-space:nowrap!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__subheading{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif!important;font-size:9px!important;font-weight:500!important;line-height:1.1!important;color:#fff!important;opacity:.9!important;white-space:nowrap!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__timer{display:flex!important;align-items:flex-start!important;color:#fff!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__unit{display:flex!important;flex-direction:column!important;align-items:center!important;min-width:27px!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__unit>span{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif!important;font-size:18px!important;font-weight:700!important;line-height:.95!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__unit small{font-size:7px!important;line-height:1!important;color:#fff!important}
    html.av-cb-cinnamon-page .avonent-sale-bar__colon{font-size:17px!important;line-height:.9!important;color:#fff!important}
    .av-cb-header-logo{display:inline-flex;align-items:center;gap:7px;color:#A84F1B;line-height:1;text-decoration:none!important}
    .av-cb-header-logo svg{width:32px;height:32px;flex:0 0 32px}
    .av-cb-header-logo span{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif;color:#111;font-size:24px;font-weight:750;letter-spacing:-.04em}
    .av-cb *{box-sizing:border-box}.av-cb a{text-decoration:none}.av-cb__wrap{width:min(1200px,calc(100% - 32px));margin:0 auto}
    .av-cb__hero{padding:34px 0 10px;background:linear-gradient(180deg,#fff 0%,#fff8f3 100%)}
    .av-cb__hero-grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:48px;align-items:center}
    .av-cb__media{min-height:0;border:0;border-radius:0;background:transparent;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:0}
    .av-cb__media img{display:block;width:100%;max-width:100%;height:auto;max-height:none;object-fit:contain;filter:none}
    .av-cb__formula-bottle{width:min(330px,85%);aspect-ratio:4/5;border-radius:28px;background:#fff;border:1px solid #d8edf2;box-shadow:0 28px 70px rgba(5,103,128,.13);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:34px}
    .av-cb__formula-bottle b{font-size:38px;line-height:1}.av-cb__formula-bottle span{font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin-top:10px;color:var(--deep)}.av-cb__formula-bottle small{margin-top:16px;color:var(--muted)}
    .av-cb__eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--deep);margin-bottom:12px}
    .av-cb__eyebrow:before{content:"";width:28px;height:3px;border-radius:99px;background:var(--blue)}
    .av-cb__title{font-size:clamp(32px,4vw,50px);line-height:1.02;letter-spacing:-.035em;margin:0 0 18px;font-weight:760;color:#171513;max-width:760px}
    .av-cb__subtitle{font-size:18px;line-height:1.55;color:var(--muted);margin:0 0 22px;max-width:650px}
    .av-cb__chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}.av-cb__chip{padding:9px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:12px;font-weight:700}
    .av-cb__price{display:flex;align-items:baseline;gap:10px;margin:0 0 15px}.av-cb__price strong{font-size:30px}.av-cb__price span{font-size:13px;color:var(--muted)}
    .av-cb__bundle-label{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin:0 0 9px}
    .av-cb__bundles{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}
    .av-cb__bundle{position:relative;border:1.5px solid var(--line);border-radius:16px;padding:15px 11px;background:#fff;cursor:pointer;text-align:left;transition:.18s ease}
    .av-cb__bundle:hover,.av-cb__bundle.is-active{border-color:var(--blue);box-shadow:0 0 0 2px rgba(168,79,27,.12)}.av-cb__bundle.is-active{background:var(--soft)}

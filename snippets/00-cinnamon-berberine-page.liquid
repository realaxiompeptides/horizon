    .av-cb__formula{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.av-cb__formula-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:26px;min-height:260px}.av-cb__formula-card .num{font-size:38px;font-weight:850;letter-spacing:-.04em;color:var(--blue)}.av-cb__formula-card .unit{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.09em;font-weight:800}.av-cb__formula-card h3{font-size:22px;margin:18px 0 9px}.av-cb__formula-card p{font-size:14px;line-height:1.6;color:var(--muted);margin:0}
    .av-cb__compare{display:grid;grid-template-columns:1fr 1fr;gap:18px}.av-cb__compare-card{border-radius:24px;padding:28px;background:#fff;border:1px solid var(--line)}.av-cb__compare-card--av{background:#0a92b3;border-color:#42cce8;color:#fff}.av-cb__compare-card h3{font-size:25px;margin:0 0 18px}.av-cb__row{display:flex;gap:10px;align-items:flex-start;padding:12px 0;border-top:1px solid rgba(255,255,255,.18)}.av-cb__compare-card:not(.av-cb__compare-card--av) .av-cb__row{border-color:var(--line)}.av-cb__check{width:22px;height:22px;border-radius:50%;background:var(--blue);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 22px}.av-cb__compare-card--av .av-cb__check{background:#8deeff;color:#07303b}.av-cb__row b{font-size:14px}.av-cb__row span{display:block;font-size:12px;opacity:.75;margin-top:2px}

html.av-cb-cinnamon-page body{margin:0!important}
html.av-cb-cinnamon-page .page-wrapper{margin:0!important;padding:0!important;width:100%;max-width:none}
html.av-cb-cinnamon-page #MainContent{margin:0;padding:0;width:100%;max-width:none}
html.av-cb-cinnamon-page .avonent-footer{width:100%;margin:0}
.av-cb{padding-bottom:0!important}.av-cb__stats-section{border-radius:0}
.av-cb__comparison{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:92px auto 30px;max-width:850px;align-items:stretch}
.av-cb__comparison-card{position:relative;background:#fff;color:#514e4b;border:1px solid #ddd;border-radius:20px;overflow:visible;padding-top:110px;text-align:center}
.av-cb__comparison-card--ours{background:#9f3e10;border-color:#9f3e10;color:#fff}
.av-cb__comparison-image{position:absolute;top:-70px;left:50%;transform:translateX(-50%);width:130px;height:140px;display:grid;place-items:center;pointer-events:none}
.av-cb__comparison-image img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 8px 12px #0002);background:transparent}
.av-cb__comparison-card h3{font-size:26px;font-weight:600;line-height:1.3;margin:0;padding:14px 12px 28px;color:inherit}
.av-cb__comparison-row{min-height:115px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;padding:18px 12px;border-top:1px solid #ddd;font-size:16px;line-height:1.4}
.av-cb__comparison-card--ours .av-cb__comparison-row{border-color:#ffffff45}
.av-cb__comparison-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#858181;color:#fff;line-height:1}
.av-cb__comparison-icon svg{width:16px;height:16px;display:block;fill:currentColor}
.av-cb__comparison-card--ours .av-cb__comparison-icon{background:rgba(255,255,255,.14);color:#fff}
.av-cb__compare-cta{max-width:680px;margin:auto}
.av-cb__reviews{padding:50px 0;background:#faf6f2}.av-cb__reviews-head{text-align:center}.av-cb__reviews-head>span{color:#b8612b;font-size:32px;letter-spacing:3px}.av-cb__reviews-head h2{font-size:clamp(28px,4vw,42px);margin:14px 0}.av-cb__reviews-head p{color:#605851}
.av-cb__photo-track,.av-cb__review-track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-inline:contain;padding:12px 0 20px;scrollbar-width:thin;scrollbar-color:#bd7950 #eaded5}
.av-cb__photo-track figure{flex:0 0 180px;height:190px;margin:0;border-radius:14px;overflow:hidden;scroll-snap-align:start}.av-cb__photo-track img{width:100%;height:100%;object-fit:cover}
.av-cb__review-card{flex:0 0 calc(50% - 8px);min-width:0;scroll-snap-align:start;background:white;border:1px solid #ddd;border-radius:18px;padding:28px;display:flex;flex-direction:column}
.av-cb__review-rating{display:flex;align-items:center;gap:12px}.av-cb__review-score{font-size:19px;font-weight:800;color:#171513}.av-cb__review-stars{color:#ab531f;font-size:23px;letter-spacing:1px}.av-cb__review-card h3{font-size:23px;margin:20px 0 12px}.av-cb__review-card p{font-size:17px;line-height:1.65;white-space:normal}.av-cb__review-card footer{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;margin-top:auto;padding-top:22px;border-top:1px solid #eee;font-size:13px}.av-cb__review-card footer span{color:#ab531f;font-weight:700}.av-cb__review-tags{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.av-cb__review-tag{display:flex;align-items:center;justify-content:center;min-height:38px;padding:7px 10px;border:1px solid #c86731;border-radius:999px;color:#b35421;background:#fff8f3;font-size:12px;font-weight:650;text-align:center}.av-cb__review-placeholder{display:grid;place-items:center;background:#e9dfd6;color:#65574d}
@media(max-width:600px){.av-cb__comparison{gap:12px;margin-top:76px}.av-cb__comparison-card{padding-top:86px;border-radius:14px}.av-cb__comparison-image{width:92px;height:108px;top:-56px}.av-cb__comparison-card h3{font-size:20px;padding:12px 8px 20px}.av-cb__comparison-row{font-size:13px;min-height:115px;padding:15px 8px}.av-cb__review-card{flex-basis:90%;padding:22px}.av-cb__photo-track figure{flex-basis:140px;height:155px}}

  </style>

  <section class="av-cb__hero" id="av-cb-top">
    <div class="av-cb__wrap av-cb__hero-grid">
      <div class="av-cb__media">
        {% if av_cb_hero_image %}
          {{ av_cb_hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '500,700,900,1200', sizes: '(min-width: 900px) 48vw, 92vw', alt: 'Avonent Berberine + Ceylon Cinnamon softgels' }}
        {% else %}
          <div class="av-cb__formula-bottle">
            <b>AVONENT</b>
            <span>Berberine + Ceylon Cinnamon</span>
            <small>120 softgels · 30 daily servings</small>
          </div>
        {% endif %}
      </div>

      <div>
        <div class="av-cb__rating">
          <span class="av-cb__stars" aria-hidden="true">★★★★★</span>
          <span class="av-cb__rating-text">{{ av_cb_rating_text }}</span>
        </div>

        <h1 class="av-cb__title">{{ av_cb_display_title }}</h1>

        <div class="av-cb__benefits">
          {% assign av_cb_benefits = av_cb_benefit_1 | append: '||' | append: av_cb_benefit_2 | append: '||' | append: av_cb_benefit_3 | append: '||' | append: av_cb_benefit_4 | split: '||' %}
          {% for benefit in av_cb_benefits %}
            <div class="av-cb__benefit">
              <span class="av-cb__benefit-check" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="m4.2 10.2 3.4 3.4 8.2-8.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span>{{ benefit }}</span>
            </div>
          {% endfor %}
        </div>

        <div class="av-cb__sold" style="--sold: {{ av_cb_sold_percent }}%;">
          <div class="av-cb__sold-row">
            <div class="av-cb__sold-track" aria-hidden="true"><div class="av-cb__sold-fill"></div></div>
            <div class="av-cb__sold-text">{{ av_cb_sold_percent }}% Sold</div>
          </div>
        </div>

        <div class="av-cb__pricing av-cb__pricing--purchase-mode">
          <span class="av-cb__purchase-heading" data-av-cb-purchase-heading>{% if av_cb_subscription != blank %}Subscribe &amp; Save{% else %}One-Time Purchase{% endif %}</span>
          <span class="av-cb__pricing-values">
            <span class="av-cb__sale-price" data-av-cb-price>{{ av_cb_subscription_unit_price | money }}</span>
            <span class="av-cb__compare-price" data-av-cb-compare-price{% if av_cb_subscription == blank and av_cb_one_time_compare_unit == 0 %} hidden{% endif %}>{% if av_cb_subscription != blank %}{{ av_cb_one_time_unit_price | money }}{% elsif av_cb_one_time_compare_unit > 0 %}{{ av_cb_one_time_compare_unit | money }}{% endif %}</span>
            <span class="av-cb__sale-badge">{{ av_cb_sale_badge }}</span>
          </span>
        </div>

        <div class="av-cb__low-stock-line"><span>{{ av_cb_low_stock_line }}</span></div>

        <product-form-component
          data-section-id="{{ editor.id }}"
          data-product-id="{{ av_cb_product.id }}"
          data-product-url="{{ av_cb_product.url }}"
          data-quantity-default="1"
          on:submit="/handleSubmit"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {% form 'product', av_cb_product, id: av_cb_form_id, class: 'av-cb__form', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" ref="variantId" value="{{ av_cb_variant.id }}">
          <input type="hidden" name="quantity" value="1" data-av-cb-quantity>
          {% if av_cb_subscription != blank %}
            <input type="hidden" name="selling_plan" value="{{ av_cb_subscription_plan_id }}" data-av-cb-selling-plan data-plan-id="{{ av_cb_subscription_plan_id }}">
          {% endif %}

          <div class="av-cb__bundles" role="group" aria-label="Choose supply">
            {% for qty in (1..3) %}
              {% if qty == 1 %}
                {% assign av_cb_bundle_title = av_cb_bundle_1_title %}
                {% assign av_cb_bundle_subtitle = av_cb_bundle_1_subtitle %}
              {% elsif qty == 2 %}
                {% assign av_cb_bundle_title = av_cb_bundle_2_title %}
                {% assign av_cb_bundle_subtitle = av_cb_bundle_2_subtitle %}
              {% else %}
                {% assign av_cb_bundle_title = av_cb_bundle_3_title %}
                {% assign av_cb_bundle_subtitle = av_cb_bundle_3_subtitle %}
              {% endif %}
              {% assign av_cb_bundle_sub_total = av_cb_subscription_unit_price | times: qty %}
              {% assign av_cb_bundle_one_time_total = av_cb_one_time_unit_price | times: qty %}
              {% assign av_cb_bundle_one_time_compare_total = av_cb_one_time_compare_unit | times: qty %}
              <button class="av-cb__bundle{% if qty == 1 %} is-active{% endif %}" type="button" data-av-cb-bundle="{{ qty }}" data-subscription-price="{{ av_cb_bundle_sub_total }}" data-subscription-compare="{{ av_cb_bundle_one_time_total }}" data-one-time-price="{{ av_cb_bundle_one_time_total }}" data-one-time-compare="{{ av_cb_bundle_one_time_compare_total }}">
                {% if qty == 2 and av_cb_bundle_2_badge != blank %}<span class="av-cb__badge">{{ av_cb_bundle_2_badge }}</span>{% endif %}
                {% if qty == 3 and av_cb_bundle_3_badge != blank %}<span class="av-cb__badge">{{ av_cb_bundle_3_badge }}</span>{% endif %}
                <span class="av-cb__bundle-thumb">
                  {% if av_cb_hero_image %}
                    {{ av_cb_hero_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: av_cb_display_title }}
                  {% else %}
                    <span class="av-cb__bundle-thumb-fallback">AVONENT</span>
                  {% endif %}
                </span>
                <span class="av-cb__bundle-copy">
                  <strong>{{ av_cb_bundle_title }}</strong>
                  <span>{{ av_cb_bundle_subtitle }}</span>
                </span>
                <span class="av-cb__bundle-price">
                  <strong data-av-cb-bundle-price="{{ qty }}">{{ av_cb_bundle_sub_total | money }}</strong>
                  <s data-av-cb-bundle-compare="{{ qty }}"{% if av_cb_subscription == blank %} hidden{% endif %}>{% if av_cb_subscription != blank %}{{ av_cb_bundle_one_time_total | money }}{% endif %}</s>
                </span>
              </button>
            {% endfor %}
          </div>

          <div class="av-cb__delivery-estimate" aria-live="polite">
            <span class="av-cb__delivery-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>Order now for delivery by: <strong data-av-cb-delivery-date></strong></span>
          </div>

          <button class="av-cb__buy" type="submit" {% unless av_cb_variant.available %}disabled{% endunless %}>
            {% if av_cb_variant.available %}
              <span class="av-cb__buy-mainline">
                <span>{{ av_cb_add_to_cart_text }}</span>
                <span class="av-cb__buy-divider" aria-hidden="true">|</span>
                <span class="av-cb__buy-price" data-av-cb-button-price>{{ av_cb_subscription_unit_price | money }}</span>
                <s class="av-cb__buy-compare" data-av-cb-button-compare{% if av_cb_subscription == blank and av_cb_one_time_compare_unit == 0 %} hidden{% endif %}>{% if av_cb_subscription != blank %}{{ av_cb_one_time_unit_price | money }}{% elsif av_cb_one_time_compare_unit > 0 %}{{ av_cb_one_time_compare_unit | money }}{% endif %}</s>
              </span>
              <span class="av-cb__buy-guarantee">90-Day Money-Back Guarantee</span>
            {% else %}
              <span class="av-cb__buy-mainline">Currently Unavailable</span>
            {% endif %}
          </button>
        {% endform %}
        </product-form-component>

        <div class="av-cb__refill-row" aria-label="Refill details">
          <span class="av-cb__refill-item">
            <span class="av-cb__refill-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M20 6v5h-5M4 18v-5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.2 10a7 7 0 0 0-11.9-3L4 9M5.8 14a7 7 0 0 0 11.9 3L20 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {{ av_cb_refill_text }}
          </span>
          <span class="av-cb__refill-divider" aria-hidden="true"></span>
          <span class="av-cb__refill-item">
            <span class="av-cb__refill-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {{ av_cb_cancel_text }}
          </span>
        </div>

        {% if av_cb_subscription != blank %}
          <button class="av-cb__purchase-toggle" type="button" data-av-cb-purchase-toggle aria-pressed="false">
            <span data-av-cb-purchase-toggle-text>One-Time Purchase <strong data-av-cb-one-time-toggle-price>{{ av_cb_one_time_unit_price | money }}</strong> + $4.95 Shipping</span>
          </button>
        {% endif %}
      </div>
    </div>
  </section>


  <div class="av-cb__top-stack">
    <div class="av-cb__guarantee-card" style="--guarantee-highlight: {{ av_cb_guarantee_color }}; --guarantee-text: #171717;">
      <div class="av-cb__guarantee-image">
        {% if av_cb_guarantee_image != blank %}
          {{ av_cb_guarantee_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', alt: 'Avonent 90-Day Money-Back Guarantee' }}
        {% else %}
          <div class="av-cb__guarantee-seal"><span>90<br><small>DAYS</small></span></div>
        {% endif %}
      </div>
      <div class="av-cb__guarantee-copy">
        <h3>{{ av_cb_guarantee_heading }}</h3>
        <p><mark>{{ av_cb_guarantee_highlight }}</mark> {{ av_cb_guarantee_body }}</p>
      </div>
    </div>

    <div class="av-cb__low-stock" style="--low-stock: #D62828; --low-stock-bg: #FFF5F5;">
      <div class="av-cb__low-stock-icon" aria-hidden="true">!</div>
      <div>
        <h3>{{ av_cb_stock_title }}</h3>
        <p>{{ av_cb_stock_text }}</p>
      </div>
    </div>

    <div class="av-cb__accordion-list" data-av-cb-accordion-list>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_1_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_1_body | newline_to_br }}</div>
      </details>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_2_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_2_body | newline_to_br }}</div>
      </details>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_3_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_3_body | newline_to_br }}</div>
      </details>
    </div>

    <div class="av-cb__trust-image-section" style="margin-top:10px;">
      {% if av_cb_trust_image != blank %}
        <span style="display:block;width:100%;">{{ av_cb_trust_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 1200px, calc(100vw - 22px)', alt: av_cb_trust_image_alt, style: 'display:block;width:100%;height:auto;border-radius:18px;' }}</span>
      {% else %}
        <img width="1600" height="900" src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-why-trust-avonent.png?v=1793242624" alt="{{ av_cb_trust_image_alt | escape }}" loading="lazy" style="display:block;width:100%;height:auto;border-radius:18px;">
      {% endif %}
    </div>

    {% unless av_cb_stats_show == false %}
      {% assign av_cb_stats_opacity = av_cb_stats_overlay_opacity | divided_by: 100.0 %}
      <section
        class="av-cb__stats-section"
        data-av-cb-stats
        style="--stats-overlay: {{ av_cb_stats_overlay_color }}; --stats-opacity: {{ av_cb_stats_opacity }}; --stats-text: {{ av_cb_stats_text_color }};{% if av_cb_stats_bg != blank %} --stats-bg: url('{{ av_cb_stats_bg | image_url: width: 1800 }}');{% endif %}"
      >
        <h2 class="av-cb__stats-heading">{{ av_cb_stats_heading }}</h2>
        <div class="av-cb__stats-list">
          {% for i in (1..4) %}
            {% case i %}
              {% when 1 %}
                {% assign av_cb_stat_start = av_cb_stat_1_start %}
                {% assign av_cb_stat_end = av_cb_stat_1_end %}
                {% assign av_cb_stat_label = av_cb_stat_1_label %}
              {% when 2 %}
                {% assign av_cb_stat_start = av_cb_stat_2_start %}
                {% assign av_cb_stat_end = av_cb_stat_2_end %}
                {% assign av_cb_stat_label = av_cb_stat_2_label %}
              {% when 3 %}
                {% assign av_cb_stat_start = av_cb_stat_3_start %}
                {% assign av_cb_stat_end = av_cb_stat_3_end %}
                {% assign av_cb_stat_label = av_cb_stat_3_label %}
              {% else %}
                {% assign av_cb_stat_start = av_cb_stat_4_start %}
                {% assign av_cb_stat_end = av_cb_stat_4_end %}
                {% assign av_cb_stat_label = av_cb_stat_4_label %}
            {% endcase %}
            {% if av_cb_stat_label != blank %}
              <div class="av-cb__stat">
                {% if av_cb_stat_end != blank %}
                  <span class="av-cb__stat-number" data-start="{{ av_cb_stat_start }}" data-end="{{ av_cb_stat_end }}" data-duration="{{ av_cb_stats_duration }}">{{ av_cb_stat_start }}%</span>
                {% else %}
                  <span class="av-cb__stat-number" aria-label="Add a verified percentage in Shopify">—%</span>
                {% endif %}
                <div class="av-cb__stat-label">{{ av_cb_stat_label | newline_to_br }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <a class="av-cb__stats-cta" href="#av-cb-top">{{ av_cb_stats_cta }}</a>
        <div class="av-cb__stats-guarantee">
          <span class="av-cb__stats-guarantee-icon" aria-hidden="true">
            {% if av_cb_stats_guarantee_icon != blank %}

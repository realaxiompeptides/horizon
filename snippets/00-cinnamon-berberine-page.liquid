        <summary><span>{{ settings.av_cb_acc_3_title | default: 'How It Works' }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ settings.av_cb_acc_3_body }}</div>
      </details>

                  <div class="av-cb__review-tags">
                    {% if review.settings.tag_1 != blank %}<span class="av-cb__review-tag">{{ review.settings.tag_1 | escape }}</span>{% endif %}
                    {% if review.settings.tag_2 != blank %}<span class="av-cb__review-tag">{{ review.settings.tag_2 | escape }}</span>{% endif %}
                  </div>
                {% endif %}
              </article>
            {% elsif request.design_mode %}
              <article class="av-cb__review-card" {{ review.shopify_attributes }}>Add a customer review in this block.</article>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

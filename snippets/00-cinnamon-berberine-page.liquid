          <span class="av-cb__chip">True Ceylon · Cinnamomum verum</span>
          <span class="av-cb__chip">Berberine HCl</span>
          <span class="av-cb__chip">MCT Oil Softgels</span>
          <span class="av-cb__chip">30-Day Supply</span>
        </div>

        <div class="av-cb__price">
          <strong data-av-cb-price>{{ av_cb_unit_price | money }}</strong>
          <span data-av-cb-supply>30-day supply</span>
        </div>

        {% form 'product', av_cb_product, id: av_cb_form_id, class: 'av-cb__form' %}
          <input type="hidden" name="id" value="{{ av_cb_variant.id }}">
          <input type="hidden" name="quantity" value="1" data-av-cb-quantity>
          <p class="av-cb__bundle-label">Choose your supply</p>
          <div class="av-cb__bundles" role="group" aria-label="Choose supply">
            <button class="av-cb__bundle is-active" type="button" data-av-cb-bundle="1">
              <strong>Buy 1</strong><span>30-Day Supply</span>
            </button>
            <button class="av-cb__bundle" type="button" data-av-cb-bundle="2">
              <span class="av-cb__badge">Most Popular</span>
              <strong>Buy 2</strong><span>60-Day Supply</span>
            </button>
            <button class="av-cb__bundle" type="button" data-av-cb-bundle="3">
              <span class="av-cb__badge">Best Value</span>
              <strong>Buy 3</strong><span>90-Day Supply</span>
            </button>
          </div>
          <button class="av-cb__buy" type="submit" {% unless av_cb_variant.available %}disabled{% endunless %}>
            {% if av_cb_variant.available %}Add to Cart · <span data-av-cb-button-price>{{ av_cb_unit_price | money }}</span>{% else %}Currently Unavailable{% endif %}
          </button>
        {% endform %}
        {% if av_cb_subscription != blank %}
          <div class="av-cb__refill-row" aria-label="Subscription details">
            <span class="av-cb__refill-item">
              <span class="av-cb__refill-icon" aria-hidden="true">

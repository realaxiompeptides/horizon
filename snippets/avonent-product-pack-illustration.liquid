{% liquid
  assign pack_kind = kind | default: 'soursop'
  assign pack_label = 'Soursop'
  assign ingredient_label = 'SOURSOP LEAF EXTRACT'
  assign pack_accent = '#21805E'
  assign pack_dark = '#175B43'
  assign bg_first = '#C5E5D8'
  assign bg_second = '#E9F5E7'
  if pack_kind == 'garlic'
    assign pack_label = 'Garlic'
    assign ingredient_label = 'ODORLESS AGED GARLIC'
    assign pack_accent = '#A94D4B'
    assign pack_dark = '#793B43'
    assign bg_first = '#E8D8D4'
    assign bg_second = '#F8EBE6'
  endif
  assign asset_id = uid | default: 'sample' | replace: '-', '' | replace: '_', ''
%}
<svg class="avonent-health-gallery__pack-art" viewBox="0 0 860 720" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="avbg{{ asset_id }}" x1="0" y1="0" x2="1" y2="1"><stop stop-color="{{ bg_first }}"/><stop offset="1" stop-color="{{ bg_second }}"/></linearGradient>
    <linearGradient id="avpaper{{ asset_id }}" x1="0" x2="1"><stop stop-color="#E5DDD0"/><stop offset=".11" stop-color="#FCF9F0"/><stop offset=".76" stop-color="#FFFDF8"/><stop offset="1" stop-color="#D8D0C4"/></linearGradient>
    <linearGradient id="avcapsule{{ asset_id }}" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FCE5A2"/><stop offset=".5" stop-color="#C78E2D"/><stop offset="1" stop-color="#A97927"/></linearGradient>
    <linearGradient id="avsurface{{ asset_id }}" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#F7F3EE"/><stop offset="1" stop-color="#DED8D1"/></linearGradient>
    <filter id="avshadow{{ asset_id }}" x="-35%" y="-35%" width="170%" height="190%"><feGaussianBlur stdDeviation="17"/></filter>
  </defs>
  <rect width="860" height="720" fill="url(#avbg{{ asset_id }})"/>
  <circle cx="770" cy="124" r="200" fill="#FFF" opacity=".19"/>
  <path d="M-28 205C100 66 145 103 230 0M-17 338C102 188 163 233 242 138M720 0C692 125 775 150 895 189" stroke="{{ pack_accent }}" opacity=".13" stroke-width="39" fill="none" stroke-linecap="round"/>
  <rect y="535" width="860" height="185" fill="url(#avsurface{{ asset_id }})"/>
  <path d="M0 535H860" stroke="#FFF" opacity=".9" stroke-width="4"/>
  <ellipse cx="435" cy="625" rx="240" ry="42" fill="#6E615A" opacity=".27" filter="url(#avshadow{{ asset_id }})"/>
  <path d="M247 85H615L637 621Q436 643 230 620L247 85Z" fill="url(#avpaper{{ asset_id }})" stroke="#CAC3B8" stroke-width="3"/>
  <path d="M244 96L240 122Q435 134 627 122L623 96Z" fill="#EDE8DE"/>
  <path d="M245 119Q432 131 630 119" stroke="#CAC3B8" stroke-width="4" fill="none"/>
  <path d="M242 142H632" stroke="#F9F6EF" stroke-width="4"/>
  <path d="M231 581C344 536 467 563 637 537L637 620Q433 643 231 620Z" fill="{{ pack_accent }}"/>
  <path d="M231 593C342 551 483 572 637 545" stroke="#FFF" opacity=".32" stroke-width="4" fill="none"/>
  <g transform="translate(324 184)" fill="none" stroke="{{ pack_dark }}" stroke-width="4" stroke-linecap="round">
    <path d="M0 7c13-26 31-20 43-1C29 6 17 23 0 7Z"/>
    <path d="M42 6c11-20 30-16 39-2C67 14 56 18 42 6Z"/>
    <path d="M40 9c-1 20 0 25 0 31"/>
  </g>
  <text x="434" y="224" text-anchor="middle" font-family="Georgia,serif" font-size="34" font-weight="700" letter-spacing="1.2" fill="#173147">Avonent</text>
  <text x="435" y="328" text-anchor="middle" font-family="Arial,sans-serif" font-size="70" font-weight="800" letter-spacing="-2" fill="{{ pack_dark }}">{{ pack_label }}</text>
  <text x="435" y="391" text-anchor="middle" font-family="Arial,sans-serif" font-size="61" font-weight="800" letter-spacing="-1.5" fill="{{ pack_dark }}">Softgels</text>
  <rect x="302" y="411" width="263" height="34" rx="17" fill="{{ pack_accent }}"/>
  <text x="434" y="435" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="700" letter-spacing=".8" fill="#FFF">{{ ingredient_label }}</text>
  {% if pack_kind == 'garlic' %}
    <g transform="translate(460 478)">
      <path d="M29 6C9 24 0 47 12 65C23 80 63 86 85 64C97 51 89 29 67 5Z" fill="#F7EEE4" stroke="#D8C5B5" stroke-width="3"/>
      <path d="M44 4C38 25 28 40 36 75M55 4C60 34 66 53 56 76" fill="none" stroke="#D2BEAF" stroke-width="2"/>
      <path d="M49 8C44-3 47-10 54-15" stroke="#B8A58D" stroke-width="5" fill="none" stroke-linecap="round"/>
    </g>
  {% else %}
    <g transform="translate(484 499) rotate(-18)">
      <ellipse cx="37" cy="28" rx="49" ry="33" fill="#89B65C" stroke="#427D42" stroke-width="3"/>
      <path d="M-3 28Q36-12 76 28Q36 68-3 28Z" fill="#F9F3D9"/>
      <ellipse cx="36" cy="27" rx="14" ry="6" fill="#79513C"/>
      <path d="m-9 12-13-7m44-16V-25m53 24 13-12m13 46 13 2m-45 28 8 10m-53-7-4 11" stroke="#427D42" stroke-width="5" stroke-linecap="round"/>
    </g>
  {% endif %}
  <g font-family="Arial,sans-serif" fill="#3D574B">
    <text x="285" y="494" font-size="19" font-weight="700">✓  DAILY WELLNESS</text>
    <text x="285" y="526" font-size="19" font-weight="700">✓  BOTANICAL EXTRACT</text>
    <text x="434" y="596" font-size="18" font-weight="700" fill="#FFF" text-anchor="middle">SOFTGELS  ·  DIETARY SUPPLEMENT</text>
  </g>
  <g transform="translate(154 606) rotate(-16)">
    <ellipse rx="52" ry="22" fill="url(#avcapsule{{ asset_id }})" stroke="#9B6B24" stroke-width="2"/>
    <path d="M-38 0C-28-14 13-18 37-8" stroke="#FFF0B8" stroke-width="8" stroke-linecap="round" opacity=".75" fill="none"/>
  </g>
  <g transform="translate(237 631) rotate(17)">
    <ellipse rx="49" ry="20" fill="url(#avcapsule{{ asset_id }})" stroke="#9B6B24" stroke-width="2"/>
    <path d="M-33-2C-15-12 11-14 35-6" stroke="#FFF0B8" stroke-width="7" stroke-linecap="round" opacity=".78" fill="none"/>
  </g>
  <g transform="translate(692 619) rotate(-32)">
    <ellipse rx="44" ry="19" fill="url(#avcapsule{{ asset_id }})" stroke="#9B6B24" stroke-width="2"/>
    <path d="M-29-1C-10-11 15-12 27-6" stroke="#FFF0B8" stroke-width="7" stroke-linecap="round" opacity=".78" fill="none"/>
  </g>
</svg>
